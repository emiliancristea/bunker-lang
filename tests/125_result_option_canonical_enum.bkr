// Test 125: Canonical Result and Option Enum Matching
// Purpose: Verify unified qualified and unqualified pattern matching for Option and Result,
// including string payload extraction on Err without pointer truncation.
// Expected: Returns 42

kernel ResultOptionCanonicalEnum {
    fn main() -> i32 {
        // 1. Unqualified Ok/Err match with integer payload
        let r1: Result<i32, str> = result_ok(20);
        let v1: i32 = match r1 {
            Ok(x) => x;
            Err(e) => 0;
        };

        // 2. Qualified Result.Ok / Result.Err match with string payload
        let r2: Result<i32, str> = result_err("world");
        let v2: i32 = match r2 {
            Result.Ok(x) => 0;
            Result.Err(e) => len(e);
        };

        // 3. Unqualified Some/None match
        let o1: Option<i32> = Some(15);
        let v3: i32 = match o1 {
            Some(v) => v;
            None => 0;
        };

        // 4. Qualified Option.Some / Option.None match
        let o2: Option<i32> = None;
        let v4: i32 = match o2 {
            Option.Some(v) => 0;
            Option.None => 2;
        };

        return v1 + v2 + v3 + v4;
    }
}
