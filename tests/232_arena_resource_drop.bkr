// Test 232: Region/Arena Allocation Rules, Deterministic Defer/Drop, and Resource Management (Q-280, M-004, M-005, M-010)
// Purpose: Verify arena region scoping, loop watermark memory reuse, LIFO defer execution, and resource teardown.
// Expected return: 42

kernel ArenaResourceDropKernel {
    struct Resource {
        id: i32,
        is_open: bool,
    }

    struct WorkItem {
        weight: i32,
        payload: [i32; 4],
    }

    fn test_nested_arena_scoping() -> bool {
        // Outer scope allocation
        let w_outer = WorkItem {
            weight: 10,
            payload: [1, 2, 3, 4],
        };

        let mut inner_sum: i32 = 0;

        if w_outer.weight > 5 {
            // Inner arena block: allocates temporary item
            let w_inner = WorkItem {
                weight: 20,
                payload: [10, 20, 30, 40],
            };
            inner_sum = w_inner.weight + w_inner.payload[3]; // 20 + 40 = 60
        }

        // Outer item remains valid and uncorrupted after inner arena pop
        let outer_sum = w_outer.weight + w_outer.payload[0] + w_outer.payload[3]; // 10 + 1 + 4 = 15

        return inner_sum == 60 && outer_sum == 15;
    }

    fn test_loop_arena_reuse() -> bool {
        let mut total_weight: i32 = 0;

        // Loop allocating work items each iteration; arena watermark pop prevents memory growth
        for i in 0..8 {
            let item = WorkItem {
                weight: i * 2,
                payload: [i, i + 1, i + 2, i + 3],
            };
            total_weight = total_weight + item.weight + item.payload[0];
            // each iteration adds (i * 2) + i = 3 * i
            // sum for i=0..7 is 3 * (0+1+2+3+4+5+6+7) = 3 * 28 = 84
        }

        return total_weight == 84;
    }

    fn test_lifo_defer_order(trace: [i32; 4]) -> i32 {
        trace[0] = 0; // step counter

        // First defer registered -> should execute LAST (3rd)
        defer {
            let step = trace[0];
            trace[1] = step + 1; // expected 3
            trace[0] = step + 1;
        }

        // Second defer registered -> should execute 2nd
        defer {
            let step = trace[0];
            trace[2] = step + 1; // expected 2
            trace[0] = step + 1;
        }

        // Third defer registered -> should execute FIRST (1st)
        defer {
            let step = trace[0];
            trace[3] = step + 1; // expected 1
            trace[0] = step + 1;
        }

        // Function body evaluation completes first
        return 100;
    }

    fn fail_with_try() -> Result<i32, str> {
        return Err("intentional failure");
    }

    fn test_defer_on_try_error(cleanup_flag: [i32; 1]) -> Result<i32, str> {
        cleanup_flag[0] = 1;

        defer {
            // Must execute when `?` returns early on Err
            cleanup_flag[0] = 99;
        }

        let val: i32 = fail_with_try()?;
        return Ok(val);
    }

    fn test_resource_deterministic_drop() -> bool {
        let res = Resource {
            id: 777,
            is_open: true,
        };

        let status_after_teardown: [i32; 2] = [0, 0];

        // Execute resource lifecycle inside enclosed block
        if res.is_open {
            let active_res = Resource {
                id: res.id,
                is_open: true,
            };

            defer {
                // Deterministic drop pattern: marks resource closed
                status_after_teardown[0] = active_res.id;
                status_after_teardown[1] = 1; // closed
            }

            // Normal processing with active_res
            let _ = active_res.id + 1;
        }

        // Assert drop executed deterministically when leaving the if block
        return status_after_teardown[0] == 777 && status_after_teardown[1] == 1;
    }

    fn main() -> i64 {
        // 1. Test nested arena block scoping
        if !test_nested_arena_scoping() {
            return 1;
        }

        // 2. Test loop watermark memory reuse
        if !test_loop_arena_reuse() {
            return 2;
        }

        // 3. Test LIFO defer execution order
        let trace: [i32; 4] = [0, 0, 0, 0];
        let ret = test_lifo_defer_order(trace);
        if ret != 100 {
            return 3;
        }
        // trace[3] ran first (= 1), trace[2] ran second (= 2), trace[1] ran third (= 3)
        if trace[3] != 1 || trace[2] != 2 || trace[1] != 3 {
            return 4;
        }

        // 4. Test defer execution upon ? operator early propagation
        let cleanup_flag: [i32; 1] = [0];
        let try_res = test_defer_on_try_error(cleanup_flag);
        let was_err = match try_res {
            Ok(_) => false;
            Err(_) => true;
        };
        if !was_err || cleanup_flag[0] != 99 {
            return 5;
        }

        // 5. Test deterministic resource teardown
        if !test_resource_deterministic_drop() {
            return 6;
        }

        return 42;
    }
}
