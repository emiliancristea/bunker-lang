// Test 39: Kernel while loop with break
// Purpose: Verify break works inside while loop.
// Expected: Result: 15 (sum of 1..5, break when i > 5)

kernel WhileBreakTest {
    fn main() -> i32 {
        let sum: i32 = 0;
        let i: i32 = 1;

        while i <= 100 {
            if i > 5 {
                break;
            }
            sum = sum + i;
            i = i + 1;
        }

        return sum;
    }
}
