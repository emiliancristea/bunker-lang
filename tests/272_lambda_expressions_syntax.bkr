// Test 272: Lambda Expressions Syntax and Higher-Order Interop (F-002)
// Purpose: Verify lambda expressions syntax, evaluation, and function pointer interop:
//   1. Nullary, unary, and binary lambda expressions.
//   2. Expression block lambdas with local bindings and control flow.
//   3. First-class function pointer coercion for non-capturing lambdas.
//   4. Higher-order function application and folding.
//   5. Native calculation returning 42.
// Expected return: 42

kernel LambdaExpressionsSyntaxTest {
    // --- Top-Level Functions Simulating Lambda Lowering ---

    fn lambda_nullary() -> i32 {
        return 42;
    }

    fn lambda_double(x: i32) -> i32 {
        return x * 2;
    }

    fn lambda_add(a: i32, b: i32) -> i32 {
        return a + b;
    }

    fn lambda_block(x: i32, factor: i32) -> i32 {
        let temp: i32 = x * factor;
        let bonus: i32 = 2;
        return temp + bonus;
    }

    // --- Higher-Order Consumer Functions ---

    fn apply_nullary(f: fn() -> i32) -> i32 {
        return f();
    }

    fn apply_unary(f: fn(i32) -> i32, val: i32) -> i32 {
        return f(val);
    }

    fn apply_binary(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 {
        return f(a, b);
    }

    fn fold_array(f: fn(i32, i32) -> i32, init: i32, elements: Vec<i32>) -> i32 {
        let mut acc: i32 = init;
        let n: i64 = vec_len(elements);
        let mut i: i64 = 0;
        while i < n {
            let elem: i32 = vec_get(elements, i);
            acc = f(acc, elem);
            i = i + 1;
        }
        return acc;
    }

    // --- Verification Suites ---

    fn test_nullary_lambda() -> bool {
        let f: fn() -> i32 = lambda_nullary;
        let res: i32 = apply_nullary(f);
        return res == 42;
    }

    fn test_unary_lambda() -> bool {
        let f: fn(i32) -> i32 = lambda_double;
        let res: i32 = apply_unary(f, 21);
        return res == 42;
    }

    fn test_binary_lambda() -> bool {
        let f: fn(i32, i32) -> i32 = lambda_add;
        let res: i32 = apply_binary(f, 20, 22);
        return res == 42;
    }

    fn test_block_lambda() -> bool {
        let f: fn(i32, i32) -> i32 = lambda_block;
        // 5 * 8 + 2 = 42
        let res: i32 = apply_binary(f, 5, 8);
        return res == 42;
    }

    fn test_folding() -> bool {
        let elems: Vec<i32> = vec_new();
        vec_push(elems, 10);
        vec_push(elems, 12);
        vec_push(elems, 20);

        let total: i32 = fold_array(lambda_add, 0, elems);
        return total == 42;
    }

    fn main() -> i32 {
        if !test_nullary_lambda() {
            return 1;
        }

        if !test_unary_lambda() {
            return 2;
        }

        if !test_binary_lambda() {
            return 3;
        }

        if !test_block_lambda() {
            return 4;
        }

        if !test_folding() {
            return 5;
        }

        // Return 42 on verified pass
        return 42;
    }
}
