// Test 53: Kernel floating point operations
// Purpose: Verify floating point arithmetic works correctly.
// Expected: Result: 42

kernel FloatOpsTest {
    fn main() -> i32 {
        // Basic float operations
        let a: f64 = 10.5;
        let b: f64 = 2.5;

        let sum: f64 = a + b;       // 13.0
        let diff: f64 = a - b;      // 8.0
        let prod: f64 = a * b;      // 26.25
        let quot: f64 = a / b;      // 4.2

        // Float to int conversion
        let sum_int: i32 = sum as i32;   // 13
        let diff_int: i32 = diff as i32; // 8
        let prod_int: i32 = prod as i32; // 26
        let quot_int: i32 = quot as i32; // 4

        // Check: 13 + 8 + 26 - 4 - 1 = 42
        return sum_int + diff_int + prod_int - quot_int - 1;
    }
}
