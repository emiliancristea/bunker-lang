// Test 12: Kernel i64 Promotion
// Purpose: Verify Kernel JIT supports i64 arithmetic with i32 literals and typed `let` widening.
// Expected: Shell can `use` an i64 Kernel function that mixes i64 values and i32 literals.

kernel Math64Promo {
    #[verified]
    fn add_two(x: i64) -> i64 {
        let one: i64 = 1;
        return x + one + 1;
    }
}

shell UseI64Promo {
    import Math64Promo;

    agent App {
        big = 5000000000;

        on receive "start" {
            let value = use Math64Promo.add_two with x=big;
            send "check" to Checker with value=value;
        }
    }

    agent Checker {
        on receive "check" with value: i64 {
            match value == 5000000002 {
                true => send "done" to System;
                false => send "fail" to System;
            }
        }
    }
}

