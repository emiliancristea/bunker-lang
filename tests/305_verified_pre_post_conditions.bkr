// Test 305: Pure Bunker Verified Pre/Post Conditions (BKR-SPEC-VERIFY-001)
// Purpose: Verify symbolic contract execution for bank transfer pre/post conditions and bug detection.
// Expected return: 42

kernel VerifiedPrePostConditions {
    struct LinExpr {
        var_names: Vec<str>,
        var_coeffs: Vec<i64>,
        constant: i64,
    }

    struct VerifyContract {
        func_name: str,
        requires_desc: Vec<str>,
        ensures_desc: Vec<str>,
        requires_satisfied: bool,
        ensures_verified: bool,
        counterexample: str,
    }

    fn lin_expr_new() -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: 0,
        };
    }

    fn lin_expr_constant(c: i64) -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: c,
        };
    }

    fn lin_expr_var(name: str) -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        vec_push(names, name);
        vec_push(coeffs, 1);
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: 0,
        };
    }

    fn lin_expr_get_coeff(expr: LinExpr, name: str) -> i64 {
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            if vec_get(expr.var_names, i) == name {
                return vec_get(expr.var_coeffs, i);
            }
            i = i + 1;
        }
        return 0;
    }

    fn lin_expr_set_coeff(expr: LinExpr, name: str, coeff: i64) -> bool {
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            if vec_get(expr.var_names, i) == name {
                vec_set(expr.var_coeffs, i, coeff);
                return true;
            }
            i = i + 1;
        }
        vec_push(expr.var_names, name);
        vec_push(expr.var_coeffs, coeff);
        return true;
    }

    fn lin_expr_add(a: LinExpr, b: LinExpr) -> LinExpr {
        let res = lin_expr_new();
        res.constant = a.constant + b.constant;

        let mut i: i64 = 0;
        let len_a = vec_len(a.var_names);
        while i < len_a {
            let name = vec_get(a.var_names, i);
            let coeff = vec_get(a.var_coeffs, i);
            lin_expr_set_coeff(res, name, coeff);
            i = i + 1;
        }

        let mut j: i64 = 0;
        let len_b = vec_len(b.var_names);
        while j < len_b {
            let name = vec_get(b.var_names, j);
            let coeff = vec_get(b.var_coeffs, j);
            let existing = lin_expr_get_coeff(res, name);
            lin_expr_set_coeff(res, name, existing + coeff);
            j = j + 1;
        }

        return res;
    }

    fn lin_expr_sub(a: LinExpr, b: LinExpr) -> LinExpr {
        let res = lin_expr_new();
        res.constant = a.constant - b.constant;

        let mut i: i64 = 0;
        let len_a = vec_len(a.var_names);
        while i < len_a {
            let name = vec_get(a.var_names, i);
            let coeff = vec_get(a.var_coeffs, i);
            lin_expr_set_coeff(res, name, coeff);
            i = i + 1;
        }

        let mut j: i64 = 0;
        let len_b = vec_len(b.var_names);
        while j < len_b {
            let name = vec_get(b.var_names, j);
            let coeff = vec_get(b.var_coeffs, j);
            let existing = lin_expr_get_coeff(res, name);
            lin_expr_set_coeff(res, name, existing - coeff);
            j = j + 1;
        }

        return res;
    }

    fn lin_expr_is_zero(expr: LinExpr) -> bool {
        if expr.constant != 0 {
            return false;
        }
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            if vec_get(expr.var_coeffs, i) != 0 {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn lin_expr_eval(expr: LinExpr, env: HashMap<str, i64>) -> i64 {
        let mut acc = expr.constant;
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            let name = vec_get(expr.var_names, i);
            let coeff = vec_get(expr.var_coeffs, i);
            if hashmap_contains(env, name) {
                let val = hashmap_get(env, name);
                acc = acc + coeff * val;
            }
            i = i + 1;
        }
        return acc;
    }

    fn verify_prove_equality(lhs: LinExpr, rhs: LinExpr) -> bool {
        let diff = lin_expr_sub(lhs, rhs);
        return lin_expr_is_zero(diff);
    }

    fn main() -> i32 {
        // --- 1. Initial State Definition (Parameters & Preconditions) ---
        let initial_from = lin_expr_var("from.balance");
        let initial_to = lin_expr_var("to.balance");
        let amount = lin_expr_var("amount");

        // Preconditions:
        // #[requires(amount > 0)]
        // #[requires(from.balance >= amount)]
        // Assumed valid in pre-state.

        // --- 2. Symbolic Execution of Banking.transfer ---
        // Statement 1: from.balance = from.balance - amount
        let final_from = lin_expr_sub(initial_from, amount);

        // Statement 2: to.balance = to.balance + amount
        let final_to = lin_expr_add(initial_to, amount);

        // --- 3. Postcondition Verification ---
        // #[ensures(from.balance + to.balance == old(from.balance) + old(to.balance))]

        // Evaluated Final LHS: from.balance' + to.balance'
        let post_lhs = lin_expr_add(final_from, final_to);

        // Initial Old RHS: old(from.balance) + old(to.balance)
        let post_rhs = lin_expr_add(initial_from, initial_to);

        // Verify correct transfer:
        if !verify_prove_equality(post_lhs, post_rhs) {
            return 1;
        }

        // Verify coefficients reduced cleanly to 1 for both variables:
        if lin_expr_get_coeff(post_lhs, "from.balance") != 1 { return 2; }
        if lin_expr_get_coeff(post_lhs, "to.balance") != 1 { return 3; }
        if lin_expr_get_coeff(post_lhs, "amount") != 0 { return 4; }

        // --- 4. Buggy Transfer Detection (06_verified_transfer_BAD.bkr) ---
        // Suppose buggy code forgets: to.balance = to.balance + amount;
        let buggy_to = initial_to; // unchanged!
        let buggy_lhs = lin_expr_add(final_from, buggy_to);

        // Proof MUST FAIL on buggy implementation:
        if verify_prove_equality(buggy_lhs, post_rhs) {
            return 5;
        }

        // Diff must be non-zero (-amount):
        let diff = lin_expr_sub(buggy_lhs, post_rhs);
        if lin_expr_is_zero(diff) { return 6; }
        if lin_expr_get_coeff(diff, "amount") != -1 { return 7; }

        // Synthesize Counterexample with concrete model { amount: 50 }:
        let model: HashMap<str, i64> = hashmap_new();
        hashmap_insert(model, "from.balance", 100);
        hashmap_insert(model, "to.balance", 20);
        hashmap_insert(model, "amount", 50);

        let eval_diff = lin_expr_eval(diff, model);
        if eval_diff != -50 { return 8; }

        return 42;
    }
}
