// Test 304: Pure Bunker Contract Verification Engine (BKR-SPEC-VERIFY-001)
// Purpose: Verify linear arithmetic expression solver, symbolic evaluation, and equality proofs in pure Bunker.
// Expected return: 42

kernel ContractVerificationEngine {
    struct LinExpr {
        var_names: Vec<str>,
        var_coeffs: Vec<i64>,
        constant: i64,
    }

    struct VerifyContract {
        func_name: str,
        requires_desc: Vec<str>,
        ensures_desc: Vec<str>,
        requires_satisfied: bool,
        ensures_verified: bool,
        counterexample: str,
    }

    fn lin_expr_new() -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: 0,
        };
    }

    fn lin_expr_constant(c: i64) -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: c,
        };
    }

    fn lin_expr_var(name: str) -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        vec_push(names, name);
        vec_push(coeffs, 1);
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: 0,
        };
    }

    fn lin_expr_var_with_coeff(name: str, coeff: i64) -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        vec_push(names, name);
        vec_push(coeffs, coeff);
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: 0,
        };
    }

    fn lin_expr_get_coeff(expr: LinExpr, name: str) -> i64 {
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            if vec_get(expr.var_names, i) == name {
                return vec_get(expr.var_coeffs, i);
            }
            i = i + 1;
        }
        return 0;
    }

    fn lin_expr_set_coeff(expr: LinExpr, name: str, coeff: i64) -> bool {
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            if vec_get(expr.var_names, i) == name {
                vec_set(expr.var_coeffs, i, coeff);
                return true;
            }
            i = i + 1;
        }
        vec_push(expr.var_names, name);
        vec_push(expr.var_coeffs, coeff);
        return true;
    }

    fn lin_expr_add(a: LinExpr, b: LinExpr) -> LinExpr {
        let res = lin_expr_new();
        res.constant = a.constant + b.constant;

        let mut i: i64 = 0;
        let len_a = vec_len(a.var_names);
        while i < len_a {
            let name = vec_get(a.var_names, i);
            let coeff = vec_get(a.var_coeffs, i);
            lin_expr_set_coeff(res, name, coeff);
            i = i + 1;
        }

        let mut j: i64 = 0;
        let len_b = vec_len(b.var_names);
        while j < len_b {
            let name = vec_get(b.var_names, j);
            let coeff = vec_get(b.var_coeffs, j);
            let existing = lin_expr_get_coeff(res, name);
            lin_expr_set_coeff(res, name, existing + coeff);
            j = j + 1;
        }

        return res;
    }

    fn lin_expr_sub(a: LinExpr, b: LinExpr) -> LinExpr {
        let res = lin_expr_new();
        res.constant = a.constant - b.constant;

        let mut i: i64 = 0;
        let len_a = vec_len(a.var_names);
        while i < len_a {
            let name = vec_get(a.var_names, i);
            let coeff = vec_get(a.var_coeffs, i);
            lin_expr_set_coeff(res, name, coeff);
            i = i + 1;
        }

        let mut j: i64 = 0;
        let len_b = vec_len(b.var_names);
        while j < len_b {
            let name = vec_get(b.var_names, j);
            let coeff = vec_get(b.var_coeffs, j);
            let existing = lin_expr_get_coeff(res, name);
            lin_expr_set_coeff(res, name, existing - coeff);
            j = j + 1;
        }

        return res;
    }

    fn lin_expr_mul_const(a: LinExpr, k: i64) -> LinExpr {
        let res = lin_expr_new();
        res.constant = a.constant * k;

        let mut i: i64 = 0;
        let len_a = vec_len(a.var_names);
        while i < len_a {
            let name = vec_get(a.var_names, i);
            let coeff = vec_get(a.var_coeffs, i);
            lin_expr_set_coeff(res, name, coeff * k);
            i = i + 1;
        }

        return res;
    }

    fn lin_expr_is_zero(expr: LinExpr) -> bool {
        if expr.constant != 0 {
            return false;
        }
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            if vec_get(expr.var_coeffs, i) != 0 {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn lin_expr_eval(expr: LinExpr, env: HashMap<str, i64>) -> i64 {
        let mut acc = expr.constant;
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            let name = vec_get(expr.var_names, i);
            let coeff = vec_get(expr.var_coeffs, i);
            if hashmap_contains(env, name) {
                let val = hashmap_get(env, name);
                acc = acc + coeff * val;
            }
            i = i + 1;
        }
        return acc;
    }

    fn verify_prove_equality(lhs: LinExpr, rhs: LinExpr) -> bool {
        let diff = lin_expr_sub(lhs, rhs);
        return lin_expr_is_zero(diff);
    }

    fn main() -> i32 {
        // 1. Construct: e1 = 2*x + 5
        let e1_var = lin_expr_var_with_coeff("x", 2);
        let e1_const = lin_expr_constant(5);
        let e1 = lin_expr_add(e1_var, e1_const);

        if lin_expr_get_coeff(e1, "x") != 2 { return 1; }
        if e1.constant != 5 { return 2; }

        // 2. Construct: e2 = 3*y - 2
        let e2_var = lin_expr_var_with_coeff("y", 3);
        let e2_const = lin_expr_constant(-2);
        let e2 = lin_expr_add(e2_var, e2_const);

        if lin_expr_get_coeff(e2, "y") != 3 { return 3; }
        if e2.constant != -2 { return 4; }

        // 3. Add: e3 = e1 + e2 = 2*x + 3*y + 3
        let e3 = lin_expr_add(e1, e2);
        if lin_expr_get_coeff(e3, "x") != 2 { return 5; }
        if lin_expr_get_coeff(e3, "y") != 3 { return 6; }
        if e3.constant != 3 { return 7; }

        // 4. Subtract self: e4 = e3 - e3 == 0
        let e4 = lin_expr_sub(e3, e3);
        if !lin_expr_is_zero(e4) { return 8; }

        // 5. Scalar multiply: e5 = 3 * (x - 4) = 3*x - 12
        let ex = lin_expr_var("x");
        let ec = lin_expr_constant(-4);
        let ex_sub = lin_expr_add(ex, ec);
        let e5 = lin_expr_mul_const(ex_sub, 3);
        if lin_expr_get_coeff(e5, "x") != 3 { return 9; }
        if e5.constant != -12 { return 10; }

        // 6. Evaluate e3 with { x: 10, y: 4 }: 2*10 + 3*4 + 3 = 20 + 12 + 3 = 35
        let env: HashMap<str, i64> = hashmap_new();
        hashmap_insert(env, "x", 10);
        hashmap_insert(env, "y", 4);
        let val = lin_expr_eval(e3, env);
        if val != 35 { return 11; }

        // 7. Verify Prove Equality
        let e3_clone = lin_expr_add(e1, e2);
        if !verify_prove_equality(e3, e3_clone) { return 12; }

        // 8. Verify Inequality Detection
        let e_mismatch = lin_expr_add(e3, lin_expr_constant(1));
        if verify_prove_equality(e3, e_mismatch) { return 13; }

        return 42;
    }
}
