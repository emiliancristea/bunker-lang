// Test 01: Basic Math
// Purpose: Verify Kernel function parsing and code generation.
// Expected: Compiles to native code. Returns 42.

kernel Math {
    fn add(x: i32, y: i32) -> i32 {
        return x + y;
    }

    fn main() -> i32 {
        let a = 10;
        let b = 32;
        let result = add(a, b);
        return result;
    }
}
