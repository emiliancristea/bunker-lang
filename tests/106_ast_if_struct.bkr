// Test 106: AstIf as a real compiler if-statement record
// Purpose: If cond/then/else/span live in a Bunker struct, not Vec<i64>.
// Expected: Result: 42

kernel AstIfStruct {
    struct AstIf {
        start: i64,
        end: i64,
        cond: i64,
        then_block: i64,
        else_block: i64
    }

    struct AstWhile {
        start: i64,
        end: i64,
        cond: i64,
        body: i64
    }

    fn make_if(cond: i64, then_block: i64, else_block: i64) -> AstIf {
        return AstIf {
            start: 0,
            end: 8,
            cond: cond,
            then_block: then_block,
            else_block: else_block
        };
    }

    fn make_while(cond: i64, body: i64) -> AstWhile {
        return AstWhile {
            start: 1,
            end: 7,
            cond: cond,
            body: body
        };
    }

    fn if_then(stmt: AstIf) -> i64 {
        return stmt.then_block;
    }

    fn while_body(stmt: AstWhile) -> i64 {
        return stmt.body;
    }

    fn main() -> i32 {
        let stmt: AstIf = make_if(1, 20, 2);
        let loop_stmt: AstWhile = make_while(3, 19);
        if stmt.start == 0 {
            if stmt.end == 8 {
                if stmt.cond == 1 {
                    if if_then(make_if(0, 21, 0)) == 21 {
                        if loop_stmt.start == 1 {
                            if while_body(make_while(4, 21)) == 21 {
                                return 42;
                            }
                        }
                    }
                }
            }
        }
        return 0;
    }
}
