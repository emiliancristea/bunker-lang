// Test 36: Kernel type casting with 'as' operator
// Purpose: Verify type casting between numeric types.
// Expected: Result: 46 (10 + 3 + 7 + 1 + 25)

kernel TypeCastTest {
    fn main() -> i32 {
        // i32 to i64 cast
        let a: i32 = 10;
        let b: i64 = a as i64;

        // f64 to i32 cast (truncation)
        let pi: f64 = 3.14159;
        let pi_int: i32 = pi as i32;  // 3

        // i32 to f64 cast
        let x: i32 = 7;
        let x_float: f64 = x as f64;  // 7.0
        let x_back: i32 = x_float as i32;  // 7

        // i64 to i32 cast (truncation)
        let big: i64 = 100000000001;
        let small: i32 = big as i32;  // truncated, but we don't rely on specific value

        // bool to i32 cast
        let flag: bool = true;
        let flag_int: i32 = flag as i32;  // 1

        // Combined: a + pi_int + x_back + flag_int + some computed value
        // Let's compute: 10 + 3 + 7 + 1 + 25 = 46
        let five: i32 = 5;
        let result: i32 = a + pi_int + x_back + flag_int + (five * five);
        return result;
    }
}
