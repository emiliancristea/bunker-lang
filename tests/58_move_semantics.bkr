// Test 58: Move Semantics
// Purpose: Verify that structs are moved by default
// Expected: JIT returns 30 (p2.x + p2.y after move)

kernel MoveTest {
    struct Point { x: i32, y: i32 }

    fn main() -> i32 {
        let p1 = Point { x: 10, y: 20 };
        let p2 = p1;  // p1 is moved to p2
        // After this, p1 should not be used (caught at compile time in BAD test)
        return p2.x + p2.y;  // Returns 30
    }
}
