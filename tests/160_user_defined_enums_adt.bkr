// Test 160: User-defined enums and ADT lowering across compilers
// Purpose: Exercise unit enums, single scalar payloads, two-field scalar payloads,
//          string pointer payloads, and comprehensive pattern matching across backends.
// Expected: Result: 42

kernel UserDefinedEnumsAdt {
    enum Status {
        Active,
        Pending,
        Archived,
    }

    enum Single {
        Val(i32),
        Empty,
    }

    enum Pair {
        Point(i32, i32),
        Origin,
    }

    enum Msg {
        Text(str),
        Code(i32),
        None,
    }

    fn check_status(s: Status) -> i32 {
        return match s {
            Status.Active => 4;
            Status.Pending => 1;
            Status.Archived => 2;
        };
    }

    fn check_single(s: Single) -> i32 {
        return match s {
            Single.Val(v) => v;
            Single.Empty => 0;
        };
    }

    fn check_pair(p: Pair) -> i32 {
        return match p {
            Pair.Point(x, y) => x + y;
            Pair.Origin => 0;
        };
    }

    fn check_msg(m: Msg) -> i32 {
        return match m {
            Msg.Text(t) => strlen(t);
            Msg.Code(c) => c;
            Msg.None => 0;
        };
    }

    fn main() -> i32 {
        if check_status(Status.Pending) != 1 {
            return 1;
        }
        if check_status(Status.Archived) != 2 {
            return 2;
        }
        if check_single(Single.Empty) != 0 {
            return 3;
        }
        if check_pair(Pair.Origin) != 0 {
            return 4;
        }
        if check_msg(Msg.None) != 0 {
            return 5;
        }
        if check_msg(Msg.Code(5)) != 5 {
            return 6;
        }

        let a: i32 = check_status(Status.Active);
        let b: i32 = check_single(Single.Val(10));
        let c: i32 = check_pair(Pair.Point(12, 10));
        let d: i32 = check_msg(Msg.Text("bunker"));

        return a + b + c + d;
    }
}
