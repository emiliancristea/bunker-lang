// Test 129: Unit Type and Unit Value ()
// Purpose: Verify unit type annotation `()`, unit value `()`, void returns,
// and canonical generic containers `Result<(), str>` and `Option<()>`.
// Expected: Returns 42

kernel UnitTypeTest {
    fn ping() -> () {
        return ();
    }

    fn pong() -> () {
        return;
    }

    fn check_result_unit(success: bool) -> Result<(), str> {
        if success {
            return result_ok(());
        }
        return result_err("failure");
    }

    fn check_option_unit(has: bool) -> Option<()> {
        if has {
            return Some(());
        }
        return None;
    }

    fn main() -> i32 {
        ping();
        pong();
        let u: () = ();

        let r1: Result<(), str> = check_result_unit(true);
        let v1: i32 = match r1 {
            Ok(_) => 20;
            Err(e) => 0;
        };

        let r2: Result<(), str> = check_result_unit(false);
        let v2: i32 = match r2 {
            Ok(_) => 0;
            Err(e) => 10;
        };

        let o1: Option<()> = check_option_unit(true);
        let v3: i32 = match o1 {
            Some(_) => 7;
            None => 0;
        };

        let o2: Option<()> = check_option_unit(false);
        let v4: i32 = match o2 {
            Some(_) => 0;
            None => 5;
        };

        return v1 + v2 + v3 + v4;
    }
}
