// Test 06: Verified Transfer (GOOD)
// Purpose: Verify Z3 contract verification passes for correct code.
// Expected: Compiles successfully. All contracts verified.

kernel Banking {
    struct Account {
        id: i32,
        balance: i64,
    }

    #[requires(amount > 0)]
    #[requires(from.balance >= amount)]
    #[ensures(from.balance + to.balance == old(from.balance) + old(to.balance))]
    fn transfer(from: &mut Account, to: &mut Account, amount: i64) {
        from.balance = from.balance - amount;
        to.balance = to.balance + amount;
    }
}
