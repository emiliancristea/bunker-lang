// Incremental test 2: Tokenizer + Parser + TypeCheck + CodeGen
kernel IncrementalTest2 {
    // Token constants
    const TOK_EOF: i64 = 0;
    const TOK_IDENT: i64 = 10;
    const TOK_INT: i64 = 11;
    const TOK_TRUE: i64 = 14;
    const TOK_FALSE: i64 = 15;
    const TOK_KERNEL: i64 = 20;
    const TOK_FN: i64 = 23;
    const TOK_LET: i64 = 24;
    const TOK_IF: i64 = 25;
    const TOK_ELSE: i64 = 26;
    const TOK_WHILE: i64 = 29;
    const TOK_RETURN: i64 = 33;
    const TOK_CONST: i64 = 35;
    const TOK_I32: i64 = 60;
    const TOK_I64: i64 = 61;
    const TOK_PLUS: i64 = 80;
    const TOK_MINUS: i64 = 81;
    const TOK_STAR: i64 = 82;
    const TOK_SLASH: i64 = 83;
    const TOK_EQ: i64 = 85;
    const TOK_NE: i64 = 86;
    const TOK_LT: i64 = 87;
    const TOK_GT: i64 = 88;
    const TOK_LE: i64 = 89;
    const TOK_GE: i64 = 90;
    const TOK_AND: i64 = 91;
    const TOK_OR: i64 = 92;
    const TOK_NOT: i64 = 93;
    const TOK_ASSIGN: i64 = 99;
    const TOK_ARROW: i64 = 101;
    const TOK_LPAREN: i64 = 110;
    const TOK_RPAREN: i64 = 111;
    const TOK_LBRACE: i64 = 112;
    const TOK_RBRACE: i64 = 113;
    const TOK_SEMICOLON: i64 = 117;
    const TOK_COLON: i64 = 118;

    // AST Node Constants
    const NODE_KERNEL: i64 = 1;
    const NODE_FN: i64 = 2;
    const NODE_TYPE: i64 = 4;
    const NODE_BLOCK: i64 = 5;
    const NODE_LET: i64 = 6;
    const NODE_RETURN: i64 = 7;
    const NODE_IF: i64 = 8;
    const NODE_WHILE: i64 = 9;
    const NODE_BINARY: i64 = 20;
    const NODE_UNARY: i64 = 21;
    const NODE_CALL: i64 = 22;
    const NODE_IDENT: i64 = 23;
    const NODE_INT_LIT: i64 = 24;
    const NODE_BOOL_LIT: i64 = 25;

    // Bytecode Opcodes
    const OP_PUSH_I64: i64 = 1;
    const OP_LOAD_LOCAL: i64 = 10;
    const OP_STORE_LOCAL: i64 = 11;
    const OP_ADD: i64 = 20;
    const OP_RETURN: i64 = 51;

    // Type Constants
    const TYPE_I32: i64 = 0;
    const TYPE_I64: i64 = 1;
    const TYPE_VOID: i64 = 5;

    // ========== TOKENIZER ==========
    fn tokenize_chunk(source: str, pos: i64) -> Vec<i64> {
        let result: Vec<i64> = vec_new();
        let src_len = len(source);
        let count: i64 = 0;
        let last_tok: i64 = 1;
        let continue_loop = true;

        while continue_loop && count < 8 {
            let skipping = true;
            while skipping && pos < src_len {
                let code = char_code(char_at(source, pos));
                if code == 32 || code == 9 || code == 10 || code == 13 {
                    pos = pos + 1;
                } else {
                    skipping = false;
                }
            }

            let tok_type: i64 = TOK_EOF;
            let handled = false;

            if pos >= src_len {
                last_tok = TOK_EOF;
                continue_loop = false;
                handled = true;
            }

            if !handled {
                let c = char_code(char_at(source, pos));
                if c >= 97 && c <= 122 {
                    tok_type = TOK_IDENT;
                    while pos < src_len && char_code(char_at(source, pos)) >= 97 && char_code(char_at(source, pos)) <= 122 {
                        pos = pos + 1;
                    }
                    handled = true;
                }
            }

            if !handled {
                let c = char_code(char_at(source, pos));
                if c >= 48 && c <= 57 {
                    tok_type = TOK_INT;
                    while pos < src_len && char_code(char_at(source, pos)) >= 48 && char_code(char_at(source, pos)) <= 57 {
                        pos = pos + 1;
                    }
                    handled = true;
                }
            }

            if !handled {
                let c = char_code(char_at(source, pos));
                if c == 123 { tok_type = TOK_LBRACE; pos = pos + 1; handled = true; }
                if c == 125 { tok_type = TOK_RBRACE; pos = pos + 1; handled = true; }
                if c == 40 { tok_type = TOK_LPAREN; pos = pos + 1; handled = true; }
                if c == 41 { tok_type = TOK_RPAREN; pos = pos + 1; handled = true; }
                if c == 59 { tok_type = TOK_SEMICOLON; pos = pos + 1; handled = true; }
                if c == 58 { tok_type = TOK_COLON; pos = pos + 1; handled = true; }
            }

            if !handled { pos = pos + 1; }

            if tok_type != TOK_EOF {
                vec_push(result, tok_type);
                last_tok = tok_type;
                count = count + 1;
            }
        }

        let packed: Vec<i64> = vec_new();
        vec_push(packed, pos);
        vec_push(packed, last_tok);
        let i: i64 = 0;
        while i < vec_len(result) {
            vec_push(packed, vec_get(result, i));
            i = i + 1;
        }
        return packed;
    }

    fn tokenize(source: str) -> Vec<i64> {
        let types: Vec<i64> = vec_new();
        let pos: i64 = 0;
        let done = false;

        while !done {
            let chunk = tokenize_chunk(source, pos);
            pos = vec_get(chunk, 0);
            let last_tok = vec_get(chunk, 1);
            let i: i64 = 2;
            while i < vec_len(chunk) {
                vec_push(types, vec_get(chunk, i));
                i = i + 1;
            }
            if last_tok == TOK_EOF { done = true; }
        }

        return types;
    }

    // ========== PARSER ==========
    fn parser_new(tokens: Vec<i64>) -> Vec<i64> {
        let state: Vec<i64> = vec_new();
        vec_push(state, tokens as i64);
        vec_push(state, 0);
        vec_push(state, 0);
        return state;
    }

    fn parser_peek(state: Vec<i64>) -> i64 {
        let tokens = vec_get(state, 0) as Vec<i64>;
        let pos = vec_get(state, 1);
        if pos >= vec_len(tokens) { return TOK_EOF; }
        return vec_get(tokens, pos);
    }

    fn parser_advance(state: Vec<i64>) -> i64 {
        let pos = vec_get(state, 1);
        vec_set(state, 1, pos + 1);
        let tokens = vec_get(state, 0) as Vec<i64>;
        return vec_get(tokens, pos);
    }

    fn parser_expect(state: Vec<i64>, expected: i64) -> bool {
        if parser_peek(state) == expected {
            parser_advance(state);
            return true;
        }
        return false;
    }

    fn parser_error(state: Vec<i64>) -> i64 {
        vec_set(state, 2, 1);
        return 0;
    }

    fn parser_has_error(state: Vec<i64>) -> bool {
        return vec_get(state, 2) != 0;
    }

    fn parse_type(state: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_TYPE);
        let tok = parser_advance(state);
        if tok == TOK_I32 { vec_push(node, TYPE_I32); }
        else if tok == TOK_I64 { vec_push(node, TYPE_I64); }
        else { vec_push(node, TYPE_VOID); }
        return node;
    }

    fn parse_primary(state: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        let tok = parser_peek(state);

        if tok == TOK_INT {
            parser_advance(state);
            vec_push(node, NODE_INT_LIT);
            vec_push(node, 42);
            return node;
        }

        if tok == TOK_IDENT {
            parser_advance(state);
            vec_push(node, NODE_IDENT);
            vec_push(node, 1);
            return node;
        }

        parser_error(state);
        vec_push(node, NODE_INT_LIT);
        vec_push(node, 0);
        return node;
    }

    fn parse_expr(state: Vec<i64>) -> Vec<i64> {
        return parse_primary(state);
    }

    fn parse_return(state: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        parser_advance(state);
        let expr: i64 = 0;
        if parser_peek(state) != TOK_SEMICOLON {
            expr = parse_expr(state) as i64;
        }
        parser_expect(state, TOK_SEMICOLON);
        vec_push(node, NODE_RETURN);
        vec_push(node, expr);
        return node;
    }

    fn parse_stmt(state: Vec<i64>) -> Vec<i64> {
        let tok = parser_peek(state);
        if tok == TOK_RETURN { return parse_return(state); }
        return parse_expr(state);
    }

    fn parse_block(state: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_BLOCK);
        parser_expect(state, TOK_LBRACE);

        while parser_peek(state) != TOK_RBRACE && parser_peek(state) != TOK_EOF {
            let stmt = parse_stmt(state);
            vec_push(node, stmt as i64);
        }

        parser_expect(state, TOK_RBRACE);
        return node;
    }

    fn parse_fn(state: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_FN);
        parser_advance(state);
        parser_advance(state);
        vec_push(node, 1);
        parser_expect(state, TOK_LPAREN);
        let params: Vec<i64> = vec_new();
        vec_push(node, params as i64);
        parser_expect(state, TOK_RPAREN);

        let ret_type: i64 = 0;
        if parser_peek(state) == TOK_ARROW {
            parser_advance(state);
            ret_type = parse_type(state) as i64;
        }
        vec_push(node, ret_type);

        let body = parse_block(state);
        vec_push(node, body as i64);
        return node;
    }

    fn parse_kernel(state: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_KERNEL);
        parser_expect(state, TOK_KERNEL);
        parser_advance(state);
        vec_push(node, 1);

        let functions: Vec<i64> = vec_new();
        parser_expect(state, TOK_LBRACE);

        while parser_peek(state) != TOK_RBRACE && parser_peek(state) != TOK_EOF {
            if parser_peek(state) == TOK_FN {
                let fn_node = parse_fn(state);
                vec_push(functions, fn_node as i64);
            } else {
                parser_advance(state);
            }
        }

        parser_expect(state, TOK_RBRACE);
        vec_push(node, functions as i64);
        return node;
    }

    // ========== TYPE CHECKER ==========
    fn typeck_new() -> Vec<i64> {
        let state: Vec<i64> = vec_new();
        vec_push(state, 0);  // error count
        return state;
    }

    fn typeck_has_errors(state: Vec<i64>) -> bool {
        return vec_get(state, 0) != 0;
    }

    fn check_kernel(state: Vec<i64>, kernel: Vec<i64>) -> i64 {
        // Simplified - just return success
        return 0;
    }

    // ========== CODE GENERATOR ==========
    fn codegen_new() -> Vec<i64> {
        let state: Vec<i64> = vec_new();
        let bytecode: Vec<i64> = vec_new();
        let locals: Vec<i64> = vec_new();
        vec_push(state, bytecode as i64);  // bytecode
        vec_push(state, locals as i64);  // locals
        vec_push(state, 0);          // local count
        return state;
    }

    fn emit(state: Vec<i64>, op: i64) -> Vec<i64> {
        let bc = vec_get(state, 0) as Vec<i64>;
        vec_push(bc, op);
        return state;
    }

    fn emit2(state: Vec<i64>, op: i64, arg: i64) -> Vec<i64> {
        let bc = vec_get(state, 0) as Vec<i64>;
        vec_push(bc, op);
        vec_push(bc, arg);
        return state;
    }

    fn gen_expr(state: Vec<i64>, expr: Vec<i64>) -> Vec<i64> {
        let node_type = vec_get(expr, 0);

        if node_type == NODE_INT_LIT {
            let value = vec_get(expr, 1);
            emit2(state, OP_PUSH_I64, value);
            return state;
        }

        return state;
    }

    fn gen_stmt(state: Vec<i64>, stmt: Vec<i64>) -> Vec<i64> {
        let node_type = vec_get(stmt, 0);

        if node_type == NODE_RETURN {
            let ret_expr = vec_get(stmt, 1);
            if ret_expr != 0 {
                gen_expr(state, ret_expr as Vec<i64>);
            }
            emit(state, OP_RETURN);
            return state;
        }

        return state;
    }

    fn gen_block(state: Vec<i64>, block: Vec<i64>) -> Vec<i64> {
        let i: i64 = 1;
        while i < vec_len(block) {
            let stmt = vec_get(block, i) as Vec<i64>;
            gen_stmt(state, stmt);
            i = i + 1;
        }
        return state;
    }

    fn gen_fn(state: Vec<i64>, fn_node: Vec<i64>) -> Vec<i64> {
        let body = vec_get(fn_node, 4) as Vec<i64>;
        gen_block(state, body);
        return state;
    }

    fn gen_kernel(state: Vec<i64>, kernel: Vec<i64>) -> Vec<i64> {
        let functions = vec_get(kernel, 2) as Vec<i64>;
        let i: i64 = 0;
        while i < vec_len(functions) {
            let fn_node = vec_get(functions, i) as Vec<i64>;
            gen_fn(state, fn_node);
            i = i + 1;
        }
        return state;
    }

    // ========== COMPILE ==========
    fn compile(source: str) -> i64 {
        // Phase 1: Tokenize
        let tokens = tokenize(source);

        // Phase 2: Parse
        let parser = parser_new(tokens);
        let ast = parse_kernel(parser);
        if parser_has_error(parser) { return 0; }

        // Phase 3: Type Check
        let typeck = typeck_new();
        check_kernel(typeck, ast);
        if typeck_has_errors(typeck) { return 0; }

        // Phase 4: Code Gen
        let codegen = codegen_new();
        gen_kernel(codegen, ast);

        // Return bytecode
        return vec_get(codegen, 0);
    }

    fn main() -> i32 {
        let source = "kernel Test { fn main() -> i32 { return 42; } }";
        let bytecode = compile(source);

        if bytecode == 0 { return 1; }
        let bc = bytecode as Vec<i64>;

        // Verify bytecode: PUSH 42, RETURN
        let bc_len = vec_len(bc);
        if bc_len != 3 { return 10 + bc_len; }
        if vec_get(bc, 0) != OP_PUSH_I64 { return 20; }
        if vec_get(bc, 1) != 42 { return 21; }
        if vec_get(bc, 2) != OP_RETURN { return 22; }

        return 42;
    }
}
