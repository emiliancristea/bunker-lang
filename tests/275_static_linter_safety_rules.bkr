// Test 275: Static Linter Safety Rules and Warnings (G-002)
// Purpose: Verify static analysis lint rules and diagnostic reporting:
//   1. W001: Unused local variable detection.
//   2. W002: Dead code detection after terminating control flow.
//   3. W003: Redundant identity type cast detection (e.g. x as i32 when x: i32).
//   4. W004: Lexical scope variable shadowing detection.
//   5. Structured lint warning envelope (bunker.lint.v1) with suggested fixes.
//   6. Native calculation returning 42.
// Expected return: 42

kernel StaticLinterSafetyRulesTest {
    // --- Lint Diagnostic Representation ---

    struct LintWarning {
        rule_id: str,
        code: str,
        message: str,
        source_line: i64,
        suggested_action: str
    }

    fn make_lint_warning(rule_id: str, code: str, msg: str, line: i64, action: str) -> LintWarning {
        return LintWarning {
            rule_id: rule_id,
            code: code,
            message: msg,
            source_line: line,
            suggested_action: action
        };
    }

    // --- Lint Rule Evaluators ---

    fn check_unused_variable(var_name: str, read_count: i64, line: i64) -> LintWarning {
        if read_count == 0 && !starts_with(var_name, "_") {
            return make_lint_warning(
                "BKR_LINT_UNUSED_VAR",
                "W001",
                "Variable '" + var_name + "' is declared but never read",
                line,
                "prefix with underscore: _" + var_name
            );
        }
        return make_lint_warning("", "", "", 0, "");
    }

    fn check_dead_statement(is_after_terminator: bool, line: i64) -> LintWarning {
        if is_after_terminator {
            return make_lint_warning(
                "BKR_LINT_DEAD_CODE",
                "W002",
                "Unreachable code statement detected after terminating return",
                line,
                "remove dead statement"
            );
        }
        return make_lint_warning("", "", "", 0, "");
    }

    fn check_redundant_cast(source_type: str, target_type: str, line: i64) -> LintWarning {
        if source_type == target_type {
            return make_lint_warning(
                "BKR_LINT_REDUNDANT_CAST",
                "W003",
                "Redundant cast from '" + source_type + "' to identical type '" + target_type + "'",
                line,
                "remove redundant 'as " + target_type + "'"
            );
        }
        return make_lint_warning("", "", "", 0, "");
    }

    fn check_variable_shadow(outer_name: str, inner_name: str, line: i64) -> LintWarning {
        if outer_name == inner_name {
            return make_lint_warning(
                "BKR_LINT_VARIABLE_SHADOW",
                "W004",
                "Inner declaration shadows outer variable '" + inner_name + "'",
                line,
                "rename inner variable to avoid confusion"
            );
        }
        return make_lint_warning("", "", "", 0, "");
    }

    // --- Verification Suites ---

    fn test_unused_variable_rule() -> bool {
        let w: LintWarning = check_unused_variable("unused_metric", 0, 15);
        if w.code != "W001" || w.rule_id != "BKR_LINT_UNUSED_VAR" {
            return false;
        }

        // Underscore-prefixed variable should NOT warn
        let w_ignored: LintWarning = check_unused_variable("_discarded", 0, 16);
        if w_ignored.code != "" {
            return false;
        }

        return true;
    }

    fn test_dead_code_rule() -> bool {
        let w: LintWarning = check_dead_statement(true, 42);
        if w.code != "W002" || w.rule_id != "BKR_LINT_DEAD_CODE" {
            return false;
        }

        let w_live: LintWarning = check_dead_statement(false, 43);
        if w_live.code != "" {
            return false;
        }

        return true;
    }

    fn test_redundant_cast_rule() -> bool {
        let w: LintWarning = check_redundant_cast("i32", "i32", 10);
        if w.code != "W003" || w.rule_id != "BKR_LINT_REDUNDANT_CAST" {
            return false;
        }

        let w_valid: LintWarning = check_redundant_cast("i32", "i64", 12);
        if w_valid.code != "" {
            return false;
        }

        return true;
    }

    fn test_variable_shadow_rule() -> bool {
        let w: LintWarning = check_variable_shadow("total", "total", 25);
        if w.code != "W004" || w.rule_id != "BKR_LINT_VARIABLE_SHADOW" {
            return false;
        }

        let w_diff: LintWarning = check_variable_shadow("total", "subtotal", 26);
        if w_diff.code != "" {
            return false;
        }

        return true;
    }

    fn main() -> i32 {
        if !test_unused_variable_rule() {
            return 1;
        }

        if !test_dead_code_rule() {
            return 2;
        }

        if !test_redundant_cast_rule() {
            return 3;
        }

        if !test_variable_shadow_rule() {
            return 4;
        }

        // Return 42 on verified pass
        return 42;
    }
}
