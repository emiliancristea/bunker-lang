// Test 86: Raw Result Handle Rejected
// Purpose: Result builtins should reject raw i64 handles.
// Expected: Type checker rejection

kernel RawResultHandleBad {
    fn main() -> i32 {
        let ok: Result<i32, i32> = result_ok(7);
        let raw: i64 = ok as i64;
        return result_unwrap(raw);
    }
}
