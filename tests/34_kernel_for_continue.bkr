// Test 34: Kernel for-loop with continue statement
// Purpose: Verify runtime for-loop can skip iterations with continue.
// Expected: Result: 30 (sum of 1..=10, skipping even numbers: 1+3+5+7+9=25, wait that's wrong)
// Actually: sum of odd numbers 1-10 = 1+3+5+7+9 = 25

kernel ForContinueTest {
    fn main() -> i32 {
        let total: i32 = 0;
        for i in 1..=10 {
            // Skip even numbers
            if i % 2 == 0 {
                continue;
            }
            total = total + i;
        }
        return total;
    }
}
