// Test 11: Shell Calls Kernel (i64)
// Purpose: Verify Shell `use` supports i64 Kernel signatures.
// Expected: Shell Agent calls an i64 Kernel function and uses the result.

kernel Math64 {
    #[verified]
    fn id(x: i64) -> i64 {
        return x;
    }
}

shell UseI64 {
    import Math64;

    agent App {
        // Int literal is stored as i64 at runtime; choose a value outside i32 range to ensure the i64 bridge is exercised.
        big = 5000000000;

        on receive "start" {
            let value = use Math64.id with x=big;
            send "check" to Checker with value=value;
        }
    }

    agent Checker {
        on receive "check" with value: i64 {
            match value == 5000000000 {
                true => send "done" to System;
                false => send "fail" to System;
            }
        }
    }
}

