// Test 227: Ownership, Move Semantics, Copy, and Reinitialization (M-001, M-009)
// Purpose: Verify move on let binding, move on reassignment, deep copy, and reinitialization of moved variables
// Expected: JIT returns 42

kernel OwnershipSemantics {
    struct Point {
        x: i32,
        y: i32,
    }

    fn main() -> i32 {
        // 1. Move on let binding
        let mut p1 = Point { x: 10, y: 20 };
        let p2 = p1; // p1 is moved to p2

        // 2. Reinitialization restores moved variable to valid state
        p1 = Point { x: 5, y: 7 };

        // 3. Deep copy preserves source variable
        let p3 = copy p1; // p1 is copied, not moved
        let sum_p1_p2: i32 = p1.x + p1.y + p2.x + p2.y; // (5 + 7) + (10 + 20) = 42
        if sum_p1_p2 != 42 {
            return 1;
        }

        // 4. Reassignment moves source value to target
        let mut slot = Point { x: 0, y: 0 };
        let incoming = Point { x: 20, y: 22 };
        slot = incoming; // incoming is moved to slot

        let slot_sum: i32 = slot.x + slot.y; // 20 + 22 = 42
        if slot_sum != 42 {
            return 2;
        }

        // 5. Array copy preserves source array
        let arr1 = [10, 20, 12];
        let arr2 = copy arr1;
        let arr_sum: i32 = arr2[0] + arr2[1] + arr2[2]; // 10 + 20 + 12 = 42
        if arr_sum != 42 {
            return 3;
        }

        return 42;
    }
}
