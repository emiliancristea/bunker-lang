// Test 57: Kernel multiple struct instances
// Purpose: Verify multiple struct instances work independently.
// Expected: Result: 42

kernel MultipleStructsTest {
    struct Counter {
        value: i32,
        step: i32,
    }

    fn new_counter(start: i32, step: i32) -> Counter {
        return Counter { value: start, step: step };
    }

    fn increment(c: Counter) -> i32 {
        return c.value + c.step;
    }

    fn main() -> i32 {
        // Create multiple counters
        let c1: Counter = new_counter(10, 5);
        let c2: Counter = new_counter(20, 2);
        let c3: Counter = Counter { value: 0, step: 1 };

        // Use each independently
        let v1: i32 = increment(c1);  // 10 + 5 = 15
        let v2: i32 = increment(c2);  // 20 + 2 = 22
        let v3: i32 = c3.value + c3.step;  // 0 + 1 = 1

        // Access original values
        let sum: i32 = c1.value + c2.step + c3.step;  // 10 + 2 + 1 = 13

        // 15 + 22 - 1 + 13 - 7 = 42
        return v1 + v2 - v3 + sum - 7;
    }
}
