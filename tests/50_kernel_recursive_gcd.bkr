// Test 50: Kernel recursive GCD
// Purpose: Verify recursive function calls work correctly.
// Expected: Result: 42

kernel RecursiveGCDTest {
    fn gcd(a: i32, b: i32) -> i32 {
        if b == 0 {
            return a;
        }
        return gcd(b, a % b);
    }

    fn main() -> i32 {
        // gcd(48, 18) = 6
        let g1: i32 = gcd(48, 18);

        // gcd(100, 35) = 5
        let g2: i32 = gcd(100, 35);

        // gcd(17, 13) = 1 (coprime)
        let g3: i32 = gcd(17, 13);

        // gcd(84, 18) = 6
        let g4: i32 = gcd(84, 18);

        // gcd(144, 60) = 12
        let g5: i32 = gcd(144, 60);

        // 6 + 5 + 1 + 6 + 12 = 30
        let sum: i32 = g1 + g2 + g3 + g4 + g5;

        // gcd(36, 24) = 12
        let g6: i32 = gcd(36, 24);

        // 30 + 12 = 42
        return sum + g6;
    }
}
