// Test 48: Kernel complex control flow
// Purpose: Verify complex nested control flow works correctly.
// Expected: Result: 42

kernel ControlFlowTest {
    fn main() -> i32 {
        let result: i32 = 0;

        // Nested loops with break and continue
        for i in 0..10 {
            if i == 7 {
                break;  // Exit at 7
            }

            if i % 2 == 0 {
                continue;  // Skip even numbers
            }

            // Only 1, 3, 5 reach here
            result = result + i;  // 1 + 3 + 5 = 9
        }

        // While with nested if
        let j: i32 = 0;
        while j < 20 {
            j = j + 1;
            if j > 10 {
                if j == 15 {
                    break;
                }
            }
        }
        // j = 15 when we break
        result = result + j;  // 9 + 15 = 24

        // Loop with condition
        let k: i32 = 0;
        loop {
            k = k + 3;
            if k >= 18 {
                break;
            }
        }
        // k = 18
        result = result + k;  // 24 + 18 = 42

        return result;
    }
}
