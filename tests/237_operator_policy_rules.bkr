// Test 237: Operator Policy Rules and Named Method Idiom (Q-284, T-021, T-022)
// Purpose: Verify primitive operator semantics (arithmetic, bitwise, comparison, logical,
//          unary, ternary) and the required explicit named method pattern on structs.
// Expected: JIT returns 42

kernel OperatorPolicyRulesTest {
    struct Vec2 {
        x: i32,
        y: i32
    }

    // Idiomatic replacement for operator overloading: explicit named methods
    fn Vec2::new(x: i32, y: i32) -> Vec2 {
        return Vec2 { x: x, y: y };
    }

    fn Vec2::add(self, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x + other.x, y: self.y + other.y };
    }

    fn Vec2::scale(self, factor: i32) -> Vec2 {
        return Vec2 { x: self.x * factor, y: self.y * factor };
    }

    fn Vec2::dot(self, other: Vec2) -> i32 {
        return self.x * other.x + self.y * other.y;
    }

    fn main() -> i32 {
        // 1. Primitive Arithmetic: +, -, *, /, %
        let a: i32 = 10 + 5;   // 15
        let b: i32 = 20 - 6;   // 14
        let c: i32 = 3 * 4;    // 12
        let d: i32 = 40 / 4;   // 10
        let e: i32 = 17 % 5;   // 2

        if a != 15 || b != 14 || c != 12 || d != 10 || e != 2 {
            return 1;
        }

        // 2. Bitwise & Shift: &, |, ^, <<, >>
        let bit_and: i32 = 12 & 10;   // 8 (1100 & 1010 = 1000)
        let bit_or: i32  = 12 | 3;    // 15 (1100 | 0011 = 1111)
        let bit_xor: i32 = 15 ^ 5;    // 10 (1111 ^ 0101 = 1010)
        let shl: i32     = 1 << 4;    // 16
        let shr: i32     = 32 >> 2;   // 8

        if bit_and != 8 || bit_or != 15 || bit_xor != 10 || shl != 16 || shr != 8 {
            return 2;
        }

        // 3. Comparison & Equality: <, <=, >, >=, ==, !=
        let lt: bool = a < 20;
        let le: bool = b <= 14;
        let gt: bool = c > 5;
        let ge: bool = d >= 10;
        let eq: bool = e == 2;
        let ne: bool = a != b;

        if !lt || !le || !gt || !ge || !eq || !ne {
            return 3;
        }

        // 4. Logical Operators: &&, ||, !
        let log_and: bool = lt && ge;
        let log_or: bool  = (a == 0) || eq;
        let log_not: bool = !ne; // false

        if !log_and || !log_or || log_not {
            return 4;
        }

        // 5. Unary Negation: -
        let neg: i32 = -5;
        if neg + 5 != 0 {
            return 5;
        }

        // 6. Ternary Expression: ? :
        let tern: i32 = eq ? 40 : 0;
        if tern != 40 {
            return 6;
        }

        // 7. Idiomatic Explicit Struct Methods (instead of operator overloading)
        let v1: Vec2 = Vec2::new(1, 2);
        let v2: Vec2 = Vec2::new(3, 4);
        let v3: Vec2 = v1.add(v2); // (4, 6)
        if v3.x != 4 || v3.y != 6 {
            return 7;
        }

        let dot_prod: i32 = v1.dot(v2); // 1*3 + 2*4 = 11
        if dot_prod != 11 {
            return 8;
        }

        let v4: Vec2 = v1.scale(5); // (5, 10)
        if v4.x != 5 || v4.y != 10 {
            return 9;
        }

        // 8. String concatenation via +
        let s1: str = "Bunker";
        let s2: str = "Lang";
        let s3: str = s1 + s2;
        if s3 != "BunkerLang" {
            return 10;
        }

        // 9. Final verified calculation totaling 42:
        // tern (40) + e (2) = 42
        let total: i32 = tern + e;
        if total != 42 {
            return 11;
        }

        return total;
    }
}
