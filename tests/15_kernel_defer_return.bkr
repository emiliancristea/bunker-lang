// Test 15: Kernel Defer Return Order
// Purpose: Ensure defer runs after return expression evaluation.
// Expected: `bunker run` would return 11 (return value computed before deferred increment).

kernel DeferReturn {
    fn main() -> i32 {
        let x: i32 = 10;
        defer {
            x = x + 1;
        }
        return x + 1;
    }
}
