// Test 64: Arena scoping with nested blocks
// Purpose: Verify that nested block allocations are properly scoped.
// Inner blocks should free their allocations when they exit,
// while outer block allocations remain valid.
// Expected: Result: 42

kernel ArenaNestTest {
    struct Point {
        x: i32,
        y: i32,
    }

    fn make_point(x: i32, y: i32) -> Point {
        return Point { x: x, y: y };
    }

    fn main() -> i32 {
        let outer: Point = make_point(10, 5);  // Allocated in main's block
        let result: i32 = 0;

        // Outer block allocations should persist
        if outer.x > 0 {
            // Inner allocation - should be freed when this block exits
            let inner: Point = make_point(20, 3);
            result = inner.x + inner.y;  // 20 + 3 = 23
        }

        // outer should still be valid here
        result = result + outer.x + outer.y;  // 23 + 10 + 5 = 38

        // Another if block
        if result > 30 {
            let p: Point = make_point(2, 2);
            result = result + p.x + p.y;  // 38 + 2 + 2 = 42
        }

        return result;  // 42
    }
}
