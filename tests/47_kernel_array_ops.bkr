// Test 47: Kernel array operations
// Purpose: Verify array creation, indexing, and iteration works correctly.
// Expected: Result: 42

kernel ArrayOpsTest {
    fn main() -> i32 {
        // Create array
        let arr: [i32; 5] = [1, 2, 3, 4, 5];

        // Index access
        let first: i32 = arr[0];  // 1
        let last: i32 = arr[4];   // 5
        let sum_ends: i32 = first + last;  // 6

        // Sum all elements via iteration
        let total: i32 = 0;
        for i in 0..5 {
            total = total + arr[i];
        }
        // total = 1 + 2 + 3 + 4 + 5 = 15

        // Another array
        let arr2: [i32; 3] = [10, 11, 12];
        let middle: i32 = arr2[1];  // 11

        // Create array in different order
        let arr3: [i32; 4] = [5, 10, 15, 20];
        let arr3_sum: i32 = arr3[0] + arr3[3];  // 5 + 20 = 25

        // But we need to return 42
        // sum_ends (6) + total (15) - middle (11) + len(arr2) (3) = 13
        // Let me recalculate...
        // 6 + 15 + 11 + 10 = 42
        return sum_ends + total + middle + arr3[0] + arr3[0];
    }
}
