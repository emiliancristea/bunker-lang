// Test 40: Kernel bitwise operators
// Purpose: Verify bitwise AND, OR, XOR, and shift operations.
// Expected: Result: 42

kernel BitwiseOpsTest {
    fn main() -> i32 {
        // Test bitwise AND: 0b1111 & 0b1010 = 0b1010 = 10
        let and_result: i32 = 15 & 10;

        // Test bitwise OR: 0b0011 | 0b1100 = 0b1111 = 15
        let or_result: i32 = 3 | 12;

        // Test bitwise XOR: 0b1111 ^ 0b1010 = 0b0101 = 5
        let xor_result: i32 = 15 ^ 10;

        // Test shift left: 1 << 3 = 8
        let shl_result: i32 = 1 << 3;

        // Test shift right: 16 >> 2 = 4
        let shr_result: i32 = 16 >> 2;

        // Combined: 10 + 15 + 5 + 8 + 4 = 42
        return and_result + or_result + xor_result + shl_result + shr_result;
    }
}
