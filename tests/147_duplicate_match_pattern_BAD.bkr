// Test 147 (BAD): Duplicate Match Pattern
// Purpose: Verify rejection when duplicate literal patterns appear in match arms.
// Expected: Rejected by typechecker for duplicate match pattern.

kernel DuplicateMatchPatternBad {
    fn main() -> i64 {
        let n: i64 = 5;
        let res: i64 = match n {
            1 => 10;
            1 => 20;
            _ => 0;
        };
        return res;
    }
}
