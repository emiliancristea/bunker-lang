// Bunker test runner
// Runs every tests/*.bkr file through bkrc and reports real pass/fail results.
//
//   *_BAD.bkr                      must be rejected by `bkrc check`
//   listed in expected_results.txt must build, run and exit with the listed code
//   anything else                  must pass `bkrc check`
//
// Tests listed in tests/known_failures.txt are allowed to fail. The run fails on any
// other failure, and also when a known failure starts passing (remove it from the list).
//
// Usage: bkrc run tools/test_runner.bkr            (uses ./bkrc)
//        BKRC=/path/to/bkrc bkrc run tools/test_runner.bkr
//        BKR_TEST_RUN_FLAGS=--native BKR_TEST_ONLY_RUN=1 \
//        BKR_TEST_KNOWN_FAILURES=tests/native_known_failures.txt bkrc run tools/test_runner.bkr
//            (run programs on the native x86-64 backend; known failures tracked separately)

kernel TestRunner {
    fn env_or(key: str, fallback: str) -> str {
        if !env_has(key) {
            return fallback;
        }
        let value: Option<str> = env_get(key);
        return match value {
            Some(found) => found;
            None => fallback;
        };
    }

    fn read_lines(path: str) -> Vec<str> {
        let lines: Vec<str> = vec_new();
        if !file_exists(path) {
            return lines;
        }
        let parts: Vec<str> = str_split(read_file(path), from_char_code(10));
        let i: i64 = 0;
        while i < vec_len(parts) {
            let line: str = trim(vec_get(parts, i));
            if len(line) > 0 && !starts_with(line, "#") {
                vec_push(lines, line);
            }
            i = i + 1;
        }
        return lines;
    }

    fn last_result_line(output: str) -> str {
        let parts: Vec<str> = str_split(output, from_char_code(10));
        let found = "";
        let i: i64 = 0;
        while i < vec_len(parts) {
            let line: str = trim(vec_get(parts, i));
            if starts_with(line, "Result: ") {
                found = substring(line, 8, len(line));
            }
            i = i + 1;
        }
        return found;
    }

    fn command_status(cmd: str) -> i64 {
        let res = process_run_status(cmd);
        if !result_is_ok(res) {
            return 255;
        }
        let code: i64 = result_unwrap(res);
        return code;
    }

    fn main() -> i32 {
        let bkrc = env_or("BKRC", "./bkrc");
        let run_flags = env_or("BKR_TEST_RUN_FLAGS", "");
        let only_run_tests = env_or("BKR_TEST_ONLY_RUN", "") == "1";
        let known_path = env_or("BKR_TEST_KNOWN_FAILURES", "tests/known_failures.txt");
        let log_path = env_or("TMPDIR", "/tmp") + "/bkr-test-runner-" + int_to_string(process_pid()) + ".log";

        let expected: HashMap<str, i64> = hashmap_new();
        let expected_lines: Vec<str> = read_lines("tests/expected_results.txt");
        let e: i64 = 0;
        while e < vec_len(expected_lines) {
            let fields: Vec<str> = str_split(vec_get(expected_lines, e), " ");
            if vec_len(fields) == 2 {
                hashmap_insert(expected, vec_get(fields, 0), parse_int(vec_get(fields, 1)));
            }
            e = e + 1;
        }

        let known: HashMap<str, i64> = hashmap_new();
        let known_lines: Vec<str> = read_lines(known_path);
        let k: i64 = 0;
        while k < vec_len(known_lines) {
            hashmap_insert(known, vec_get(known_lines, k), 1);
            k = k + 1;
        }

        let list_path = log_path + ".list";
        if command_status("ls tests/*.bkr > " + list_path) != 0 {
            println("Error: cannot list tests/*.bkr");
            return 1;
        }
        let files: Vec<str> = read_lines(list_path);
        file_remove(list_path);

        let total: i64 = 0;
        let passed: i64 = 0;
        let known_failed: i64 = 0;
        let unexpected: i64 = 0;
        let stale: i64 = 0;
        let run_passed: i64 = 0;
        let run_total: i64 = 0;
        let bad_passed: i64 = 0;
        let bad_total: i64 = 0;
        let check_passed: i64 = 0;
        let check_total: i64 = 0;

        let i: i64 = 0;
        while i < vec_len(files) {
            let file: str = vec_get(files, i);
            let name = substring(path_base(file), 0, len(path_base(file)) - 4);
            let selected = !only_run_tests || hashmap_contains(expected, name);
            if selected {
                let ok = false;
                let detail = "";

                if ends_with(name, "_BAD") {
                    bad_total = bad_total + 1;
                    let status = command_status("timeout 60 " + bkrc + " check " + file + " > " + log_path + " 2>&1");
                    ok = status != 0;
                    detail = "should be rejected by check";
                    if ok {
                        bad_passed = bad_passed + 1;
                    }
                } else if hashmap_contains(expected, name) {
                    run_total = run_total + 1;
                    let want: i64 = hashmap_get(expected, name);
                    command_status("timeout 60 " + bkrc + " run " + run_flags + " " + file + " > " + log_path + " 2>&1");
                    let got = "";
                    if file_exists(log_path) {
                        got = last_result_line(read_file(log_path));
                    }
                    ok = got == int_to_string(want);
                    if len(got) == 0 {
                        detail = "expected " + int_to_string(want) + ", did not build or run";
                    } else {
                        detail = "expected " + int_to_string(want) + ", got " + got;
                    }
                    if ok {
                        run_passed = run_passed + 1;
                    }
                } else {
                    check_total = check_total + 1;
                    let status = command_status("timeout 60 " + bkrc + " check " + file + " > " + log_path + " 2>&1");
                    ok = status == 0;
                    detail = "check failed";
                    if ok {
                        check_passed = check_passed + 1;
                    }
                }

                total = total + 1;
                let is_known = hashmap_contains(known, name);
                if ok && !is_known {
                    passed = passed + 1;
                } else if ok && is_known {
                    passed = passed + 1;
                    stale = stale + 1;
                    println("FIXED  " + name + " (now passes: remove it from tests/known_failures.txt)");
                } else if is_known {
                    known_failed = known_failed + 1;
                } else {
                    unexpected = unexpected + 1;
                    println("FAIL   " + name + " (" + detail + ")");
                }
            }
            i = i + 1;
        }
        file_remove(log_path);

        println("");
        println("=== Bunker test results ===");
        println("Run tests (build, execute, compare exit code): " + int_to_string(run_passed) + "/" + int_to_string(run_total));
        println("Rejection tests (*_BAD must fail check):       " + int_to_string(bad_passed) + "/" + int_to_string(bad_total));
        println("Check-only tests (must pass check):            " + int_to_string(check_passed) + "/" + int_to_string(check_total));
        println("Total passing: " + int_to_string(passed) + "/" + int_to_string(total));
        println("Known failures still failing: " + int_to_string(known_failed));
        println("Unexpected failures: " + int_to_string(unexpected));
        println("Known failures now passing: " + int_to_string(stale));

        if unexpected > 0 || stale > 0 {
            return 1;
        }
        return 0;
    }
}
