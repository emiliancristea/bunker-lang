// Bunker Self-Hosting Compiler - Main Driver
// Demonstrates the full compilation pipeline: Lex -> Parse -> TypeCheck -> CodeGen

kernel Compiler {
    // ===== Token Constants =====
    const TOK_EOF: i64 = 0;
    const TOK_IDENT: i64 = 10;
    const TOK_INT: i64 = 11;
    const TOK_TRUE: i64 = 14;
    const TOK_FALSE: i64 = 15;
    const TOK_KERNEL: i64 = 20;
    const TOK_FN: i64 = 23;
    const TOK_LET: i64 = 24;
    const TOK_IF: i64 = 25;
    const TOK_ELSE: i64 = 26;
    const TOK_WHILE: i64 = 29;
    const TOK_RETURN: i64 = 33;
    const TOK_CONST: i64 = 35;
    const TOK_I32: i64 = 60;
    const TOK_I64: i64 = 61;
    const TOK_PLUS: i64 = 80;
    const TOK_MINUS: i64 = 81;
    const TOK_STAR: i64 = 82;
    const TOK_SLASH: i64 = 83;
    const TOK_EQ: i64 = 85;
    const TOK_NE: i64 = 86;
    const TOK_LT: i64 = 87;
    const TOK_GT: i64 = 88;
    const TOK_LE: i64 = 89;
    const TOK_GE: i64 = 90;
    const TOK_AND: i64 = 91;
    const TOK_OR: i64 = 92;
    const TOK_NOT: i64 = 93;
    const TOK_ASSIGN: i64 = 99;
    const TOK_ARROW: i64 = 101;
    const TOK_LPAREN: i64 = 110;
    const TOK_RPAREN: i64 = 111;
    const TOK_LBRACE: i64 = 112;
    const TOK_RBRACE: i64 = 113;
    const TOK_SEMICOLON: i64 = 117;
    const TOK_COLON: i64 = 118;

    // ===== AST Node Constants =====
    const NODE_KERNEL: i64 = 1;
    const NODE_FN: i64 = 2;
    const NODE_TYPE: i64 = 4;
    const NODE_BLOCK: i64 = 5;
    const NODE_LET: i64 = 6;
    const NODE_RETURN: i64 = 7;
    const NODE_IF: i64 = 8;
    const NODE_WHILE: i64 = 9;
    const NODE_BINARY: i64 = 20;
    const NODE_UNARY: i64 = 21;
    const NODE_CALL: i64 = 22;
    const NODE_IDENT: i64 = 23;
    const NODE_INT_LIT: i64 = 24;
    const NODE_BOOL_LIT: i64 = 25;

    // ===== Bytecode Opcodes =====
    const OP_PUSH_I64: i64 = 1;
    const OP_LOAD_LOCAL: i64 = 10;
    const OP_STORE_LOCAL: i64 = 11;
    const OP_ADD: i64 = 20;
    const OP_SUB: i64 = 21;
    const OP_MUL: i64 = 22;
    const OP_DIV: i64 = 23;
    const OP_RETURN: i64 = 51;

    // ===== Type Constants =====
    const TYPE_I32: i64 = 0;
    const TYPE_I64: i64 = 1;
    const TYPE_VOID: i64 = 5;
    const TYPE_UNKNOWN: i64 = 99;

    // ========================================
    // LEXER (Chunked to avoid JIT bug)
    // ========================================

    fn tokenize_chunk(source: str, pos: i64) -> i64 {
        let result = vec_new();
        let src_len = len(source);
        let count: i64 = 0;
        let last_tok: i64 = 1;  // TOK_ERROR
        let continue_loop = true;

        while continue_loop && count < 8 {
            // Skip whitespace
            let skipping = true;
            while skipping && pos < src_len {
                let code = char_code(char_at(source, pos));
                if code == 32 || code == 9 || code == 10 || code == 13 {
                    pos = pos + 1;
                } else {
                    skipping = false;
                }
            }

            let tok_type: i64 = TOK_EOF;
            let handled = false;

            if pos >= src_len {
                tok_type = TOK_EOF;
                handled = true;
                continue_loop = false;
            }

            // Identifier/keyword
            if !handled {
                let code = char_code(char_at(source, pos));
                let is_alpha = (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code == 95;
                if is_alpha {
                    let start = pos;
                    let scanning = true;
                    while scanning && pos < src_len {
                        let pc = char_code(char_at(source, pos));
                        let is_alnum = (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || pc == 95 || (pc >= 48 && pc <= 57);
                        if is_alnum { pos = pos + 1; }
                        else { scanning = false; }
                    }
                    let word = substring(source, start, pos);
                    tok_type = TOK_IDENT;
                    if word == "kernel" { tok_type = TOK_KERNEL; }
                    if word == "fn" { tok_type = TOK_FN; }
                    if word == "let" { tok_type = TOK_LET; }
                    if word == "return" { tok_type = TOK_RETURN; }
                    if word == "if" { tok_type = TOK_IF; }
                    if word == "else" { tok_type = TOK_ELSE; }
                    if word == "while" { tok_type = TOK_WHILE; }
                    if word == "i32" { tok_type = TOK_I32; }
                    if word == "i64" { tok_type = TOK_I64; }
                    if word == "true" { tok_type = TOK_TRUE; }
                    if word == "false" { tok_type = TOK_FALSE; }
                    handled = true;
                }
            }

            // Number
            if !handled {
                let code = char_code(char_at(source, pos));
                if code >= 48 && code <= 57 {
                    let scanning = true;
                    while scanning && pos < src_len {
                        let dc = char_code(char_at(source, pos));
                        if dc >= 48 && dc <= 57 { pos = pos + 1; }
                        else { scanning = false; }
                    }
                    tok_type = TOK_INT;
                    handled = true;
                }
            }

            // Two-char operators
            if !handled && pos + 1 < src_len {
                let two = char_at(source, pos) + char_at(source, pos + 1);
                if two == "->" { tok_type = TOK_ARROW; pos = pos + 2; handled = true; }
                if !handled && two == "==" { tok_type = TOK_EQ; pos = pos + 2; handled = true; }
                if !handled && two == "!=" { tok_type = TOK_NE; pos = pos + 2; handled = true; }
                if !handled && two == "<=" { tok_type = TOK_LE; pos = pos + 2; handled = true; }
                if !handled && two == ">=" { tok_type = TOK_GE; pos = pos + 2; handled = true; }
                if !handled && two == "&&" { tok_type = TOK_AND; pos = pos + 2; handled = true; }
                if !handled && two == "||" { tok_type = TOK_OR; pos = pos + 2; handled = true; }
            }

            // Single-char
            if !handled {
                let ch = char_at(source, pos);
                if ch == "+" { tok_type = TOK_PLUS; }
                if ch == "-" { tok_type = TOK_MINUS; }
                if ch == "*" { tok_type = TOK_STAR; }
                if ch == "/" { tok_type = TOK_SLASH; }
                if ch == "<" { tok_type = TOK_LT; }
                if ch == ">" { tok_type = TOK_GT; }
                if ch == "!" { tok_type = TOK_NOT; }
                if ch == "=" { tok_type = TOK_ASSIGN; }
                if ch == "(" { tok_type = TOK_LPAREN; }
                if ch == ")" { tok_type = TOK_RPAREN; }
                if ch == "{" { tok_type = TOK_LBRACE; }
                if ch == "}" { tok_type = TOK_RBRACE; }
                if ch == ";" { tok_type = TOK_SEMICOLON; }
                if ch == ":" { tok_type = TOK_COLON; }
                pos = pos + 1;
            }

            vec_push(result, tok_type);
            last_tok = tok_type;
            count = count + 1;
        }

        let final_result = vec_new();
        vec_push(final_result, pos);
        vec_push(final_result, last_tok);
        let i: i64 = 0;
        while i < vec_len(result) {
            vec_push(final_result, vec_get(result, i));
            i = i + 1;
        }
        return final_result;
    }

    fn tokenize(source: str) -> i64 {
        let types = vec_new();
        let pos: i64 = 0;
        let done = false;

        while !done {
            let chunk = tokenize_chunk(source, pos);
            pos = vec_get(chunk, 0);
            let last_tok = vec_get(chunk, 1);
            let i: i64 = 2;
            while i < vec_len(chunk) {
                vec_push(types, vec_get(chunk, i));
                i = i + 1;
            }
            if last_tok == TOK_EOF { done = true; }
        }

        return types;
    }

    // ========================================
    // PARSER (Create nodes before if-peek)
    // ========================================

    fn parser_new(tokens: i64) -> i64 {
        let state = vec_new();
        vec_push(state, tokens);
        vec_push(state, 0);
        vec_push(state, 0);
        return state;
    }

    fn parser_peek(state: i64) -> i64 {
        let tokens = vec_get(state, 0);
        let pos = vec_get(state, 1);
        if pos >= vec_len(tokens) { return TOK_EOF; }
        return vec_get(tokens, pos);
    }

    fn parser_advance(state: i64) -> i64 {
        let pos = vec_get(state, 1);
        vec_set(state, 1, pos + 1);
        return vec_get(vec_get(state, 0), pos);
    }

    fn parser_expect(state: i64, expected: i64) -> bool {
        if parser_peek(state) == expected {
            parser_advance(state);
            return true;
        }
        return false;
    }

    fn parser_error(state: i64) -> i64 {
        vec_set(state, 2, 1);
        return state;
    }

    fn parser_has_error(state: i64) -> bool {
        return vec_get(state, 2) != 0;
    }

    fn parse_type(state: i64) -> i64 {
        let node = vec_new();
        vec_push(node, NODE_TYPE);
        let tok = parser_peek(state);
        let kind: i64 = 0;
        if tok == TOK_I32 { kind = 0; parser_advance(state); }
        if tok == TOK_I64 { kind = 1; parser_advance(state); }
        vec_push(node, kind);
        return node;
    }

    fn parse_primary(state: i64) -> i64 {
        let node = vec_new();
        let tok = parser_peek(state);

        if tok == TOK_INT {
            parser_advance(state);
            vec_push(node, NODE_INT_LIT);
            vec_push(node, 42);
            return node;
        }

        if tok == TOK_IDENT {
            parser_advance(state);
            let pos = vec_get(state, 1) - 1;
            if parser_peek(state) == TOK_LPAREN {
                parser_advance(state);
                vec_push(node, NODE_CALL);
                vec_push(node, pos);
                parser_expect(state, TOK_RPAREN);
                return node;
            }
            vec_push(node, NODE_IDENT);
            vec_push(node, pos);
            return node;
        }

        if tok == TOK_LPAREN {
            parser_advance(state);
            let inner = parse_expr(state);
            parser_expect(state, TOK_RPAREN);
            return inner;
        }

        vec_push(node, NODE_INT_LIT);
        vec_push(node, 0);
        return node;
    }

    fn parse_mul(state: i64) -> i64 {
        let left = parse_primary(state);
        let continuing = true;

        while continuing {
            let tok = parser_peek(state);
            if tok == TOK_STAR || tok == TOK_SLASH {
                let node = vec_new();
                vec_push(node, NODE_BINARY);
                vec_push(node, tok);
                vec_push(node, left);
                parser_advance(state);
                let right = parse_primary(state);
                vec_push(node, right);
                left = node;
            } else {
                continuing = false;
            }
        }
        return left;
    }

    fn parse_add(state: i64) -> i64 {
        let left = parse_mul(state);
        let continuing = true;

        while continuing {
            let tok = parser_peek(state);
            if tok == TOK_PLUS || tok == TOK_MINUS {
                let node = vec_new();
                vec_push(node, NODE_BINARY);
                vec_push(node, tok);
                vec_push(node, left);
                parser_advance(state);
                let right = parse_mul(state);
                vec_push(node, right);
                left = node;
            } else {
                continuing = false;
            }
        }
        return left;
    }

    fn parse_expr(state: i64) -> i64 {
        return parse_add(state);
    }

    fn parse_return(state: i64) -> i64 {
        let node = vec_new();
        vec_push(node, NODE_RETURN);
        parser_advance(state);
        let expr: i64 = 0;
        if parser_peek(state) != TOK_SEMICOLON {
            expr = parse_expr(state);
        }
        vec_push(node, expr);
        parser_expect(state, TOK_SEMICOLON);
        return node;
    }

    fn parse_let(state: i64) -> i64 {
        let node = vec_new();
        vec_push(node, NODE_LET);
        parser_advance(state);
        let name_pos = vec_get(state, 1);
        parser_expect(state, TOK_IDENT);
        vec_push(node, name_pos);

        let type_node: i64 = 0;
        if parser_peek(state) == TOK_COLON {
            parser_advance(state);
            type_node = parse_type(state);
        }
        vec_push(node, type_node);

        let init_expr: i64 = 0;
        if parser_peek(state) == TOK_ASSIGN {
            parser_advance(state);
            init_expr = parse_expr(state);
        }
        vec_push(node, init_expr);
        parser_expect(state, TOK_SEMICOLON);
        return node;
    }

    fn parse_stmt(state: i64) -> i64 {
        let tok = parser_peek(state);
        if tok == TOK_LET { return parse_let(state); }
        if tok == TOK_RETURN { return parse_return(state); }
        parser_error(state);
        let node = vec_new();
        return node;
    }

    fn parse_block(state: i64) -> i64 {
        let node = vec_new();
        vec_push(node, NODE_BLOCK);
        parser_expect(state, TOK_LBRACE);
        let continuing = true;
        while continuing {
            let tok = parser_peek(state);
            if tok == TOK_RBRACE || tok == TOK_EOF {
                continuing = false;
            } else {
                let stmt = parse_stmt(state);
                vec_push(node, stmt);
            }
        }
        parser_expect(state, TOK_RBRACE);
        return node;
    }

    fn parse_fn(state: i64) -> i64 {
        let node = vec_new();
        vec_push(node, NODE_FN);
        parser_advance(state);
        let name_pos = vec_get(state, 1);
        parser_expect(state, TOK_IDENT);
        vec_push(node, name_pos);
        parser_expect(state, TOK_LPAREN);
        vec_push(node, vec_new());
        parser_expect(state, TOK_RPAREN);
        let ret_type: i64 = 0;
        if parser_peek(state) == TOK_ARROW {
            parser_advance(state);
            ret_type = parse_type(state);
        }
        vec_push(node, ret_type);
        let body = parse_block(state);
        vec_push(node, body);
        return node;
    }

    fn parse_kernel(state: i64) -> i64 {
        let node = vec_new();
        vec_push(node, NODE_KERNEL);
        parser_expect(state, TOK_KERNEL);
        let name_pos = vec_get(state, 1);
        parser_expect(state, TOK_IDENT);
        vec_push(node, name_pos);
        parser_expect(state, TOK_LBRACE);
        let functions = vec_new();
        vec_push(node, functions);

        let continuing = true;
        while continuing {
            let tok = parser_peek(state);
            if tok == TOK_RBRACE || tok == TOK_EOF {
                continuing = false;
            } else if tok == TOK_FN {
                let fn_node = parse_fn(state);
                vec_push(functions, fn_node);
            } else {
                continuing = false;
            }
        }
        parser_expect(state, TOK_RBRACE);
        return node;
    }

    // ========================================
    // TYPE CHECKER (Simplified)
    // ========================================

    fn typeck_new() -> i64 {
        let state = vec_new();
        vec_push(state, vec_new());  // errors
        vec_push(state, TYPE_VOID);  // return type
        return state;
    }

    fn typeck_has_errors(state: i64) -> bool {
        return vec_len(vec_get(state, 0)) > 0;
    }

    fn check_kernel(state: i64, kernel: i64) -> i64 {
        // Simplified: just verify structure
        let funcs = vec_get(kernel, 2);
        if vec_len(funcs) < 1 {
            vec_push(vec_get(state, 0), 1);
        }
        return state;
    }

    // ========================================
    // CODE GENERATOR
    // ========================================

    fn codegen_new() -> i64 {
        let state = vec_new();
        vec_push(state, vec_new());  // bytecode
        vec_push(state, vec_new());  // locals
        vec_push(state, 0);          // local count
        return state;
    }

    fn emit(state: i64, op: i64) -> i64 {
        vec_push(vec_get(state, 0), op);
        return state;
    }

    fn emit2(state: i64, op: i64, arg: i64) -> i64 {
        vec_push(vec_get(state, 0), op);
        vec_push(vec_get(state, 0), arg);
        return state;
    }

    fn add_local(state: i64, name_idx: i64) -> i64 {
        let slot = vec_get(state, 2);
        vec_push(vec_get(state, 1), name_idx);
        vec_set(state, 2, slot + 1);
        return slot;
    }

    fn lookup_local(state: i64, name_idx: i64) -> i64 {
        let locals = vec_get(state, 1);
        let i: i64 = 0;
        while i < vec_len(locals) {
            if vec_get(locals, i) == name_idx { return i; }
            i = i + 1;
        }
        return 0;
    }

    fn gen_expr(state: i64, expr: i64) -> i64 {
        let node_type = vec_get(expr, 0);
        if node_type == NODE_INT_LIT {
            emit2(state, OP_PUSH_I64, vec_get(expr, 1));
            return state;
        }
        if node_type == NODE_IDENT {
            emit2(state, OP_LOAD_LOCAL, lookup_local(state, vec_get(expr, 1)));
            return state;
        }
        if node_type == NODE_BINARY {
            gen_expr(state, vec_get(expr, 2));
            gen_expr(state, vec_get(expr, 3));
            let op = vec_get(expr, 1);
            if op == TOK_PLUS { emit(state, OP_ADD); }
            if op == TOK_MINUS { emit(state, OP_SUB); }
            if op == TOK_STAR { emit(state, OP_MUL); }
            if op == TOK_SLASH { emit(state, OP_DIV); }
            return state;
        }
        return state;
    }

    fn gen_stmt(state: i64, stmt: i64) -> i64 {
        let node_type = vec_get(stmt, 0);
        if node_type == NODE_LET {
            let slot = add_local(state, vec_get(stmt, 1));
            let init = vec_get(stmt, 3);
            if init != 0 {
                gen_expr(state, init);
                emit2(state, OP_STORE_LOCAL, slot);
            }
            return state;
        }
        if node_type == NODE_RETURN {
            let expr = vec_get(stmt, 1);
            if expr != 0 { gen_expr(state, expr); }
            emit(state, OP_RETURN);
            return state;
        }
        return state;
    }

    fn gen_block(state: i64, block: i64) -> i64 {
        let i: i64 = 1;
        while i < vec_len(block) {
            gen_stmt(state, vec_get(block, i));
            i = i + 1;
        }
        return state;
    }

    fn gen_fn(state: i64, fn_node: i64) -> i64 {
        gen_block(state, vec_get(fn_node, 4));
        return state;
    }

    fn gen_kernel(state: i64, kernel: i64) -> i64 {
        let funcs = vec_get(kernel, 2);
        let i: i64 = 0;
        while i < vec_len(funcs) {
            gen_fn(state, vec_get(funcs, i));
            i = i + 1;
        }
        return state;
    }

    // ========================================
    // MAIN COMPILER DRIVER
    // ========================================

    fn compile(source: str) -> i64 {
        // Phase 1: Lexical Analysis
        let tokens = tokenize(source);

        // Phase 2: Parsing
        let parser = parser_new(tokens);
        let ast = parse_kernel(parser);
        if parser_has_error(parser) { return 0; }

        // Phase 3: Type Checking
        let typeck = typeck_new();
        check_kernel(typeck, ast);
        if typeck_has_errors(typeck) { return 0; }

        // Phase 4: Code Generation
        let codegen = codegen_new();
        gen_kernel(codegen, ast);

        // Return bytecode
        return vec_get(codegen, 0);
    }

    fn main() -> i32 {
        // Test: Compile a simple Bunker program
        let source = "kernel Test { fn main() -> i32 { return 42; } }";
        let bytecode = compile(source);

        if bytecode == 0 { return 1; }

        // Verify bytecode: PUSH 42, RETURN
        let bc_len = vec_len(bytecode);
        if bc_len != 3 { return 10 + bc_len; }
        if vec_get(bytecode, 0) != OP_PUSH_I64 { return 20; }
        if vec_get(bytecode, 1) != 42 { return 21; }
        if vec_get(bytecode, 2) != OP_RETURN { return 22; }

        return 42;
    }
}
