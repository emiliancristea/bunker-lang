// Bunker Minimal Compiler - Proof of Concept
// Compiles simple Bunker to C, writes to test.c

kernel MinimalCompiler {
    // Constants
    const TOK_EOF: i64 = 0;
    const TOK_INT: i64 = 11;
    const TOK_RETURN: i64 = 33;
    const TOK_KERNEL: i64 = 20;
    const TOK_FN: i64 = 23;
    const TOK_IDENT: i64 = 10;
    const TOK_I32: i64 = 60;
    const TOK_ARROW: i64 = 101;
    const TOK_LPAREN: i64 = 110;
    const TOK_RPAREN: i64 = 111;
    const TOK_LBRACE: i64 = 112;
    const TOK_RBRACE: i64 = 113;
    const TOK_SEMICOLON: i64 = 117;

    const NODE_KERNEL: i64 = 1;
    const NODE_FN: i64 = 2;
    const NODE_RETURN: i64 = 7;
    const NODE_INT_LIT: i64 = 24;

    // Generate C code for a program that returns 42
    fn gen_simple_c() -> Vec<str> {
        let lines: Vec<str> = vec_new();
        vec_push(lines, "/* Generated by Bunker Compiler */");
        vec_push(lines, "#include <stdio.h>");
        vec_push(lines, "#include <stdint.h>");
        vec_push(lines, "");
        vec_push(lines, "typedef int32_t bkr_i32;");
        vec_push(lines, "");
        vec_push(lines, "bkr_i32 bunker_main(void) {");
        vec_push(lines, "    return 42;");
        vec_push(lines, "}");
        vec_push(lines, "");
        vec_push(lines, "int main(void) {");
        vec_push(lines, "    return (int)bunker_main();");
        vec_push(lines, "}");
        return lines;
    }

    // Join lines with newlines
    fn join_lines(lines: Vec<str>) -> str {
        let output: str = "";
        let i: i64 = 0;
        while i < vec_len(lines) {
            let line: str = vec_get(lines, i);
            output = output + line + "\n";
            i = i + 1;
        }
        return output;
    }

    fn main() -> i32 {
        let lines: Vec<str> = gen_simple_c();
        let c_code = join_lines(lines);

        // Write to test.c
        write_file("test.c", c_code);

        return 42;
    }
}
