    // ========================================
    // BOOTSTRAP TYPECHECK REPORT
    // ========================================
    //
    // Produces BUNKER_TYPECHECK_JSON for conservative expected/found semantic
    // diagnostics from typed AST refs over the bootstrap layout.

    fn typecheck_is_integer_kind(kind: i64) -> bool {
        return kind == TYPE_I32 || kind == TYPE_I64;
    }

    fn typecheck_is_numeric_kind(kind: i64) -> bool {
        return kind == TYPE_I32 || kind == TYPE_I64 || kind == TYPE_F64;
    }

    fn typecheck_is_unknown_kind(kind: i64) -> bool {
        return kind == TYPE_UNKNOWN;
    }

    fn typecheck_kinds_compatible(expected_kind: i64, found_kind: i64) -> bool {
        if expected_kind == TYPE_UNKNOWN || found_kind == TYPE_UNKNOWN {
            return true;
        }
        if expected_kind == found_kind {
            return true;
        }
        if typecheck_is_integer_kind(expected_kind) && typecheck_is_integer_kind(found_kind) {
            return true;
        }
        return false;
    }

    fn typecheck_is_scalar_cast_kind(kind: i64) -> bool {
        return kind == TYPE_I32 || kind == TYPE_I64 || kind == TYPE_F64 || kind == TYPE_BOOL;
    }

    fn typecheck_value_kinds_compatible(expected_kind: i64, found_kind: i64) -> bool {
        if typecheck_kinds_compatible(expected_kind, found_kind) {
            return true;
        }
        if typecheck_is_scalar_cast_kind(expected_kind) && typecheck_is_scalar_cast_kind(found_kind) {
            return true;
        }
        return false;
    }

    fn typecheck_expr_kind(cstate: CgenStateRef, expr_value: i64) -> i64 {
        if ast_optional_is_none(expr_value) {
            return TYPE_UNKNOWN;
        }
        return typecheck_expr_ref_kind(cstate, ast_expr_ref_from_handle(expr_value));
    }

    fn typecheck_expr_ref_kind(cstate: CgenStateRef, expr_ref: AstExprRef) -> i64 {
        return infer_c_expr_ref_type(cstate, expr_ref);
    }

    fn typecheck_declared_kind(type_node: i64) -> i64 {
        if ast_optional_is_none(type_node) {
            return TYPE_UNKNOWN;
        }
        return typecheck_declared_ref_kind(ast_type_ref_from_handle(type_node));
    }

    fn typecheck_declared_ref_kind(type_ref: AstTypeRef) -> i64 {
        return ast_type_ref_kind_value(type_ref);
    }

    fn typecheck_return_kind(fn_node: Vec<i64>) -> i64 {
        return typecheck_return_ref_kind(ast_item_ref_from_node(fn_node));
    }

    fn typecheck_return_ref_kind(fn_ref: AstItemRef) -> i64 {
        let return_type: i64 = ast_fn_ref_return_type_handle(fn_ref);
        if ast_optional_is_none(return_type) {
            return TYPE_VOID;
        }
        return typecheck_declared_ref_kind(ast_type_ref_from_handle(return_type));
    }

    fn typecheck_diagnostic_json(kind: str, code: str, name: str, scope: str,
                                 node: Vec<i64>, expected: str, found: str,
                                 repair_hint: str) -> str {
        return typecheck_diagnostic_ref_json(kind, code, name, scope,
            ast_node_ref_from_node(node), expected, found, repair_hint);
    }

    fn typecheck_diagnostic_ref_json(kind: str, code: str, name: str, scope: str,
                                     node_ref: AstNodeRef, expected: str, found: str,
                                     repair_hint: str) -> str {
        return typecheck_diagnostic_ref_json_with_type_context(kind, code, name, scope,
            node_ref, expected, found,
            type_graph_kind_json(TYPE_UNKNOWN, "expected"),
            type_graph_kind_json(TYPE_UNKNOWN, "found"),
            repair_hint);
    }

    fn typecheck_diagnostic_ref_json_with_type_context(kind: str, code: str, name: str, scope: str,
                                                       node_ref: AstNodeRef, expected: str, found: str,
                                                       expected_type: str, found_type: str,
                                                       repair_hint: str) -> str {
        let comma: str = ",";
        return "{" +
            json_field_str("phase", "typecheck") + comma +
            json_field_str("kind", kind) + comma +
            json_field_str("error_code", code) + comma +
            json_field_str("name", name) + comma +
            json_field_str("scope", scope) + comma +
            json_field_i64("source_start", ast_node_ref_span_start(node_ref)) + comma +
            json_field_i64("source_end", ast_node_ref_span_end(node_ref)) + comma +
            json_field_bool("span_known", ast_node_ref_span_start(node_ref) != AST_SPAN_UNKNOWN && ast_node_ref_span_end(node_ref) != AST_SPAN_UNKNOWN) + comma +
            json_field_str("expected", expected) + comma +
            json_field_str("found", found) + comma +
            json_field_raw("expected_type", expected_type) + comma +
            json_field_raw("found_type", found_type) + comma +
            json_field_str("suggested_action", repair_hint) + comma +
            json_field_str("fix_applicability", "manual_review") + comma +
            json_field_str("fix_confidence", "medium") + comma +
            json_field_bool("safe_edit_available", false) + comma +
            json_field_raw("suggested_edits", diagnostic_no_edits_json()) + comma +
            json_field_str("repair_hint", repair_hint) +
            "}";
    }

    fn typecheck_append_mismatch(state: Vec<str>, kind: str, name: str, scope: str,
                                 node: Vec<i64>, expected_kind: i64, found_kind: i64,
                                 repair_hint: str) -> Vec<str> {
        return typecheck_append_mismatch_ref(state, kind, name, scope,
            ast_node_ref_from_node(node), expected_kind, found_kind, repair_hint);
    }

    fn typecheck_append_mismatch_ref(state: Vec<str>, kind: str, name: str, scope: str,
                                     node_ref: AstNodeRef, expected_kind: i64, found_kind: i64,
                                     repair_hint: str) -> Vec<str> {
        return resolver_state_append(state,
            typecheck_diagnostic_ref_json_with_type_context(kind, "BKR_SELF_TYPE_MISMATCH", name, scope,
                node_ref, ast_type_kind_name(expected_kind), ast_type_kind_name(found_kind),
                type_graph_kind_json(expected_kind, "expected"),
                type_graph_kind_json(found_kind, "found"),
                repair_hint));
    }

    fn typecheck_append_count_mismatch_ref(state: Vec<str>, kind: str, name: str, scope: str,
                                           node_ref: AstNodeRef, expected_count: i64, found_count: i64,
                                           repair_hint: str) -> Vec<str> {
        return resolver_state_append(state,
            typecheck_diagnostic_ref_json(kind, "BKR_SELF_ARITY_MISMATCH", name, scope,
                node_ref,
                int_to_string(expected_count) + " argument(s)",
                int_to_string(found_count) + " argument(s)",
                repair_hint));
    }

    fn typecheck_append_invalid_assignment_target_ref(state: Vec<str>, scope: str,
                                                      target_ref: AstExprRef) -> Vec<str> {
        let target_kind: i64 = ast_expr_ref_kind(target_ref);
        let hint = "Assign only to a mutable local name, an indexed element, or a field access target.";
        return resolver_state_append(state,
            typecheck_diagnostic_ref_json("invalid_assignment_target", "BKR_SELF_ASSIGNMENT_TARGET",
                "assignment", scope, ast_node_ref_from_expr_ref(target_ref),
                "identifier, index, or field access assignment target",
                ast_node_kind_name(target_kind),
                hint));
    }

    fn typecheck_assignment_target_valid_ref(target_ref: AstExprRef) -> bool {
        let target_kind: i64 = ast_expr_ref_kind(target_ref);
        if target_kind == NODE_IDENT { return true; }
        if target_kind == NODE_INDEX { return true; }
        if target_kind == NODE_FIELD_ACCESS { return true; }
        return false;
    }

    fn typecheck_binary_op_requires_bool(op: i64) -> bool {
        return op == TOK_AND || op == TOK_OR;
    }

    fn typecheck_binary_op_requires_integer(op: i64) -> bool {
        return op == TOK_PERCENT || op == TOK_BIT_AND || op == TOK_BIT_OR ||
            op == TOK_BIT_XOR || op == TOK_SHL || op == TOK_SHR;
    }

    fn typecheck_binary_op_requires_numeric(op: i64) -> bool {
        return op == TOK_PLUS || op == TOK_MINUS || op == TOK_STAR || op == TOK_SLASH ||
            op == TOK_LT || op == TOK_GT || op == TOK_LE || op == TOK_GE;
    }

    fn typecheck_maybe_append_mismatch(state: Vec<str>, kind: str, name: str, scope: str,
                                       node: Vec<i64>, expected_kind: i64, found_kind: i64,
                                       repair_hint: str) -> Vec<str> {
        return typecheck_maybe_append_mismatch_ref(state, kind, name, scope,
            ast_node_ref_from_node(node), expected_kind, found_kind, repair_hint);
    }

    fn typecheck_maybe_append_mismatch_ref(state: Vec<str>, kind: str, name: str, scope: str,
                                           node_ref: AstNodeRef, expected_kind: i64, found_kind: i64,
                                           repair_hint: str) -> Vec<str> {
        if !typecheck_kinds_compatible(expected_kind, found_kind) {
            state = typecheck_append_mismatch_ref(state, kind, name, scope,
                node_ref, expected_kind, found_kind, repair_hint);
        }
        return state;
    }

    fn typecheck_maybe_append_value_mismatch(state: Vec<str>, kind: str, name: str, scope: str,
                                             node: Vec<i64>, expected_kind: i64, found_kind: i64,
                                             repair_hint: str) -> Vec<str> {
        return typecheck_maybe_append_value_mismatch_ref(state, kind, name, scope,
            ast_node_ref_from_node(node), expected_kind, found_kind, repair_hint);
    }

    fn typecheck_maybe_append_value_mismatch_ref(state: Vec<str>, kind: str, name: str, scope: str,
                                                 node_ref: AstNodeRef, expected_kind: i64, found_kind: i64,
                                                 repair_hint: str) -> Vec<str> {
        if !typecheck_value_kinds_compatible(expected_kind, found_kind) {
            state = typecheck_append_mismatch_ref(state, kind, name, scope,
                node_ref, expected_kind, found_kind, repair_hint);
        }
        return state;
    }

    fn typecheck_find_function_ref(kernel_ref: AstNodeRef, name_idx: i64) -> AstItemRef {
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstItemRef = ast_node_list_ref_get_item_ref(items_ref, i);
            if ast_item_ref_kind(item_ref) == NODE_FN && ast_fn_ref_name_idx(item_ref) == name_idx {
                return item_ref;
            }
            i = i + 1;
        }
        return ast_optional_item_ref_none();
    }

    fn typecheck_struct_field_kind_ref(kernel_ref: AstNodeRef, struct_name_idx: i64, field_name_idx: i64) -> i64 {
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstItemRef = ast_node_list_ref_get_item_ref(items_ref, i);
            if ast_item_ref_kind(item_ref) == NODE_STRUCT && ast_struct_ref_name_idx(item_ref) == struct_name_idx {
                let fields_ref: AstNodeListRef = ast_struct_ref_fields_ref(item_ref);
                let j: i64 = 0;
                while j < ast_node_list_ref_count(fields_ref) {
                    let field_ref: AstNodeRef = ast_node_list_ref_get_ref(fields_ref, j);
                    if ast_field_decl_ref_name_idx(field_ref) == field_name_idx {
                        return typecheck_declared_ref_kind(ast_type_ref_from_handle(ast_field_decl_ref_type_handle(field_ref)));
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return TYPE_UNKNOWN;
    }

    fn typecheck_check_binary_operand_ref(state: Vec<str>, scope: str, operand_name: str,
                                          operand_ref: AstExprRef, expected_kind: i64,
                                          found_kind: i64, repair_hint: str) -> Vec<str> {
        if typecheck_is_unknown_kind(found_kind) {
            return state;
        }
        return typecheck_append_mismatch_ref(state, "binary_operand_type_mismatch", operand_name,
            scope, ast_node_ref_from_expr_ref(operand_ref), expected_kind, found_kind, repair_hint);
    }

    fn typecheck_check_binary_operands_ref(state: Vec<str>, cstate: CgenStateRef,
                                           expr_ref: AstExprRef, scope: str) -> Vec<str> {
        let op: i64 = ast_binary_ref_op(expr_ref);
        let left_ref: AstExprRef = ast_expr_ref_from_handle(ast_binary_ref_left_handle(expr_ref));
        let right_ref: AstExprRef = ast_expr_ref_from_handle(ast_binary_ref_right_handle(expr_ref));
        let left_kind: i64 = typecheck_expr_ref_kind(cstate, left_ref);
        let right_kind: i64 = typecheck_expr_ref_kind(cstate, right_ref);
        let op_name = token_name(op);

        if typecheck_binary_op_requires_bool(op) {
            if left_kind != TYPE_BOOL {
                state = typecheck_check_binary_operand_ref(state, scope, "left operand for " + op_name,
                    left_ref, TYPE_BOOL, left_kind, "Use bool operands with " + op_name + ".");
            }
            if right_kind != TYPE_BOOL {
                state = typecheck_check_binary_operand_ref(state, scope, "right operand for " + op_name,
                    right_ref, TYPE_BOOL, right_kind, "Use bool operands with " + op_name + ".");
            }
        } else if typecheck_binary_op_requires_integer(op) {
            if !typecheck_is_integer_kind(left_kind) {
                state = typecheck_check_binary_operand_ref(state, scope, "left operand for " + op_name,
                    left_ref, TYPE_I64, left_kind, "Use integer operands with " + op_name + ".");
            }
            if !typecheck_is_integer_kind(right_kind) {
                state = typecheck_check_binary_operand_ref(state, scope, "right operand for " + op_name,
                    right_ref, TYPE_I64, right_kind, "Use integer operands with " + op_name + ".");
            }
        } else if typecheck_binary_op_requires_numeric(op) {
            if op == TOK_PLUS && (left_kind == TYPE_STR || right_kind == TYPE_STR) {
                return state;
            }
            if !typecheck_is_numeric_kind(left_kind) {
                state = typecheck_check_binary_operand_ref(state, scope, "left operand for " + op_name,
                    left_ref, TYPE_I64, left_kind, "Use numeric operands with " + op_name + ".");
            }
            if !typecheck_is_numeric_kind(right_kind) {
                state = typecheck_check_binary_operand_ref(state, scope, "right operand for " + op_name,
                    right_ref, TYPE_I64, right_kind, "Use numeric operands with " + op_name + ".");
            }
        } else if op == TOK_EQ || op == TOK_NE {
            if !typecheck_kinds_compatible(left_kind, right_kind) {
                state = typecheck_append_mismatch_ref(state, "binary_operand_type_mismatch",
                    "right operand for " + op_name, scope, ast_node_ref_from_expr_ref(right_ref),
                    left_kind, right_kind, "Compare values with compatible operand types.");
            }
        }
        return state;
    }

    fn typecheck_check_unary_operand_ref(state: Vec<str>, cstate: CgenStateRef,
                                         expr_ref: AstExprRef, scope: str) -> Vec<str> {
        let op: i64 = ast_unary_ref_op(expr_ref);
        let operand_ref: AstExprRef = ast_expr_ref_from_handle(ast_unary_ref_operand_handle(expr_ref));
        let operand_kind: i64 = typecheck_expr_ref_kind(cstate, operand_ref);
        if typecheck_is_unknown_kind(operand_kind) {
            return state;
        }
        if op == TOK_NOT && operand_kind != TYPE_BOOL {
            return typecheck_append_mismatch_ref(state, "unary_operand_type_mismatch",
                "operand for !", scope, ast_node_ref_from_expr_ref(operand_ref),
                TYPE_BOOL, operand_kind, "Use a bool operand with !.");
        }
        if op == TOK_MINUS && !typecheck_is_numeric_kind(operand_kind) {
            return typecheck_append_mismatch_ref(state, "unary_operand_type_mismatch",
                "operand for unary -", scope, ast_node_ref_from_expr_ref(operand_ref),
                TYPE_I64, operand_kind, "Use a numeric operand with unary -.");
        }
        return state;
    }

    fn typecheck_check_expression_against(state: Vec<str>, names: Vec<str>, cstate: CgenStateRef,
                                          expr_value: i64, scope: str, diagnostic_kind: str,
                                          name: str, expected_kind: i64, repair_hint: str) -> Vec<str> {
        if ast_optional_is_none(expr_value) {
            if expected_kind != TYPE_VOID && expected_kind != TYPE_UNKNOWN {
                let placeholder: Vec<i64> = ast_new(NODE_RETURN);
                state = typecheck_append_mismatch(state, diagnostic_kind, name, scope,
                    placeholder, expected_kind, TYPE_VOID, repair_hint);
            }
            return state;
        }
        return typecheck_check_expression_ref_against(state, names, cstate,
            ast_expr_ref_from_handle(expr_value), scope, diagnostic_kind,
            name, expected_kind, repair_hint);
    }

    fn typecheck_check_expression_ref_against(state: Vec<str>, names: Vec<str>, cstate: CgenStateRef,
                                              expr_ref: AstExprRef, scope: str, diagnostic_kind: str,
                                              name: str, expected_kind: i64, repair_hint: str) -> Vec<str> {
        let found_kind: i64 = typecheck_expr_ref_kind(cstate, expr_ref);
        return typecheck_maybe_append_mismatch_ref(state, diagnostic_kind, name, scope,
            ast_node_ref_from_expr_ref(expr_ref), expected_kind, found_kind, repair_hint);
    }

    fn typecheck_check_call_arguments(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                      cstate: CgenStateRef, expr: Vec<i64>, scope: str) -> Vec<str> {
        return typecheck_check_call_arguments_ref(state, ast_node_ref_from_node(kernel), names,
            cstate, ast_expr_ref_from_node(expr), scope);
    }

    fn typecheck_check_call_arguments_ref(state: Vec<str>, kernel_ref: AstNodeRef, names: Vec<str>,
                                          cstate: CgenStateRef, expr_ref: AstExprRef, scope: str) -> Vec<str> {
        let name_idx: i64 = ast_call_ref_name_idx(expr_ref);
        let fn_ref: AstItemRef = typecheck_find_function_ref(kernel_ref, name_idx);
        if ast_item_ref_is_none(fn_ref) {
            return state;
        }

        let fn_name: str = ast_report_name(names, name_idx);
        let args_ref: AstNodeListRef = ast_call_ref_args_ref(expr_ref);
        let params_ref: AstNodeListRef = ast_fn_ref_params_ref(fn_ref);
        let arg_count: i64 = ast_node_list_ref_count(args_ref);
        let param_count: i64 = ast_node_list_ref_count(params_ref);
        if arg_count != param_count {
            let arity_hint = "Call " + fn_name + " with exactly " + int_to_string(param_count) +
                " argument(s), or update the function signature.";
            state = typecheck_append_count_mismatch_ref(state, "call_argument_count_mismatch", fn_name,
                scope, ast_node_ref_from_expr_ref(expr_ref), param_count, arg_count, arity_hint);
        }
        let i: i64 = 0;
        while i < arg_count && i < param_count {
            let param_ref: AstNodeRef = ast_node_list_ref_get_ref(params_ref, i);
            let param_type: i64 = ast_param_ref_type_handle(param_ref);
            let arg_node_ref: AstNodeRef = ast_node_list_ref_get_ref(args_ref, i);
            let arg_ref: AstExprRef = ast_expr_ref_from_node_ref(arg_node_ref);
            let expected_kind: i64 = typecheck_declared_ref_kind(ast_type_ref_from_handle(param_type));
            let found_kind: i64 = typecheck_expr_ref_kind(cstate, arg_ref);
            let hint: str = "Change argument " + int_to_string(i + 1) + " for " + fn_name +
                " to match parameter " + ast_report_name(names, ast_param_ref_name_idx(param_ref)) +
                " or update the function signature.";
            state = typecheck_maybe_append_mismatch_ref(state, "call_argument_type_mismatch", fn_name,
                scope, arg_node_ref, expected_kind, found_kind, hint);
            i = i + 1;
        }
        return state;
    }

    fn typecheck_expr_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                  cstate: CgenStateRef, expr_value: i64, scope: str,
                                  expected_return_kind: i64) -> Vec<str> {
        return typecheck_expr_handle_diagnostics(state, ast_node_ref_from_node(kernel), names,
            cstate, expr_value, scope, expected_return_kind);
    }

    fn typecheck_expr_handle_diagnostics(state: Vec<str>, kernel_ref: AstNodeRef, names: Vec<str>,
                                         cstate: CgenStateRef, expr_value: i64, scope: str,
                                         expected_return_kind: i64) -> Vec<str> {
        if ast_optional_is_none(expr_value) {
            return state;
        }
        return typecheck_expr_ref_diagnostics(state, kernel_ref, names, cstate,
            ast_expr_ref_from_handle(expr_value), scope, expected_return_kind);
    }

    fn typecheck_expr_ref_diagnostics(state: Vec<str>, kernel_ref: AstNodeRef, names: Vec<str>,
                                      cstate: CgenStateRef, expr_ref: AstExprRef, scope: str,
                                      expected_return_kind: i64) -> Vec<str> {
        let kind: i64 = ast_expr_ref_kind(expr_ref);
        if kind == NODE_CALL {
            state = typecheck_check_call_arguments_ref(state, kernel_ref, names, cstate, expr_ref, scope);
            let args_ref: AstNodeListRef = ast_call_ref_args_ref(expr_ref);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(args_ref) {
                let arg_ref: AstNodeRef = ast_node_list_ref_get_ref(args_ref, i);
                state = typecheck_expr_ref_diagnostics(state, kernel_ref, names, cstate,
                    ast_expr_ref_from_node_ref(arg_ref), scope, expected_return_kind);
                i = i + 1;
            }
        } else if kind == NODE_STRUCT_LIT {
            let struct_name_idx: i64 = ast_struct_lit_ref_name_idx(expr_ref);
            let struct_name: str = ast_report_name(names, struct_name_idx);
            let field_names_ref: AstI64ListRef = ast_struct_lit_ref_field_names_ref(expr_ref);
            let field_values_ref: AstNodeListRef = ast_struct_lit_ref_field_values_ref(expr_ref);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(field_values_ref) {
                let field_name_idx: i64 = ast_i64_list_ref_get(field_names_ref, i);
                let field_name: str = ast_report_name(names, field_name_idx);
                let field_value_ref: AstNodeRef = ast_node_list_ref_get_ref(field_values_ref, i);
                state = typecheck_expr_ref_diagnostics(state, kernel_ref, names, cstate,
                    ast_expr_ref_from_node_ref(field_value_ref), scope, expected_return_kind);
                let expected_kind: i64 = typecheck_struct_field_kind_ref(kernel_ref, struct_name_idx, field_name_idx);
                let found_kind: i64 = typecheck_expr_ref_kind(cstate, ast_expr_ref_from_node_ref(field_value_ref));
                let hint: str = "Change field " + field_name + " for struct " + struct_name +
                    " to match the declared field type.";
                state = typecheck_maybe_append_value_mismatch_ref(state, "struct_field_type_mismatch",
                    struct_name + "." + field_name, scope, field_value_ref, expected_kind, found_kind, hint);
                i = i + 1;
            }
        } else if kind == NODE_FIELD_ACCESS {
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_field_access_ref_base_handle(expr_ref), scope, expected_return_kind);
        } else if kind == NODE_BINARY {
            state = typecheck_check_binary_operands_ref(state, cstate, expr_ref, scope);
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_binary_ref_left_handle(expr_ref), scope, expected_return_kind);
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_binary_ref_right_handle(expr_ref), scope, expected_return_kind);
        } else if kind == NODE_UNARY {
            state = typecheck_check_unary_operand_ref(state, cstate, expr_ref, scope);
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_unary_ref_operand_handle(expr_ref), scope, expected_return_kind);
        } else if kind == NODE_TERNARY {
            state = typecheck_check_expression_ref_against(state, names, cstate,
                ast_expr_ref_from_handle(ast_ternary_ref_cond_handle(expr_ref)), scope, "condition_type_mismatch", "ternary condition",
                TYPE_BOOL, "Make this ternary condition produce bool.");
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_ternary_ref_cond_handle(expr_ref), scope, expected_return_kind);
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_ternary_ref_then_handle(expr_ref), scope, expected_return_kind);
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_ternary_ref_else_handle(expr_ref), scope, expected_return_kind);
        } else if kind == NODE_ARRAY_LIT {
            let elements_ref: AstNodeListRef = ast_array_lit_ref_elements_ref(expr_ref);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(elements_ref) {
                let element_ref: AstNodeRef = ast_node_list_ref_get_ref(elements_ref, i);
                state = typecheck_expr_ref_diagnostics(state, kernel_ref, names, cstate,
                    ast_expr_ref_from_node_ref(element_ref), scope, expected_return_kind);
                i = i + 1;
            }
        } else if kind == NODE_INDEX {
            let index_expr_ref: AstExprRef = ast_expr_ref_from_handle(ast_index_ref_expr_handle(expr_ref));
            let index_kind: i64 = typecheck_expr_ref_kind(cstate, index_expr_ref);
            state = typecheck_maybe_append_mismatch_ref(state, "index_type_mismatch", "index expression",
                scope, ast_node_ref_from_expr_ref(index_expr_ref), TYPE_I64, index_kind,
                "Use an integer-compatible index expression.");
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_index_ref_base_handle(expr_ref), scope, expected_return_kind);
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_index_ref_expr_handle(expr_ref), scope, expected_return_kind);
        } else if kind == NODE_MATCH {
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_match_ref_scrutinee_handle(expr_ref), scope, expected_return_kind);
            let bodies_ref: AstNodeListRef = ast_match_ref_bodies_ref(expr_ref);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(bodies_ref) {
                let body_ref: AstNodeRef = ast_node_list_ref_get_ref(bodies_ref, i);
                if ast_node_ref_kind(body_ref) == NODE_BLOCK {
                    state = typecheck_block_ref_diagnostics(state, kernel_ref, names, cstate,
                        ast_block_ref_from_node_ref(body_ref), scope, expected_return_kind);
                } else {
                    state = typecheck_expr_ref_diagnostics(state, kernel_ref, names, cstate,
                        ast_expr_ref_from_node_ref(body_ref), scope, expected_return_kind);
                }
                i = i + 1;
            }
        }
        return state;
    }

    fn typecheck_stmt_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                  cstate: CgenStateRef, stmt: Vec<i64>, scope: str,
                                  expected_return_kind: i64) -> Vec<str> {
        return typecheck_stmt_ref_diagnostics(state, ast_node_ref_from_node(kernel), names,
            cstate, ast_stmt_ref_from_node(stmt), scope, expected_return_kind);
    }

    fn typecheck_stmt_ref_diagnostics(state: Vec<str>, kernel_ref: AstNodeRef, names: Vec<str>,
                                      cstate: CgenStateRef, stmt_ref: AstStmtRef, scope: str,
                                      expected_return_kind: i64) -> Vec<str> {
        let stmt_node_ref: AstNodeRef = ast_node_ref_from_stmt_ref(stmt_ref);
        let kind: i64 = ast_stmt_ref_kind(stmt_ref);
        if kind == NODE_LET {
            let init: i64 = ast_let_ref_init_handle(stmt_ref);
            let name: str = ast_report_name(names, ast_let_ref_name_idx(stmt_ref));
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                init, scope, expected_return_kind);
            let type_node: i64 = ast_let_ref_type_handle(stmt_ref);
            if ast_optional_is_some(type_node) && ast_optional_is_some(init) {
                let expected_kind: i64 = typecheck_declared_ref_kind(ast_type_ref_from_handle(type_node));
                let found_kind: i64 = typecheck_expr_ref_kind(cstate, ast_expr_ref_from_handle(init));
                let hint: str = "Change the initializer for " + name +
                    " or update the declared local type.";
                state = typecheck_maybe_append_value_mismatch_ref(state, "annotation_type_mismatch",
                    name, scope, stmt_node_ref, expected_kind, found_kind, hint);
            }
            type_graph_add_let_ref_to_state(cstate, stmt_ref);
        } else if kind == NODE_RETURN {
            let return_expr: i64 = ast_return_ref_expr_handle(stmt_ref);
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                return_expr, scope, expected_return_kind);
            if ast_optional_is_none(return_expr) {
                if expected_return_kind != TYPE_VOID && expected_return_kind != TYPE_UNKNOWN {
                    state = typecheck_append_mismatch_ref(state, "return_type_mismatch", "return",
                        scope, stmt_node_ref, expected_return_kind, TYPE_VOID,
                        "Return a value matching the function return type or change the function signature.");
                }
            } else {
                let found_kind: i64 = typecheck_expr_ref_kind(cstate, ast_expr_ref_from_handle(return_expr));
                state = typecheck_maybe_append_value_mismatch_ref(state, "return_type_mismatch", "return",
                    scope, stmt_node_ref, expected_return_kind, found_kind,
                    "Return a value matching the function return type or change the function signature.");
            }
        } else if kind == NODE_IF {
            let cond: i64 = ast_if_ref_cond_handle(stmt_ref);
            state = typecheck_check_expression_ref_against(state, names, cstate,
                ast_expr_ref_from_handle(cond), scope, "condition_type_mismatch", "if condition",
                TYPE_BOOL, "Make this if condition produce bool.");
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                cond, scope, expected_return_kind);
            state = typecheck_block_ref_diagnostics(state, kernel_ref, names, cstate,
                ast_if_ref_then_block_ref(stmt_ref), scope, expected_return_kind);
            let else_block: i64 = ast_if_ref_else_handle(stmt_ref);
            if ast_optional_is_some(else_block) {
                state = typecheck_block_ref_diagnostics(state, kernel_ref, names, cstate,
                    ast_block_ref_from_handle(else_block), scope, expected_return_kind);
            }
        } else if kind == NODE_WHILE {
            let cond: i64 = ast_while_ref_cond_handle(stmt_ref);
            state = typecheck_check_expression_ref_against(state, names, cstate,
                ast_expr_ref_from_handle(cond), scope, "condition_type_mismatch", "while condition",
                TYPE_BOOL, "Make this while condition produce bool.");
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                cond, scope, expected_return_kind);
            state = typecheck_block_ref_diagnostics(state, kernel_ref, names, cstate,
                ast_while_ref_body_ref(stmt_ref), scope, expected_return_kind);
        } else if kind == NODE_FOR {
            let start: i64 = ast_for_ref_start_handle(stmt_ref);
            let end_expr: i64 = ast_for_ref_end_handle(stmt_ref);
            state = typecheck_check_expression_ref_against(state, names, cstate,
                ast_expr_ref_from_handle(start), scope, "for_range_type_mismatch", "for range start",
                TYPE_I64, "Make the for range start numeric.");
            state = typecheck_check_expression_ref_against(state, names, cstate,
                ast_expr_ref_from_handle(end_expr), scope, "for_range_type_mismatch", "for range end",
                TYPE_I64, "Make the for range end numeric.");
            cgen_add_local_type_ref(cstate, ast_for_ref_name_idx(stmt_ref), TYPE_I64);
            state = typecheck_block_ref_diagnostics(state, kernel_ref, names, cstate,
                ast_for_ref_body_ref(stmt_ref), scope, expected_return_kind);
        } else if kind == NODE_LOOP {
            state = typecheck_block_ref_diagnostics(state, kernel_ref, names, cstate,
                ast_loop_ref_body_ref(stmt_ref), scope, expected_return_kind);
        } else if kind == NODE_ASSIGN {
            let target: i64 = ast_assign_ref_target_handle(stmt_ref);
            let value: i64 = ast_assign_ref_value_handle(stmt_ref);
            let target_ref: AstExprRef = ast_expr_ref_from_handle(target);
            if !typecheck_assignment_target_valid_ref(target_ref) {
                state = typecheck_append_invalid_assignment_target_ref(state, scope, target_ref);
            }
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                target, scope, expected_return_kind);
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                value, scope, expected_return_kind);
            let expected_kind: i64 = typecheck_expr_ref_kind(cstate, target_ref);
            let found_kind: i64 = typecheck_expr_ref_kind(cstate, ast_expr_ref_from_handle(value));
            state = typecheck_maybe_append_value_mismatch_ref(state, "assignment_type_mismatch",
                "assignment", scope, stmt_node_ref, expected_kind, found_kind,
                "Assign a value that matches the target type.");
        } else if kind == NODE_EXPR_STMT {
            state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
                ast_expr_stmt_ref_expr_handle(stmt_ref), scope, expected_return_kind);
        }
        return state;
    }

    fn typecheck_block_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                   cstate: CgenStateRef, block: Vec<i64>, scope: str,
                                   expected_return_kind: i64) -> Vec<str> {
        return typecheck_block_ref_diagnostics(state, ast_node_ref_from_node(kernel), names,
            cstate, ast_block_ref_from_node(block), scope, expected_return_kind);
    }

    fn typecheck_block_ref_diagnostics(state: Vec<str>, kernel_ref: AstNodeRef, names: Vec<str>,
                                       cstate: CgenStateRef, block_ref: AstBlockRef, scope: str,
                                       expected_return_kind: i64) -> Vec<str> {
        let i: i64 = 0;
        while i < ast_block_ref_stmt_count(block_ref) {
            state = typecheck_stmt_ref_diagnostics(state, kernel_ref, names, cstate,
                ast_block_ref_stmt_ref(block_ref, i), scope, expected_return_kind);
            i = i + 1;
        }
        return state;
    }

    fn typecheck_const_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                   cstate: CgenStateRef, item: Vec<i64>, kernel_scope: str) -> Vec<str> {
        return typecheck_const_ref_diagnostics(state, ast_node_ref_from_node(kernel), names,
            cstate, ast_item_ref_from_node(item), kernel_scope);
    }

    fn typecheck_const_ref_diagnostics(state: Vec<str>, kernel_ref: AstNodeRef, names: Vec<str>,
                                       cstate: CgenStateRef, item_ref: AstItemRef, kernel_scope: str) -> Vec<str> {
        let item_node_ref: AstNodeRef = ast_node_ref_from_item_ref(item_ref);
        let const_name: str = ast_report_name(names, ast_const_ref_name_idx(item_ref));
        let value: i64 = ast_const_ref_value_handle(item_ref);
        state = typecheck_expr_handle_diagnostics(state, kernel_ref, names, cstate,
            value, kernel_scope, TYPE_UNKNOWN);
        let type_node: i64 = ast_const_ref_type_handle(item_ref);
        if ast_optional_is_some(type_node) && ast_optional_is_some(value) {
            let expected_kind: i64 = typecheck_declared_ref_kind(ast_type_ref_from_handle(type_node));
            let found_kind: i64 = typecheck_expr_ref_kind(cstate, ast_expr_ref_from_handle(value));
            let hint: str = "Change the initializer for " + const_name +
                " or update the declared constant type.";
            state = typecheck_maybe_append_value_mismatch_ref(state, "annotation_type_mismatch",
                const_name, kernel_scope, item_node_ref, expected_kind, found_kind, hint);
        }
        return state;
    }

    fn typecheck_function_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                      item: Vec<i64>) -> Vec<str> {
        return typecheck_function_ref_diagnostics(state, ast_node_ref_from_node(kernel), names,
            ast_item_ref_from_node(item));
    }

    fn typecheck_function_ref_diagnostics(state: Vec<str>, kernel_ref: AstNodeRef, names: Vec<str>,
                                          item_ref: AstItemRef) -> Vec<str> {
        let fn_name: str = ast_report_name(names, ast_fn_ref_name_idx(item_ref));
        let scope: str = "function:" + fn_name;
        let cstate: CgenStateRef = type_graph_function_state_ref(kernel_ref, item_ref);
        let expected_return_kind: i64 = typecheck_return_ref_kind(item_ref);
        return typecheck_block_ref_diagnostics(state, kernel_ref, names, cstate,
            ast_fn_ref_body_ref(item_ref), scope, expected_return_kind);
    }

    fn typecheck_kernel_diagnostics(state: Vec<str>, kernel: Vec<i64>) -> Vec<str> {
        return typecheck_kernel_ref_diagnostics(state, ast_node_ref_from_node(kernel));
    }

    fn typecheck_kernel_ref_diagnostics(state: Vec<str>, kernel_ref: AstNodeRef) -> Vec<str> {
        let names: Vec<str> = ast_kernel_ref_names(kernel_ref);
        let kernel_scope: str = "kernel:" + ast_report_name(names, ast_node_ref_name_idx(kernel_ref));
        let cstate: CgenStateRef = type_graph_seed_state_ref(kernel_ref);
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstItemRef = ast_node_list_ref_get_item_ref(items_ref, i);
            let kind: i64 = ast_item_ref_kind(item_ref);
            if kind == NODE_CONST {
                state = typecheck_const_ref_diagnostics(state, kernel_ref, names, cstate,
                    item_ref, kernel_scope);
            } else if kind == NODE_FN {
                state = typecheck_function_ref_diagnostics(state, kernel_ref, names, item_ref);
            }
            i = i + 1;
        }
        return state;
    }

    fn self_host_typecheck_json(kernel: Vec<i64>) -> str {
        let comma: str = ",";
        let state: Vec<str> = resolver_state_new();
        let kernel_ref: AstNodeRef = ast_node_ref_from_node(kernel);
        typecheck_kernel_ref_diagnostics(state, kernel_ref);
        return "{" +
            json_field_str("schema_version", "bunker.self_host.typecheck.v1") + comma +
            json_field_str("representation", "bootstrap_typecheck_pass") + comma +
            json_field_bool("complete", false) + comma +
            json_field_bool("annotation_checks", true) + comma +
            json_field_bool("return_checks", true) + comma +
            json_field_bool("condition_checks", true) + comma +
            json_field_bool("call_argument_checks", true) + comma +
            json_field_bool("call_arity_checks", true) + comma +
            json_field_bool("assignment_target_checks", true) + comma +
            json_field_bool("struct_field_value_checks", true) + comma +
            json_field_bool("index_type_checks", true) + comma +
            json_field_bool("binary_operand_checks", true) + comma +
            json_field_bool("unary_operand_checks", true) + comma +
            json_field_bool("typed_diagnostic_context", true) + comma +
            json_field_bool("structured_repair_metadata", true) + comma +
            json_field_bool("diagnostic_phase_field", true) + comma +
            json_field_bool("suggested_edit_envelope", true) + comma +
            json_field_bool("has_diagnostics", resolver_state_count(state) > 0) + comma +
            json_field_i64("diagnostic_count", resolver_state_count(state)) + comma +
            json_field_str("known_limits", "Bootstrap typecheck report compares declared annotations, returns, conditions, assignments and assignment targets, indexes, unary/binary operands, for ranges, direct user-function call arguments, call arity, and struct literal field values using codegen inference, and emits expected/found type objects for diagnostics; value assignment/return checks permit scalar cast-compatible types until casts are preserved in the AST. It does not yet enforce full generics, numeric ranges, trait bounds, exhaustiveness, method/field access typing, or cross-module types.") + comma +
            json_field_raw("diagnostics", resolver_state_json(state)) +
            "}";
    }

    fn build_typecheck_report_comment(kernel: Vec<i64>) -> str {
        return "/* BUNKER_TYPECHECK_JSON: " + self_host_typecheck_json(kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }
