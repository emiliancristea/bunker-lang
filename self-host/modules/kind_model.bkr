    // ========================================
    // KIND MODEL HELPERS
    // ========================================
    //
    // Centralizes bootstrap numeric tag interpretation behind enum-ready
    // helpers. Later slices can replace these i64 constants with language
    // enums without changing parser/codegen/report call sites.

    fn ast_node_kind_name(kind: i64) -> str {
        if kind == NODE_KERNEL { return "kernel"; }
        if kind == NODE_FN { return "function"; }
        if kind == NODE_PARAM { return "parameter"; }
        if kind == NODE_TYPE { return "type"; }
        if kind == NODE_BLOCK { return "block"; }
        if kind == NODE_LET { return "let"; }
        if kind == NODE_RETURN { return "return"; }
        if kind == NODE_IF { return "if"; }
        if kind == NODE_WHILE { return "while"; }
        if kind == NODE_EXPR_STMT { return "expression statement"; }
        if kind == NODE_ASSIGN { return "assignment"; }
        if kind == NODE_BREAK { return "break"; }
        if kind == NODE_CONTINUE { return "continue"; }
        if kind == NODE_FOR { return "for"; }
        if kind == NODE_LOOP { return "loop"; }
        if kind == NODE_BINARY { return "binary expression"; }
        if kind == NODE_UNARY { return "unary expression"; }
        if kind == NODE_CALL { return "call expression"; }
        if kind == NODE_IDENT { return "identifier"; }
        if kind == NODE_INT_LIT { return "integer literal"; }
        if kind == NODE_BOOL_LIT { return "boolean literal"; }
        if kind == NODE_STR_LIT { return "string literal"; }
        if kind == NODE_CONST { return "constant"; }
        if kind == NODE_TERNARY { return "ternary expression"; }
        if kind == NODE_FLOAT_LIT { return "float literal"; }
        if kind == NODE_ARRAY_LIT { return "array literal"; }
        if kind == NODE_INDEX { return "index expression"; }
        if kind == NODE_STRUCT { return "struct"; }
        if kind == NODE_FIELD { return "field"; }
        if kind == NODE_FIELD_ACCESS { return "field access"; }
        if kind == NODE_STRUCT_LIT { return "struct literal"; }
        if kind == NODE_MATCH { return "match expression"; }
        return "node " + int_to_string(kind);
    }

    fn ast_type_kind_name(kind: i64) -> str {
        if kind == TYPE_I32 { return "i32"; }
        if kind == TYPE_I64 { return "i64"; }
        if kind == TYPE_F64 { return "f64"; }
        if kind == TYPE_BOOL { return "bool"; }
        if kind == TYPE_STR { return "str"; }
        if kind == TYPE_VOID { return "void"; }
        if kind == TYPE_ARRAY { return "array"; }
        if kind == TYPE_STRUCT { return "struct"; }
        if kind == TYPE_UNKNOWN { return "unknown"; }
        return "type " + int_to_string(kind);
    }

    fn ast_pattern_kind_name(kind: i64) -> str {
        if kind == PAT_INT { return "integer pattern"; }
        if kind == PAT_BOOL { return "boolean pattern"; }
        if kind == PAT_BIND { return "binding pattern"; }
        if kind == PAT_WILDCARD { return "wildcard pattern"; }
        if kind == PAT_SOME { return "Some pattern"; }
        if kind == PAT_NONE { return "None pattern"; }
        return "pattern " + int_to_string(kind);
    }

    fn ast_category_name(category: i64) -> str {
        if category == AST_CAT_ITEM { return "item"; }
        if category == AST_CAT_STMT { return "statement"; }
        if category == AST_CAT_EXPR { return "expression"; }
        if category == AST_CAT_TYPE { return "type"; }
        if category == AST_CAT_DECL { return "declaration"; }
        return "unknown";
    }

    fn ast_node_category_kind(kind: i64) -> i64 {
        if kind == NODE_KERNEL || kind == NODE_FN || kind == NODE_CONST || kind == NODE_STRUCT {
            return AST_CAT_ITEM;
        }
        if kind == NODE_BLOCK || kind == NODE_LET || kind == NODE_RETURN || kind == NODE_IF ||
           kind == NODE_WHILE || kind == NODE_EXPR_STMT || kind == NODE_ASSIGN ||
           kind == NODE_BREAK || kind == NODE_CONTINUE || kind == NODE_FOR || kind == NODE_LOOP {
            return AST_CAT_STMT;
        }
        if kind == NODE_BINARY || kind == NODE_UNARY || kind == NODE_CALL || kind == NODE_IDENT ||
           kind == NODE_INT_LIT || kind == NODE_BOOL_LIT || kind == NODE_STR_LIT ||
           kind == NODE_TERNARY || kind == NODE_FLOAT_LIT || kind == NODE_ARRAY_LIT ||
           kind == NODE_INDEX || kind == NODE_FIELD_ACCESS || kind == NODE_STRUCT_LIT ||
           kind == NODE_MATCH {
            return AST_CAT_EXPR;
        }
        if kind == NODE_TYPE {
            return AST_CAT_TYPE;
        }
        if kind == NODE_PARAM || kind == NODE_FIELD {
            return AST_CAT_DECL;
        }
        return AST_CAT_UNKNOWN;
    }

    fn ast_is_item_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_ITEM;
    }

    fn ast_is_stmt_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_STMT;
    }

    fn ast_is_expr_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_EXPR;
    }

    fn ast_is_type_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_TYPE;
    }

    fn ast_is_decl_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_DECL;
    }
