    // ========================================
    // LEXER RESULT HELPERS
    // ========================================
    //
    // Lexer results are still represented as Vec<i64> during bootstrap.
    // Keep the output table layout behind this module so the parser can later
    // consume a fully typed lexer result without changing parse logic.
    //
    // Layout:
    // [tokens, names, values, strings]

    struct LexerResultRef {
        handle: i64,
    }

    fn lexer_result_new(tokens: Vec<i64>, names: Vec<str>, values: Vec<i64>, strings: Vec<str>) -> Vec<i64> {
        return lexer_result_from_ref(lexer_result_new_ref(tokens, names, values, strings));
    }

    fn lexer_result_new_ref(tokens: Vec<i64>, names: Vec<str>, values: Vec<i64>, strings: Vec<str>) -> LexerResultRef {
        let result: Vec<i64> = vec_new();
        vec_push(result, tokens as i64);
        vec_push(result, names as i64);
        vec_push(result, values as i64);
        vec_push(result, strings as i64);
        return lexer_result_ref_from_result(result);
    }

    fn lexer_result_ref_from_result(result: Vec<i64>) -> LexerResultRef {
        return LexerResultRef { handle: result as i64 };
    }

    fn lexer_result_from_ref(result_ref: LexerResultRef) -> Vec<i64> {
        return result_ref.handle as Vec<i64>;
    }

    fn lexer_result_tokens(result: Vec<i64>) -> Vec<i64> {
        return lexer_result_tokens_ref(lexer_result_ref_from_result(result));
    }

    fn lexer_result_tokens_ref(result_ref: LexerResultRef) -> Vec<i64> {
        return vec_get(lexer_result_from_ref(result_ref), 0) as Vec<i64>;
    }

    fn lexer_result_names(result: Vec<i64>) -> Vec<str> {
        return lexer_result_names_ref(lexer_result_ref_from_result(result));
    }

    fn lexer_result_names_ref(result_ref: LexerResultRef) -> Vec<str> {
        return vec_get(lexer_result_from_ref(result_ref), 1) as Vec<str>;
    }

    fn lexer_result_values(result: Vec<i64>) -> Vec<i64> {
        return lexer_result_values_ref(lexer_result_ref_from_result(result));
    }

    fn lexer_result_values_ref(result_ref: LexerResultRef) -> Vec<i64> {
        return vec_get(lexer_result_from_ref(result_ref), 2) as Vec<i64>;
    }

    fn lexer_result_strings(result: Vec<i64>) -> Vec<str> {
        return lexer_result_strings_ref(lexer_result_ref_from_result(result));
    }

    fn lexer_result_strings_ref(result_ref: LexerResultRef) -> Vec<str> {
        return vec_get(lexer_result_from_ref(result_ref), 3) as Vec<str>;
    }
