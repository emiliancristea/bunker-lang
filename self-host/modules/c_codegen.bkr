    // ========================================
    // C CODE GENERATOR
    // ========================================

    fn cgen_is_enum_name_ref(state: CgenStateRef, name_idx: i64) -> bool {
        let names: Vec<str> = cgen_names_ref(state);
        return cgen_enum_name_exists_ref(state, name_from_table(names, name_idx));
    }

    fn cgen_enum_name_exists_ref(state: CgenStateRef, enum_name: str) -> bool {
        let kernel_handle: i64 = cgen_kernel_handle(state);
        if kernel_handle == 0 {
            return false;
        }
        let kernel_ref: AstNodeRef = ast_node_ref_from_handle(kernel_handle);
        let names: Vec<str> = cgen_names_ref(state);
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstItemRef = ast_node_list_ref_get_item_ref(items_ref, i);
            if ast_item_ref_kind(item_ref) == NODE_ENUM {
                if name_from_table(names, ast_enum_ref_name_idx(item_ref)) == enum_name {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    fn cgen_enum_variant_tag_ref(state: CgenStateRef, enum_name: str, variant_name: str) -> i64 {
        let kernel_handle: i64 = cgen_kernel_handle(state);
        if kernel_handle == 0 {
            return -1;
        }
        let kernel_ref: AstNodeRef = ast_node_ref_from_handle(kernel_handle);
        let names: Vec<str> = cgen_names_ref(state);
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstItemRef = ast_node_list_ref_get_item_ref(items_ref, i);
            if ast_item_ref_kind(item_ref) == NODE_ENUM {
                if name_from_table(names, ast_enum_ref_name_idx(item_ref)) == enum_name {
                    let variants_ref: AstI64ListRef = ast_enum_ref_variants_ref(item_ref);
                    let j: i64 = 0;
                    while j < ast_i64_list_ref_count(variants_ref) {
                        if name_from_table(names, ast_i64_list_ref_get(variants_ref, j)) == variant_name {
                            return j;
                        }
                        j = j + 1;
                    }
                    return -1;
                }
            }
            i = i + 1;
        }
        return -1;
    }
    fn cgen_enum_variant_payload_kind_ref(state: CgenStateRef, enum_name: str, variant_name: str, field_idx: i64) -> i64 {
        let kernel_handle: i64 = cgen_kernel_handle(state);
        if kernel_handle == 0 {
            return TYPE_UNKNOWN;
        }
        let kernel_ref: AstNodeRef = ast_node_ref_from_handle(kernel_handle);
        let names: Vec<str> = cgen_names_ref(state);
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstItemRef = ast_node_list_ref_get_item_ref(items_ref, i);
            if ast_item_ref_kind(item_ref) == NODE_ENUM {
                if name_from_table(names, ast_enum_ref_name_idx(item_ref)) == enum_name {
                    let variants_ref: AstI64ListRef = ast_enum_ref_variants_ref(item_ref);
                    let payloads_ref: AstI64ListRef = ast_enum_ref_payloads_ref(item_ref);
                    let j: i64 = 0;
                    while j < ast_i64_list_ref_count(variants_ref) {
                        if name_from_table(names, ast_i64_list_ref_get(variants_ref, j)) == variant_name {
                            if j < ast_i64_list_ref_count(payloads_ref) {
                                let payload: i64 = ast_i64_list_ref_get(payloads_ref, j);
                                if ast_optional_is_some(payload) {
                                    let fields_ref: AstI64ListRef = ast_i64_list_ref_from_handle(payload);
                                    if field_idx >= 0 && field_idx < ast_i64_list_ref_count(fields_ref) {
                                        let field_type_handle: i64 = ast_i64_list_ref_get(fields_ref, field_idx);
                                        if ast_optional_is_some(field_type_handle) {
                                            return ast_type_ref_kind_value(ast_type_ref_from_handle(field_type_handle));
                                        }
                                    }
                                }
                            }
                            return TYPE_UNKNOWN;
                        }
                        j = j + 1;
                    }
                    return TYPE_UNKNOWN;
                }
            }
            i = i + 1;
        }
        return TYPE_UNKNOWN;
    }

    fn cgen_enum_has_string_payload_ref(state: CgenStateRef, enum_name: str) -> bool {
        let kernel_handle: i64 = cgen_kernel_handle(state);
        if kernel_handle == 0 {
            return false;
        }
        let kernel_ref: AstNodeRef = ast_node_ref_from_handle(kernel_handle);
        let names: Vec<str> = cgen_names_ref(state);
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstItemRef = ast_node_list_ref_get_item_ref(items_ref, i);
            if ast_item_ref_kind(item_ref) == NODE_ENUM {
                if name_from_table(names, ast_enum_ref_name_idx(item_ref)) == enum_name {
                    let payloads_ref: AstI64ListRef = ast_enum_ref_payloads_ref(item_ref);
                    let j: i64 = 0;
                    while j < ast_i64_list_ref_count(payloads_ref) {
                        let payload: i64 = ast_i64_list_ref_get(payloads_ref, j);
                        if ast_optional_is_some(payload) {
                            let fields_ref: AstI64ListRef = ast_i64_list_ref_from_handle(payload);
                            let k: i64 = 0;
                            while k < ast_i64_list_ref_count(fields_ref) {
                                let field_type_handle: i64 = ast_i64_list_ref_get(fields_ref, k);
                                if ast_optional_is_some(field_type_handle) {
                                    if ast_type_ref_kind_value(ast_type_ref_from_handle(field_type_handle)) == TYPE_STR {
                                        return true;
                                    }
                                }
                                k = k + 1;
                            }
                        }
                        j = j + 1;
                    }
                    return false;
                }
            }
            i = i + 1;
        }
        return false;
    }

    fn type_to_c(kind: TypeKind) -> str {
        if kind == TYPE_I32 { return "bkr_i32"; }
        if kind == TYPE_I64 { return "bkr_i64"; }
        if kind == TYPE_F64 { return "bkr_f64"; }
        if kind == TYPE_BOOL { return "bkr_bool"; }
        if kind == TYPE_STR { return "bkr_str"; }
        if kind == TYPE_VOID || kind == TYPE_NEVER { return "void"; }
        if kind == TYPE_VEC || kind == TYPE_MAP || kind == TYPE_OPTION || kind == TYPE_RESULT || kind == TYPE_FN { return "bkr_i64"; }
        return "bkr_i64";
    }

    fn type_node_to_c(state: Vec<i64>, type_node: i64) -> str {
        if ast_optional_is_none(type_node) {
            return "bkr_i64";
        }
        return type_node_to_c_ref(cgen_state_ref_from_state(state), ast_type_ref_from_handle(type_node));
    }

    fn type_node_to_c_ref(state: CgenStateRef, type_ref: AstTypeRef) -> str {
        let kind: i64 = ast_type_ref_kind_value(type_ref);
        if kind == TYPE_STRUCT {
            let struct_name_idx: i64 = ast_type_ref_struct_name_idx_value(type_ref);
            if struct_name_idx >= 0 {
                if cgen_is_enum_name_ref(state, struct_name_idx) {
                    return "bkr_i64";
                }
                return name_to_c_ref(state, struct_name_idx);
            }
        }
        return type_to_c(kind);
    }

    fn op_to_c(op: i64) -> str {
        if op == TOK_PLUS { return " + "; }
        if op == TOK_MINUS { return " - "; }
        if op == TOK_STAR { return " * "; }
        if op == TOK_SLASH { return " / "; }
        if op == TOK_PERCENT { return " % "; }
        if op == TOK_EQ { return " == "; }
        if op == TOK_NE { return " != "; }
        if op == TOK_LT { return " < "; }
        if op == TOK_GT { return " > "; }
        if op == TOK_LE { return " <= "; }
        if op == TOK_GE { return " >= "; }
        if op == TOK_AND { return " && "; }
        if op == TOK_OR { return " || "; }
        if op == TOK_BIT_AND { return " & "; }
        if op == TOK_BIT_OR { return " | "; }
        if op == TOK_BIT_XOR { return " ^ "; }
        if op == TOK_SHL { return " << "; }
        if op == TOK_SHR { return " >> "; }
        return " ? ";
    }

    fn name_from_table(names: Vec<str>, idx: i64) -> str {
        if idx >= 0 && idx < vec_len(names) {
            return vec_get(names, idx);
        }
        return "";
    }

    fn builtin_to_c(raw: str) -> str {
        if raw == "len" { return "bkr_len"; }
        if raw == "strlen" { return "bkr_len"; }
        if raw == "print" { return "bkr_print"; }
        if raw == "println" { return "bkr_println"; }
        if raw == "log" { return "bkr_log"; }
        if raw == "read_file" { return "read_file"; }
        if raw == "write_file" { return "write_file"; }
        if raw == "file_exists" { return "file_exists"; }
        if raw == "vec_new" { return "vec_new"; }
        if raw == "vec_push" { return "vec_push"; }
        if raw == "vec_get" { return "vec_get"; }
        if raw == "vec_set" { return "vec_set"; }
        if raw == "vec_len" { return "vec_len"; }
        if raw == "vec_pop" { return "vec_pop"; }
        if raw == "hashmap_new" { return "hashmap_new"; }
        if raw == "hashmap_insert" { return "hashmap_insert"; }
        if raw == "hashmap_get" { return "hashmap_get"; }
        if raw == "hashmap_contains" { return "hashmap_contains"; }
        if raw == "hashmap_remove" { return "hashmap_remove"; }
        if raw == "hashmap_keys" { return "hashmap_keys"; }
        if raw == "hashmap_len" { return "hashmap_len"; }
        if raw == "hashmap_clear" { return "hashmap_clear"; }
        if raw == "char_at" { return "char_at"; }
        if raw == "char_code" { return "char_code"; }
        if raw == "char_code_at" { return "char_code_at"; }
        if raw == "substring" { return "substring"; }
        if raw == "contains" { return "contains"; }
        if raw == "starts_with" { return "starts_with"; }
        if raw == "ends_with" { return "ends_with"; }
        if raw == "trim" { return "trim"; }
        if raw == "parse_int" { return "parse_int"; }
        if raw == "int_to_string" { return "int_to_string"; }
        if raw == "from_char_code" { return "from_char_code"; }
        if raw == "join_lines" { return "join_lines"; }
        if raw == "args_count" { return "bkr_args_count"; }
        if raw == "arg_at" { return "bkr_arg_at"; }
        if raw == "str_index_of" { return "str_index_of"; }
        if raw == "str_replace" { return "str_replace"; }
        if raw == "str_split" { return "str_split"; }
        if raw == "str_to_upper" { return "str_to_upper"; }
        if raw == "str_to_lower" { return "str_to_lower"; }
        if raw == "str_repeat" { return "str_repeat"; }
        if raw == "path_join" { return "path_join"; }
        if raw == "path_dir" { return "path_dir"; }
        if raw == "path_base" { return "path_base"; }
        if raw == "path_ext" { return "path_ext"; }
        if raw == "path_is_abs" { return "path_is_abs"; }
        if raw == "env_var" { return "env_var"; }
        if raw == "env_get" { return "env_get"; }
        if raw == "env_set" { return "env_set"; }
        if raw == "env_has" { return "env_has"; }
        if raw == "time_now_ms" { return "time_now_ms"; }
        if raw == "time_now_unix" { return "time_now_unix"; }
        return "";
    }

    fn name_to_c_from_names(names: Vec<str>, idx: i64) -> str {
        let raw = name_from_table(names, idx);
        let builtin = builtin_to_c(raw);
        if builtin != "" {
            return builtin;
        }
        return "_v" + int_to_string(idx);
    }

    fn name_to_c(state: Vec<i64>, idx: i64) -> str {
        return name_to_c_ref(cgen_state_ref_from_state(state), idx);
    }

    fn name_to_c_ref(state: CgenStateRef, idx: i64) -> str {
        return name_to_c_from_names(cgen_names_ref(state), idx);
    }

    fn type_node_kind(type_node: i64) -> i64 {
        return type_node_kind_ref(ast_type_ref_from_handle(type_node));
    }

    fn type_node_kind_ref(type_ref: AstTypeRef) -> i64 {
        return ast_type_ref_kind_value(type_ref);
    }

    fn type_node_array_elem_kind(type_node: i64) -> i64 {
        return type_node_array_elem_kind_ref(ast_type_ref_from_handle(type_node));
    }

    fn type_node_array_elem_kind_ref(type_ref: AstTypeRef) -> i64 {
        return ast_type_ref_array_elem_kind_value(type_ref);
    }

    fn type_node_array_len(type_node: i64) -> i64 {
        return type_node_array_len_ref(ast_type_ref_from_handle(type_node));
    }

    fn type_node_array_len_ref(type_ref: AstTypeRef) -> i64 {
        return ast_type_ref_array_len_value(type_ref);
    }

