    // ========================================
    // SELF-HOST SYMBOL TABLE REPORT
    // ========================================
    //
    // Produces BUNKER_SYMBOL_TABLE_JSON declaration/reference tables from the
    // bootstrap raw Vec<i64> AST layout.

    fn symbol_table_json_array_append(result: str, item: str) -> str {
        if len(result) > 1 {
            return result + "," + item;
        }
        return result + item;
    }

    fn symbol_table_json_array_append_items(result: str, items: str) -> str {
        if len(items) <= 2 {
            return result;
        }
        let inner = substring(items, 1, len(items) - 1);
        if len(result) > 1 {
            return result + "," + inner;
        }
        return result + inner;
    }

    fn symbol_table_entry_json(kind: str, name: str, scope: str, source_start: i64, source_end: i64) -> str {
        let comma = ",";
        return "{" +
            json_field_str("kind", kind) + comma +
            json_field_str("name", name) + comma +
            json_field_str("scope", scope) + comma +
            json_field_i64("source_start", source_start) + comma +
            json_field_i64("source_end", source_end) + comma +
            json_field_bool("span_known", source_start != AST_SPAN_UNKNOWN && source_end != AST_SPAN_UNKNOWN) +
            "}";
    }

    fn symbol_table_node_entry_json(kind: str, name: str, scope: str, node: Vec<i64>) -> str {
        return symbol_table_entry_json(kind, name, scope, ast_node_span_start(node), ast_node_span_end(node));
    }

    fn symbol_table_pattern_entry_json(kind: str, name: str, scope: str, pattern: Vec<i64>) -> str {
        return symbol_table_entry_json(kind, name, scope, ast_pattern_span_start(pattern), ast_pattern_span_end(pattern));
    }

    fn symbol_table_type_references_json(names: Vec<str>, type_node: i64, scope: str) -> str {
        let result = "[";
        if ast_optional_is_some(type_node) && ast_type_kind_value(type_node) == TYPE_STRUCT {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("type_reference",
                    ast_report_name(names, ast_type_struct_name_idx_value(type_node)),
                    scope,
                    ast_optional_node(type_node)));
        }
        return result + "]";
    }

    fn symbol_table_pattern_declarations_json(names: Vec<str>, pattern: Vec<i64>, scope: str) -> str {
        let result = "[";
        let kind = ast_pattern_kind(pattern);
        if kind == PAT_BIND || kind == PAT_SOME {
            result = symbol_table_json_array_append(result,
                symbol_table_pattern_entry_json("pattern_binding",
                    ast_report_name(names, ast_pattern_value(pattern)),
                    scope,
                    pattern));
        }
        return result + "]";
    }

    fn symbol_table_expr_declarations_json(names: Vec<str>, expr_value: i64, scope: str) -> str {
        let result = "[";
        if ast_optional_is_none(expr_value) {
            return result + "]";
        }

        let expr = ast_optional_node(expr_value);
        let kind = ast_kind(expr);
        if kind == NODE_MATCH {
            let i: i64 = 0;
            while i < ast_match_arm_count(expr) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_pattern_declarations_json(names, ast_match_pattern(expr, i), scope));
                let body = ast_match_body(expr, i);
                if ast_is_block(body) {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_block_declarations_json(names, body, scope));
                } else {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_expr_declarations_json(names, ast_expr_handle(body), scope));
                }
                i = i + 1;
            }
        } else if kind == NODE_BINARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_binary_left(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_binary_right(expr)), scope));
        } else if kind == NODE_UNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_unary_operand(expr)), scope));
        } else if kind == NODE_CALL {
            let i: i64 = 0;
            while i < ast_call_arg_count(expr) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_declarations_json(names, ast_expr_handle(ast_call_arg(expr, i)), scope));
                i = i + 1;
            }
        } else if kind == NODE_TERNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_ternary_cond(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_ternary_then(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_ternary_else(expr)), scope));
        } else if kind == NODE_ARRAY_LIT {
            let i: i64 = 0;
            while i < ast_array_element_count(expr) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_declarations_json(names, ast_expr_handle(ast_array_element(expr, i)), scope));
                i = i + 1;
            }
        } else if kind == NODE_INDEX {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_index_base(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_index_expr(expr)), scope));
        } else if kind == NODE_FIELD_ACCESS {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_field_base(expr)), scope));
        } else if kind == NODE_STRUCT_LIT {
            let i: i64 = 0;
            while i < ast_struct_lit_field_count(expr) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_declarations_json(names, ast_expr_handle(ast_struct_lit_field_value(expr, i)), scope));
                i = i + 1;
            }
        }

        return result + "]";
    }

    fn symbol_table_stmt_declarations_json(names: Vec<str>, stmt: Vec<i64>, scope: str) -> str {
        let result = "[";
        let kind = ast_kind(stmt);
        if kind == NODE_LET {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("local",
                    ast_report_name(names, ast_let_name_idx(stmt)),
                    scope,
                    stmt));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_let_init(stmt), scope));
        } else if kind == NODE_RETURN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_return_expr(stmt), scope));
        } else if kind == NODE_IF {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_if_cond(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_if_then(stmt), scope));
            let else_block = ast_if_else(stmt);
            if ast_optional_is_some(else_block) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_block_declarations_json(names, ast_optional_node(else_block), scope));
            }
        } else if kind == NODE_WHILE {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_while_cond(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_while_body(stmt), scope));
        } else if kind == NODE_FOR {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("for_binding",
                    ast_report_name(names, ast_for_name_idx(stmt)),
                    scope,
                    stmt));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_for_start(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_for_end(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_for_body(stmt), scope));
        } else if kind == NODE_LOOP {
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_loop_body(stmt), scope));
        } else if kind == NODE_ASSIGN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_assign_target(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_assign_value(stmt)), scope));
        } else if kind == NODE_EXPR_STMT {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_handle(ast_expr_stmt_expr(stmt)), scope));
        }
        return result + "]";
    }

    fn symbol_table_block_declarations_json(names: Vec<str>, block: Vec<i64>, scope: str) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_stmt_declarations_json(names, ast_block_stmt(block, i), scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn symbol_table_item_declarations_json(kernel: Vec<i64>, item: Vec<i64>, kernel_scope: str) -> str {
        let names = ast_kernel_names(kernel);
        let result = "[";
        if ast_is_fn_item(item) {
            let fn_name = ast_report_name(names, ast_fn_name_idx(item));
            let fn_scope = "function:" + fn_name;
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("function", fn_name, kernel_scope, item));

            let i: i64 = 0;
            while i < ast_fn_param_count(item) {
                let param = ast_fn_param(item, i);
                result = symbol_table_json_array_append(result,
                    symbol_table_node_entry_json("parameter",
                        ast_report_name(names, ast_param_name_idx(param)),
                        fn_scope,
                        param));
                i = i + 1;
            }

            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_fn_body(item), fn_scope));
        } else if ast_is_const_item(item) {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("constant",
                    ast_report_name(names, ast_const_name_idx(item)),
                    kernel_scope,
                    item));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_const_value(item), kernel_scope));
        } else if ast_is_struct_item(item) {
            let struct_name = ast_report_name(names, ast_struct_name_idx(item));
            let struct_scope = "struct:" + struct_name;
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("struct", struct_name, kernel_scope, item));
            let i: i64 = 0;
            while i < ast_struct_field_count(item) {
                let field = ast_struct_field(item, i);
                result = symbol_table_json_array_append(result,
                    symbol_table_node_entry_json("field",
                        ast_report_name(names, ast_field_decl_name_idx(field)),
                        struct_scope,
                        field));
                i = i + 1;
            }
        }
        return result + "]";
    }

    fn symbol_table_declarations_json(kernel: Vec<i64>) -> str {
        let names = ast_kernel_names(kernel);
        let kernel_name = ast_report_name(names, ast_name_idx(kernel));
        let kernel_scope = "kernel:" + kernel_name;
        let result = "[";
        result = symbol_table_json_array_append(result,
            symbol_table_node_entry_json("kernel", kernel_name, "global", kernel));

        let i: i64 = 0;
        while i < ast_kernel_item_count(kernel) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_item_declarations_json(kernel, ast_kernel_item(kernel, i), kernel_scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn symbol_table_expr_references_json(names: Vec<str>, expr_value: i64, scope: str) -> str {
        let result = "[";
        if ast_optional_is_none(expr_value) {
            return result + "]";
        }

        let expr = ast_optional_node(expr_value);
        let kind = ast_kind(expr);
        if kind == NODE_IDENT {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("identifier",
                    ast_report_name(names, ast_name_idx(expr)),
                    scope,
                    expr));
        } else if kind == NODE_CALL {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("function_call",
                    ast_report_name(names, ast_call_name_idx(expr)),
                    scope,
                    expr));
            let i: i64 = 0;
            while i < ast_call_arg_count(expr) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_references_json(names, ast_expr_handle(ast_call_arg(expr, i)), scope));
                i = i + 1;
            }
        } else if kind == NODE_FIELD_ACCESS {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_field_base(expr)), scope));
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("field_access",
                    ast_report_name(names, ast_field_name_idx(expr)),
                    scope,
                    expr));
        } else if kind == NODE_STRUCT_LIT {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("struct_literal",
                    ast_report_name(names, ast_struct_lit_name_idx(expr)),
                    scope,
                    expr));
            let i: i64 = 0;
            while i < ast_struct_lit_field_count(expr) {
                result = symbol_table_json_array_append(result,
                    symbol_table_node_entry_json("field_initializer",
                        ast_report_name(names, ast_struct_lit_field_name_idx(expr, i)),
                        scope,
                        expr));
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_references_json(names, ast_expr_handle(ast_struct_lit_field_value(expr, i)), scope));
                i = i + 1;
            }
        } else if kind == NODE_BINARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_binary_left(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_binary_right(expr)), scope));
        } else if kind == NODE_UNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_unary_operand(expr)), scope));
        } else if kind == NODE_TERNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_ternary_cond(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_ternary_then(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_ternary_else(expr)), scope));
        } else if kind == NODE_ARRAY_LIT {
            let i: i64 = 0;
            while i < ast_array_element_count(expr) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_references_json(names, ast_expr_handle(ast_array_element(expr, i)), scope));
                i = i + 1;
            }
        } else if kind == NODE_INDEX {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_index_base(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_index_expr(expr)), scope));
        } else if kind == NODE_MATCH {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_match_scrutinee(expr)), scope));
            let i: i64 = 0;
            while i < ast_match_arm_count(expr) {
                let body = ast_match_body(expr, i);
                if ast_is_block(body) {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_block_references_json(names, body, scope));
                } else {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_expr_references_json(names, ast_expr_handle(body), scope));
                }
                i = i + 1;
            }
        }
        return result + "]";
    }

    fn symbol_table_stmt_references_json(names: Vec<str>, stmt: Vec<i64>, scope: str) -> str {
        let result = "[";
        let kind = ast_kind(stmt);
        if kind == NODE_LET {
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_json(names, ast_let_type_node(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_let_init(stmt), scope));
        } else if kind == NODE_RETURN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_return_expr(stmt), scope));
        } else if kind == NODE_IF {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_if_cond(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_if_then(stmt), scope));
            let else_block = ast_if_else(stmt);
            if ast_optional_is_some(else_block) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_block_references_json(names, ast_optional_node(else_block), scope));
            }
        } else if kind == NODE_WHILE {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_while_cond(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_while_body(stmt), scope));
        } else if kind == NODE_FOR {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_for_start(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_for_end(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_for_body(stmt), scope));
        } else if kind == NODE_LOOP {
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_loop_body(stmt), scope));
        } else if kind == NODE_ASSIGN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_assign_target(stmt)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_assign_value(stmt)), scope));
        } else if kind == NODE_EXPR_STMT {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_handle(ast_expr_stmt_expr(stmt)), scope));
        }
        return result + "]";
    }

    fn symbol_table_block_references_json(names: Vec<str>, block: Vec<i64>, scope: str) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_stmt_references_json(names, ast_block_stmt(block, i), scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn symbol_table_item_references_json(kernel: Vec<i64>, item: Vec<i64>, kernel_scope: str) -> str {
        let names = ast_kernel_names(kernel);
        let result = "[";
        if ast_is_fn_item(item) {
            let fn_name = ast_report_name(names, ast_fn_name_idx(item));
            let fn_scope = "function:" + fn_name;
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_json(names, ast_fn_return_type(item), fn_scope));
            let i: i64 = 0;
            while i < ast_fn_param_count(item) {
                let param = ast_fn_param(item, i);
                result = symbol_table_json_array_append_items(result,
                    symbol_table_type_references_json(names, ast_type_handle(ast_param_type_node(param)), fn_scope));
                i = i + 1;
            }
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_fn_body(item), fn_scope));
        } else if ast_is_const_item(item) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_json(names, ast_const_type_node(item), kernel_scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_const_value(item), kernel_scope));
        } else if ast_is_struct_item(item) {
            let struct_scope = "struct:" + ast_report_name(names, ast_struct_name_idx(item));
            let i: i64 = 0;
            while i < ast_struct_field_count(item) {
                let field = ast_struct_field(item, i);
                result = symbol_table_json_array_append_items(result,
                    symbol_table_type_references_json(names, ast_field_decl_type_node(field), struct_scope));
                i = i + 1;
            }
        }
        return result + "]";
    }

    fn symbol_table_references_json(kernel: Vec<i64>) -> str {
        let names = ast_kernel_names(kernel);
        let kernel_scope = "kernel:" + ast_report_name(names, ast_name_idx(kernel));
        let result = "[";
        let i: i64 = 0;
        while i < ast_kernel_item_count(kernel) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_item_references_json(kernel, ast_kernel_item(kernel, i), kernel_scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn self_host_symbol_table_json(kernel: Vec<i64>) -> str {
        let comma = ",";
        let names = ast_kernel_names(kernel);
        let items = ast_kernel_items(kernel);
        return "{" +
            json_field_str("schema_version", "bunker.self_host.symbol_table.v1") + comma +
            json_field_str("representation", "bootstrap_ast_walk") + comma +
            json_field_bool("complete", false) + comma +
            json_field_bool("declarations", true) + comma +
            json_field_bool("references", true) + comma +
            json_field_str("scope_model", "bootstrap kernel/function/struct scopes paired with BUNKER_RESOLVER_JSON validation") + comma +
            json_field_str("known_limits", "Derived from AST names and paired with BUNKER_RESOLVER_JSON for bootstrap duplicate/unresolved diagnostics; imports, visibility, overloads, and related definition-use spans are not complete yet.") + comma +
            json_field_str("resolver_report", "BUNKER_RESOLVER_JSON") + comma +
            json_field_raw("summary", "{" +
                json_field_i64("interned_name_count", vec_len(names)) + comma +
                json_field_i64("function_count", ast_report_count_kind(items, NODE_FN)) + comma +
                json_field_i64("struct_count", ast_report_count_kind(items, NODE_STRUCT)) + comma +
                json_field_i64("const_count", ast_report_count_kind(items, NODE_CONST)) +
                "}") + comma +
            json_field_raw("declaration_table", symbol_table_declarations_json(kernel)) + comma +
            json_field_raw("reference_table", symbol_table_references_json(kernel)) +
            "}";
    }

    fn build_symbol_table_report_comment(kernel: Vec<i64>) -> str {
        return "/* BUNKER_SYMBOL_TABLE_JSON: " + self_host_symbol_table_json(kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }
