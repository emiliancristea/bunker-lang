    // ========================================
    // SELF-HOST SYMBOL TABLE REPORT
    // ========================================
    //
    // Produces BUNKER_SYMBOL_TABLE_JSON declaration/reference tables from typed
    // AST refs over the bootstrap layout.

    fn symbol_table_json_array_append(result: str, item: str) -> str {
        if len(result) > 1 {
            return result + "," + item;
        }
        return result + item;
    }

    fn symbol_table_json_array_append_items(result: str, items: str) -> str {
        if len(items) <= 2 {
            return result;
        }
        let inner = substring(items, 1, len(items) - 1);
        if len(result) > 1 {
            return result + "," + inner;
        }
        return result + inner;
    }

    fn symbol_table_entry_json(kind: str, name: str, scope: str, source_start: i64, source_end: i64) -> str {
        let comma = ",";
        return "{" +
            json_field_str("kind", kind) + comma +
            json_field_str("name", name) + comma +
            json_field_str("scope", scope) + comma +
            json_field_i64("source_start", source_start) + comma +
            json_field_i64("source_end", source_end) + comma +
            json_field_bool("span_known", source_start != AST_SPAN_UNKNOWN && source_end != AST_SPAN_UNKNOWN) +
            "}";
    }

    fn symbol_table_node_ref_entry_json(kind: str, name: str, scope: str, node_ref: AstNodeRef) -> str {
        return symbol_table_entry_json(kind, name, scope, ast_node_ref_span_start(node_ref), ast_node_ref_span_end(node_ref));
    }

    fn symbol_table_node_entry_json(kind: str, name: str, scope: str, node: Vec<i64>) -> str {
        return symbol_table_node_ref_entry_json(kind, name, scope, ast_node_ref_from_node(node));
    }

    fn symbol_table_pattern_ref_entry_json(kind: str, name: str, scope: str, pattern_ref: AstPatternRef) -> str {
        return symbol_table_entry_json(kind, name, scope, ast_pattern_ref_span_start(pattern_ref), ast_pattern_ref_span_end(pattern_ref));
    }

    fn symbol_table_pattern_entry_json(kind: str, name: str, scope: str, pattern: Vec<i64>) -> str {
        return symbol_table_pattern_ref_entry_json(kind, name, scope, ast_pattern_ref_from_pattern(pattern));
    }

    fn symbol_table_type_references_json(names: Vec<str>, type_node: i64, scope: str) -> str {
        let result = "[";
        if ast_optional_is_some(type_node) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_ref_json(names, ast_type_ref_from_handle(type_node), scope));
        }
        return result + "]";
    }

    fn symbol_table_type_references_ref_json(names: Vec<str>, type_ref: AstTypeRef, scope: str) -> str {
        let result = "[";
        if ast_type_ref_kind_value(type_ref) == TYPE_STRUCT {
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("type_reference",
                    ast_report_name(names, ast_type_struct_name_idx_value(ast_type_ref_handle(type_ref))),
                    scope,
                    ast_node_ref_from_handle(ast_type_ref_handle(type_ref))));
        }
        return result + "]";
    }

    fn symbol_table_pattern_declarations_json(names: Vec<str>, pattern: Vec<i64>, scope: str) -> str {
        return symbol_table_pattern_declarations_ref_json(names, ast_pattern_ref_from_pattern(pattern), scope);
    }

    fn symbol_table_pattern_declarations_ref_json(names: Vec<str>, pattern_ref: AstPatternRef, scope: str) -> str {
        let result = "[";
        let kind: i64 = ast_pattern_ref_kind(pattern_ref);
        if kind == PAT_BIND || kind == PAT_SOME {
            result = symbol_table_json_array_append(result,
                symbol_table_pattern_ref_entry_json("pattern_binding",
                    ast_report_name(names, ast_pattern_value(ast_pattern_from_ref(pattern_ref))),
                    scope,
                    pattern_ref));
        }
        return result + "]";
    }

    fn symbol_table_expr_declarations_json(names: Vec<str>, expr_value: i64, scope: str) -> str {
        let result = "[";
        if ast_optional_is_none(expr_value) {
            return result + "]";
        }
        result = symbol_table_json_array_append_items(result,
            symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(expr_value), scope));
        return result + "]";
    }

    fn symbol_table_expr_declarations_ref_json(names: Vec<str>, expr_ref: AstExprRef, scope: str) -> str {
        let result = "[";
        let expr: Vec<i64> = ast_expr_node_from_ref(expr_ref);
        let kind: i64 = ast_expr_ref_kind(expr_ref);
        if kind == NODE_MATCH {
            let patterns_ref: AstPatternListRef = ast_match_patterns_ref(expr);
            let bodies_ref: AstNodeListRef = ast_match_bodies_ref(expr);
            let i: i64 = 0;
            while i < ast_pattern_list_ref_count(patterns_ref) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_pattern_declarations_ref_json(names, ast_pattern_list_ref_get_ref(patterns_ref, i), scope));
                let body_ref: AstNodeRef = ast_node_list_ref_get_ref(bodies_ref, i);
                if ast_node_ref_kind(body_ref) == NODE_BLOCK {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_block_declarations_ref_json(names, ast_block_ref_from_handle(ast_node_ref_handle(body_ref)), scope));
                } else {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_node_ref_handle(body_ref)), scope));
                }
                i = i + 1;
            }
        } else if kind == NODE_BINARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_binary_left_handle(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_binary_right_handle(expr)), scope));
        } else if kind == NODE_UNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_unary_operand_handle(expr)), scope));
        } else if kind == NODE_CALL {
            let args_ref: AstNodeListRef = ast_call_args_ref(expr);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(args_ref) {
                let arg_ref: AstNodeRef = ast_node_list_ref_get_ref(args_ref, i);
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_node_ref_handle(arg_ref)), scope));
                i = i + 1;
            }
        } else if kind == NODE_TERNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_ternary_cond_handle(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_ternary_then_handle(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_ternary_else_handle(expr)), scope));
        } else if kind == NODE_ARRAY_LIT {
            let elements_ref: AstNodeListRef = ast_array_elements_ref(expr);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(elements_ref) {
                let element_ref: AstNodeRef = ast_node_list_ref_get_ref(elements_ref, i);
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_node_ref_handle(element_ref)), scope));
                i = i + 1;
            }
        } else if kind == NODE_INDEX {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_index_base_handle(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_index_expr_handle(expr)), scope));
        } else if kind == NODE_FIELD_ACCESS {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_field_base_handle(expr)), scope));
        } else if kind == NODE_STRUCT_LIT {
            let field_values_ref: AstNodeListRef = ast_struct_lit_field_values_ref(expr);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(field_values_ref) {
                let field_value_ref: AstNodeRef = ast_node_list_ref_get_ref(field_values_ref, i);
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_declarations_ref_json(names, ast_expr_ref_from_handle(ast_node_ref_handle(field_value_ref)), scope));
                i = i + 1;
            }
        }

        return result + "]";
    }

    fn symbol_table_stmt_declarations_json(names: Vec<str>, stmt: Vec<i64>, scope: str) -> str {
        return symbol_table_stmt_declarations_ref_json(names, ast_stmt_ref_from_node(stmt), scope);
    }

    fn symbol_table_stmt_declarations_ref_json(names: Vec<str>, stmt_ref: AstStmtRef, scope: str) -> str {
        let result = "[";
        let stmt: Vec<i64> = ast_stmt_node_from_ref(stmt_ref);
        let kind: i64 = ast_stmt_ref_kind(stmt_ref);
        if kind == NODE_LET {
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("local",
                    ast_report_name(names, ast_let_name_idx(stmt)),
                    scope,
                    ast_node_ref_from_handle(ast_stmt_ref_handle(stmt_ref))));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_let_init_handle(stmt), scope));
        } else if kind == NODE_RETURN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_return_expr_handle(stmt), scope));
        } else if kind == NODE_IF {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_if_cond_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_ref_json(names, ast_block_ref_from_node(ast_if_then(stmt)), scope));
            let else_block: i64 = ast_if_else_handle(stmt);
            if ast_optional_is_some(else_block) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_block_declarations_ref_json(names, ast_block_ref_from_handle(else_block), scope));
            }
        } else if kind == NODE_WHILE {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_while_cond_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_ref_json(names, ast_block_ref_from_node(ast_while_body(stmt)), scope));
        } else if kind == NODE_FOR {
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("for_binding",
                    ast_report_name(names, ast_for_name_idx(stmt)),
                    scope,
                    ast_node_ref_from_handle(ast_stmt_ref_handle(stmt_ref))));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_for_start_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_for_end_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_ref_json(names, ast_block_ref_from_node(ast_for_body(stmt)), scope));
        } else if kind == NODE_LOOP {
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_ref_json(names, ast_block_ref_from_node(ast_loop_body(stmt)), scope));
        } else if kind == NODE_ASSIGN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_assign_target_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_assign_value_handle(stmt), scope));
        } else if kind == NODE_EXPR_STMT {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_stmt_expr_handle(stmt), scope));
        }
        return result + "]";
    }

    fn symbol_table_block_declarations_json(names: Vec<str>, block: Vec<i64>, scope: str) -> str {
        return symbol_table_block_declarations_ref_json(names, ast_block_ref_from_node(block), scope);
    }

    fn symbol_table_block_declarations_ref_json(names: Vec<str>, block_ref: AstBlockRef, scope: str) -> str {
        let result = "[";
        let block: Vec<i64> = ast_block_node_from_ref(block_ref);
        let i: i64 = 0;
        while i < ast_block_ref_stmt_count(block_ref) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_stmt_declarations_ref_json(names, ast_stmt_ref_from_node(ast_block_stmt(block, i)), scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn symbol_table_item_declarations_json(kernel: Vec<i64>, item: Vec<i64>, kernel_scope: str) -> str {
        return symbol_table_item_declarations_ref_json(ast_node_ref_from_node(kernel), ast_item_ref_from_node(item), kernel_scope);
    }

    fn symbol_table_item_declarations_ref_json(kernel_ref: AstNodeRef, item_ref: AstItemRef, kernel_scope: str) -> str {
        let names = ast_kernel_ref_names(kernel_ref);
        let result = "[";
        let item_node_ref: AstNodeRef = ast_node_ref_from_item_ref(item_ref);
        let kind: i64 = ast_item_ref_kind(item_ref);
        if kind == NODE_FN {
            let fn_name = ast_report_name(names, ast_fn_ref_name_idx(item_ref));
            let fn_scope = "function:" + fn_name;
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("function", fn_name, kernel_scope, item_node_ref));

            let params_ref: AstNodeListRef = ast_fn_ref_params_ref(item_ref);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(params_ref) {
                let param_ref: AstNodeRef = ast_node_list_ref_get_ref(params_ref, i);
                result = symbol_table_json_array_append(result,
                    symbol_table_node_ref_entry_json("parameter",
                        ast_report_name(names, ast_param_ref_name_idx(param_ref)),
                        fn_scope,
                        param_ref));
                i = i + 1;
            }

            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_ref_json(names, ast_fn_ref_body_ref(item_ref), fn_scope));
        } else if kind == NODE_CONST {
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("constant",
                    ast_report_name(names, ast_const_ref_name_idx(item_ref)),
                    kernel_scope,
                    item_node_ref));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_const_ref_value_handle(item_ref), kernel_scope));
        } else if kind == NODE_STRUCT {
            let struct_name = ast_report_name(names, ast_struct_ref_name_idx(item_ref));
            let struct_scope = "struct:" + struct_name;
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("struct", struct_name, kernel_scope, item_node_ref));
            let fields_ref: AstNodeListRef = ast_struct_ref_fields_ref(item_ref);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(fields_ref) {
                let field_ref: AstNodeRef = ast_node_list_ref_get_ref(fields_ref, i);
                result = symbol_table_json_array_append(result,
                    symbol_table_node_ref_entry_json("field",
                        ast_report_name(names, ast_field_decl_ref_name_idx(field_ref)),
                        struct_scope,
                        field_ref));
                i = i + 1;
            }
        }
        return result + "]";
    }

    fn symbol_table_declarations_json(kernel: Vec<i64>) -> str {
        return symbol_table_declarations_ref_json(ast_node_ref_from_node(kernel));
    }

    fn symbol_table_declarations_ref_json(kernel_ref: AstNodeRef) -> str {
        let names = ast_kernel_ref_names(kernel_ref);
        let kernel_name = ast_report_name(names, ast_node_ref_name_idx(kernel_ref));
        let kernel_scope = "kernel:" + kernel_name;
        let result = "[";
        result = symbol_table_json_array_append(result,
            symbol_table_node_ref_entry_json("kernel", kernel_name, "global", kernel_ref));

        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstItemRef = ast_node_list_ref_get_item_ref(items_ref, i);
            result = symbol_table_json_array_append_items(result,
                symbol_table_item_declarations_ref_json(kernel_ref, item_ref, kernel_scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn symbol_table_expr_references_json(names: Vec<str>, expr_value: i64, scope: str) -> str {
        let result = "[";
        if ast_optional_is_none(expr_value) {
            return result + "]";
        }
        result = symbol_table_json_array_append_items(result,
            symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(expr_value), scope));
        return result + "]";
    }

    fn symbol_table_expr_references_ref_json(names: Vec<str>, expr_ref: AstExprRef, scope: str) -> str {
        let result = "[";
        let expr: Vec<i64> = ast_expr_node_from_ref(expr_ref);
        let kind: i64 = ast_expr_ref_kind(expr_ref);
        if kind == NODE_IDENT {
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("identifier",
                    ast_report_name(names, ast_name_idx(expr)),
                    scope,
                    ast_node_ref_from_handle(ast_expr_ref_handle(expr_ref))));
        } else if kind == NODE_CALL {
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("function_call",
                    ast_report_name(names, ast_call_name_idx(expr)),
                    scope,
                    ast_node_ref_from_handle(ast_expr_ref_handle(expr_ref))));
            let args_ref: AstNodeListRef = ast_call_args_ref(expr);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(args_ref) {
                let arg_ref: AstNodeRef = ast_node_list_ref_get_ref(args_ref, i);
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_node_ref_handle(arg_ref)), scope));
                i = i + 1;
            }
        } else if kind == NODE_FIELD_ACCESS {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_field_base_handle(expr)), scope));
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("field_access",
                    ast_report_name(names, ast_field_name_idx(expr)),
                    scope,
                    ast_node_ref_from_handle(ast_expr_ref_handle(expr_ref))));
        } else if kind == NODE_STRUCT_LIT {
            result = symbol_table_json_array_append(result,
                symbol_table_node_ref_entry_json("struct_literal",
                    ast_report_name(names, ast_struct_lit_name_idx(expr)),
                    scope,
                    ast_node_ref_from_handle(ast_expr_ref_handle(expr_ref))));
            let field_names_ref: AstI64ListRef = ast_struct_lit_field_names_ref(expr);
            let field_values_ref: AstNodeListRef = ast_struct_lit_field_values_ref(expr);
            let i: i64 = 0;
            while i < ast_i64_list_ref_count(field_names_ref) {
                let field_value_ref: AstNodeRef = ast_node_list_ref_get_ref(field_values_ref, i);
                result = symbol_table_json_array_append(result,
                    symbol_table_node_ref_entry_json("field_initializer",
                        ast_report_name(names, ast_i64_list_ref_get(field_names_ref, i)),
                        scope,
                        ast_node_ref_from_handle(ast_expr_ref_handle(expr_ref))));
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_node_ref_handle(field_value_ref)), scope));
                i = i + 1;
            }
        } else if kind == NODE_BINARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_binary_left_handle(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_binary_right_handle(expr)), scope));
        } else if kind == NODE_UNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_unary_operand_handle(expr)), scope));
        } else if kind == NODE_TERNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_ternary_cond_handle(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_ternary_then_handle(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_ternary_else_handle(expr)), scope));
        } else if kind == NODE_ARRAY_LIT {
            let elements_ref: AstNodeListRef = ast_array_elements_ref(expr);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(elements_ref) {
                let element_ref: AstNodeRef = ast_node_list_ref_get_ref(elements_ref, i);
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_node_ref_handle(element_ref)), scope));
                i = i + 1;
            }
        } else if kind == NODE_INDEX {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_index_base_handle(expr)), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_index_expr_handle(expr)), scope));
        } else if kind == NODE_MATCH {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_match_scrutinee_handle(expr)), scope));
            let bodies_ref: AstNodeListRef = ast_match_bodies_ref(expr);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(bodies_ref) {
                let body_ref: AstNodeRef = ast_node_list_ref_get_ref(bodies_ref, i);
                if ast_node_ref_kind(body_ref) == NODE_BLOCK {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_block_references_ref_json(names, ast_block_ref_from_handle(ast_node_ref_handle(body_ref)), scope));
                } else {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_expr_references_ref_json(names, ast_expr_ref_from_handle(ast_node_ref_handle(body_ref)), scope));
                }
                i = i + 1;
            }
        }
        return result + "]";
    }

    fn symbol_table_stmt_references_json(names: Vec<str>, stmt: Vec<i64>, scope: str) -> str {
        return symbol_table_stmt_references_ref_json(names, ast_stmt_ref_from_node(stmt), scope);
    }

    fn symbol_table_stmt_references_ref_json(names: Vec<str>, stmt_ref: AstStmtRef, scope: str) -> str {
        let result = "[";
        let stmt: Vec<i64> = ast_stmt_node_from_ref(stmt_ref);
        let kind: i64 = ast_stmt_ref_kind(stmt_ref);
        if kind == NODE_LET {
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_json(names, ast_let_type_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_let_init_handle(stmt), scope));
        } else if kind == NODE_RETURN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_return_expr_handle(stmt), scope));
        } else if kind == NODE_IF {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_if_cond_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_ref_json(names, ast_block_ref_from_node(ast_if_then(stmt)), scope));
            let else_block: i64 = ast_if_else_handle(stmt);
            if ast_optional_is_some(else_block) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_block_references_ref_json(names, ast_block_ref_from_handle(else_block), scope));
            }
        } else if kind == NODE_WHILE {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_while_cond_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_ref_json(names, ast_block_ref_from_node(ast_while_body(stmt)), scope));
        } else if kind == NODE_FOR {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_for_start_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_for_end_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_ref_json(names, ast_block_ref_from_node(ast_for_body(stmt)), scope));
        } else if kind == NODE_LOOP {
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_ref_json(names, ast_block_ref_from_node(ast_loop_body(stmt)), scope));
        } else if kind == NODE_ASSIGN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_assign_target_handle(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_assign_value_handle(stmt), scope));
        } else if kind == NODE_EXPR_STMT {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_stmt_expr_handle(stmt), scope));
        }
        return result + "]";
    }

    fn symbol_table_block_references_json(names: Vec<str>, block: Vec<i64>, scope: str) -> str {
        return symbol_table_block_references_ref_json(names, ast_block_ref_from_node(block), scope);
    }

    fn symbol_table_block_references_ref_json(names: Vec<str>, block_ref: AstBlockRef, scope: str) -> str {
        let result = "[";
        let block: Vec<i64> = ast_block_node_from_ref(block_ref);
        let i: i64 = 0;
        while i < ast_block_ref_stmt_count(block_ref) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_stmt_references_ref_json(names, ast_stmt_ref_from_node(ast_block_stmt(block, i)), scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn symbol_table_item_references_json(kernel: Vec<i64>, item: Vec<i64>, kernel_scope: str) -> str {
        return symbol_table_item_references_ref_json(ast_node_ref_from_node(kernel), ast_item_ref_from_node(item), kernel_scope);
    }

    fn symbol_table_item_references_ref_json(kernel_ref: AstNodeRef, item_ref: AstItemRef, kernel_scope: str) -> str {
        let names = ast_kernel_ref_names(kernel_ref);
        let result = "[";
        let kind: i64 = ast_item_ref_kind(item_ref);
        if kind == NODE_FN {
            let fn_name = ast_report_name(names, ast_fn_ref_name_idx(item_ref));
            let fn_scope = "function:" + fn_name;
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_json(names, ast_fn_ref_return_type_handle(item_ref), fn_scope));
            let params_ref: AstNodeListRef = ast_fn_ref_params_ref(item_ref);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(params_ref) {
                let param_ref: AstNodeRef = ast_node_list_ref_get_ref(params_ref, i);
                result = symbol_table_json_array_append_items(result,
                    symbol_table_type_references_json(names, ast_param_ref_type_handle(param_ref), fn_scope));
                i = i + 1;
            }
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_ref_json(names, ast_fn_ref_body_ref(item_ref), fn_scope));
        } else if kind == NODE_CONST {
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_json(names, ast_const_ref_type_handle(item_ref), kernel_scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_const_ref_value_handle(item_ref), kernel_scope));
        } else if kind == NODE_STRUCT {
            let struct_scope = "struct:" + ast_report_name(names, ast_struct_ref_name_idx(item_ref));
            let fields_ref: AstNodeListRef = ast_struct_ref_fields_ref(item_ref);
            let i: i64 = 0;
            while i < ast_node_list_ref_count(fields_ref) {
                let field_ref: AstNodeRef = ast_node_list_ref_get_ref(fields_ref, i);
                result = symbol_table_json_array_append_items(result,
                    symbol_table_type_references_json(names, ast_field_decl_ref_type_handle(field_ref), struct_scope));
                i = i + 1;
            }
        }
        return result + "]";
    }

    fn symbol_table_references_json(kernel: Vec<i64>) -> str {
        return symbol_table_references_ref_json(ast_node_ref_from_node(kernel));
    }

    fn symbol_table_references_ref_json(kernel_ref: AstNodeRef) -> str {
        let names = ast_kernel_ref_names(kernel_ref);
        let kernel_scope = "kernel:" + ast_report_name(names, ast_node_ref_name_idx(kernel_ref));
        let result = "[";
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstItemRef = ast_node_list_ref_get_item_ref(items_ref, i);
            result = symbol_table_json_array_append_items(result,
                symbol_table_item_references_ref_json(kernel_ref, item_ref, kernel_scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn self_host_symbol_table_json(kernel: Vec<i64>) -> str {
        let comma = ",";
        let kernel_ref: AstNodeRef = ast_node_ref_from_node(kernel);
        let names = ast_kernel_ref_names(kernel_ref);
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        return "{" +
            json_field_str("schema_version", "bunker.self_host.symbol_table.v1") + comma +
            json_field_str("representation", "bootstrap_ast_walk") + comma +
            json_field_bool("complete", false) + comma +
            json_field_bool("declarations", true) + comma +
            json_field_bool("references", true) + comma +
            json_field_str("scope_model", "bootstrap kernel/function/struct scopes paired with BUNKER_RESOLVER_JSON validation") + comma +
            json_field_str("known_limits", "Derived from AST names and paired with BUNKER_RESOLVER_JSON for bootstrap duplicate/unresolved diagnostics; imports, visibility, overloads, and related definition-use spans are not complete yet.") + comma +
            json_field_str("resolver_report", "BUNKER_RESOLVER_JSON") + comma +
            json_field_raw("summary", "{" +
                json_field_i64("interned_name_count", vec_len(names)) + comma +
                json_field_i64("function_count", ast_report_count_kind_ref(items_ref, NODE_FN)) + comma +
                json_field_i64("struct_count", ast_report_count_kind_ref(items_ref, NODE_STRUCT)) + comma +
                json_field_i64("const_count", ast_report_count_kind_ref(items_ref, NODE_CONST)) +
                "}") + comma +
            json_field_raw("declaration_table", symbol_table_declarations_ref_json(kernel_ref)) + comma +
            json_field_raw("reference_table", symbol_table_references_ref_json(kernel_ref)) +
            "}";
    }

    fn build_symbol_table_report_comment(kernel: Vec<i64>) -> str {
        return "/* BUNKER_SYMBOL_TABLE_JSON: " + self_host_symbol_table_json(kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }
