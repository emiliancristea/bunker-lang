    // ========================================
    // COMPILER DRIVER
    // ========================================

    fn is_import_line(line: str) -> bool {
        let trimmed_line = trim(line);
        let n = len(trimmed_line);
        if n < 11 { return false; }
        if !starts_with(trimmed_line, "import ") { return false; }
        if char_code_at(trimmed_line, 7) != 34 { return false; }
        if char_code_at(trimmed_line, n - 2) != 34 { return false; }
        if char_code_at(trimmed_line, n - 1) != 59 { return false; }
        return true;
    }

    fn import_path_from_line(line: str) -> str {
        let trimmed_line = trim(line);
        return substring(trimmed_line, 8, len(trimmed_line) - 2);
    }

    fn import_path_has_backslash(import_path: str) -> bool {
        let i: i64 = 0;
        while i < len(import_path) {
            if char_code_at(import_path, i) == 92 {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn import_path_is_absolute(import_path: str) -> bool {
        if len(import_path) <= 0 { return false; }
        if char_code_at(import_path, 0) == 47 { return true; }
        if char_code_at(import_path, 0) == 92 { return true; }
        if len(import_path) >= 2 && char_code_at(import_path, 1) == 58 { return true; }
        return false;
    }

    fn import_path_has_parent_segment(import_path: str) -> bool {
        if import_path == ".." { return true; }
        if starts_with(import_path, "../") { return true; }
        if ends_with(import_path, "/..") { return true; }
        if contains(import_path, "/../") { return true; }
        return false;
    }

    fn import_path_has_empty_segment(import_path: str) -> bool {
        if starts_with(import_path, "./") { return true; }
        if ends_with(import_path, "/") { return true; }
        if contains(import_path, "//") { return true; }
        return false;
    }

    fn import_path_is_valid(import_path: str) -> bool {
        if len(import_path) <= 0 { return false; }
        if import_path_is_absolute(import_path) { return false; }
        if import_path_has_backslash(import_path) { return false; }
        if contains(import_path, ":") { return false; }
        if import_path_has_parent_segment(import_path) { return false; }
        if import_path_has_empty_segment(import_path) { return false; }
        return true;
    }

    fn resolve_import_path(base_dir: str, import_path: str) -> str {
        if len(base_dir) <= 0 {
            return import_path;
        }
        return base_dir + "/" + import_path;
    }

    fn import_path_dir(resolved_path: str) -> str {
        let last_slash: i64 = -1;
        let i: i64 = 0;
        while i < len(resolved_path) {
            if char_code_at(resolved_path, i) == 47 {
                last_slash = i;
            }
            i = i + 1;
        }
        if last_slash < 0 {
            return "";
        }
        return substring(resolved_path, 0, last_slash);
    }

    fn import_seen_contains(seen: Vec<str>, import_path: str) -> bool {
        let i: i64 = 0;
        while i < vec_len(seen) {
            if vec_get(seen, i) == import_path {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn append_expanded_line_with_seen(output: str, line: str, seen: Vec<str>, base_dir: str) -> str {
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !import_path_is_valid(import_path) {
                return output + "// Invalid import path: " + import_path + from_char_code(10);
            }
            let resolved_path = resolve_import_path(base_dir, import_path);
            if !file_exists(resolved_path) {
                return output + "// Missing import: " + resolved_path + from_char_code(10);
            }
            if import_seen_contains(seen, resolved_path) {
                return output;
            }
            vec_push(seen, resolved_path);
            let imported = read_file(resolved_path);
            let expanded_import = expand_imports_with_seen(imported, seen, import_path_dir(resolved_path));
            let result = output + expanded_import;
            if len(result) > 0 && char_code_at(result, len(result) - 1) != 10 {
                result = result + from_char_code(10);
            }
            return result;
        }
        return output + line + from_char_code(10);
    }

    fn expand_imports_with_seen(source: str, seen: Vec<str>, base_dir: str) -> str {
        let output = "";
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                output = append_expanded_line_with_seen(output, substring(source, start, pos), seen, base_dir);
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            output = append_expanded_line_with_seen(output, substring(source, start, source_len), seen, base_dir);
        }

        return output;
    }

    fn expand_imports(source: str) -> str {
        return expand_imports_from_base(source, "");
    }

    fn expand_imports_from_base(source: str, base_dir: str) -> str {
        let seen: Vec<str> = vec_new();
        return expand_imports_with_seen(source, seen, base_dir);
    }

    fn missing_import_in_line_with_seen(line: str, seen: Vec<str>, base_dir: str) -> str {
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !import_path_is_valid(import_path) {
                return "";
            }
            let resolved_path = resolve_import_path(base_dir, import_path);
            if !file_exists(resolved_path) {
                return resolved_path;
            }
            if import_seen_contains(seen, resolved_path) {
                return "";
            }
            vec_push(seen, resolved_path);
            return first_missing_import_path_with_seen(read_file(resolved_path), seen, import_path_dir(resolved_path));
        }
        return "";
    }

    fn first_missing_import_path_with_seen(source: str, seen: Vec<str>, base_dir: str) -> str {
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                let missing = missing_import_in_line_with_seen(substring(source, start, pos), seen, base_dir);
                if len(missing) > 0 {
                    return missing;
                }
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            return missing_import_in_line_with_seen(substring(source, start, source_len), seen, base_dir);
        }

        return "";
    }

    fn first_missing_import_path(source: str) -> str {
        return first_missing_import_path_from_base(source, "");
    }

    fn first_missing_import_path_from_base(source: str, base_dir: str) -> str {
        let seen: Vec<str> = vec_new();
        return first_missing_import_path_with_seen(source, seen, base_dir);
    }

    fn invalid_import_in_line_with_seen(line: str, seen: Vec<str>, base_dir: str) -> str {
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !import_path_is_valid(import_path) {
                return import_path;
            }
            let resolved_path = resolve_import_path(base_dir, import_path);
            if !file_exists(resolved_path) {
                return "";
            }
            if import_seen_contains(seen, resolved_path) {
                return "";
            }
            vec_push(seen, resolved_path);
            return first_invalid_import_path_with_seen(read_file(resolved_path), seen, import_path_dir(resolved_path));
        }
        return "";
    }

    fn first_invalid_import_path_with_seen(source: str, seen: Vec<str>, base_dir: str) -> str {
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                let invalid = invalid_import_in_line_with_seen(substring(source, start, pos), seen, base_dir);
                if len(invalid) > 0 {
                    return invalid;
                }
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            return invalid_import_in_line_with_seen(substring(source, start, source_len), seen, base_dir);
        }

        return "";
    }

    fn first_invalid_import_path(source: str) -> str {
        return first_invalid_import_path_from_base(source, "");
    }

    fn first_invalid_import_path_from_base(source: str, base_dir: str) -> str {
        let seen: Vec<str> = vec_new();
        return first_invalid_import_path_with_seen(source, seen, base_dir);
    }

    fn import_count_in_line_with_seen(line: str, seen: Vec<str>, base_dir: str) -> i64 {
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !import_path_is_valid(import_path) {
                return 0;
            }
            let resolved_path = resolve_import_path(base_dir, import_path);
            if !file_exists(resolved_path) {
                return 0;
            }
            if import_seen_contains(seen, resolved_path) {
                return 0;
            }
            vec_push(seen, resolved_path);
            return 1 + import_count_with_seen(read_file(resolved_path), seen, import_path_dir(resolved_path));
        }
        return 0;
    }

    fn import_count_with_seen(source: str, seen: Vec<str>, base_dir: str) -> i64 {
        let count: i64 = 0;
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                count = count + import_count_in_line_with_seen(substring(source, start, pos), seen, base_dir);
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            count = count + import_count_in_line_with_seen(substring(source, start, source_len), seen, base_dir);
        }

        return count;
    }

    fn unique_import_count(source: str) -> i64 {
        return unique_import_count_from_base(source, "");
    }

    fn unique_import_count_from_base(source: str, base_dir: str) -> i64 {
        let seen: Vec<str> = vec_new();
        return import_count_with_seen(source, seen, base_dir);
    }

    fn import_graph_json_array_append(result: str, item: str) -> str {
        if len(result) > 1 {
            return result + "," + item;
        }
        return result + item;
    }

    fn import_graph_json_array_append_items(result: str, items: str) -> str {
        if len(items) <= 2 {
            return result;
        }
        let inner = substring(items, 1, len(items) - 1);
        if len(result) > 1 {
            return result + "," + inner;
        }
        return result + inner;
    }

    fn import_paths_json_in_line_with_seen(line: str, seen: Vec<str>, base_dir: str) -> str {
        let result = "[";
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !import_path_is_valid(import_path) {
                return result + "]";
            }
            let resolved_path = resolve_import_path(base_dir, import_path);
            if !file_exists(resolved_path) {
                return result + "]";
            }
            if import_seen_contains(seen, resolved_path) {
                return result + "]";
            }
            vec_push(seen, resolved_path);
            result = import_graph_json_array_append(result, json_escape_string(resolved_path));
            result = import_graph_json_array_append_items(result, import_paths_json_with_seen(read_file(resolved_path), seen, import_path_dir(resolved_path)));
        }
        return result + "]";
    }

    fn import_paths_json_with_seen(source: str, seen: Vec<str>, base_dir: str) -> str {
        let result = "[";
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                result = import_graph_json_array_append_items(result, import_paths_json_in_line_with_seen(substring(source, start, pos), seen, base_dir));
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            result = import_graph_json_array_append_items(result, import_paths_json_in_line_with_seen(substring(source, start, source_len), seen, base_dir));
        }

        return result + "]";
    }

    fn unique_import_paths_json(source: str) -> str {
        return unique_import_paths_json_from_base(source, "");
    }

    fn unique_import_paths_json_from_base(source: str, base_dir: str) -> str {
        let seen: Vec<str> = vec_new();
        return import_paths_json_with_seen(source, seen, base_dir);
    }

    fn import_edge_json(from_base: str, requested: str, resolved: str, status: str) -> str {
        let comma = ",";
        return "{" +
            json_field_str("from_base", from_base) + comma +
            json_field_str("requested", requested) + comma +
            json_field_str("resolved", resolved) + comma +
            json_field_str("status", status) +
            "}";
    }

    fn import_edges_json_in_line_with_seen(line: str, seen: Vec<str>, base_dir: str) -> str {
        let result = "[";
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !import_path_is_valid(import_path) {
                return import_graph_json_array_append(result,
                    import_edge_json(base_dir, import_path, "", "invalid")) + "]";
            }
            let resolved_path = resolve_import_path(base_dir, import_path);
            if !file_exists(resolved_path) {
                return import_graph_json_array_append(result,
                    import_edge_json(base_dir, import_path, resolved_path, "missing")) + "]";
            }
            if import_seen_contains(seen, resolved_path) {
                return import_graph_json_array_append(result,
                    import_edge_json(base_dir, import_path, resolved_path, "duplicate")) + "]";
            }
            vec_push(seen, resolved_path);
            result = import_graph_json_array_append(result,
                import_edge_json(base_dir, import_path, resolved_path, "ok"));
            result = import_graph_json_array_append_items(result,
                import_edges_json_with_seen(read_file(resolved_path), seen, import_path_dir(resolved_path)));
        }
        return result + "]";
    }

    fn import_edges_json_with_seen(source: str, seen: Vec<str>, base_dir: str) -> str {
        let result = "[";
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                result = import_graph_json_array_append_items(result,
                    import_edges_json_in_line_with_seen(substring(source, start, pos), seen, base_dir));
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            result = import_graph_json_array_append_items(result,
                import_edges_json_in_line_with_seen(substring(source, start, source_len), seen, base_dir));
        }

        return result + "]";
    }

    fn import_edges_json_from_base(source: str, base_dir: str) -> str {
        let seen: Vec<str> = vec_new();
        return import_edges_json_with_seen(source, seen, base_dir);
    }

    fn import_edge_status_count_in_json(edges_json: str, status: str) -> i64 {
        let quote = from_char_code(34);
        let needle = quote + "status" + quote + ":" + json_escape_string(status);
        let count: i64 = 0;
        let i: i64 = 0;
        while i + len(needle) <= len(edges_json) {
            if substring(edges_json, i, i + len(needle)) == needle {
                count = count + 1;
                i = i + len(needle);
            } else {
                i = i + 1;
            }
        }
        return count;
    }

    fn import_edge_status_count_from_base(source: str, base_dir: str, status: str) -> i64 {
        return import_edge_status_count_in_json(import_edges_json_from_base(source, base_dir), status);
    }

    fn import_edge_count_from_base(source: str, base_dir: str) -> i64 {
        return import_edge_status_count_from_base(source, base_dir, "ok") +
            import_edge_status_count_from_base(source, base_dir, "missing") +
            import_edge_status_count_from_base(source, base_dir, "invalid") +
            import_edge_status_count_from_base(source, base_dir, "duplicate");
    }

    fn source_line_at(source: str, offset: i64) -> i64 {
        let line: i64 = 1;
        let i: i64 = 0;
        let source_len = len(source);
        while i < offset && i < source_len {
            if char_code_at(source, i) == 10 {
                line = line + 1;
            }
            i = i + 1;
        }
        return line;
    }

    fn source_column_at(source: str, offset: i64) -> i64 {
        let column: i64 = 1;
        let i: i64 = 0;
        let source_len = len(source);
        while i < offset && i < source_len {
            if char_code_at(source, i) == 10 {
                column = 1;
            } else {
                column = column + 1;
            }
            i = i + 1;
        }
        return column;
    }

    fn source_line_excerpt_at(source: str, offset: i64) -> str {
        let source_len = len(source);
        if source_len <= 0 {
            return "";
        }

        let safe_offset = offset;
        if safe_offset < 0 {
            safe_offset = 0;
        }
        if safe_offset >= source_len {
            safe_offset = source_len - 1;
        }

        let start = safe_offset;
        while start > 0 && char_code_at(source, start - 1) != 10 {
            start = start - 1;
        }

        let end = safe_offset;
        while end < source_len && char_code_at(source, end) != 10 {
            end = end + 1;
        }

        return substring(source, start, end);
    }

    fn self_host_diagnostic_json(category: str, code: str, message: str,
                                 source_start: i64, source_end: i64,
                                 source_line: i64, source_column: i64,
                                 source_excerpt: str,
                                 expected: str, actual: str, repair_hint: str) -> str {
        let comma = ",";
        return "{" +
            json_field_str("schema_version", "bunker.self_host.diagnostic.v1") + comma +
            json_field_str("category", category) + comma +
            json_field_str("error_code", code) + comma +
            json_field_str("message", message) + comma +
            json_field_i64("source_start", source_start) + comma +
            json_field_i64("source_end", source_end) + comma +
            json_field_i64("source_line", source_line) + comma +
            json_field_i64("source_column", source_column) + comma +
            json_field_str("source_excerpt", source_excerpt) + comma +
            json_field_str("expected", expected) + comma +
            json_field_str("actual", actual) + comma +
            json_field_str("suggested_action", repair_hint) + comma +
            json_field_str("fix_applicability", "manual_review") + comma +
            json_field_str("fix_confidence", "medium") + comma +
            json_field_str("repair_hint", repair_hint) +
            "}";
    }

    fn self_host_capability_json() -> str {
        let comma = ",";
        return "{" +
            json_field_str("schema_version", "bunker.self_host.capability.v1") + comma +
            json_field_str("compiler", "bkrc-self-host-bootstrap") + comma +
            json_field_bool("source_byte_spans", true) + comma +
            json_field_bool("source_excerpts", true) + comma +
            json_field_bool("structured_repair_metadata", true) + comma +
            json_field_bool("structured_parse_diagnostics", true) + comma +
            json_field_bool("import_expansion", true) + comma +
            json_field_bool("import_graph_report", true) + comma +
            json_field_bool("stage1_stage2_ci_gate", true) + comma +
            json_field_bool("type_graph_report", true) + comma +
            json_field_bool("symbol_table_report", true) + comma +
            json_field_bool("name_resolver_report", true) + comma +
            json_field_bool("typecheck_report", true) + comma +
            json_field_bool("typed_ast", false) + comma +
            json_field_bool("real_module_resolver", false) + comma +
            json_field_bool("real_generics", false) + comma +
            json_field_bool("user_defined_adts", false) + comma +
            json_field_bool("multi_error_recovery", false) + comma +
            json_field_str("supported_constructs", "kernel, struct, fn, const, let, fixed arrays, field access, if, else, match, Option via Some and None, Result via result_* builtins, Vec handles, HashMap handles, for ranges, while, loop, break, continue, return, primitive types, calls, casts, ternary, bitwise operators, string literals, float literals") + comma +
            json_field_str("known_limits", "bootstrap raw Vec AST, byte spans only, no file span table, bootstrap string-path import graph with import path policy and importer-directory resolution but no filesystem canonicalization or visibility, bootstrap name resolver and typecheck reports only, no full Bunker typechecker, no real generics, no user-defined ADTs, no parser multi-error recovery") + comma +
            json_field_str("agent_guidance", "Use BUNKER_DIAGNOSTIC_JSON for repair tasks. Treat BUNKER_CAPABILITY_JSON as the current compiler surface before generating Bunker code.") +
            "}";
    }

    fn build_capability_report_comment() -> str {
        return "/* BUNKER_CAPABILITY_JSON: " + self_host_capability_json() + from_char_code(10) +
            "*/" + from_char_code(10);
    }

    fn self_host_import_graph_json(source: str) -> str {
        return self_host_import_graph_json_with_base_dir(source, "");
    }

    fn self_host_import_graph_json_with_base_dir(source: str, base_dir: str) -> str {
        let comma = ",";
        let invalid_import = first_invalid_import_path_from_base(source, base_dir);
        let missing_import = first_missing_import_path_from_base(source, base_dir);
        return "{" +
            json_field_str("schema_version", "bunker.self_host.import_graph.v1") + comma +
            json_field_str("root_base_dir", base_dir) + comma +
            json_field_str("path_policy", "normalized_relative_forward_slash") + comma +
            json_field_bool("base_directory_resolution", true) + comma +
            json_field_bool("recursive_expansion", true) + comma +
            json_field_bool("duplicate_suppression", true) + comma +
            json_field_i64("unique_import_count", unique_import_count_from_base(source, base_dir)) + comma +
            json_field_i64("edge_count", import_edge_count_from_base(source, base_dir)) + comma +
            json_field_i64("ok_edge_count", import_edge_status_count_from_base(source, base_dir, "ok")) + comma +
            json_field_i64("missing_edge_count", import_edge_status_count_from_base(source, base_dir, "missing")) + comma +
            json_field_i64("invalid_edge_count", import_edge_status_count_from_base(source, base_dir, "invalid")) + comma +
            json_field_i64("duplicate_edge_count", import_edge_status_count_from_base(source, base_dir, "duplicate")) + comma +
            json_field_raw("imports", unique_import_paths_json_from_base(source, base_dir)) + comma +
            json_field_raw("edges", import_edges_json_from_base(source, base_dir)) + comma +
            json_field_bool("has_invalid_import", len(invalid_import) > 0) + comma +
            json_field_str("invalid_import", invalid_import) + comma +
            json_field_bool("has_missing_import", len(missing_import) > 0) + comma +
            json_field_str("missing_import", missing_import) +
            "}";
    }

    fn build_import_graph_report_comment(source: str) -> str {
        return build_import_graph_report_comment_with_base_dir(source, "");
    }

    fn build_import_graph_report_comment_with_base_dir(source: str, base_dir: str) -> str {
        return "/* BUNKER_IMPORT_GRAPH_JSON: " + self_host_import_graph_json_with_base_dir(source, base_dir) + from_char_code(10) +
            "*/" + from_char_code(10);
    }

    fn build_import_path_diagnostic(invalid_import: str) -> str {
        let repair_hint = "Use a normalized relative import path such as modules/example.bkr. Do not use empty paths, absolute paths, drive prefixes, backslashes, parent traversal, leading ./, trailing /, or // segments.";
        let message = "Import error: invalid import path " + invalid_import;
        let json = self_host_diagnostic_json("import", "BKR_SELF_IMPORT_PATH", message,
            0, 0, 1, 1, "", "normalized relative forward-slash import path", invalid_import, repair_hint);
        return "/* " + message + ". AI repair hint: " + repair_hint + from_char_code(10) +
            "BUNKER_DIAGNOSTIC_JSON: " + json + from_char_code(10) +
            "*/";
    }

    fn build_import_diagnostic(missing_import: str) -> str {
        let repair_hint = "Copy the imported Bunker module next to self_host_input.bkr or pre-expand imports before running bkrc.";
        let message = "Import error: missing module " + missing_import;
        let json = self_host_diagnostic_json("import", "BKR_SELF_IMPORT", message,
            0, 0, 1, 1, "", "existing imported module", missing_import, repair_hint);
        return "/* " + message + ". AI repair hint: " + repair_hint + from_char_code(10) +
            "BUNKER_DIAGNOSTIC_JSON: " + json + from_char_code(10) +
            "*/";
    }

    fn build_parse_diagnostic(source: str, p: ParserStateRef) -> str {
        let expected = token_name(parser_error_expected_ref(p));
        let actual = token_name(parser_error_actual_ref(p));
        let error_span = parser_error_span_ref(p);
        let source_start = ast_span_start(error_span);
        let source_end = ast_span_end(error_span);
        let source_line = source_line_at(source, source_start);
        let source_column = source_column_at(source, source_start);
        let source_excerpt = source_line_excerpt_at(source, source_start);
        let repair_hint = "Inspect the construct before this token. Supported bootstrap syntax includes kernel, struct, fn, const, let, fixed arrays, field access, if, else, match expressions, Option<T> via Some/None, Result<T,E> via result_* builtins, Vec<T> and HashMap<i32,V> runtime handles, for-in ranges, while, loop, break, continue, return, primitive types, calls, casts, ternary expressions, bitwise operators, and basic expressions.";
        let message = "Parse error at token " + int_to_string(parser_error_position_ref(p)) +
            ": expected " + expected + ", got " + actual;
        let json = self_host_diagnostic_json("parse", "BKR_SELF_PARSE", message,
            source_start, source_end, source_line, source_column, source_excerpt, expected, actual, repair_hint);
        return "/* " + message + ". AI repair hint: " + repair_hint + from_char_code(10) +
            "BUNKER_DIAGNOSTIC_JSON: " + json + from_char_code(10) +
            "*/";
    }

    fn self_host_trace_enabled() -> bool {
        return file_exists("self_host_trace.enabled");
    }

    fn self_host_trace_phase(phase: str) -> i64 {
        if self_host_trace_enabled() {
            let trace_path = "self_host_trace.log";
            let existing = "";
            if file_exists(trace_path) {
                existing = read_file(trace_path);
            }
            write_file(trace_path, existing + "[self-host trace] " + phase + from_char_code(10));
        }
        return 0;
    }

    fn compile_to_c(source: str) -> str {
        return compile_to_c_with_base_dir(source, "");
    }

    fn compile_to_c_with_base_dir(source: str, root_base_dir: str) -> str {
        self_host_trace_phase("compile_to_c:begin");
        let capability_report = build_capability_report_comment();
        self_host_trace_phase("compile_to_c:capability_report");
        let import_graph_report = build_import_graph_report_comment_with_base_dir(source, root_base_dir);
        self_host_trace_phase("compile_to_c:import_graph_report");
        let invalid_import = first_invalid_import_path_from_base(source, root_base_dir);
        if len(invalid_import) > 0 {
            self_host_trace_phase("compile_to_c:invalid_import");
            return capability_report + import_graph_report + build_import_path_diagnostic(invalid_import) + from_char_code(10);
        }
        let missing_import = first_missing_import_path_from_base(source, root_base_dir);
        if len(missing_import) > 0 {
            self_host_trace_phase("compile_to_c:missing_import");
            return capability_report + import_graph_report + build_import_diagnostic(missing_import) + from_char_code(10);
        }

        let expanded_source = expand_imports_from_base(source, root_base_dir);
        self_host_trace_phase("compile_to_c:imports_expanded");
        let lex_result: LexerResultRef = tokenize_ref(expanded_source);
        self_host_trace_phase("compile_to_c:tokenized");
        let p: ParserStateRef = parser_new_ref(lex_result);
        self_host_trace_phase("compile_to_c:parser_state");
        let ast: Vec<i64> = parse_kernel_ref(p);
        self_host_trace_phase("compile_to_c:parsed");

        if parser_has_error_ref(p) {
            self_host_trace_phase("compile_to_c:parse_error");
            return capability_report + import_graph_report + build_parse_diagnostic(expanded_source, p) + from_char_code(10);
        }

        let ast_report = build_ast_report_comment(expanded_source, ast);
        self_host_trace_phase("compile_to_c:ast_report");
        let type_graph_report = build_type_graph_report_comment(ast);
        self_host_trace_phase("compile_to_c:type_graph_report");
        let symbol_table_report = build_symbol_table_report_comment(ast);
        self_host_trace_phase("compile_to_c:symbol_table_report");
        let resolver_report = build_resolver_report_comment(ast);
        self_host_trace_phase("compile_to_c:resolver_report");
        let typecheck_report = build_typecheck_report_comment(ast);
        self_host_trace_phase("compile_to_c:typecheck_report");
        let c_program = gen_c_program(ast);
        self_host_trace_phase("compile_to_c:c_program");

        return capability_report + import_graph_report + ast_report +
            type_graph_report +
            symbol_table_report +
            resolver_report +
            typecheck_report +
            c_program;
    }

    fn main() -> i32 {
        // File-based entrypoint for agents and the Rust wrapper:
        // write self_host_input.bkr, run this program, read self_host_output.c.
        let input_path = "self_host_input.bkr";
        let output_path = "self_host_output.c";

        let default_source = "kernel Test { fn main() -> i32 { let x: i32 = 40; let y: i32 = 2; return x + y; } }";
        if !file_exists(input_path) {
            write_file(input_path, default_source);
        }

        let source = read_file(input_path);
        let c_code = compile_to_c_with_base_dir(source, import_path_dir(input_path));
        let wrote = write_file(output_path, c_code);
        if !wrote {
            return 1;
        }

        if !file_exists(output_path) {
            return 2;
        }

        return 42;
    }
