    // ========================================
    // COMPILER DRIVER
    // ========================================

    fn is_import_line(line: str) -> bool {
        let trimmed_line = trim(line);
        let n = len(trimmed_line);
        if n < 11 { return false; }
        if !starts_with(trimmed_line, "import ") { return false; }
        if char_code_at(trimmed_line, 7) != 34 { return false; }
        if char_code_at(trimmed_line, n - 2) != 34 { return false; }
        if char_code_at(trimmed_line, n - 1) != 59 { return false; }
        return true;
    }

    fn import_path_from_line(line: str) -> str {
        let trimmed_line = trim(line);
        return substring(trimmed_line, 8, len(trimmed_line) - 2);
    }

    fn append_expanded_line(output: str, line: str) -> str {
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !file_exists(import_path) {
                return output + "// Missing import: " + import_path + from_char_code(10);
            }
            let imported = read_file(import_path);
            let result = output + imported;
            if len(result) > 0 && char_code_at(result, len(result) - 1) != 10 {
                result = result + from_char_code(10);
            }
            return result;
        }
        return output + line + from_char_code(10);
    }

    fn expand_imports(source: str) -> str {
        let output = "";
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                output = append_expanded_line(output, substring(source, start, pos));
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            output = append_expanded_line(output, substring(source, start, source_len));
        }

        return output;
    }

    fn missing_import_in_line(line: str) -> str {
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !file_exists(import_path) {
                return import_path;
            }
        }
        return "";
    }

    fn first_missing_import_path(source: str) -> str {
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                let missing = missing_import_in_line(substring(source, start, pos));
                if len(missing) > 0 {
                    return missing;
                }
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            return missing_import_in_line(substring(source, start, source_len));
        }

        return "";
    }

    fn source_line_at(source: str, offset: i64) -> i64 {
        let line: i64 = 1;
        let i: i64 = 0;
        let source_len = len(source);
        while i < offset && i < source_len {
            if char_code_at(source, i) == 10 {
                line = line + 1;
            }
            i = i + 1;
        }
        return line;
    }

    fn source_column_at(source: str, offset: i64) -> i64 {
        let column: i64 = 1;
        let i: i64 = 0;
        let source_len = len(source);
        while i < offset && i < source_len {
            if char_code_at(source, i) == 10 {
                column = 1;
            } else {
                column = column + 1;
            }
            i = i + 1;
        }
        return column;
    }

    fn json_escape_string(raw: str) -> str {
        let quote = from_char_code(34);
        let backslash = from_char_code(92);
        let out = "";
        let i: i64 = 0;
        while i < len(raw) {
            let ch = char_at(raw, i);
            let ch_code = char_code(ch);

            if ch_code == 10 {
                out = out + backslash + "n";
            } else if ch_code == 13 {
                out = out + backslash + "r";
            } else if ch_code == 9 {
                out = out + backslash + "t";
            } else if ch_code == 34 {
                out = out + backslash + quote;
            } else if ch_code == 92 {
                out = out + backslash + backslash;
            } else if ch_code == 47 && i > 0 && char_code_at(raw, i - 1) == 42 {
                out = out + backslash + ch;
            } else {
                out = out + ch;
            }

            i = i + 1;
        }

        return quote + out + quote;
    }

    fn json_field_str(name: str, value: str) -> str {
        let quote = from_char_code(34);
        return quote + name + quote + ":" + json_escape_string(value);
    }

    fn json_field_i64(name: str, value: i64) -> str {
        let quote = from_char_code(34);
        return quote + name + quote + ":" + int_to_string(value);
    }

    fn json_field_bool(name: str, value: bool) -> str {
        let quote = from_char_code(34);
        if value {
            return quote + name + quote + ":true";
        }
        return quote + name + quote + ":false";
    }

    fn json_field_raw(name: str, value: str) -> str {
        let quote = from_char_code(34);
        return quote + name + quote + ":" + value;
    }

    fn self_host_diagnostic_json(category: str, code: str, message: str,
                                 source_start: i64, source_end: i64,
                                 source_line: i64, source_column: i64,
                                 expected: str, actual: str, repair_hint: str) -> str {
        let comma = ",";
        return "{" +
            json_field_str("schema_version", "bunker.self_host.diagnostic.v1") + comma +
            json_field_str("category", category) + comma +
            json_field_str("error_code", code) + comma +
            json_field_str("message", message) + comma +
            json_field_i64("source_start", source_start) + comma +
            json_field_i64("source_end", source_end) + comma +
            json_field_i64("source_line", source_line) + comma +
            json_field_i64("source_column", source_column) + comma +
            json_field_str("expected", expected) + comma +
            json_field_str("actual", actual) + comma +
            json_field_str("repair_hint", repair_hint) +
            "}";
    }

    fn self_host_capability_json() -> str {
        let comma = ",";
        return "{" +
            json_field_str("schema_version", "bunker.self_host.capability.v1") + comma +
            json_field_str("compiler", "bkrc-self-host-bootstrap") + comma +
            json_field_bool("source_byte_spans", true) + comma +
            json_field_bool("structured_parse_diagnostics", true) + comma +
            json_field_bool("import_expansion", true) + comma +
            json_field_bool("stage1_stage2_ci_gate", true) + comma +
            json_field_bool("type_graph_report", true) + comma +
            json_field_bool("symbol_table_report", true) + comma +
            json_field_bool("name_resolver_report", true) + comma +
            json_field_bool("typecheck_report", true) + comma +
            json_field_bool("typed_ast", false) + comma +
            json_field_bool("real_module_resolver", false) + comma +
            json_field_bool("real_generics", false) + comma +
            json_field_bool("user_defined_adts", false) + comma +
            json_field_bool("multi_error_recovery", false) + comma +
            json_field_str("supported_constructs", "kernel, struct, fn, const, let, fixed arrays, field access, if, else, match, Option via Some and None, Result via result_* builtins, Vec handles, HashMap handles, for ranges, while, loop, break, continue, return, primitive types, calls, casts, ternary, bitwise operators, string literals, float literals") + comma +
            json_field_str("known_limits", "bootstrap raw Vec AST, byte spans only, no file span table, bootstrap name resolver and typecheck reports only, no full Bunker typechecker, no real generics, no user-defined ADTs, no parser multi-error recovery") + comma +
            json_field_str("agent_guidance", "Use BUNKER_DIAGNOSTIC_JSON for repair tasks. Treat BUNKER_CAPABILITY_JSON as the current compiler surface before generating Bunker code.") +
            "}";
    }

    fn build_capability_report_comment() -> str {
        return "/* BUNKER_CAPABILITY_JSON: " + self_host_capability_json() + from_char_code(10) +
            "*/" + from_char_code(10);
    }

    fn source_line_count(source: str) -> i64 {
        let count: i64 = 1;
        let i: i64 = 0;
        while i < len(source) {
            if char_code_at(source, i) == 10 {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    fn ast_report_name(names: Vec<str>, idx: i64) -> str {
        if idx >= 0 && idx < vec_len(names) {
            return vec_get(names, idx);
        }
        return "";
    }

    fn ast_report_item_name_idx(item: Vec<i64>) -> i64 {
        if ast_is_fn_item(item) {
            return ast_fn_name_idx(item);
        }
        if ast_is_const_item(item) {
            return ast_const_name_idx(item);
        }
        if ast_is_struct_item(item) {
            return ast_struct_name_idx(item);
        }
        return -1;
    }

    fn ast_report_item_param_count(item: Vec<i64>) -> i64 {
        if ast_is_fn_item(item) {
            return vec_len(ast_fn_params(item));
        }
        return 0;
    }

    fn ast_report_item_field_count(item: Vec<i64>) -> i64 {
        if ast_is_struct_item(item) {
            return vec_len(ast_struct_fields(item));
        }
        return 0;
    }

    fn ast_report_item_stmt_count(item: Vec<i64>) -> i64 {
        if ast_is_fn_item(item) {
            return ast_block_stmt_count(ast_fn_body(item));
        }
        return 0;
    }

    fn ast_report_item_json(names: Vec<str>, item: Vec<i64>) -> str {
        let comma = ",";
        return "{" +
            json_field_str("kind", ast_node_kind_name(ast_kind(item))) + comma +
            json_field_str("category", ast_category_name(ast_node_category(item))) + comma +
            json_field_str("name", ast_report_name(names, ast_report_item_name_idx(item))) + comma +
            json_field_i64("source_start", ast_node_span_start(item)) + comma +
            json_field_i64("source_end", ast_node_span_end(item)) + comma +
            json_field_bool("span_known", ast_node_has_span(item)) + comma +
            json_field_i64("param_count", ast_report_item_param_count(item)) + comma +
            json_field_i64("field_count", ast_report_item_field_count(item)) + comma +
            json_field_i64("statement_count", ast_report_item_stmt_count(item)) +
            "}";
    }

    fn ast_report_count_kind(items: Vec<i64>, kind: i64) -> i64 {
        let count: i64 = 0;
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_kind(item) == kind {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    fn ast_report_items_json(kernel: Vec<i64>) -> str {
        let names = ast_kernel_names(kernel);
        let items = ast_kernel_items(kernel);
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(items) {
            if i > 0 {
                result = result + ",";
            }
            result = result + ast_report_item_json(names, vec_get(items, i) as Vec<i64>);
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_node_array_json(names: Vec<str>, nodes: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(nodes) {
            if i > 0 {
                result = result + ",";
            }
            result = result + ast_report_node_json(names, vec_get(nodes, i) as Vec<i64>);
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_optional_node_json(names: Vec<str>, node_value: i64) -> str {
        if node_value == 0 {
            return "null";
        }
        return ast_report_node_json(names, node_value as Vec<i64>);
    }

    fn ast_report_block_statements_json(names: Vec<str>, block: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            if i > 0 {
                result = result + ",";
            }
            result = result + ast_report_node_json(names, ast_block_stmt(block, i));
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_pattern_json(names: Vec<str>, pattern: Vec<i64>) -> str {
        let comma = ",";
        let kind = ast_pattern_kind(pattern);
        let result = "{" +
            json_field_str("kind", ast_pattern_kind_name(kind)) + comma +
            json_field_i64("source_start", ast_pattern_span_start(pattern)) + comma +
            json_field_i64("source_end", ast_pattern_span_end(pattern)) + comma +
            json_field_bool("span_known", ast_pattern_span_start(pattern) != AST_SPAN_UNKNOWN && ast_pattern_span_end(pattern) != AST_SPAN_UNKNOWN);

        if kind == PAT_INT {
            result = result + comma + json_field_i64("value", ast_pattern_value(pattern));
        } else if kind == PAT_BOOL {
            result = result + comma + json_field_bool("value", ast_pattern_value(pattern) == 1);
        } else if kind == PAT_BIND || kind == PAT_SOME {
            result = result + comma + json_field_str("binding", ast_report_name(names, ast_pattern_value(pattern)));
        }

        return result + "}";
    }

    fn ast_report_match_arms_json(names: Vec<str>, patterns: Vec<i64>, bodies: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(patterns) {
            if i > 0 {
                result = result + ",";
            }
            result = result + "{" +
                json_field_raw("pattern", ast_report_pattern_json(names, vec_get(patterns, i) as Vec<i64>)) + "," +
                json_field_raw("body", ast_report_node_json(names, vec_get(bodies, i) as Vec<i64>)) +
                "}";
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_struct_lit_fields_json(names: Vec<str>, node: Vec<i64>) -> str {
        let field_names = ast_struct_lit_field_names(node);
        let field_values = ast_struct_lit_field_values(node);
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(field_names) {
            if i > 0 {
                result = result + ",";
            }
            result = result + "{" +
                json_field_str("name", ast_report_name(names, vec_get(field_names, i))) + "," +
                json_field_raw("value", ast_report_node_json(names, vec_get(field_values, i) as Vec<i64>)) +
                "}";
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_node_json(names: Vec<str>, node: Vec<i64>) -> str {
        let comma = ",";
        let kind = ast_kind(node);
        let result = "{" +
            json_field_str("kind", ast_node_kind_name(kind)) + comma +
            json_field_str("category", ast_category_name(ast_node_category(node))) + comma +
            json_field_i64("source_start", ast_node_span_start(node)) + comma +
            json_field_i64("source_end", ast_node_span_end(node)) + comma +
            json_field_bool("span_known", ast_node_has_span(node));

        if kind == NODE_KERNEL {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_name_idx(node))) + comma +
                json_field_str("entry", ast_report_name(names, ast_kernel_entry_idx(node))) + comma +
                json_field_raw("items", ast_report_node_array_json(names, ast_kernel_items(node)));
        } else if kind == NODE_FN {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_fn_name_idx(node))) + comma +
                json_field_raw("params", ast_report_node_array_json(names, ast_fn_params(node))) + comma +
                json_field_raw("return_type", ast_report_optional_node_json(names, ast_fn_return_type(node))) + comma +
                json_field_raw("body", ast_report_node_json(names, ast_fn_body(node)));
        } else if kind == NODE_PARAM {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_param_name_idx(node))) + comma +
                json_field_raw("type", ast_report_node_json(names, ast_param_type_node(node)));
        } else if kind == NODE_TYPE {
            let type_kind = ast_type_kind_value(node as i64);
            result = result + comma +
                json_field_str("type_kind", ast_type_kind_name(type_kind)) + comma +
                json_field_i64("type_tag", type_kind);
            if type_kind == TYPE_STRUCT {
                result = result + comma + json_field_str("struct_name", ast_report_name(names, ast_type_struct_name_idx_value(node as i64)));
            } else if type_kind == TYPE_ARRAY {
                result = result + comma +
                    json_field_str("element_type_kind", ast_type_kind_name(ast_type_array_elem_kind_value(node as i64))) + comma +
                    json_field_i64("array_len", ast_type_array_len_value(node as i64));
            }
        } else if kind == NODE_BLOCK {
            result = result + comma + json_field_raw("statements", ast_report_block_statements_json(names, node));
        } else if kind == NODE_LET {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_let_name_idx(node))) + comma +
                json_field_raw("declared_type", ast_report_optional_node_json(names, ast_let_type_node(node))) + comma +
                json_field_raw("init", ast_report_optional_node_json(names, ast_let_init(node)));
        } else if kind == NODE_RETURN {
            result = result + comma + json_field_raw("expr", ast_report_optional_node_json(names, ast_return_expr(node)));
        } else if kind == NODE_IF {
            result = result + comma +
                json_field_raw("condition", ast_report_node_json(names, ast_if_cond(node))) + comma +
                json_field_raw("then", ast_report_node_json(names, ast_if_then(node))) + comma +
                json_field_raw("else", ast_report_optional_node_json(names, ast_if_else(node)));
        } else if kind == NODE_WHILE {
            result = result + comma +
                json_field_raw("condition", ast_report_node_json(names, ast_while_cond(node))) + comma +
                json_field_raw("body", ast_report_node_json(names, ast_while_body(node)));
        } else if kind == NODE_EXPR_STMT {
            result = result + comma + json_field_raw("expr", ast_report_node_json(names, ast_expr_stmt_expr(node)));
        } else if kind == NODE_ASSIGN {
            result = result + comma +
                json_field_raw("target", ast_report_node_json(names, ast_assign_target(node))) + comma +
                json_field_raw("value", ast_report_node_json(names, ast_assign_value(node)));
        } else if kind == NODE_FOR {
            result = result + comma +
                json_field_str("binding", ast_report_name(names, ast_for_name_idx(node))) + comma +
                json_field_raw("start", ast_report_node_json(names, ast_for_start(node))) + comma +
                json_field_raw("end", ast_report_node_json(names, ast_for_end(node))) + comma +
                json_field_bool("inclusive", ast_for_inclusive(node) == 1) + comma +
                json_field_raw("body", ast_report_node_json(names, ast_for_body(node)));
        } else if kind == NODE_LOOP {
            result = result + comma + json_field_raw("body", ast_report_node_json(names, ast_loop_body(node)));
        } else if kind == NODE_BINARY {
            result = result + comma +
                json_field_str("op", token_name(ast_binary_op(node))) + comma +
                json_field_raw("left", ast_report_node_json(names, ast_binary_left(node))) + comma +
                json_field_raw("right", ast_report_node_json(names, ast_binary_right(node)));
        } else if kind == NODE_UNARY {
            result = result + comma +
                json_field_str("op", token_name(ast_unary_op(node))) + comma +
                json_field_raw("operand", ast_report_node_json(names, ast_unary_operand(node)));
        } else if kind == NODE_CALL {
            result = result + comma +
                json_field_str("callee", ast_report_name(names, ast_call_name_idx(node))) + comma +
                json_field_raw("args", ast_report_node_array_json(names, ast_call_args(node)));
        } else if kind == NODE_IDENT {
            result = result + comma + json_field_str("name", ast_report_name(names, ast_name_idx(node)));
        } else if kind == NODE_INT_LIT {
            result = result + comma + json_field_i64("value", ast_value(node));
        } else if kind == NODE_BOOL_LIT {
            result = result + comma + json_field_bool("value", ast_value(node) == 1);
        } else if kind == NODE_STR_LIT {
            result = result + comma + json_field_str("value", ast_value(node) as str);
        } else if kind == NODE_CONST {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_const_name_idx(node))) + comma +
                json_field_raw("type", ast_report_optional_node_json(names, ast_const_type_node(node))) + comma +
                json_field_raw("value", ast_report_optional_node_json(names, ast_const_value(node)));
        } else if kind == NODE_TERNARY {
            result = result + comma +
                json_field_raw("condition", ast_report_node_json(names, ast_ternary_cond(node))) + comma +
                json_field_raw("then", ast_report_node_json(names, ast_ternary_then(node))) + comma +
                json_field_raw("else", ast_report_node_json(names, ast_ternary_else(node)));
        } else if kind == NODE_FLOAT_LIT {
            result = result + comma + json_field_str("value", ast_value(node) as str);
        } else if kind == NODE_ARRAY_LIT {
            result = result + comma + json_field_raw("elements", ast_report_node_array_json(names, ast_array_elements(node)));
        } else if kind == NODE_INDEX {
            result = result + comma +
                json_field_raw("base", ast_report_node_json(names, ast_index_base(node))) + comma +
                json_field_raw("index", ast_report_node_json(names, ast_index_expr(node)));
        } else if kind == NODE_STRUCT {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_struct_name_idx(node))) + comma +
                json_field_raw("fields", ast_report_node_array_json(names, ast_struct_fields(node)));
        } else if kind == NODE_FIELD {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_field_decl_name_idx(node))) + comma +
                json_field_raw("type", ast_report_optional_node_json(names, ast_field_decl_type_node(node)));
        } else if kind == NODE_FIELD_ACCESS {
            result = result + comma +
                json_field_raw("base", ast_report_node_json(names, ast_field_base(node))) + comma +
                json_field_str("field", ast_report_name(names, ast_field_name_idx(node)));
        } else if kind == NODE_STRUCT_LIT {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_struct_lit_name_idx(node))) + comma +
                json_field_raw("fields", ast_report_struct_lit_fields_json(names, node));
        } else if kind == NODE_MATCH {
            result = result + comma +
                json_field_raw("scrutinee", ast_report_node_json(names, ast_match_scrutinee(node))) + comma +
                json_field_raw("arms", ast_report_match_arms_json(names, ast_match_patterns(node), ast_match_bodies(node)));
        }

        return result + "}";
    }

    fn self_host_ast_json(source: str, kernel: Vec<i64>) -> str {
        let comma = ",";
        let names = ast_kernel_names(kernel);
        let items = ast_kernel_items(kernel);
        let root = "{" +
            json_field_str("kind", ast_node_kind_name(ast_kind(kernel))) + comma +
            json_field_str("name", ast_report_name(names, ast_name_idx(kernel))) + comma +
            json_field_str("entry", ast_report_name(names, ast_kernel_entry_idx(kernel))) + comma +
            json_field_i64("source_start", ast_node_span_start(kernel)) + comma +
            json_field_i64("source_end", ast_node_span_end(kernel)) + comma +
            json_field_bool("span_known", ast_node_has_span(kernel)) +
            "}";
        let summary = "{" +
            json_field_i64("source_bytes", len(source)) + comma +
            json_field_i64("source_lines", source_line_count(source)) + comma +
            json_field_i64("item_count", vec_len(items)) + comma +
            json_field_i64("function_count", ast_report_count_kind(items, NODE_FN)) + comma +
            json_field_i64("struct_count", ast_report_count_kind(items, NODE_STRUCT)) + comma +
            json_field_i64("const_count", ast_report_count_kind(items, NODE_CONST)) +
            "}";
        return "{" +
            json_field_str("schema_version", "bunker.self_host.ast.v1") + comma +
            json_field_str("representation", "bootstrap_vec_i64") + comma +
            json_field_bool("source_byte_spans", true) + comma +
            json_field_bool("complete_tree", true) + comma +
            json_field_raw("root", root) + comma +
            json_field_raw("summary", summary) + comma +
            json_field_raw("items", ast_report_items_json(kernel)) + comma +
            json_field_raw("tree", ast_report_node_json(names, kernel)) +
            "}";
    }

    fn build_ast_report_comment(source: str, kernel: Vec<i64>) -> str {
        return "/* BUNKER_AST_JSON: " + self_host_ast_json(source, kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }

    fn type_graph_kind_json(kind: i64, source: str) -> str {
        let comma = ",";
        return "{" +
            json_field_str("type_kind", ast_type_kind_name(kind)) + comma +
            json_field_i64("type_tag", kind) + comma +
            json_field_str("c_abi", type_to_c(kind)) + comma +
            json_field_str("source", source) + comma +
            json_field_bool("known", kind != TYPE_UNKNOWN) +
            "}";
    }

    fn type_graph_type_node_json(names: Vec<str>, type_node: i64, source: str) -> str {
        if type_node == 0 {
            return type_graph_kind_json(TYPE_UNKNOWN, source);
        }

        let comma = ",";
        let kind = ast_type_kind_value(type_node);
        let result = "{" +
            json_field_str("type_kind", ast_type_kind_name(kind)) + comma +
            json_field_i64("type_tag", kind) + comma +
            json_field_str("c_abi", type_to_c(kind)) + comma +
            json_field_str("source", source) + comma +
            json_field_bool("known", kind != TYPE_UNKNOWN);

        if kind == TYPE_STRUCT {
            result = result + comma +
                json_field_str("struct_name", ast_report_name(names, ast_type_struct_name_idx_value(type_node)));
        } else if kind == TYPE_ARRAY {
            result = result + comma +
                json_field_str("element_type_kind", ast_type_kind_name(ast_type_array_elem_kind_value(type_node))) + comma +
                json_field_i64("array_len", ast_type_array_len_value(type_node));
        }

        return result + "}";
    }

    fn type_graph_expr_json(state: Vec<i64>, expr_value: i64) -> str {
        if expr_value == 0 {
            return type_graph_kind_json(TYPE_UNKNOWN, "absent");
        }
        return type_graph_kind_json(infer_c_expr_type(state, expr_value as Vec<i64>), "bootstrap_inferred");
    }

    fn type_graph_effective_kind(state: Vec<i64>, type_node: i64, expr_value: i64) -> i64 {
        if type_node != 0 {
            return ast_type_kind_value(type_node);
        }
        if expr_value != 0 {
            return infer_c_expr_type(state, expr_value as Vec<i64>);
        }
        return TYPE_UNKNOWN;
    }

    fn type_graph_maybe_add_array_type(state: Vec<i64>, name_idx: i64, type_node: i64) -> Vec<i64> {
        if type_node != 0 && ast_type_kind_value(type_node) == TYPE_ARRAY {
            cgen_add_array_type(state, name_idx,
                ast_type_array_elem_kind_value(type_node),
                ast_type_array_len_value(type_node));
        }
        return state;
    }

    fn type_graph_seed_state(kernel: Vec<i64>) -> Vec<i64> {
        let names = ast_kernel_names(kernel);
        let state = cgen_new(ast_report_name(names, ast_name_idx(kernel)), names);
        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_fn_item(item) {
                let ret_type = ast_fn_return_type(item);
                let ret_kind = TYPE_VOID;
                if ret_type != 0 {
                    ret_kind = ast_type_kind_value(ret_type);
                }
                cgen_add_fn_type(state, ast_fn_name_idx(item), ret_kind);
            } else if ast_is_const_item(item) {
                let const_kind = type_graph_effective_kind(state, ast_const_type_node(item), ast_const_value(item));
                cgen_add_global_type(state, ast_const_name_idx(item), const_kind);
            }
            i = i + 1;
        }
        return state;
    }

    fn type_graph_json_array_append(result: str, item: str) -> str {
        if len(result) > 1 {
            return result + "," + item;
        }
        return result + item;
    }

    fn type_graph_json_array_append_items(result: str, items: str) -> str {
        if len(items) <= 2 {
            return result;
        }
        let inner = substring(items, 1, len(items) - 1);
        if len(result) > 1 {
            return result + "," + inner;
        }
        return result + inner;
    }

    fn type_graph_param_json(names: Vec<str>, param: Vec<i64>) -> str {
        let comma = ",";
        return "{" +
            json_field_str("name", ast_report_name(names, ast_param_name_idx(param))) + comma +
            json_field_i64("source_start", ast_node_span_start(param)) + comma +
            json_field_i64("source_end", ast_node_span_end(param)) + comma +
            json_field_raw("declared_type", type_graph_type_node_json(names, ast_param_type_node(param) as i64, "declared")) +
            "}";
    }

    fn type_graph_params_json(names: Vec<str>, params: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(params) {
            result = type_graph_json_array_append(result,
                type_graph_param_json(names, vec_get(params, i) as Vec<i64>));
            i = i + 1;
        }
        return result + "]";
    }

    fn type_graph_field_json(names: Vec<str>, field: Vec<i64>) -> str {
        let comma = ",";
        return "{" +
            json_field_str("name", ast_report_name(names, ast_field_decl_name_idx(field))) + comma +
            json_field_i64("source_start", ast_node_span_start(field)) + comma +
            json_field_i64("source_end", ast_node_span_end(field)) + comma +
            json_field_raw("declared_type", type_graph_type_node_json(names, ast_field_decl_type_node(field), "declared")) +
            "}";
    }

    fn type_graph_fields_json(names: Vec<str>, fields: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(fields) {
            result = type_graph_json_array_append(result,
                type_graph_field_json(names, vec_get(fields, i) as Vec<i64>));
            i = i + 1;
        }
        return result + "]";
    }

    fn type_graph_struct_json(names: Vec<str>, item: Vec<i64>) -> str {
        let comma = ",";
        return "{" +
            json_field_str("name", ast_report_name(names, ast_struct_name_idx(item))) + comma +
            json_field_i64("source_start", ast_node_span_start(item)) + comma +
            json_field_i64("source_end", ast_node_span_end(item)) + comma +
            json_field_raw("fields", type_graph_fields_json(names, ast_struct_fields(item))) +
            "}";
    }

    fn type_graph_structs_json(kernel: Vec<i64>) -> str {
        let names = ast_kernel_names(kernel);
        let items = ast_kernel_items(kernel);
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_struct_item(item) {
                result = type_graph_json_array_append(result, type_graph_struct_json(names, item));
            }
            i = i + 1;
        }
        return result + "]";
    }

    fn type_graph_const_json(state: Vec<i64>, names: Vec<str>, item: Vec<i64>) -> str {
        let comma = ",";
        let type_node = ast_const_type_node(item);
        return "{" +
            json_field_str("name", ast_report_name(names, ast_const_name_idx(item))) + comma +
            json_field_i64("source_start", ast_node_span_start(item)) + comma +
            json_field_i64("source_end", ast_node_span_end(item)) + comma +
            json_field_raw("declared_type", type_graph_type_node_json(names, type_node, "declared")) + comma +
            json_field_raw("inferred_type", type_graph_expr_json(state, ast_const_value(item))) + comma +
            json_field_raw("effective_type", type_graph_kind_json(type_graph_effective_kind(state, type_node, ast_const_value(item)), "effective")) +
            "}";
    }

    fn type_graph_consts_json(kernel: Vec<i64>, state: Vec<i64>) -> str {
        let names = ast_kernel_names(kernel);
        let items = ast_kernel_items(kernel);
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_const_item(item) {
                result = type_graph_json_array_append(result, type_graph_const_json(state, names, item));
            }
            i = i + 1;
        }
        return result + "]";
    }

    fn type_graph_let_json(state: Vec<i64>, names: Vec<str>, stmt: Vec<i64>) -> str {
        let comma = ",";
        let type_node = ast_let_type_node(stmt);
        let init = ast_let_init(stmt);
        let effective_kind = type_graph_effective_kind(state, type_node, init);
        let result = "{" +
            json_field_str("name", ast_report_name(names, ast_let_name_idx(stmt))) + comma +
            json_field_i64("source_start", ast_node_span_start(stmt)) + comma +
            json_field_i64("source_end", ast_node_span_end(stmt)) + comma +
            json_field_raw("declared_type", type_graph_type_node_json(names, type_node, "declared")) + comma +
            json_field_raw("inferred_type", type_graph_expr_json(state, init)) + comma +
            json_field_raw("effective_type", type_graph_kind_json(effective_kind, "effective"));
        return result + "}";
    }

    fn type_graph_add_let_to_state(state: Vec<i64>, stmt: Vec<i64>) -> Vec<i64> {
        let type_node = ast_let_type_node(stmt);
        let init = ast_let_init(stmt);
        let kind = type_graph_effective_kind(state, type_node, init);
        cgen_add_local_type(state, ast_let_name_idx(stmt), kind);
        type_graph_maybe_add_array_type(state, ast_let_name_idx(stmt), type_node);
        return state;
    }

    fn type_graph_block_locals_json(state: Vec<i64>, names: Vec<str>, block: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            let stmt = ast_block_stmt(block, i);
            let kind = ast_kind(stmt);
            if kind == NODE_LET {
                result = type_graph_json_array_append(result, type_graph_let_json(state, names, stmt));
                type_graph_add_let_to_state(state, stmt);
            } else if kind == NODE_IF {
                result = type_graph_json_array_append_items(result, type_graph_block_locals_json(state, names, ast_if_then(stmt)));
                if ast_if_else(stmt) != 0 {
                    result = type_graph_json_array_append_items(result, type_graph_block_locals_json(state, names, ast_if_else(stmt) as Vec<i64>));
                }
            } else if kind == NODE_WHILE {
                result = type_graph_json_array_append_items(result, type_graph_block_locals_json(state, names, ast_while_body(stmt)));
            } else if kind == NODE_FOR {
                cgen_add_local_type(state, ast_for_name_idx(stmt), TYPE_I64);
                result = type_graph_json_array_append_items(result, type_graph_block_locals_json(state, names, ast_for_body(stmt)));
            } else if kind == NODE_LOOP {
                result = type_graph_json_array_append_items(result, type_graph_block_locals_json(state, names, ast_loop_body(stmt)));
            }
            i = i + 1;
        }
        return result + "]";
    }

    fn type_graph_return_json(state: Vec<i64>, stmt: Vec<i64>) -> str {
        let comma = ",";
        return "{" +
            json_field_i64("source_start", ast_node_span_start(stmt)) + comma +
            json_field_i64("source_end", ast_node_span_end(stmt)) + comma +
            json_field_raw("expr_type", type_graph_expr_json(state, ast_return_expr(stmt))) +
            "}";
    }

    fn type_graph_block_returns_json(state: Vec<i64>, names: Vec<str>, block: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            let stmt = ast_block_stmt(block, i);
            let kind = ast_kind(stmt);
            if kind == NODE_RETURN {
                result = type_graph_json_array_append(result, type_graph_return_json(state, stmt));
            } else if kind == NODE_IF {
                result = type_graph_json_array_append_items(result, type_graph_block_returns_json(state, names, ast_if_then(stmt)));
                if ast_if_else(stmt) != 0 {
                    result = type_graph_json_array_append_items(result, type_graph_block_returns_json(state, names, ast_if_else(stmt) as Vec<i64>));
                }
            } else if kind == NODE_WHILE {
                result = type_graph_json_array_append_items(result, type_graph_block_returns_json(state, names, ast_while_body(stmt)));
            } else if kind == NODE_FOR {
                result = type_graph_json_array_append_items(result, type_graph_block_returns_json(state, names, ast_for_body(stmt)));
            } else if kind == NODE_LOOP {
                result = type_graph_json_array_append_items(result, type_graph_block_returns_json(state, names, ast_loop_body(stmt)));
            }
            i = i + 1;
        }
        return result + "]";
    }

    fn type_graph_function_state(kernel: Vec<i64>, fn_node: Vec<i64>) -> Vec<i64> {
        let state = type_graph_seed_state(kernel);
        let params = ast_fn_params(fn_node);
        let i: i64 = 0;
        while i < vec_len(params) {
            let param = vec_get(params, i) as Vec<i64>;
            let param_type = ast_param_type_node(param) as i64;
            cgen_add_local_type(state, ast_param_name_idx(param), ast_type_kind_value(param_type));
            type_graph_maybe_add_array_type(state, ast_param_name_idx(param), param_type);
            i = i + 1;
        }
        return state;
    }

    fn type_graph_function_json(kernel: Vec<i64>, names: Vec<str>, item: Vec<i64>) -> str {
        let comma = ",";
        let state = type_graph_function_state(kernel, item);
        let body = ast_fn_body(item);
        let locals = type_graph_block_locals_json(state, names, body);
        let returns = type_graph_block_returns_json(state, names, body);
        return "{" +
            json_field_str("name", ast_report_name(names, ast_fn_name_idx(item))) + comma +
            json_field_i64("source_start", ast_node_span_start(item)) + comma +
            json_field_i64("source_end", ast_node_span_end(item)) + comma +
            json_field_raw("return_type", type_graph_type_node_json(names, ast_fn_return_type(item), "declared")) + comma +
            json_field_raw("params", type_graph_params_json(names, ast_fn_params(item))) + comma +
            json_field_raw("locals", locals) + comma +
            json_field_raw("returns", returns) +
            "}";
    }

    fn type_graph_functions_json(kernel: Vec<i64>) -> str {
        let names = ast_kernel_names(kernel);
        let items = ast_kernel_items(kernel);
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_fn_item(item) {
                result = type_graph_json_array_append(result, type_graph_function_json(kernel, names, item));
            }
            i = i + 1;
        }
        return result + "]";
    }

    fn self_host_type_graph_json(kernel: Vec<i64>) -> str {
        let comma = ",";
        let state = type_graph_seed_state(kernel);
        let items = ast_kernel_items(kernel);
        return "{" +
            json_field_str("schema_version", "bunker.self_host.type_graph.v1") + comma +
            json_field_str("representation", "bootstrap_codegen_inference") + comma +
            json_field_bool("complete", false) + comma +
            json_field_bool("declared_types", true) + comma +
            json_field_bool("local_inference", true) + comma +
            json_field_str("known_limits", "Derived from declarations plus bootstrap C codegen inference; no real Bunker typechecker, generic graph, trait constraints, exhaustiveness graph, or cross-module type graph yet.") + comma +
            json_field_raw("summary", "{" +
                json_field_i64("function_count", ast_report_count_kind(items, NODE_FN)) + comma +
                json_field_i64("struct_count", ast_report_count_kind(items, NODE_STRUCT)) + comma +
                json_field_i64("const_count", ast_report_count_kind(items, NODE_CONST)) +
                "}") + comma +
            json_field_raw("structs", type_graph_structs_json(kernel)) + comma +
            json_field_raw("constants", type_graph_consts_json(kernel, state)) + comma +
            json_field_raw("functions", type_graph_functions_json(kernel)) +
            "}";
    }

    fn build_type_graph_report_comment(kernel: Vec<i64>) -> str {
        return "/* BUNKER_TYPE_GRAPH_JSON: " + self_host_type_graph_json(kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }

    fn symbol_table_json_array_append(result: str, item: str) -> str {
        if len(result) > 1 {
            return result + "," + item;
        }
        return result + item;
    }

    fn symbol_table_json_array_append_items(result: str, items: str) -> str {
        if len(items) <= 2 {
            return result;
        }
        let inner = substring(items, 1, len(items) - 1);
        if len(result) > 1 {
            return result + "," + inner;
        }
        return result + inner;
    }

    fn symbol_table_entry_json(kind: str, name: str, scope: str, source_start: i64, source_end: i64) -> str {
        let comma = ",";
        return "{" +
            json_field_str("kind", kind) + comma +
            json_field_str("name", name) + comma +
            json_field_str("scope", scope) + comma +
            json_field_i64("source_start", source_start) + comma +
            json_field_i64("source_end", source_end) + comma +
            json_field_bool("span_known", source_start != AST_SPAN_UNKNOWN && source_end != AST_SPAN_UNKNOWN) +
            "}";
    }

    fn symbol_table_node_entry_json(kind: str, name: str, scope: str, node: Vec<i64>) -> str {
        return symbol_table_entry_json(kind, name, scope, ast_node_span_start(node), ast_node_span_end(node));
    }

    fn symbol_table_pattern_entry_json(kind: str, name: str, scope: str, pattern: Vec<i64>) -> str {
        return symbol_table_entry_json(kind, name, scope, ast_pattern_span_start(pattern), ast_pattern_span_end(pattern));
    }

    fn symbol_table_type_references_json(names: Vec<str>, type_node: i64, scope: str) -> str {
        let result = "[";
        if type_node != 0 && ast_type_kind_value(type_node) == TYPE_STRUCT {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("type_reference",
                    ast_report_name(names, ast_type_struct_name_idx_value(type_node)),
                    scope,
                    type_node as Vec<i64>));
        }
        return result + "]";
    }

    fn symbol_table_pattern_declarations_json(names: Vec<str>, pattern: Vec<i64>, scope: str) -> str {
        let result = "[";
        let kind = ast_pattern_kind(pattern);
        if kind == PAT_BIND || kind == PAT_SOME {
            result = symbol_table_json_array_append(result,
                symbol_table_pattern_entry_json("pattern_binding",
                    ast_report_name(names, ast_pattern_value(pattern)),
                    scope,
                    pattern));
        }
        return result + "]";
    }

    fn symbol_table_expr_declarations_json(names: Vec<str>, expr_value: i64, scope: str) -> str {
        let result = "[";
        if expr_value == 0 {
            return result + "]";
        }

        let expr = expr_value as Vec<i64>;
        let kind = ast_kind(expr);
        if kind == NODE_MATCH {
            let patterns = ast_match_patterns(expr);
            let bodies = ast_match_bodies(expr);
            let i: i64 = 0;
            while i < vec_len(patterns) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_pattern_declarations_json(names, vec_get(patterns, i) as Vec<i64>, scope));
                let body = vec_get(bodies, i) as Vec<i64>;
                if ast_is_block(body) {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_block_declarations_json(names, body, scope));
                } else {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_expr_declarations_json(names, body as i64, scope));
                }
                i = i + 1;
            }
        } else if kind == NODE_BINARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_binary_left(expr) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_binary_right(expr) as i64, scope));
        } else if kind == NODE_UNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_unary_operand(expr) as i64, scope));
        } else if kind == NODE_CALL {
            let args = ast_call_args(expr);
            let i: i64 = 0;
            while i < vec_len(args) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_declarations_json(names, vec_get(args, i), scope));
                i = i + 1;
            }
        } else if kind == NODE_TERNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_ternary_cond(expr) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_ternary_then(expr) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_ternary_else(expr) as i64, scope));
        } else if kind == NODE_ARRAY_LIT {
            let elements = ast_array_elements(expr);
            let i: i64 = 0;
            while i < vec_len(elements) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_declarations_json(names, vec_get(elements, i), scope));
                i = i + 1;
            }
        } else if kind == NODE_INDEX {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_index_base(expr) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_index_expr(expr) as i64, scope));
        } else if kind == NODE_FIELD_ACCESS {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_field_base(expr) as i64, scope));
        } else if kind == NODE_STRUCT_LIT {
            let values = ast_struct_lit_field_values(expr);
            let i: i64 = 0;
            while i < vec_len(values) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_declarations_json(names, vec_get(values, i), scope));
                i = i + 1;
            }
        }

        return result + "]";
    }

    fn symbol_table_stmt_declarations_json(names: Vec<str>, stmt: Vec<i64>, scope: str) -> str {
        let result = "[";
        let kind = ast_kind(stmt);
        if kind == NODE_LET {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("local",
                    ast_report_name(names, ast_let_name_idx(stmt)),
                    scope,
                    stmt));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_let_init(stmt), scope));
        } else if kind == NODE_RETURN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_return_expr(stmt), scope));
        } else if kind == NODE_IF {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_if_cond(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_if_then(stmt), scope));
            if ast_if_else(stmt) != 0 {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_block_declarations_json(names, ast_if_else(stmt) as Vec<i64>, scope));
            }
        } else if kind == NODE_WHILE {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_while_cond(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_while_body(stmt), scope));
        } else if kind == NODE_FOR {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("for_binding",
                    ast_report_name(names, ast_for_name_idx(stmt)),
                    scope,
                    stmt));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_for_start(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_for_end(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_for_body(stmt), scope));
        } else if kind == NODE_LOOP {
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_loop_body(stmt), scope));
        } else if kind == NODE_ASSIGN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_assign_target(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_assign_value(stmt) as i64, scope));
        } else if kind == NODE_EXPR_STMT {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_expr_stmt_expr(stmt) as i64, scope));
        }
        return result + "]";
    }

    fn symbol_table_block_declarations_json(names: Vec<str>, block: Vec<i64>, scope: str) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_stmt_declarations_json(names, ast_block_stmt(block, i), scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn symbol_table_item_declarations_json(kernel: Vec<i64>, item: Vec<i64>, kernel_scope: str) -> str {
        let names = ast_kernel_names(kernel);
        let result = "[";
        if ast_is_fn_item(item) {
            let fn_name = ast_report_name(names, ast_fn_name_idx(item));
            let fn_scope = "function:" + fn_name;
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("function", fn_name, kernel_scope, item));

            let params = ast_fn_params(item);
            let i: i64 = 0;
            while i < vec_len(params) {
                let param = vec_get(params, i) as Vec<i64>;
                result = symbol_table_json_array_append(result,
                    symbol_table_node_entry_json("parameter",
                        ast_report_name(names, ast_param_name_idx(param)),
                        fn_scope,
                        param));
                i = i + 1;
            }

            result = symbol_table_json_array_append_items(result,
                symbol_table_block_declarations_json(names, ast_fn_body(item), fn_scope));
        } else if ast_is_const_item(item) {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("constant",
                    ast_report_name(names, ast_const_name_idx(item)),
                    kernel_scope,
                    item));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_declarations_json(names, ast_const_value(item), kernel_scope));
        } else if ast_is_struct_item(item) {
            let struct_name = ast_report_name(names, ast_struct_name_idx(item));
            let struct_scope = "struct:" + struct_name;
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("struct", struct_name, kernel_scope, item));
            let fields = ast_struct_fields(item);
            let i: i64 = 0;
            while i < vec_len(fields) {
                let field = vec_get(fields, i) as Vec<i64>;
                result = symbol_table_json_array_append(result,
                    symbol_table_node_entry_json("field",
                        ast_report_name(names, ast_field_decl_name_idx(field)),
                        struct_scope,
                        field));
                i = i + 1;
            }
        }
        return result + "]";
    }

    fn symbol_table_declarations_json(kernel: Vec<i64>) -> str {
        let names = ast_kernel_names(kernel);
        let kernel_name = ast_report_name(names, ast_name_idx(kernel));
        let kernel_scope = "kernel:" + kernel_name;
        let result = "[";
        result = symbol_table_json_array_append(result,
            symbol_table_node_entry_json("kernel", kernel_name, "global", kernel));

        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_item_declarations_json(kernel, vec_get(items, i) as Vec<i64>, kernel_scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn symbol_table_expr_references_json(names: Vec<str>, expr_value: i64, scope: str) -> str {
        let result = "[";
        if expr_value == 0 {
            return result + "]";
        }

        let expr = expr_value as Vec<i64>;
        let kind = ast_kind(expr);
        if kind == NODE_IDENT {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("identifier",
                    ast_report_name(names, ast_name_idx(expr)),
                    scope,
                    expr));
        } else if kind == NODE_CALL {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("function_call",
                    ast_report_name(names, ast_call_name_idx(expr)),
                    scope,
                    expr));
            let args = ast_call_args(expr);
            let i: i64 = 0;
            while i < vec_len(args) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_references_json(names, vec_get(args, i), scope));
                i = i + 1;
            }
        } else if kind == NODE_FIELD_ACCESS {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_field_base(expr) as i64, scope));
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("field_access",
                    ast_report_name(names, ast_field_name_idx(expr)),
                    scope,
                    expr));
        } else if kind == NODE_STRUCT_LIT {
            result = symbol_table_json_array_append(result,
                symbol_table_node_entry_json("struct_literal",
                    ast_report_name(names, ast_struct_lit_name_idx(expr)),
                    scope,
                    expr));
            let field_names = ast_struct_lit_field_names(expr);
            let field_values = ast_struct_lit_field_values(expr);
            let i: i64 = 0;
            while i < vec_len(field_names) {
                result = symbol_table_json_array_append(result,
                    symbol_table_node_entry_json("field_initializer",
                        ast_report_name(names, vec_get(field_names, i)),
                        scope,
                        expr));
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_references_json(names, vec_get(field_values, i), scope));
                i = i + 1;
            }
        } else if kind == NODE_BINARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_binary_left(expr) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_binary_right(expr) as i64, scope));
        } else if kind == NODE_UNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_unary_operand(expr) as i64, scope));
        } else if kind == NODE_TERNARY {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_ternary_cond(expr) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_ternary_then(expr) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_ternary_else(expr) as i64, scope));
        } else if kind == NODE_ARRAY_LIT {
            let elements = ast_array_elements(expr);
            let i: i64 = 0;
            while i < vec_len(elements) {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_expr_references_json(names, vec_get(elements, i), scope));
                i = i + 1;
            }
        } else if kind == NODE_INDEX {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_index_base(expr) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_index_expr(expr) as i64, scope));
        } else if kind == NODE_MATCH {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_match_scrutinee(expr) as i64, scope));
            let bodies = ast_match_bodies(expr);
            let i: i64 = 0;
            while i < vec_len(bodies) {
                let body = vec_get(bodies, i) as Vec<i64>;
                if ast_is_block(body) {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_block_references_json(names, body, scope));
                } else {
                    result = symbol_table_json_array_append_items(result,
                        symbol_table_expr_references_json(names, body as i64, scope));
                }
                i = i + 1;
            }
        }
        return result + "]";
    }

    fn symbol_table_stmt_references_json(names: Vec<str>, stmt: Vec<i64>, scope: str) -> str {
        let result = "[";
        let kind = ast_kind(stmt);
        if kind == NODE_LET {
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_json(names, ast_let_type_node(stmt), scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_let_init(stmt), scope));
        } else if kind == NODE_RETURN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_return_expr(stmt), scope));
        } else if kind == NODE_IF {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_if_cond(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_if_then(stmt), scope));
            if ast_if_else(stmt) != 0 {
                result = symbol_table_json_array_append_items(result,
                    symbol_table_block_references_json(names, ast_if_else(stmt) as Vec<i64>, scope));
            }
        } else if kind == NODE_WHILE {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_while_cond(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_while_body(stmt), scope));
        } else if kind == NODE_FOR {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_for_start(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_for_end(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_for_body(stmt), scope));
        } else if kind == NODE_LOOP {
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_loop_body(stmt), scope));
        } else if kind == NODE_ASSIGN {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_assign_target(stmt) as i64, scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_assign_value(stmt) as i64, scope));
        } else if kind == NODE_EXPR_STMT {
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_expr_stmt_expr(stmt) as i64, scope));
        }
        return result + "]";
    }

    fn symbol_table_block_references_json(names: Vec<str>, block: Vec<i64>, scope: str) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_stmt_references_json(names, ast_block_stmt(block, i), scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn symbol_table_item_references_json(kernel: Vec<i64>, item: Vec<i64>, kernel_scope: str) -> str {
        let names = ast_kernel_names(kernel);
        let result = "[";
        if ast_is_fn_item(item) {
            let fn_name = ast_report_name(names, ast_fn_name_idx(item));
            let fn_scope = "function:" + fn_name;
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_json(names, ast_fn_return_type(item), fn_scope));
            let params = ast_fn_params(item);
            let i: i64 = 0;
            while i < vec_len(params) {
                let param = vec_get(params, i) as Vec<i64>;
                result = symbol_table_json_array_append_items(result,
                    symbol_table_type_references_json(names, ast_param_type_node(param) as i64, fn_scope));
                i = i + 1;
            }
            result = symbol_table_json_array_append_items(result,
                symbol_table_block_references_json(names, ast_fn_body(item), fn_scope));
        } else if ast_is_const_item(item) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_type_references_json(names, ast_const_type_node(item), kernel_scope));
            result = symbol_table_json_array_append_items(result,
                symbol_table_expr_references_json(names, ast_const_value(item), kernel_scope));
        } else if ast_is_struct_item(item) {
            let struct_scope = "struct:" + ast_report_name(names, ast_struct_name_idx(item));
            let fields = ast_struct_fields(item);
            let i: i64 = 0;
            while i < vec_len(fields) {
                let field = vec_get(fields, i) as Vec<i64>;
                result = symbol_table_json_array_append_items(result,
                    symbol_table_type_references_json(names, ast_field_decl_type_node(field), struct_scope));
                i = i + 1;
            }
        }
        return result + "]";
    }

    fn symbol_table_references_json(kernel: Vec<i64>) -> str {
        let names = ast_kernel_names(kernel);
        let kernel_scope = "kernel:" + ast_report_name(names, ast_name_idx(kernel));
        let result = "[";
        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            result = symbol_table_json_array_append_items(result,
                symbol_table_item_references_json(kernel, vec_get(items, i) as Vec<i64>, kernel_scope));
            i = i + 1;
        }
        return result + "]";
    }

    fn self_host_symbol_table_json(kernel: Vec<i64>) -> str {
        let comma = ",";
        let names = ast_kernel_names(kernel);
        let items = ast_kernel_items(kernel);
        return "{" +
            json_field_str("schema_version", "bunker.self_host.symbol_table.v1") + comma +
            json_field_str("representation", "bootstrap_ast_walk") + comma +
            json_field_bool("complete", false) + comma +
            json_field_bool("declarations", true) + comma +
            json_field_bool("references", true) + comma +
            json_field_str("scope_model", "bootstrap kernel/function/struct scopes paired with BUNKER_RESOLVER_JSON validation") + comma +
            json_field_str("known_limits", "Derived from AST names and paired with BUNKER_RESOLVER_JSON for bootstrap duplicate/unresolved diagnostics; imports, visibility, overloads, and related definition-use spans are not complete yet.") + comma +
            json_field_str("resolver_report", "BUNKER_RESOLVER_JSON") + comma +
            json_field_raw("summary", "{" +
                json_field_i64("interned_name_count", vec_len(names)) + comma +
                json_field_i64("function_count", ast_report_count_kind(items, NODE_FN)) + comma +
                json_field_i64("struct_count", ast_report_count_kind(items, NODE_STRUCT)) + comma +
                json_field_i64("const_count", ast_report_count_kind(items, NODE_CONST)) +
                "}") + comma +
            json_field_raw("declaration_table", symbol_table_declarations_json(kernel)) + comma +
            json_field_raw("reference_table", symbol_table_references_json(kernel)) +
            "}";
    }

    fn build_symbol_table_report_comment(kernel: Vec<i64>) -> str {
        return "/* BUNKER_SYMBOL_TABLE_JSON: " + self_host_symbol_table_json(kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }

    fn resolver_state_new() -> Vec<str> {
        let state: Vec<str> = vec_new();
        return state;
    }

    fn resolver_state_json(state: Vec<str>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(state) {
            if i > 0 {
                result = result + ",";
            }
            let diagnostic: str = vec_get(state, i);
            result = result + diagnostic;
            i = i + 1;
        }
        return result + "]";
    }

    fn resolver_state_count(state: Vec<str>) -> i64 {
        return vec_len(state);
    }

    fn resolver_state_append(state: Vec<str>, diagnostic: str) -> Vec<str> {
        vec_push(state, diagnostic);
        return state;
    }

    fn resolver_i64_vec_contains(values: Vec<i64>, value: i64) -> bool {
        let i: i64 = 0;
        while i < vec_len(values) {
            if vec_get(values, i) == value {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn resolver_empty_i64_vec() -> Vec<i64> {
        let values: Vec<i64> = vec_new();
        return values;
    }

    fn resolver_i64_vec_copy(values: Vec<i64>) -> Vec<i64> {
        let result: Vec<i64> = vec_new();
        let i: i64 = 0;
        while i < vec_len(values) {
            let copied_value: i64 = vec_get(values, i);
            vec_push(result, copied_value);
            i = i + 1;
        }
        return result;
    }

    fn resolver_i64_vec_with(values: Vec<i64>, value: i64) -> Vec<i64> {
        let result: Vec<i64> = resolver_i64_vec_copy(values);
        vec_push(result, value);
        return result;
    }

    fn resolver_diagnostic_json(kind: str, code: str, name: str, scope: str,
                                source_start: i64, source_end: i64,
                                expected: str, actual: str, repair_hint: str) -> str {
        let comma = ",";
        return "{" +
            json_field_str("kind", kind) + comma +
            json_field_str("error_code", code) + comma +
            json_field_str("name", name) + comma +
            json_field_str("scope", scope) + comma +
            json_field_i64("source_start", source_start) + comma +
            json_field_i64("source_end", source_end) + comma +
            json_field_bool("span_known", source_start != AST_SPAN_UNKNOWN && source_end != AST_SPAN_UNKNOWN) + comma +
            json_field_str("expected", expected) + comma +
            json_field_str("actual", actual) + comma +
            json_field_str("repair_hint", repair_hint) +
            "}";
    }

    fn resolver_node_diagnostic_json(kind: str, code: str, name: str, scope: str,
                                     node: Vec<i64>, expected: str, actual: str,
                                     repair_hint: str) -> str {
        return resolver_diagnostic_json(kind, code, name, scope,
            ast_node_span_start(node), ast_node_span_end(node),
            expected, actual, repair_hint);
    }

    fn resolver_pattern_diagnostic_json(kind: str, code: str, name: str, scope: str,
                                        pattern: Vec<i64>, expected: str, actual: str,
                                        repair_hint: str) -> str {
        return resolver_diagnostic_json(kind, code, name, scope,
            ast_pattern_span_start(pattern), ast_pattern_span_end(pattern),
            expected, actual, repair_hint);
    }

    fn resolver_append_duplicate_node(state: Vec<str>, name: str, scope: str,
                                      declaration_kind: str, node: Vec<i64>) -> Vec<str> {
        let hint = "Rename this " + declaration_kind + " or remove the earlier declaration with the same name in this scope.";
        return resolver_state_append(state,
            resolver_node_diagnostic_json("duplicate_declaration", "BKR_SELF_DUPLICATE_SYMBOL",
                name, scope, node, "unique " + declaration_kind + " name", name, hint));
    }

    fn resolver_append_duplicate_pattern(state: Vec<str>, name: str, scope: str,
                                         pattern: Vec<i64>) -> Vec<str> {
        let hint = "Rename this pattern binding or remove the earlier binding with the same name in this pattern scope.";
        return resolver_state_append(state,
            resolver_pattern_diagnostic_json("duplicate_declaration", "BKR_SELF_DUPLICATE_SYMBOL",
                name, scope, pattern, "unique pattern binding", name, hint));
    }

    fn resolver_append_unresolved_node(state: Vec<str>, name: str, scope: str,
                                      reference_kind: str, node: Vec<i64>,
                                      expected: str) -> Vec<str> {
        let hint = "Declare " + name + " in scope " + scope + ", import it through a real module, or correct the misspelled reference.";
        return resolver_state_append(state,
            resolver_node_diagnostic_json("unresolved_reference", "BKR_SELF_UNRESOLVED_SYMBOL",
                name, scope, node, expected, reference_kind + " " + name, hint));
    }

    fn resolver_is_builtin_call(name: str) -> bool {
        if name == "Some" { return true; }
        if name == "len" { return true; }
        if name == "strlen" { return true; }
        if name == "print" { return true; }
        if name == "println" { return true; }
        if name == "read_file" { return true; }
        if name == "write_file" { return true; }
        if name == "file_exists" { return true; }
        if name == "vec_new" { return true; }
        if name == "vec_push" { return true; }
        if name == "vec_get" { return true; }
        if name == "vec_set" { return true; }
        if name == "vec_len" { return true; }
        if name == "vec_pop" { return true; }
        if name == "hashmap_new" { return true; }
        if name == "hashmap_insert" { return true; }
        if name == "hashmap_get" { return true; }
        if name == "hashmap_contains" { return true; }
        if name == "hashmap_remove" { return true; }
        if name == "hashmap_keys" { return true; }
        if name == "char_at" { return true; }
        if name == "char_code" { return true; }
        if name == "char_code_at" { return true; }
        if name == "substring" { return true; }
        if name == "contains" { return true; }
        if name == "starts_with" { return true; }
        if name == "ends_with" { return true; }
        if name == "trim" { return true; }
        if name == "parse_int" { return true; }
        if name == "int_to_string" { return true; }
        if name == "from_char_code" { return true; }
        if name == "result_ok" { return true; }
        if name == "result_err" { return true; }
        if name == "result_is_ok" { return true; }
        if name == "result_is_err" { return true; }
        if name == "result_unwrap" { return true; }
        if name == "result_unwrap_err" { return true; }
        if name == "result_tag" { return true; }
        if name == "result_value" { return true; }
        return false;
    }

    fn resolver_has_function_name(kernel: Vec<i64>, name_idx: i64) -> bool {
        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_fn_item(item) && ast_fn_name_idx(item) == name_idx {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn resolver_has_const_name(kernel: Vec<i64>, name_idx: i64) -> bool {
        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_const_item(item) && ast_const_name_idx(item) == name_idx {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn resolver_has_struct_name(kernel: Vec<i64>, name_idx: i64) -> bool {
        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_struct_item(item) && ast_struct_name_idx(item) == name_idx {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn resolver_struct_has_field(kernel: Vec<i64>, struct_name_idx: i64, field_name_idx: i64) -> bool {
        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_struct_item(item) && ast_struct_name_idx(item) == struct_name_idx {
                let fields = ast_struct_fields(item);
                let j: i64 = 0;
                while j < vec_len(fields) {
                    let field = vec_get(fields, j) as Vec<i64>;
                    if ast_field_decl_name_idx(field) == field_name_idx {
                        return true;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        return false;
    }

    fn resolver_type_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                 type_node: i64, scope: str) -> Vec<str> {
        if type_node != 0 && ast_type_kind_value(type_node) == TYPE_STRUCT {
            let name_idx = ast_type_struct_name_idx_value(type_node);
            if !resolver_has_struct_name(kernel, name_idx) {
                state = resolver_append_unresolved_node(state,
                    ast_report_name(names, name_idx),
                    scope,
                    "type_reference",
                    type_node as Vec<i64>,
                    "declared struct type");
            }
        }
        return state;
    }

    fn resolver_pattern_bindings(state: Vec<str>, names: Vec<str>, pattern: Vec<i64>,
                                 scope: str, bindings: Vec<i64>) -> Vec<str> {
        let kind = ast_pattern_kind(pattern);
        if kind == PAT_BIND || kind == PAT_SOME {
            let name_idx = ast_pattern_value(pattern);
            if resolver_i64_vec_contains(bindings, name_idx) {
                state = resolver_append_duplicate_pattern(state, ast_report_name(names, name_idx), scope, pattern);
            } else {
                vec_push(bindings, name_idx);
            }
        }
        return state;
    }

    fn resolver_expr_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                 expr_value: i64, scope: str, bindings: Vec<i64>) -> Vec<str> {
        if expr_value == 0 {
            return state;
        }

        let expr = expr_value as Vec<i64>;
        let kind = ast_kind(expr);
        if kind == NODE_IDENT {
            let name_idx = ast_name_idx(expr);
            let name = ast_report_name(names, name_idx);
            if name != "None" && !resolver_i64_vec_contains(bindings, name_idx) && !resolver_has_const_name(kernel, name_idx) {
                state = resolver_append_unresolved_node(state, name, scope, "identifier", expr, "local, parameter, for binding, pattern binding, or constant");
            }
        } else if kind == NODE_CALL {
            let name_idx = ast_call_name_idx(expr);
            let name = ast_report_name(names, name_idx);
            if !resolver_is_builtin_call(name) && !resolver_has_function_name(kernel, name_idx) {
                state = resolver_append_unresolved_node(state, name, scope, "function_call", expr, "declared function or supported bootstrap builtin");
            }
            let args = ast_call_args(expr);
            let i: i64 = 0;
            while i < vec_len(args) {
                state = resolver_expr_diagnostics(state, kernel, names, vec_get(args, i), scope, bindings);
                i = i + 1;
            }
        } else if kind == NODE_STRUCT_LIT {
            let struct_name_idx = ast_struct_lit_name_idx(expr);
            let struct_name = ast_report_name(names, struct_name_idx);
            if !resolver_has_struct_name(kernel, struct_name_idx) {
                state = resolver_append_unresolved_node(state, struct_name, scope, "struct_literal", expr, "declared struct");
            }

            let field_names = ast_struct_lit_field_names(expr);
            let field_values = ast_struct_lit_field_values(expr);
            let seen_fields: Vec<i64> = vec_new();
            let i: i64 = 0;
            while i < vec_len(field_names) {
                let field_name_idx = vec_get(field_names, i);
                let field_name = ast_report_name(names, field_name_idx);
                if resolver_i64_vec_contains(seen_fields, field_name_idx) {
                    state = resolver_append_unresolved_node(state, field_name, scope, "field_initializer", expr, "one initializer per field");
                } else {
                    vec_push(seen_fields, field_name_idx);
                    if resolver_has_struct_name(kernel, struct_name_idx) && !resolver_struct_has_field(kernel, struct_name_idx, field_name_idx) {
                        state = resolver_append_unresolved_node(state, field_name, scope, "field_initializer", expr, "field declared on struct " + struct_name);
                    }
                }
                state = resolver_expr_diagnostics(state, kernel, names, vec_get(field_values, i), scope, bindings);
                i = i + 1;
            }
        } else if kind == NODE_FIELD_ACCESS {
            state = resolver_expr_diagnostics(state, kernel, names, ast_field_base(expr) as i64, scope, bindings);
        } else if kind == NODE_BINARY {
            state = resolver_expr_diagnostics(state, kernel, names, ast_binary_left(expr) as i64, scope, bindings);
            state = resolver_expr_diagnostics(state, kernel, names, ast_binary_right(expr) as i64, scope, bindings);
        } else if kind == NODE_UNARY {
            state = resolver_expr_diagnostics(state, kernel, names, ast_unary_operand(expr) as i64, scope, bindings);
        } else if kind == NODE_TERNARY {
            state = resolver_expr_diagnostics(state, kernel, names, ast_ternary_cond(expr) as i64, scope, bindings);
            state = resolver_expr_diagnostics(state, kernel, names, ast_ternary_then(expr) as i64, scope, bindings);
            state = resolver_expr_diagnostics(state, kernel, names, ast_ternary_else(expr) as i64, scope, bindings);
        } else if kind == NODE_ARRAY_LIT {
            let elements = ast_array_elements(expr);
            let i: i64 = 0;
            while i < vec_len(elements) {
                state = resolver_expr_diagnostics(state, kernel, names, vec_get(elements, i), scope, bindings);
                i = i + 1;
            }
        } else if kind == NODE_INDEX {
            state = resolver_expr_diagnostics(state, kernel, names, ast_index_base(expr) as i64, scope, bindings);
            state = resolver_expr_diagnostics(state, kernel, names, ast_index_expr(expr) as i64, scope, bindings);
        } else if kind == NODE_MATCH {
            state = resolver_expr_diagnostics(state, kernel, names, ast_match_scrutinee(expr) as i64, scope, bindings);
            let patterns = ast_match_patterns(expr);
            let bodies = ast_match_bodies(expr);
            let i: i64 = 0;
            while i < vec_len(patterns) {
                let arm_bindings = resolver_i64_vec_copy(bindings);
                let pattern_bindings: Vec<i64> = vec_new();
                state = resolver_pattern_bindings(state, names, vec_get(patterns, i) as Vec<i64>, scope, pattern_bindings);
                let j: i64 = 0;
                while j < vec_len(pattern_bindings) {
                    let binding_name_idx: i64 = vec_get(pattern_bindings, j);
                    vec_push(arm_bindings, binding_name_idx);
                    j = j + 1;
                }

                let body = vec_get(bodies, i) as Vec<i64>;
                if ast_is_block(body) {
                    state = resolver_block_diagnostics(state, kernel, names, body, scope, arm_bindings, resolver_empty_i64_vec());
                } else {
                    state = resolver_expr_diagnostics(state, kernel, names, body as i64, scope, arm_bindings);
                }
                i = i + 1;
            }
        }
        return state;
    }

    fn resolver_stmt_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                 stmt: Vec<i64>, scope: str,
                                 bindings: Vec<i64>, declared: Vec<i64>) -> Vec<str> {
        let kind = ast_kind(stmt);
        if kind == NODE_LET {
            let name_idx = ast_let_name_idx(stmt);
            state = resolver_type_diagnostics(state, kernel, names, ast_let_type_node(stmt), scope);
            state = resolver_expr_diagnostics(state, kernel, names, ast_let_init(stmt), scope, bindings);
            if resolver_i64_vec_contains(declared, name_idx) {
                state = resolver_append_duplicate_node(state, ast_report_name(names, name_idx), scope, "local", stmt);
            } else {
                vec_push(declared, name_idx);
            }
            vec_push(bindings, name_idx);
        } else if kind == NODE_RETURN {
            state = resolver_expr_diagnostics(state, kernel, names, ast_return_expr(stmt), scope, bindings);
        } else if kind == NODE_IF {
            state = resolver_expr_diagnostics(state, kernel, names, ast_if_cond(stmt) as i64, scope, bindings);
            state = resolver_block_diagnostics(state, kernel, names, ast_if_then(stmt), scope, bindings, resolver_empty_i64_vec());
            if ast_if_else(stmt) != 0 {
                state = resolver_block_diagnostics(state, kernel, names, ast_if_else(stmt) as Vec<i64>, scope, bindings, resolver_empty_i64_vec());
            }
        } else if kind == NODE_WHILE {
            state = resolver_expr_diagnostics(state, kernel, names, ast_while_cond(stmt) as i64, scope, bindings);
            state = resolver_block_diagnostics(state, kernel, names, ast_while_body(stmt), scope, bindings, resolver_empty_i64_vec());
        } else if kind == NODE_FOR {
            let name_idx = ast_for_name_idx(stmt);
            state = resolver_expr_diagnostics(state, kernel, names, ast_for_start(stmt) as i64, scope, bindings);
            state = resolver_expr_diagnostics(state, kernel, names, ast_for_end(stmt) as i64, scope, bindings);
            if resolver_i64_vec_contains(declared, name_idx) {
                state = resolver_append_duplicate_node(state, ast_report_name(names, name_idx), scope, "for binding", stmt);
            }
            let loop_bindings = resolver_i64_vec_with(bindings, name_idx);
            state = resolver_block_diagnostics(state, kernel, names, ast_for_body(stmt), scope, loop_bindings, resolver_empty_i64_vec());
        } else if kind == NODE_LOOP {
            state = resolver_block_diagnostics(state, kernel, names, ast_loop_body(stmt), scope, bindings, resolver_empty_i64_vec());
        } else if kind == NODE_ASSIGN {
            state = resolver_expr_diagnostics(state, kernel, names, ast_assign_target(stmt) as i64, scope, bindings);
            state = resolver_expr_diagnostics(state, kernel, names, ast_assign_value(stmt) as i64, scope, bindings);
        } else if kind == NODE_EXPR_STMT {
            state = resolver_expr_diagnostics(state, kernel, names, ast_expr_stmt_expr(stmt) as i64, scope, bindings);
        }
        return state;
    }

    fn resolver_block_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                  block: Vec<i64>, scope: str,
                                  parent_bindings: Vec<i64>, declared_seed: Vec<i64>) -> Vec<str> {
        let bindings = resolver_i64_vec_copy(parent_bindings);
        let declared = resolver_i64_vec_copy(declared_seed);
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            state = resolver_stmt_diagnostics(state, kernel, names, ast_block_stmt(block, i), scope, bindings, declared);
            i = i + 1;
        }
        return state;
    }

    fn resolver_function_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                     item: Vec<i64>, kernel_scope: str) -> Vec<str> {
        let fn_name = ast_report_name(names, ast_fn_name_idx(item));
        let fn_scope = "function:" + fn_name;
        state = resolver_type_diagnostics(state, kernel, names, ast_fn_return_type(item), fn_scope);

        let params = ast_fn_params(item);
        let bindings: Vec<i64> = vec_new();
        let declared: Vec<i64> = vec_new();
        let i: i64 = 0;
        while i < vec_len(params) {
            let param = vec_get(params, i) as Vec<i64>;
            let name_idx = ast_param_name_idx(param);
            state = resolver_type_diagnostics(state, kernel, names, ast_param_type_node(param) as i64, fn_scope);
            if resolver_i64_vec_contains(declared, name_idx) {
                state = resolver_append_duplicate_node(state, ast_report_name(names, name_idx), fn_scope, "parameter", param);
            } else {
                vec_push(declared, name_idx);
            }
            vec_push(bindings, name_idx);
            i = i + 1;
        }

        return resolver_block_diagnostics(state, kernel, names, ast_fn_body(item), fn_scope, bindings, declared);
    }

    fn resolver_struct_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                   item: Vec<i64>) -> Vec<str> {
        let struct_name = ast_report_name(names, ast_struct_name_idx(item));
        let struct_scope = "struct:" + struct_name;
        let fields = ast_struct_fields(item);
        let declared: Vec<i64> = vec_new();
        let i: i64 = 0;
        while i < vec_len(fields) {
            let field = vec_get(fields, i) as Vec<i64>;
            let name_idx = ast_field_decl_name_idx(field);
            if resolver_i64_vec_contains(declared, name_idx) {
                state = resolver_append_duplicate_node(state, ast_report_name(names, name_idx), struct_scope, "field", field);
            } else {
                vec_push(declared, name_idx);
            }
            state = resolver_type_diagnostics(state, kernel, names, ast_field_decl_type_node(field), struct_scope);
            i = i + 1;
        }
        return state;
    }

    fn resolver_top_level_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>) -> Vec<str> {
        let kernel_scope = "kernel:" + ast_report_name(names, ast_name_idx(kernel));
        let declared: Vec<i64> = vec_new();
        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            let name_idx: i64 = -1;
            let declaration_kind = "item";
            if ast_is_fn_item(item) {
                name_idx = ast_fn_name_idx(item);
                declaration_kind = "function";
            } else if ast_is_const_item(item) {
                name_idx = ast_const_name_idx(item);
                declaration_kind = "constant";
            } else if ast_is_struct_item(item) {
                name_idx = ast_struct_name_idx(item);
                declaration_kind = "struct";
            }

            if name_idx >= 0 {
                if resolver_i64_vec_contains(declared, name_idx) {
                    state = resolver_append_duplicate_node(state, ast_report_name(names, name_idx), kernel_scope, declaration_kind, item);
                } else {
                    vec_push(declared, name_idx);
                }
            }
            i = i + 1;
        }
        return state;
    }

    fn resolver_kernel_diagnostics(state: Vec<str>, kernel: Vec<i64>) -> Vec<str> {
        let names = ast_kernel_names(kernel);
        let kernel_scope = "kernel:" + ast_report_name(names, ast_name_idx(kernel));
        state = resolver_top_level_diagnostics(state, kernel, names);

        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_fn_item(item) {
                state = resolver_function_diagnostics(state, kernel, names, item, kernel_scope);
            } else if ast_is_const_item(item) {
                state = resolver_type_diagnostics(state, kernel, names, ast_const_type_node(item), kernel_scope);
                state = resolver_expr_diagnostics(state, kernel, names, ast_const_value(item), kernel_scope, resolver_empty_i64_vec());
            } else if ast_is_struct_item(item) {
                state = resolver_struct_diagnostics(state, kernel, names, item);
            }
            i = i + 1;
        }
        return state;
    }

    fn self_host_resolver_json(kernel: Vec<i64>) -> str {
        let comma = ",";
        let state = resolver_state_new();
        resolver_kernel_diagnostics(state, kernel);
        return "{" +
            json_field_str("schema_version", "bunker.self_host.resolver.v1") + comma +
            json_field_str("representation", "bootstrap_name_resolver") + comma +
            json_field_bool("complete", false) + comma +
            json_field_bool("duplicate_detection", true) + comma +
            json_field_bool("unresolved_detection", true) + comma +
            json_field_bool("has_diagnostics", resolver_state_count(state) > 0) + comma +
            json_field_i64("diagnostic_count", resolver_state_count(state)) + comma +
            json_field_str("scope_model", "kernel globals plus function/block/pattern binding scopes using interned names") + comma +
            json_field_str("known_limits", "Bootstrap resolver validates duplicate declarations and unresolved identifiers, calls, struct types, struct literals, and struct literal fields; it does not yet resolve imports, visibility, overloads, method receiver fields, or related definition spans.") + comma +
            json_field_raw("diagnostics", resolver_state_json(state)) +
            "}";
    }

    fn build_resolver_report_comment(kernel: Vec<i64>) -> str {
        return "/* BUNKER_RESOLVER_JSON: " + self_host_resolver_json(kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }

    fn typecheck_is_integer_kind(kind: i64) -> bool {
        return kind == TYPE_I32 || kind == TYPE_I64;
    }

    fn typecheck_kinds_compatible(expected_kind: i64, found_kind: i64) -> bool {
        if expected_kind == TYPE_UNKNOWN || found_kind == TYPE_UNKNOWN {
            return true;
        }
        if expected_kind == found_kind {
            return true;
        }
        if typecheck_is_integer_kind(expected_kind) && typecheck_is_integer_kind(found_kind) {
            return true;
        }
        return false;
    }

    fn typecheck_is_scalar_cast_kind(kind: i64) -> bool {
        return kind == TYPE_I32 || kind == TYPE_I64 || kind == TYPE_F64 || kind == TYPE_BOOL;
    }

    fn typecheck_value_kinds_compatible(expected_kind: i64, found_kind: i64) -> bool {
        if typecheck_kinds_compatible(expected_kind, found_kind) {
            return true;
        }
        if typecheck_is_scalar_cast_kind(expected_kind) && typecheck_is_scalar_cast_kind(found_kind) {
            return true;
        }
        return false;
    }

    fn typecheck_expr_kind(cstate: Vec<i64>, expr_value: i64) -> i64 {
        if expr_value == 0 {
            return TYPE_UNKNOWN;
        }
        return infer_c_expr_type(cstate, expr_value as Vec<i64>);
    }

    fn typecheck_declared_kind(type_node: i64) -> i64 {
        if type_node == 0 {
            return TYPE_UNKNOWN;
        }
        return ast_type_kind_value(type_node);
    }

    fn typecheck_return_kind(fn_node: Vec<i64>) -> i64 {
        let return_type = ast_fn_return_type(fn_node);
        if return_type == 0 {
            return TYPE_VOID;
        }
        return ast_type_kind_value(return_type);
    }

    fn typecheck_diagnostic_json(kind: str, code: str, name: str, scope: str,
                                 node: Vec<i64>, expected: str, found: str,
                                 repair_hint: str) -> str {
        let comma = ",";
        return "{" +
            json_field_str("kind", kind) + comma +
            json_field_str("error_code", code) + comma +
            json_field_str("name", name) + comma +
            json_field_str("scope", scope) + comma +
            json_field_i64("source_start", ast_node_span_start(node)) + comma +
            json_field_i64("source_end", ast_node_span_end(node)) + comma +
            json_field_bool("span_known", ast_node_span_start(node) != AST_SPAN_UNKNOWN && ast_node_span_end(node) != AST_SPAN_UNKNOWN) + comma +
            json_field_str("expected", expected) + comma +
            json_field_str("found", found) + comma +
            json_field_str("repair_hint", repair_hint) +
            "}";
    }

    fn typecheck_append_mismatch(state: Vec<str>, kind: str, name: str, scope: str,
                                 node: Vec<i64>, expected_kind: i64, found_kind: i64,
                                 repair_hint: str) -> Vec<str> {
        return resolver_state_append(state,
            typecheck_diagnostic_json(kind, "BKR_SELF_TYPE_MISMATCH", name, scope,
                node, ast_type_kind_name(expected_kind), ast_type_kind_name(found_kind), repair_hint));
    }

    fn typecheck_maybe_append_mismatch(state: Vec<str>, kind: str, name: str, scope: str,
                                       node: Vec<i64>, expected_kind: i64, found_kind: i64,
                                       repair_hint: str) -> Vec<str> {
        if !typecheck_kinds_compatible(expected_kind, found_kind) {
            state = typecheck_append_mismatch(state, kind, name, scope,
                node, expected_kind, found_kind, repair_hint);
        }
        return state;
    }

    fn typecheck_maybe_append_value_mismatch(state: Vec<str>, kind: str, name: str, scope: str,
                                             node: Vec<i64>, expected_kind: i64, found_kind: i64,
                                             repair_hint: str) -> Vec<str> {
        if !typecheck_value_kinds_compatible(expected_kind, found_kind) {
            state = typecheck_append_mismatch(state, kind, name, scope,
                node, expected_kind, found_kind, repair_hint);
        }
        return state;
    }

    fn typecheck_find_function(kernel: Vec<i64>, name_idx: i64) -> i64 {
        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_fn_item(item) && ast_fn_name_idx(item) == name_idx {
                return item as i64;
            }
            i = i + 1;
        }
        return 0;
    }

    fn typecheck_check_expression_against(state: Vec<str>, names: Vec<str>, cstate: Vec<i64>,
                                          expr_value: i64, scope: str, diagnostic_kind: str,
                                          name: str, expected_kind: i64, repair_hint: str) -> Vec<str> {
        if expr_value == 0 {
            if expected_kind != TYPE_VOID && expected_kind != TYPE_UNKNOWN {
                let placeholder: Vec<i64> = ast_new(NODE_RETURN);
                state = typecheck_append_mismatch(state, diagnostic_kind, name, scope,
                    placeholder, expected_kind, TYPE_VOID, repair_hint);
            }
            return state;
        }

        let expr = expr_value as Vec<i64>;
        let found_kind = typecheck_expr_kind(cstate, expr_value);
        return typecheck_maybe_append_mismatch(state, diagnostic_kind, name, scope,
            expr, expected_kind, found_kind, repair_hint);
    }

    fn typecheck_check_call_arguments(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                      cstate: Vec<i64>, expr: Vec<i64>, scope: str) -> Vec<str> {
        let name_idx = ast_call_name_idx(expr);
        let fn_value = typecheck_find_function(kernel, name_idx);
        if fn_value == 0 {
            return state;
        }

        let fn_node = fn_value as Vec<i64>;
        let fn_name = ast_report_name(names, name_idx);
        let params = ast_fn_params(fn_node);
        let args = ast_call_args(expr);
        let i: i64 = 0;
        while i < vec_len(args) && i < vec_len(params) {
            let param = vec_get(params, i) as Vec<i64>;
            let param_type = ast_param_type_node(param) as i64;
            let arg_value: i64 = vec_get(args, i);
            let expected_kind = ast_type_kind_value(param_type);
            let found_kind = typecheck_expr_kind(cstate, arg_value);
            let hint = "Change argument " + int_to_string(i + 1) + " for " + fn_name +
                " to match parameter " + ast_report_name(names, ast_param_name_idx(param)) +
                " or update the function signature.";
            state = typecheck_maybe_append_mismatch(state, "call_argument_type_mismatch", fn_name,
                scope, arg_value as Vec<i64>, expected_kind, found_kind, hint);
            i = i + 1;
        }
        return state;
    }

    fn typecheck_expr_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                  cstate: Vec<i64>, expr_value: i64, scope: str,
                                  expected_return_kind: i64) -> Vec<str> {
        if expr_value == 0 {
            return state;
        }

        let expr = expr_value as Vec<i64>;
        let kind = ast_kind(expr);
        if kind == NODE_CALL {
            state = typecheck_check_call_arguments(state, kernel, names, cstate, expr, scope);
            let args = ast_call_args(expr);
            let i: i64 = 0;
            while i < vec_len(args) {
                state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                    vec_get(args, i), scope, expected_return_kind);
                i = i + 1;
            }
        } else if kind == NODE_STRUCT_LIT {
            let field_values = ast_struct_lit_field_values(expr);
            let i: i64 = 0;
            while i < vec_len(field_values) {
                state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                    vec_get(field_values, i), scope, expected_return_kind);
                i = i + 1;
            }
        } else if kind == NODE_FIELD_ACCESS {
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_field_base(expr) as i64, scope, expected_return_kind);
        } else if kind == NODE_BINARY {
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_binary_left(expr) as i64, scope, expected_return_kind);
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_binary_right(expr) as i64, scope, expected_return_kind);
        } else if kind == NODE_UNARY {
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_unary_operand(expr) as i64, scope, expected_return_kind);
        } else if kind == NODE_TERNARY {
            state = typecheck_check_expression_against(state, names, cstate,
                ast_ternary_cond(expr) as i64, scope, "condition_type_mismatch", "ternary condition",
                TYPE_BOOL, "Make this ternary condition produce bool.");
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_ternary_cond(expr) as i64, scope, expected_return_kind);
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_ternary_then(expr) as i64, scope, expected_return_kind);
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_ternary_else(expr) as i64, scope, expected_return_kind);
        } else if kind == NODE_ARRAY_LIT {
            let elements = ast_array_elements(expr);
            let i: i64 = 0;
            while i < vec_len(elements) {
                state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                    vec_get(elements, i), scope, expected_return_kind);
                i = i + 1;
            }
        } else if kind == NODE_INDEX {
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_index_base(expr) as i64, scope, expected_return_kind);
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_index_expr(expr) as i64, scope, expected_return_kind);
        } else if kind == NODE_MATCH {
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_match_scrutinee(expr) as i64, scope, expected_return_kind);
            let bodies = ast_match_bodies(expr);
            let i: i64 = 0;
            while i < vec_len(bodies) {
                let body = vec_get(bodies, i) as Vec<i64>;
                if ast_is_block(body) {
                    state = typecheck_block_diagnostics(state, kernel, names, cstate,
                        body, scope, expected_return_kind);
                } else {
                    state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                        body as i64, scope, expected_return_kind);
                }
                i = i + 1;
            }
        }
        return state;
    }

    fn typecheck_stmt_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                  cstate: Vec<i64>, stmt: Vec<i64>, scope: str,
                                  expected_return_kind: i64) -> Vec<str> {
        let kind = ast_kind(stmt);
        if kind == NODE_LET {
            let init = ast_let_init(stmt);
            let name = ast_report_name(names, ast_let_name_idx(stmt));
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                init, scope, expected_return_kind);
            if ast_let_type_node(stmt) != 0 && init != 0 {
                let expected_kind = typecheck_declared_kind(ast_let_type_node(stmt));
                let found_kind = typecheck_expr_kind(cstate, init);
                let hint = "Change the initializer for " + name +
                    " or update the declared local type.";
                state = typecheck_maybe_append_value_mismatch(state, "annotation_type_mismatch",
                    name, scope, stmt, expected_kind, found_kind, hint);
            }
            type_graph_add_let_to_state(cstate, stmt);
        } else if kind == NODE_RETURN {
            let return_expr = ast_return_expr(stmt);
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                return_expr, scope, expected_return_kind);
            if return_expr == 0 {
                if expected_return_kind != TYPE_VOID && expected_return_kind != TYPE_UNKNOWN {
                    state = typecheck_append_mismatch(state, "return_type_mismatch", "return",
                        scope, stmt, expected_return_kind, TYPE_VOID,
                        "Return a value matching the function return type or change the function signature.");
                }
            } else {
                let found_kind = typecheck_expr_kind(cstate, return_expr);
                state = typecheck_maybe_append_value_mismatch(state, "return_type_mismatch", "return",
                    scope, stmt, expected_return_kind, found_kind,
                    "Return a value matching the function return type or change the function signature.");
            }
        } else if kind == NODE_IF {
            state = typecheck_check_expression_against(state, names, cstate,
                ast_if_cond(stmt) as i64, scope, "condition_type_mismatch", "if condition",
                TYPE_BOOL, "Make this if condition produce bool.");
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_if_cond(stmt) as i64, scope, expected_return_kind);
            state = typecheck_block_diagnostics(state, kernel, names, cstate,
                ast_if_then(stmt), scope, expected_return_kind);
            if ast_if_else(stmt) != 0 {
                state = typecheck_block_diagnostics(state, kernel, names, cstate,
                    ast_if_else(stmt) as Vec<i64>, scope, expected_return_kind);
            }
        } else if kind == NODE_WHILE {
            state = typecheck_check_expression_against(state, names, cstate,
                ast_while_cond(stmt) as i64, scope, "condition_type_mismatch", "while condition",
                TYPE_BOOL, "Make this while condition produce bool.");
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_while_cond(stmt) as i64, scope, expected_return_kind);
            state = typecheck_block_diagnostics(state, kernel, names, cstate,
                ast_while_body(stmt), scope, expected_return_kind);
        } else if kind == NODE_FOR {
            state = typecheck_check_expression_against(state, names, cstate,
                ast_for_start(stmt) as i64, scope, "for_range_type_mismatch", "for range start",
                TYPE_I64, "Make the for range start numeric.");
            state = typecheck_check_expression_against(state, names, cstate,
                ast_for_end(stmt) as i64, scope, "for_range_type_mismatch", "for range end",
                TYPE_I64, "Make the for range end numeric.");
            cgen_add_local_type(cstate, ast_for_name_idx(stmt), TYPE_I64);
            state = typecheck_block_diagnostics(state, kernel, names, cstate,
                ast_for_body(stmt), scope, expected_return_kind);
        } else if kind == NODE_LOOP {
            state = typecheck_block_diagnostics(state, kernel, names, cstate,
                ast_loop_body(stmt), scope, expected_return_kind);
        } else if kind == NODE_ASSIGN {
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_assign_target(stmt) as i64, scope, expected_return_kind);
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_assign_value(stmt) as i64, scope, expected_return_kind);
            let expected_kind = typecheck_expr_kind(cstate, ast_assign_target(stmt) as i64);
            let found_kind = typecheck_expr_kind(cstate, ast_assign_value(stmt) as i64);
            state = typecheck_maybe_append_value_mismatch(state, "assignment_type_mismatch",
                "assignment", scope, stmt, expected_kind, found_kind,
                "Assign a value that matches the target type.");
        } else if kind == NODE_EXPR_STMT {
            state = typecheck_expr_diagnostics(state, kernel, names, cstate,
                ast_expr_stmt_expr(stmt) as i64, scope, expected_return_kind);
        }
        return state;
    }

    fn typecheck_block_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                   cstate: Vec<i64>, block: Vec<i64>, scope: str,
                                   expected_return_kind: i64) -> Vec<str> {
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            state = typecheck_stmt_diagnostics(state, kernel, names, cstate,
                ast_block_stmt(block, i), scope, expected_return_kind);
            i = i + 1;
        }
        return state;
    }

    fn typecheck_const_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                   cstate: Vec<i64>, item: Vec<i64>, kernel_scope: str) -> Vec<str> {
        let const_name = ast_report_name(names, ast_const_name_idx(item));
        let value = ast_const_value(item);
        state = typecheck_expr_diagnostics(state, kernel, names, cstate,
            value, kernel_scope, TYPE_UNKNOWN);
        if ast_const_type_node(item) != 0 && value != 0 {
            let expected_kind = typecheck_declared_kind(ast_const_type_node(item));
            let found_kind = typecheck_expr_kind(cstate, value);
            let hint = "Change the initializer for " + const_name +
                " or update the declared constant type.";
            state = typecheck_maybe_append_value_mismatch(state, "annotation_type_mismatch",
                const_name, kernel_scope, item, expected_kind, found_kind, hint);
        }
        return state;
    }

    fn typecheck_function_diagnostics(state: Vec<str>, kernel: Vec<i64>, names: Vec<str>,
                                      item: Vec<i64>) -> Vec<str> {
        let fn_name = ast_report_name(names, ast_fn_name_idx(item));
        let scope = "function:" + fn_name;
        let cstate = type_graph_function_state(kernel, item);
        let expected_return_kind = typecheck_return_kind(item);
        return typecheck_block_diagnostics(state, kernel, names, cstate,
            ast_fn_body(item), scope, expected_return_kind);
    }

    fn typecheck_kernel_diagnostics(state: Vec<str>, kernel: Vec<i64>) -> Vec<str> {
        let names = ast_kernel_names(kernel);
        let kernel_scope = "kernel:" + ast_report_name(names, ast_name_idx(kernel));
        let cstate = type_graph_seed_state(kernel);
        let items = ast_kernel_items(kernel);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if ast_is_const_item(item) {
                state = typecheck_const_diagnostics(state, kernel, names, cstate,
                    item, kernel_scope);
            } else if ast_is_fn_item(item) {
                state = typecheck_function_diagnostics(state, kernel, names, item);
            }
            i = i + 1;
        }
        return state;
    }

    fn self_host_typecheck_json(kernel: Vec<i64>) -> str {
        let comma = ",";
        let state = resolver_state_new();
        typecheck_kernel_diagnostics(state, kernel);
        return "{" +
            json_field_str("schema_version", "bunker.self_host.typecheck.v1") + comma +
            json_field_str("representation", "bootstrap_typecheck_pass") + comma +
            json_field_bool("complete", false) + comma +
            json_field_bool("annotation_checks", true) + comma +
            json_field_bool("return_checks", true) + comma +
            json_field_bool("condition_checks", true) + comma +
            json_field_bool("call_argument_checks", true) + comma +
            json_field_bool("has_diagnostics", resolver_state_count(state) > 0) + comma +
            json_field_i64("diagnostic_count", resolver_state_count(state)) + comma +
            json_field_str("known_limits", "Bootstrap typecheck report compares declared annotations, returns, conditions, assignments, for ranges, and direct user-function call arguments using codegen inference; value assignment/return checks permit scalar cast-compatible types until casts are preserved in the AST. It does not yet enforce full generics, struct field value types, numeric ranges, trait bounds, exhaustiveness, or cross-module types.") + comma +
            json_field_raw("diagnostics", resolver_state_json(state)) +
            "}";
    }

    fn build_typecheck_report_comment(kernel: Vec<i64>) -> str {
        return "/* BUNKER_TYPECHECK_JSON: " + self_host_typecheck_json(kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }

    fn build_import_diagnostic(missing_import: str) -> str {
        let repair_hint = "Copy the imported Bunker module next to self_host_input.bkr or pre-expand imports before running bkrc.";
        let message = "Import error: missing module " + missing_import;
        let json = self_host_diagnostic_json("import", "BKR_SELF_IMPORT", message,
            0, 0, 1, 1, "existing imported module", missing_import, repair_hint);
        return "/* " + message + ". AI repair hint: " + repair_hint + from_char_code(10) +
            "BUNKER_DIAGNOSTIC_JSON: " + json + from_char_code(10) +
            "*/";
    }

    fn build_parse_diagnostic(source: str, p: Vec<i64>) -> str {
        let expected = token_name(parser_error_expected(p));
        let actual = token_name(parser_error_actual(p));
        let error_span = parser_error_span(p);
        let source_start = ast_span_start(error_span);
        let source_end = ast_span_end(error_span);
        let source_line = source_line_at(source, source_start);
        let source_column = source_column_at(source, source_start);
        let repair_hint = "Inspect the construct before this token. Supported bootstrap syntax includes kernel, struct, fn, const, let, fixed arrays, field access, if, else, match expressions, Option<T> via Some/None, Result<T,E> via result_* builtins, Vec<T> and HashMap<i32,V> runtime handles, for-in ranges, while, loop, break, continue, return, primitive types, calls, casts, ternary expressions, bitwise operators, and basic expressions.";
        let message = "Parse error at token " + int_to_string(parser_error_position(p)) +
            ": expected " + expected + ", got " + actual;
        let json = self_host_diagnostic_json("parse", "BKR_SELF_PARSE", message,
            source_start, source_end, source_line, source_column, expected, actual, repair_hint);
        return "/* " + message + ". AI repair hint: " + repair_hint + from_char_code(10) +
            "BUNKER_DIAGNOSTIC_JSON: " + json + from_char_code(10) +
            "*/";
    }

    fn compile_to_c(source: str) -> str {
        let capability_report = build_capability_report_comment();
        let missing_import = first_missing_import_path(source);
        if len(missing_import) > 0 {
            return capability_report + build_import_diagnostic(missing_import) + from_char_code(10);
        }

        let expanded_source = expand_imports(source);
        let lex_result: Vec<i64> = tokenize(expanded_source);
        let p: Vec<i64> = parser_new(lex_result);
        let ast: Vec<i64> = parse_kernel(p);

        if parser_has_error(p) {
            return capability_report + build_parse_diagnostic(expanded_source, p) + from_char_code(10);
        }

        return capability_report + build_ast_report_comment(expanded_source, ast) +
            build_type_graph_report_comment(ast) +
            build_symbol_table_report_comment(ast) +
            build_resolver_report_comment(ast) +
            build_typecheck_report_comment(ast) +
            gen_c_program(ast);
    }

    fn main() -> i32 {
        // File-based entrypoint for agents and the Rust wrapper:
        // write self_host_input.bkr, run this program, read self_host_output.c.
        let input_path = "self_host_input.bkr";
        let output_path = "self_host_output.c";

        let default_source = "kernel Test { fn main() -> i32 { let x: i32 = 40; let y: i32 = 2; return x + y; } }";
        if !file_exists(input_path) {
            write_file(input_path, default_source);
        }

        let source = read_file(input_path);
        let c_code = compile_to_c(source);
        let wrote = write_file(output_path, c_code);
        if !wrote {
            return 1;
        }

        if !file_exists(output_path) {
            return 2;
        }

        return 42;
    }
