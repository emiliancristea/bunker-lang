    // ========================================
    // CONTRACT VERIFICATION ENGINE
    // ========================================
    //
    // Pure Bunker implementation of the Formal Contract Verification Engine (BKR-SPEC-VERIFY-001).
    // Provides linear arithmetic expression representation, symbolic execution tracking,
    // precondition/postcondition verification, and counterexample synthesis.

    struct LinExpr {
        var_names: Vec<str>,
        var_coeffs: Vec<i64>,
        constant: i64,
    }

    struct VerifyContract {
        func_name: str,
        requires_desc: Vec<str>,
        ensures_desc: Vec<str>,
        requires_satisfied: bool,
        ensures_verified: bool,
        counterexample: str,
    }

    fn lin_expr_new() -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: 0,
        };
    }

    fn lin_expr_constant(c: i64) -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: c,
        };
    }

    fn lin_expr_var(name: str) -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        vec_push(names, name);
        vec_push(coeffs, 1);
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: 0,
        };
    }

    fn lin_expr_var_with_coeff(name: str, coeff: i64) -> LinExpr {
        let names: Vec<str> = vec_new();
        let coeffs: Vec<i64> = vec_new();
        vec_push(names, name);
        vec_push(coeffs, coeff);
        return LinExpr {
            var_names: names,
            var_coeffs: coeffs,
            constant: 0,
        };
    }

    fn lin_expr_get_coeff(expr: LinExpr, name: str) -> i64 {
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            if vec_get(expr.var_names, i) == name {
                return vec_get(expr.var_coeffs, i);
            }
            i = i + 1;
        }
        return 0;
    }

    fn lin_expr_set_coeff(expr: LinExpr, name: str, coeff: i64) -> bool {
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            if vec_get(expr.var_names, i) == name {
                vec_set(expr.var_coeffs, i, coeff);
                return true;
            }
            i = i + 1;
        }
        vec_push(expr.var_names, name);
        vec_push(expr.var_coeffs, coeff);
        return true;
    }

    fn lin_expr_add(a: LinExpr, b: LinExpr) -> LinExpr {
        let res = lin_expr_new();
        res.constant = a.constant + b.constant;

        let mut i: i64 = 0;
        let len_a = vec_len(a.var_names);
        while i < len_a {
            let name = vec_get(a.var_names, i);
            let coeff = vec_get(a.var_coeffs, i);
            lin_expr_set_coeff(res, name, coeff);
            i = i + 1;
        }

        let mut j: i64 = 0;
        let len_b = vec_len(b.var_names);
        while j < len_b {
            let name = vec_get(b.var_names, j);
            let coeff = vec_get(b.var_coeffs, j);
            let existing = lin_expr_get_coeff(res, name);
            lin_expr_set_coeff(res, name, existing + coeff);
            j = j + 1;
        }

        return res;
    }

    fn lin_expr_sub(a: LinExpr, b: LinExpr) -> LinExpr {
        let res = lin_expr_new();
        res.constant = a.constant - b.constant;

        let mut i: i64 = 0;
        let len_a = vec_len(a.var_names);
        while i < len_a {
            let name = vec_get(a.var_names, i);
            let coeff = vec_get(a.var_coeffs, i);
            lin_expr_set_coeff(res, name, coeff);
            i = i + 1;
        }

        let mut j: i64 = 0;
        let len_b = vec_len(b.var_names);
        while j < len_b {
            let name = vec_get(b.var_names, j);
            let coeff = vec_get(b.var_coeffs, j);
            let existing = lin_expr_get_coeff(res, name);
            lin_expr_set_coeff(res, name, existing - coeff);
            j = j + 1;
        }

        return res;
    }

    fn lin_expr_mul_const(a: LinExpr, k: i64) -> LinExpr {
        let res = lin_expr_new();
        res.constant = a.constant * k;

        let mut i: i64 = 0;
        let len_a = vec_len(a.var_names);
        while i < len_a {
            let name = vec_get(a.var_names, i);
            let coeff = vec_get(a.var_coeffs, i);
            lin_expr_set_coeff(res, name, coeff * k);
            i = i + 1;
        }

        return res;
    }

    fn lin_expr_is_zero(expr: LinExpr) -> bool {
        if expr.constant != 0 {
            return false;
        }
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            if vec_get(expr.var_coeffs, i) != 0 {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn lin_expr_eval(expr: LinExpr, env: HashMap<str, i64>) -> i64 {
        let mut acc = expr.constant;
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            let name = vec_get(expr.var_names, i);
            let coeff = vec_get(expr.var_coeffs, i);
            if hashmap_contains(env, name) {
                let val = hashmap_get(env, name);
                acc = acc + coeff * val;
            }
            i = i + 1;
        }
        return acc;
    }

    fn lin_expr_format(expr: LinExpr) -> str {
        let mut out = "";
        let mut first = true;
        let mut i: i64 = 0;
        let total = vec_len(expr.var_names);
        while i < total {
            let coeff = vec_get(expr.var_coeffs, i);
            let name = vec_get(expr.var_names, i);
            if coeff != 0 {
                if first {
                    if coeff == 1 {
                        out = out + name;
                    } else if coeff == -1 {
                        out = out + "-" + name;
                    } else {
                        out = out + int_to_string(coeff) + "*" + name;
                    }
                    first = false;
                } else {
                    if coeff > 0 {
                        out = out + " + ";
                        if coeff == 1 {
                            out = out + name;
                        } else {
                            out = out + int_to_string(coeff) + "*" + name;
                        }
                    } else {
                        out = out + " - ";
                        let abs_coeff = 0 - coeff;
                        if abs_coeff == 1 {
                            out = out + name;
                        } else {
                            out = out + int_to_string(abs_coeff) + "*" + name;
                        }
                    }
                }
            }
            i = i + 1;
        }

        if expr.constant != 0 || first {
            if first {
                out = out + int_to_string(expr.constant);
            } else if expr.constant > 0 {
                out = out + " + " + int_to_string(expr.constant);
            } else {
                out = out + " - " + int_to_string(0 - expr.constant);
            }
        }
        return out;
    }

    fn verify_contract_new(func_name: str) -> VerifyContract {
        let reqs: Vec<str> = vec_new();
        let ens: Vec<str> = vec_new();
        return VerifyContract {
            func_name: func_name,
            requires_desc: reqs,
            ensures_desc: ens,
            requires_satisfied: true,
            ensures_verified: true,
            counterexample: ""
        };
    }

    fn verify_add_requires(vc: VerifyContract, desc: str) -> bool {
        vec_push(vc.requires_desc, desc);
        return true;
    }

    fn verify_add_ensures(vc: VerifyContract, desc: str) -> bool {
        vec_push(vc.ensures_desc, desc);
        return true;
    }

    fn verify_prove_equality(lhs: LinExpr, rhs: LinExpr) -> bool {
        let diff = lin_expr_sub(lhs, rhs);
        return lin_expr_is_zero(diff);
    }

    fn verify_synthesize_counterexample(lhs: LinExpr, rhs: LinExpr, env: HashMap<str, i64>) -> str {
        let diff = lin_expr_sub(lhs, rhs);
        let eval_diff = lin_expr_eval(diff, env);
        let diff_str = lin_expr_format(diff);
        return "diff: " + diff_str + " (evaluated: " + int_to_string(eval_diff) + ")";
    }

    fn verify_contract_json(vc: VerifyContract) -> str {
        let comma = ",";
        let total_contracts = vec_len(vc.requires_desc) + vec_len(vc.ensures_desc);
        return "{" +
            json_field_str("schema_version", "bunker.verify.v1") + comma +
            json_field_str("function_name", vc.func_name) + comma +
            json_field_i64("contracts_checked", total_contracts) + comma +
            json_field_bool("verified", vc.ensures_verified) + comma +
            json_field_str("counterexample", vc.counterexample) +
            "}";
    }
