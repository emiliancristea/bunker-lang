        vec_push(node, item.name_idx);
        vec_push(node, item.params);
        vec_push(node, item.return_type);
        vec_push(node, item.body);
        return node;
    }

    fn ast_fn_unpack(node: Vec<i64>) -> AstFn {
        let name_idx: i64 = 0;
        let params: i64 = 0;
        let return_type: i64 = 0;
        let body: i64 = 0;
        if vec_len(node) > AST_NODE_DATA_START {
            name_idx = vec_get(node, AST_NODE_DATA_START);
        }
        if vec_len(node) > AST_NODE_DATA_START + 1 {
            params = vec_get(node, AST_NODE_DATA_START + 1);
        }
        if vec_len(node) > AST_NODE_DATA_START + 2 {
            return_type = vec_get(node, AST_NODE_DATA_START + 2);
        }
        if vec_len(node) > AST_NODE_DATA_START + 3 {
            body = vec_get(node, AST_NODE_DATA_START + 3);
        }
        return AstFn {
            start: vec_get(node, AST_NODE_SPAN_START_INDEX),
            end: vec_get(node, AST_NODE_SPAN_END_INDEX),
            name_idx: name_idx,
            params: params,
            return_type: return_type,
            body: body
        };
