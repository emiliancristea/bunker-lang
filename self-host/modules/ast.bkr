        let node_ref: AstNodeRef = ast_node_ref_new(NODE_TYPE);
        ast_node_ref_push(node_ref, TYPE_ARRAY);
        ast_node_ref_push(node_ref, elem_kind);
        ast_node_ref_push(node_ref, len_value);
        return ast_type_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_type_array(elem_kind: TypeKind, len_value: i64) -> Vec<i64> {
