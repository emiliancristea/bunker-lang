    // ========================================
    // AST LAYOUT HELPERS
    // ========================================
    //
    // The bootstrap compiler still represents AST nodes as Vec<i64>.
    // Keep all layout construction here so later slices can replace the
    // representation with real Bunker structs/enums behind one boundary.

    struct AstNodeRef {
        handle: i64,
    }

    struct AstTypeRef {
        handle: i64,
    }

    struct AstExprRef {
        handle: i64,
    }

    struct AstStmtRef {
        handle: i64,
    }

    struct AstItemRef {
        handle: i64,
    }

    struct AstBlockRef {
        handle: i64,
    }

    struct AstPatternRef {
        handle: i64,
    }

    fn ast_new(kind: i64) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, kind);
        vec_push(node, AST_SPAN_UNKNOWN);
        vec_push(node, AST_SPAN_UNKNOWN);
        return node;
    }

    fn ast_push(node: Vec<i64>, value: i64) -> Vec<i64> {
        vec_push(node, value);
        return node;
    }

    fn ast_kind(node: Vec<i64>) -> i64 {
        return vec_get(node, 0);
    }

    fn ast_span(start: i64, end: i64) -> Vec<i64> {
        let span: Vec<i64> = vec_new();
        vec_push(span, start);
        vec_push(span, end);
        return span;
    }

    fn ast_span_unknown() -> Vec<i64> {
        return ast_span(AST_SPAN_UNKNOWN, AST_SPAN_UNKNOWN);
    }

    fn ast_span_start(span: Vec<i64>) -> i64 {
        if vec_len(span) < 1 {
            return AST_SPAN_UNKNOWN;
        }
        return vec_get(span, 0);
    }

    fn ast_span_end(span: Vec<i64>) -> i64 {
        if vec_len(span) < 2 {
            return AST_SPAN_UNKNOWN;
        }
        return vec_get(span, 1);
    }

    fn ast_span_is_known(span: Vec<i64>) -> bool {
        return ast_span_start(span) != AST_SPAN_UNKNOWN && ast_span_end(span) != AST_SPAN_UNKNOWN;
    }

    fn ast_node_span_start(node: Vec<i64>) -> i64 {
        return vec_get(node, AST_NODE_SPAN_START_INDEX);
    }

    fn ast_node_span_end(node: Vec<i64>) -> i64 {
        return vec_get(node, AST_NODE_SPAN_END_INDEX);
    }

    fn ast_node_span(node: Vec<i64>) -> Vec<i64> {
        return ast_span(ast_node_span_start(node), ast_node_span_end(node));
    }

    fn ast_node_has_span(node: Vec<i64>) -> bool {
        return ast_span_is_known(ast_node_span(node));
    }

    fn ast_set_span(node: Vec<i64>, start: i64, end: i64) -> Vec<i64> {
        vec_set(node, AST_NODE_SPAN_START_INDEX, start);
        vec_set(node, AST_NODE_SPAN_END_INDEX, end);
        return node;
    }

    fn ast_set_span_from(node: Vec<i64>, span: Vec<i64>) -> Vec<i64> {
        return ast_set_span(node, ast_span_start(span), ast_span_end(span));
    }

    fn ast_has_field(node: Vec<i64>, index: i64) -> bool {
        return vec_len(node) > index + AST_NODE_DATA_OFFSET;
    }

    fn ast_node_category(node: Vec<i64>) -> i64 {
        return ast_node_category_kind(ast_kind(node));
    }

    fn ast_is_item(node: Vec<i64>) -> bool {
        return ast_is_item_kind(ast_kind(node));
    }

    fn ast_is_stmt(node: Vec<i64>) -> bool {
        return ast_is_stmt_kind(ast_kind(node));
    }

    fn ast_is_expr(node: Vec<i64>) -> bool {
        return ast_is_expr_kind(ast_kind(node));
    }

    fn ast_is_type_node(node: Vec<i64>) -> bool {
        return ast_is_type_kind(ast_kind(node));
    }

    fn ast_debug_label(node: Vec<i64>) -> str {
        let category = ast_node_category(node);
        return ast_category_name(category) + ":" + ast_node_kind_name(ast_kind(node));
    }

    fn ast_is_ident(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_IDENT;
    }

    fn ast_is_call(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_CALL;
    }

    fn ast_is_block(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_BLOCK;
    }

    fn ast_is_expr_stmt(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_EXPR_STMT;
    }

    fn ast_is_fn_item(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_FN;
    }

    fn ast_is_const_item(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_CONST;
    }

    fn ast_is_struct_item(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_STRUCT;
    }

    fn ast_field(node: Vec<i64>, index: i64) -> i64 {
        return vec_get(node, index + AST_NODE_DATA_OFFSET);
    }

    fn ast_node_handle(node: Vec<i64>) -> i64 {
        return node as i64;
    }

    fn ast_node_ref_from_handle(handle: i64) -> AstNodeRef {
        return AstNodeRef { handle: handle };
    }

    fn ast_node_ref_from_node(node: Vec<i64>) -> AstNodeRef {
        return ast_node_ref_from_handle(ast_node_handle(node));
    }

    fn ast_node_ref_handle(node_ref: AstNodeRef) -> i64 {
        return node_ref.handle;
    }

    fn ast_node_from_ref(node_ref: AstNodeRef) -> Vec<i64> {
        return ast_node_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_node_ref_kind(node_ref: AstNodeRef) -> i64 {
        return ast_kind(ast_node_from_ref(node_ref));
    }

    fn ast_node_ref_span_start(node_ref: AstNodeRef) -> i64 {
        return ast_node_span_start(ast_node_from_ref(node_ref));
    }

    fn ast_node_ref_span_end(node_ref: AstNodeRef) -> i64 {
        return ast_node_span_end(ast_node_from_ref(node_ref));
    }

    fn ast_node_from_handle(handle: i64) -> Vec<i64> {
        return handle as Vec<i64>;
    }

    fn ast_node_list_from_handle(handle: i64) -> Vec<i64> {
        return handle as Vec<i64>;
    }

    fn ast_i64_list_from_handle(handle: i64) -> Vec<i64> {
        return handle as Vec<i64>;
    }

    fn ast_string_list_from_handle(handle: i64) -> Vec<str> {
        return handle as Vec<str>;
    }

    fn ast_type_handle(type_node: Vec<i64>) -> i64 {
        return ast_node_handle(type_node);
    }

    fn ast_type_ref_from_handle(handle: i64) -> AstTypeRef {
        return AstTypeRef { handle: handle };
    }

    fn ast_type_ref_from_node(type_node: Vec<i64>) -> AstTypeRef {
        return ast_type_ref_from_handle(ast_type_handle(type_node));
    }

    fn ast_type_ref_handle(type_ref: AstTypeRef) -> i64 {
        return type_ref.handle;
    }

    fn ast_type_node_from_ref(type_ref: AstTypeRef) -> Vec<i64> {
        return ast_node_from_handle(ast_type_ref_handle(type_ref));
    }

    fn ast_type_ref_kind_value(type_ref: AstTypeRef) -> i64 {
        return ast_type_kind_value(ast_type_ref_handle(type_ref));
    }

    fn ast_expr_handle(expr: Vec<i64>) -> i64 {
        return ast_node_handle(expr);
    }

    fn ast_expr_ref_from_handle(handle: i64) -> AstExprRef {
        return AstExprRef { handle: handle };
    }

    fn ast_expr_ref_from_node(expr: Vec<i64>) -> AstExprRef {
        return ast_expr_ref_from_handle(ast_expr_handle(expr));
    }

    fn ast_expr_ref_handle(expr_ref: AstExprRef) -> i64 {
        return expr_ref.handle;
    }

    fn ast_expr_node_from_ref(expr_ref: AstExprRef) -> Vec<i64> {
        return ast_node_from_handle(ast_expr_ref_handle(expr_ref));
    }

    fn ast_expr_ref_kind(expr_ref: AstExprRef) -> i64 {
        return ast_kind(ast_expr_node_from_ref(expr_ref));
    }

    fn ast_stmt_handle(stmt: Vec<i64>) -> i64 {
        return ast_node_handle(stmt);
    }

    fn ast_stmt_ref_from_handle(handle: i64) -> AstStmtRef {
        return AstStmtRef { handle: handle };
    }

    fn ast_stmt_ref_from_node(stmt: Vec<i64>) -> AstStmtRef {
        return ast_stmt_ref_from_handle(ast_stmt_handle(stmt));
    }

    fn ast_stmt_ref_handle(stmt_ref: AstStmtRef) -> i64 {
        return stmt_ref.handle;
    }

    fn ast_stmt_node_from_ref(stmt_ref: AstStmtRef) -> Vec<i64> {
        return ast_node_from_handle(ast_stmt_ref_handle(stmt_ref));
    }

    fn ast_stmt_ref_kind(stmt_ref: AstStmtRef) -> i64 {
        return ast_kind(ast_stmt_node_from_ref(stmt_ref));
    }

    fn ast_item_handle(item: Vec<i64>) -> i64 {
        return ast_node_handle(item);
    }

    fn ast_item_ref_from_handle(handle: i64) -> AstItemRef {
        return AstItemRef { handle: handle };
    }

    fn ast_item_ref_from_node(item: Vec<i64>) -> AstItemRef {
        return ast_item_ref_from_handle(ast_item_handle(item));
    }

    fn ast_item_ref_handle(item_ref: AstItemRef) -> i64 {
        return item_ref.handle;
    }

    fn ast_item_node_from_ref(item_ref: AstItemRef) -> Vec<i64> {
        return ast_node_from_handle(ast_item_ref_handle(item_ref));
    }

    fn ast_item_ref_kind(item_ref: AstItemRef) -> i64 {
        return ast_kind(ast_item_node_from_ref(item_ref));
    }

    fn ast_block_handle(block: Vec<i64>) -> i64 {
        return ast_node_handle(block);
    }

    fn ast_block_ref_from_handle(handle: i64) -> AstBlockRef {
        return AstBlockRef { handle: handle };
    }

    fn ast_block_ref_from_node(block: Vec<i64>) -> AstBlockRef {
        return ast_block_ref_from_handle(ast_block_handle(block));
    }

    fn ast_block_ref_handle(block_ref: AstBlockRef) -> i64 {
        return block_ref.handle;
    }

    fn ast_block_node_from_ref(block_ref: AstBlockRef) -> Vec<i64> {
        return ast_node_from_handle(ast_block_ref_handle(block_ref));
    }

    fn ast_block_ref_stmt_count(block_ref: AstBlockRef) -> i64 {
        return ast_block_stmt_count(ast_block_node_from_ref(block_ref));
    }

    fn ast_pattern_handle(pattern: Vec<i64>) -> i64 {
        return pattern as i64;
    }

    fn ast_pattern_ref_from_handle(handle: i64) -> AstPatternRef {
        return AstPatternRef { handle: handle };
    }

    fn ast_pattern_ref_from_pattern(pattern: Vec<i64>) -> AstPatternRef {
        return ast_pattern_ref_from_handle(ast_pattern_handle(pattern));
    }

    fn ast_pattern_ref_handle(pattern_ref: AstPatternRef) -> i64 {
        return pattern_ref.handle;
    }

    fn ast_pattern_from_ref(pattern_ref: AstPatternRef) -> Vec<i64> {
        return ast_pattern_from_handle(ast_pattern_ref_handle(pattern_ref));
    }

    fn ast_pattern_ref_kind(pattern_ref: AstPatternRef) -> i64 {
        return ast_pattern_kind(ast_pattern_from_ref(pattern_ref));
    }

    fn ast_pattern_from_handle(handle: i64) -> Vec<i64> {
        return handle as Vec<i64>;
    }

    fn ast_node_list_handle(nodes: Vec<i64>) -> i64 {
        return nodes as i64;
    }

    fn ast_i64_list_handle(values: Vec<i64>) -> i64 {
        return values as i64;
    }

    fn ast_string_list_handle(values: Vec<str>) -> i64 {
        return values as i64;
    }

    fn ast_node_list_append(nodes: Vec<i64>, node: Vec<i64>) -> Vec<i64> {
        vec_push(nodes, ast_node_handle(node));
        return nodes;
    }

    fn ast_pattern_list_append(patterns: Vec<i64>, pattern: Vec<i64>) -> Vec<i64> {
        vec_push(patterns, ast_pattern_handle(pattern));
        return patterns;
    }

    fn ast_i64_list_append(values: Vec<i64>, value: i64) -> Vec<i64> {
        vec_push(values, value);
        return values;
    }

    fn ast_field_node(node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_from_handle(ast_field(node, index));
    }

    fn ast_field_node_list(node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_list_from_handle(ast_field(node, index));
    }

    fn ast_field_i64_list(node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_i64_list_from_handle(ast_field(node, index));
    }

    fn ast_field_pattern_list(node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_i64_list_from_handle(ast_field(node, index));
    }

    fn ast_field_string_list(node: Vec<i64>, index: i64) -> Vec<str> {
        return ast_string_list_from_handle(ast_field(node, index));
    }

    fn ast_optional_none() -> i64 {
        return 0;
    }

    fn ast_optional_is_none(value: i64) -> bool {
        return value == 0;
    }

    fn ast_optional_is_some(value: i64) -> bool {
        return value != 0;
    }

    fn ast_optional_node(value: i64) -> Vec<i64> {
        return ast_node_from_handle(value);
    }

    fn ast_type_kind_value(type_node: i64) -> i64 {
        if ast_optional_is_none(type_node) {
            return TYPE_UNKNOWN;
        }
        return ast_field(ast_node_from_handle(type_node), 1);
    }

    fn ast_type_struct_name_idx_value(type_node: i64) -> i64 {
        if ast_optional_is_none(type_node) {
            return -1;
        }
        let node = ast_node_from_handle(type_node);
        if ast_has_field(node, 2) && ast_type_kind_value(type_node) == TYPE_STRUCT {
            return ast_field(node, 2);
        }
        return -1;
    }

    fn ast_type_array_elem_kind_value(type_node: i64) -> i64 {
        if ast_optional_is_none(type_node) {
            return TYPE_UNKNOWN;
        }
        let node = ast_node_from_handle(type_node);
        if ast_has_field(node, 2) && ast_type_kind_value(type_node) == TYPE_ARRAY {
            return ast_field(node, 2);
        }
        return TYPE_UNKNOWN;
    }

    fn ast_type_array_len_value(type_node: i64) -> i64 {
        if ast_optional_is_none(type_node) {
            return -1;
        }
        let node = ast_node_from_handle(type_node);
        if ast_has_field(node, 3) && ast_type_kind_value(type_node) == TYPE_ARRAY {
            return ast_field(node, 3);
        }
        return -1;
    }

    fn ast_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_value(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_type_node(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_init_expr(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_binary_op(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_binary_left(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 2);
    }

    fn ast_binary_left_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_binary_right(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 3);
    }

    fn ast_binary_right_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_unary_op(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_unary_operand(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 2);
    }

    fn ast_unary_operand_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_call_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_call_args(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node_list(node, 2);
    }

    fn ast_array_elements(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node_list(node, 1);
    }

    fn ast_index_base(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 1);
    }

    fn ast_index_base_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_index_expr(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 2);
    }

    fn ast_index_expr_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_field_base(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 1);
    }

    fn ast_field_base_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_field_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_struct_lit_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_struct_lit_field_names(node: Vec<i64>) -> Vec<i64> {
        return ast_field_i64_list(node, 2);
    }

    fn ast_struct_lit_field_values(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node_list(node, 3);
    }

    fn ast_ternary_cond(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 1);
    }

    fn ast_ternary_cond_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_ternary_then(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 2);
    }

    fn ast_ternary_then_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_ternary_else(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 3);
    }

    fn ast_ternary_else_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_match_scrutinee(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node(node, 1);
    }

    fn ast_match_scrutinee_handle(node: Vec<i64>) -> i64 {
