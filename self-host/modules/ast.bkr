        return AstAtom {
            kind: vec_get(node, 0),
            start: vec_get(node, AST_NODE_SPAN_START_INDEX),
            end: vec_get(node, AST_NODE_SPAN_END_INDEX),
            payload: payload
        };
    }

    fn ast_atom_expr_ref(kind: NodeKind, payload: i64) -> AstExprRef {
        let rec: AstAtom = ast_atom_record(kind, payload);
        return ast_expr_ref_from_handle(ast_atom_pack(rec) as i64);
    }

