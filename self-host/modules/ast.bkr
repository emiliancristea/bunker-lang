    fn ast_type_ref(kind: TypeKind) -> AstTypeRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_TYPE);
        ast_node_ref_push(node_ref, kind);
        return ast_type_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_type(kind: TypeKind) -> Vec<i64> {
        return ast_type_node_from_ref(ast_type_ref(kind));
    }

