    fn ast_expr_stmt_record(expr: i64) -> AstExprStmt {
        return AstExprStmt {
            start: AST_SPAN_UNKNOWN,
            end: AST_SPAN_UNKNOWN,
            expr: expr
        };
    }

    fn ast_expr_stmt_pack(stmt: AstExprStmt) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_EXPR_STMT);
        vec_push(node, stmt.start);
        vec_push(node, stmt.end);
        vec_push(node, stmt.expr);
        return node;
    }

    fn ast_expr_stmt_unpack(node: Vec<i64>) -> AstExprStmt {
        let expr: i64 = 0;
        if vec_len(node) > AST_NODE_DATA_START {
            expr = vec_get(node, AST_NODE_DATA_START);
        }
        return AstExprStmt {
            start: vec_get(node, AST_NODE_SPAN_START_INDEX),
            end: vec_get(node, AST_NODE_SPAN_END_INDEX),
            expr: expr
        };
    }

    fn ast_expr_stmt_ref(expr_ref: AstExprRef) -> AstStmtRef {
        let rec: AstExprStmt = ast_expr_stmt_record(ast_expr_ref_handle(expr_ref));
        return ast_stmt_ref_from_handle(ast_expr_stmt_pack(rec) as i64);
    }

    fn ast_expr_stmt(expr: Vec<i64>) -> Vec<i64> {
        return ast_stmt_node_from_ref(ast_expr_stmt_ref(ast_expr_ref_from_node(expr)));
    }

    fn ast_block_ref() -> AstBlockRef {
        return ast_block_ref_from_handle(ast_node_ref_handle(ast_node_ref_new(NODE_BLOCK)));
    }

    fn ast_block() -> Vec<i64> {
        return ast_block_node_from_ref(ast_block_ref());
    }

    fn ast_block_stmt_count(block: Vec<i64>) -> i64 {
        return ast_block_ref_stmt_count(ast_block_ref_from_node(block));
    }

    fn ast_block_stmt(block: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_from_handle(vec_get(block, AST_NODE_DATA_START + index));
    }

    fn ast_block_ref_stmt_ref(block_ref: AstBlockRef, index: i64) -> AstStmtRef {
        return ast_stmt_ref_from_node(ast_block_stmt(ast_block_node_from_ref(block_ref), index));
    }

    fn ast_block_last_stmt(block: Vec<i64>) -> Vec<i64> {
        return ast_block_stmt(block, ast_block_stmt_count(block) - 1);
    }

    fn ast_block_append_ref(block_ref: AstBlockRef, stmt_ref: AstStmtRef) -> AstBlockRef {
        ast_node_ref_push(ast_node_ref_from_handle(ast_block_ref_handle(block_ref)), ast_stmt_ref_handle(stmt_ref));
        return block_ref;
    }

    fn ast_block_append(block: Vec<i64>, stmt: Vec<i64>) -> Vec<i64> {
        ast_block_append_ref(ast_block_ref_from_node(block), ast_stmt_ref_from_node(stmt));
        return block;
    }

    fn ast_block_with_ref(stmt_ref: AstStmtRef) -> AstBlockRef {
        let stmt: Vec<i64> = ast_stmt_node_from_ref(stmt_ref);
        let block_ref: AstBlockRef = ast_block_ref();
        ast_node_ref_set_span(ast_node_ref_from_handle(ast_block_ref_handle(block_ref)), ast_node_span_start(stmt), ast_node_span_end(stmt));
        ast_block_append_ref(block_ref, stmt_ref);
        return block_ref;
    }

    fn ast_block_with(stmt: Vec<i64>) -> Vec<i64> {
        return ast_block_node_from_ref(ast_block_with_ref(ast_stmt_ref_from_node(stmt)));
    }

    fn ast_if_record(cond: i64, then_block: i64, else_block: i64) -> AstIf {
        return AstIf {
            start: AST_SPAN_UNKNOWN,
            end: AST_SPAN_UNKNOWN,
            cond: cond,
            then_block: then_block,
            else_block: else_block
        };
    }

    fn ast_if_pack(stmt: AstIf) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_IF);
        vec_push(node, stmt.start);
        vec_push(node, stmt.end);
        vec_push(node, stmt.cond);
        vec_push(node, stmt.then_block);
        vec_push(node, stmt.else_block);
        return node;
    }

    fn ast_if_unpack(node: Vec<i64>) -> AstIf {
        let cond: i64 = 0;
        let then_block: i64 = 0;
        let else_block: i64 = 0;
        if vec_len(node) > AST_NODE_DATA_START {
            cond = vec_get(node, AST_NODE_DATA_START);
        }
        if vec_len(node) > AST_NODE_DATA_START + 1 {
            then_block = vec_get(node, AST_NODE_DATA_START + 1);
        }
        if vec_len(node) > AST_NODE_DATA_START + 2 {
            else_block = vec_get(node, AST_NODE_DATA_START + 2);
        }
        return AstIf {
            start: vec_get(node, AST_NODE_SPAN_START_INDEX),
            end: vec_get(node, AST_NODE_SPAN_END_INDEX),
            cond: cond,
            then_block: then_block,
            else_block: else_block
        };
    }

    fn ast_if_ref(cond_ref: AstExprRef, then_block_ref: AstBlockRef, else_block: i64) -> AstStmtRef {
        let rec: AstIf = ast_if_record(ast_expr_ref_handle(cond_ref), ast_block_ref_handle(then_block_ref), else_block);
        return ast_stmt_ref_from_handle(ast_if_pack(rec) as i64);
    }

    fn ast_if(cond: Vec<i64>, then_block: Vec<i64>, else_block: i64) -> Vec<i64> {
        return ast_stmt_node_from_ref(ast_if_ref(ast_expr_ref_from_node(cond), ast_block_ref_from_node(then_block), else_block));
    }

    fn ast_for_record(name_idx: i64, start_expr: i64, end_expr: i64, inclusive: i64, body: i64) -> AstFor {
        return AstFor {
            start: AST_SPAN_UNKNOWN,
            end: AST_SPAN_UNKNOWN,
            name_idx: name_idx,
            start_expr: start_expr,
            end_expr: end_expr,
            inclusive: inclusive,
            body: body
