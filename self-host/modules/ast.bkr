    // ========================================
    // AST LAYOUT HELPERS
    // ========================================
    //
    // The bootstrap compiler still represents AST nodes as Vec<i64>.
    // Node-kind construction and typed-ref kind readers now use enum NodeKind;
    // keep layout construction here so later slices can replace the
    // representation with real Bunker structs/enums behind one boundary.
    //
    // SH-003 convention: pack structs at construction and keep typed unpack
    // APIs for whole-record access. Single-field hot readers must use
    // ast_field so stage1 typecheck of bkrc stays inside the CI smoke.

    struct AstSpan {
        start: i64,
        end: i64,
    }

    struct AstNodeRef {
        handle: i64,
    }

    struct AstType {
        kind: TypeKind,
        start: i64,
        end: i64,
        payload: i64,
        aux: i64
    }

    struct AstTypeRef {
        handle: i64,
    }

    struct AstAtom {
        kind: NodeKind,
        start: i64,
        end: i64,
        payload: i64
    }

    struct AstBinary {
        start: i64,
        end: i64,
        op: TokenKind,
        left: i64,
        right: i64
    }

    struct AstUnary {
        start: i64,
        end: i64,
        op: TokenKind,
        operand: i64
    }

    struct AstCall {
        start: i64,
        end: i64,
        name_idx: i64,
        args: i64
    }

    struct AstIndex {
        start: i64,
        end: i64,
        base: i64,
        index: i64
    }

    struct AstFieldAccess {
        start: i64,
        end: i64,
        base: i64,
        name_idx: i64
    }

    struct AstLet {
        start: i64,
        end: i64,
        name_idx: i64,
        type_handle: i64,
        init: i64
    }

    struct AstReturn {
        start: i64,
        end: i64,
        expr: i64
    }

    struct AstIf {
        start: i64,
        end: i64,
        cond: i64,
        then_block: i64,
        else_block: i64
    }

    struct AstWhile {
        start: i64,
        end: i64,
        cond: i64,
        body: i64
    }

    struct AstFor {
        start: i64,
        end: i64,
        name_idx: i64,
        start_expr: i64,
        end_expr: i64,
        inclusive: i64,
        body: i64
    }

    struct AstLoop {
        start: i64,
        end: i64,
        body: i64
    }

    struct AstAssign {
        start: i64,
        end: i64,
        target: i64,
        value: i64
    }

    struct AstExprStmt {
        start: i64,
        end: i64,
        expr: i64
    }

    struct AstTernary {
        start: i64,
        end: i64,
        cond: i64,
        then_expr: i64,
        else_expr: i64
    }

    struct AstArrayLit {
        start: i64,
        end: i64,
        elements: i64
    }

    struct AstStructLit {
        start: i64,
        end: i64,
        name_idx: i64,
        field_names: i64,
        field_values: i64
    }

    struct AstMatch {
        start: i64,
        end: i64,
        scrutinee: i64,
        patterns: i64,
        bodies: i64
    }

    struct AstParam {
        start: i64,
        end: i64,
        name_idx: i64,
        type_handle: i64
    }

    struct AstFn {
        start: i64,
        end: i64,
        name_idx: i64,
        params: i64,
        return_type: i64,
        body: i64
    }

    struct AstConst {
        start: i64,
        end: i64,
        name_idx: i64,
        type_handle: i64,
        value: i64
    }

    struct AstFieldDecl {
        start: i64,
        end: i64,
        name_idx: i64,
        type_handle: i64
    }

    struct AstStruct {
        start: i64,
        end: i64,
        name_idx: i64,
        fields: i64
    }

    struct AstEnum {
        start: i64,
        end: i64,
        name_idx: i64,
        variants: i64
    }

    struct AstExprRef {
        handle: i64,
    }

    struct AstStmtRef {
        handle: i64,
    }

    struct AstItemRef {
        handle: i64,
    }

    struct AstBlockRef {
        handle: i64,
    }

    struct AstPattern {
        kind: PatternKind,
        start: i64,
        end: i64,
        value: i64,
        aux: i64,
    }

    struct AstPatternRef {
        handle: i64,
    }

    struct AstNodeListRef {
        handle: i64,
    }

    struct AstI64ListRef {
        handle: i64,
    }

    struct AstPatternListRef {
        handle: i64,
    }

    struct AstStringListRef {
        handle: i64,
    }

    fn ast_node_ref_new(kind: NodeKind) -> AstNodeRef {
        let node: Vec<i64> = vec_new();
        vec_push(node, kind);
        vec_push(node, AST_SPAN_UNKNOWN);
        vec_push(node, AST_SPAN_UNKNOWN);
        return AstNodeRef { handle: node as i64 };
    }

    fn ast_node_ref_push(node_ref: AstNodeRef, value: i64) -> AstNodeRef {
        vec_push(ast_node_from_ref(node_ref), value);
        return node_ref;
    }

    fn ast_node_ref_set_span(node_ref: AstNodeRef, start: i64, end: i64) -> AstNodeRef {
        let node: Vec<i64> = ast_node_from_ref(node_ref);
        vec_set(node, AST_NODE_SPAN_START_INDEX, start);
        vec_set(node, AST_NODE_SPAN_END_INDEX, end);
        return node_ref;
    }

    fn ast_node_ref_set_span_from(node_ref: AstNodeRef, span: AstSpan) -> AstNodeRef {
        return ast_node_ref_set_span(node_ref, span.start, span.end);
    }

    fn ast_pattern_record(kind: PatternKind, value: i64) -> AstPattern {
        return ast_pattern_record2(kind, value, 0);
    }

    fn ast_pattern_record2(kind: PatternKind, value: i64, aux: i64) -> AstPattern {
        return AstPattern {
            kind: kind,
            start: AST_SPAN_UNKNOWN,
            end: AST_SPAN_UNKNOWN,
            value: value,
            aux: aux
        };
    }

    fn ast_pattern_pack(pattern: AstPattern) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, pattern.kind);
        vec_push(node, pattern.start);
        vec_push(node, pattern.end);
        vec_push(node, pattern.value);
        vec_push(node, pattern.aux);
        return node;
    }

    fn ast_pattern_unpack(node: Vec<i64>) -> AstPattern {
        let aux: i64 = 0;
        if vec_len(node) > AST_NODE_DATA_START + 1 {
            aux = vec_get(node, AST_NODE_DATA_START + 1);
        }
        return AstPattern {
            kind: vec_get(node, 0),
            start: vec_get(node, AST_NODE_SPAN_START_INDEX),
            end: vec_get(node, AST_NODE_SPAN_END_INDEX),
            value: vec_get(node, AST_NODE_DATA_START),
            aux: aux
        };
    }

    fn ast_pattern_ref_new(kind: PatternKind, value: i64) -> AstPatternRef {
        return ast_pattern_ref_new2(kind, value, 0);
    }

    fn ast_pattern_ref_new2(kind: PatternKind, value: i64, aux: i64) -> AstPatternRef {
        let pattern: AstPattern = ast_pattern_record2(kind, value, aux);
        return AstPatternRef { handle: ast_pattern_pack(pattern) as i64 };
    }

    fn ast_pattern_ref_set_span(pattern_ref: AstPatternRef, start: i64, end: i64) -> AstPatternRef {
        let pattern: Vec<i64> = ast_pattern_from_ref(pattern_ref);
        vec_set(pattern, AST_NODE_SPAN_START_INDEX, start);
        vec_set(pattern, AST_NODE_SPAN_END_INDEX, end);
        return pattern_ref;
    }

    fn ast_new(kind: i64) -> Vec<i64> {
        return ast_node_from_ref(ast_node_ref_new(kind));
    }

    fn ast_push(node: Vec<i64>, value: i64) -> Vec<i64> {
        ast_node_ref_push(ast_node_ref_from_node(node), value);
        return node;
    }

    fn ast_kind(node: Vec<i64>) -> i64 {
        return vec_get(node, 0);
    }

    fn ast_node_kind(node: Vec<i64>) -> NodeKind {
        return ast_kind(node);
    }

    fn ast_span(start: i64, end: i64) -> AstSpan {
        return AstSpan { start: start, end: end };
    }

    fn ast_span_unknown() -> AstSpan {
        return ast_span(AST_SPAN_UNKNOWN, AST_SPAN_UNKNOWN);
    }

    fn ast_span_start(span: AstSpan) -> i64 {
        return span.start;
    }

    fn ast_span_end(span: AstSpan) -> i64 {
        return span.end;
    }

    fn ast_span_is_known(span: AstSpan) -> bool {
        return span.start != AST_SPAN_UNKNOWN && span.end != AST_SPAN_UNKNOWN;
    }

    fn ast_node_span_start(node: Vec<i64>) -> i64 {
        return vec_get(node, AST_NODE_SPAN_START_INDEX);
    }

    fn ast_node_span_end(node: Vec<i64>) -> i64 {
        return vec_get(node, AST_NODE_SPAN_END_INDEX);
    }

    fn ast_node_span(node: Vec<i64>) -> AstSpan {
        return ast_span(ast_node_span_start(node), ast_node_span_end(node));
    }

    fn ast_node_has_span(node: Vec<i64>) -> bool {
        return ast_span_is_known(ast_node_span(node));
    }

    fn ast_set_span(node: Vec<i64>, start: i64, end: i64) -> Vec<i64> {
        ast_node_ref_set_span(ast_node_ref_from_node(node), start, end);
        return node;
    }

    fn ast_set_span_from(node: Vec<i64>, span: AstSpan) -> Vec<i64> {
        ast_node_ref_set_span_from(ast_node_ref_from_node(node), span);
        return node;
    }

    fn ast_has_field(node: Vec<i64>, index: i64) -> bool {
        return vec_len(node) > index + AST_NODE_DATA_OFFSET;
    }

    fn ast_node_category(node: Vec<i64>) -> i64 {
        return ast_node_category_kind(ast_kind(node));
    }

    fn ast_is_item(node: Vec<i64>) -> bool {
        return ast_is_item_kind(ast_kind(node));
    }

    fn ast_is_stmt(node: Vec<i64>) -> bool {
        return ast_is_stmt_kind(ast_kind(node));
    }

    fn ast_is_expr(node: Vec<i64>) -> bool {
        return ast_is_expr_kind(ast_kind(node));
    }

    fn ast_is_type_node(node: Vec<i64>) -> bool {
        return ast_is_type_kind(ast_kind(node));
    }

    fn ast_debug_label(node: Vec<i64>) -> str {
        let category = ast_node_category(node);
        return ast_category_name(category) + ":" + ast_node_kind_name(ast_kind(node));
    }

    fn ast_is_ident(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_IDENT;
    }

    fn ast_is_call(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_CALL;
    }

    fn ast_is_block(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_BLOCK;
    }

    fn ast_is_expr_stmt(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_EXPR_STMT;
    }

    fn ast_is_fn_item(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_FN;
    }

    fn ast_is_const_item(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_CONST;
    }

    fn ast_is_struct_item(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_STRUCT;
    }

    fn ast_field(node: Vec<i64>, index: i64) -> i64 {
        return vec_get(node, index + AST_NODE_DATA_OFFSET);
    }

    fn ast_node_handle(node: Vec<i64>) -> i64 {
        return node as i64;
    }

    fn ast_node_ref_from_handle(handle: i64) -> AstNodeRef {
        return AstNodeRef { handle: handle };
    }

    fn ast_node_ref_from_node(node: Vec<i64>) -> AstNodeRef {
        return ast_node_ref_from_handle(ast_node_handle(node));
    }

    fn ast_node_ref_handle(node_ref: AstNodeRef) -> i64 {
        return node_ref.handle;
    }

    fn ast_node_from_ref(node_ref: AstNodeRef) -> Vec<i64> {
        return ast_node_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_node_ref_kind(node_ref: AstNodeRef) -> NodeKind {
        return ast_node_kind(ast_node_from_ref(node_ref));
    }

    fn ast_node_ref_category(node_ref: AstNodeRef) -> i64 {
        return ast_node_category(ast_node_from_ref(node_ref));
    }

    fn ast_node_ref_span_start(node_ref: AstNodeRef) -> i64 {
        return ast_node_span_start(ast_node_from_ref(node_ref));
    }

    fn ast_node_ref_span_end(node_ref: AstNodeRef) -> i64 {
        return ast_node_span_end(ast_node_from_ref(node_ref));
    }

    fn ast_node_from_handle(handle: i64) -> Vec<i64> {
        return handle as Vec<i64>;
    }

    fn ast_node_ref_from_optional_handle(handle: i64) -> AstNodeRef {
        return ast_node_ref_from_handle(handle);
    }

    fn ast_type_handle(type_node: Vec<i64>) -> i64 {
        return ast_node_handle(type_node);
    }

    fn ast_type_ref_from_handle(handle: i64) -> AstTypeRef {
        return AstTypeRef { handle: handle };
    }

    fn ast_type_ref_from_node(type_node: Vec<i64>) -> AstTypeRef {
        return ast_type_ref_from_handle(ast_type_handle(type_node));
    }

    fn ast_type_ref_from_node_ref(node_ref: AstNodeRef) -> AstTypeRef {
        return ast_type_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_type_ref_handle(type_ref: AstTypeRef) -> i64 {
        return type_ref.handle;
    }

    fn ast_type_ref_to_optional_handle(type_ref: AstTypeRef) -> i64 {
        return ast_type_ref_handle(type_ref);
    }

    fn ast_type_node_from_ref(type_ref: AstTypeRef) -> Vec<i64> {
        return ast_node_from_handle(ast_type_ref_handle(type_ref));
    }

    fn ast_type_ref_record(type_ref: AstTypeRef) -> AstType {
        return ast_type_unpack(ast_type_node_from_ref(type_ref));
    }

    fn ast_type_ref_kind_value(type_ref: AstTypeRef) -> TypeKind {
        let rec: AstType = ast_type_ref_record(type_ref);
        return rec.kind;
    }

    fn ast_type_ref_struct_name_idx_value(type_ref: AstTypeRef) -> i64 {
        let rec: AstType = ast_type_ref_record(type_ref);
        if rec.kind == TypeKind.Struct {
            return rec.payload;
        }
        return -1;
    }

    fn ast_type_ref_array_elem_kind_value(type_ref: AstTypeRef) -> TypeKind {
        let rec: AstType = ast_type_ref_record(type_ref);
        if rec.kind == TypeKind.Array {
            return rec.payload;
        }
        return TYPE_UNKNOWN;
    }

    fn ast_type_ref_array_len_value(type_ref: AstTypeRef) -> i64 {
        let rec: AstType = ast_type_ref_record(type_ref);
        if rec.kind == TypeKind.Array {
            return rec.aux;
        }
        return -1;
    }

    fn ast_expr_handle(expr: Vec<i64>) -> i64 {
        return ast_node_handle(expr);
    }

    fn ast_expr_ref_from_handle(handle: i64) -> AstExprRef {
        return AstExprRef { handle: handle };
    }

    fn ast_expr_ref_from_node(expr: Vec<i64>) -> AstExprRef {
        return ast_expr_ref_from_handle(ast_expr_handle(expr));
    }

    fn ast_expr_ref_from_node_ref(node_ref: AstNodeRef) -> AstExprRef {
        return ast_expr_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_expr_ref_handle(expr_ref: AstExprRef) -> i64 {
        return expr_ref.handle;
    }

    fn ast_expr_ref_to_optional_handle(expr_ref: AstExprRef) -> i64 {
        return ast_expr_ref_handle(expr_ref);
    }

    fn ast_expr_node_from_ref(expr_ref: AstExprRef) -> Vec<i64> {
        return ast_node_from_handle(ast_expr_ref_handle(expr_ref));
    }

    fn ast_expr_ref_kind(expr_ref: AstExprRef) -> NodeKind {
        return ast_node_kind(ast_expr_node_from_ref(expr_ref));
    }

    fn ast_expr_ref_span_start(expr_ref: AstExprRef) -> i64 {
        return ast_node_ref_span_start(ast_node_ref_from_expr_ref(expr_ref));
    }

    fn ast_expr_ref_span_end(expr_ref: AstExprRef) -> i64 {
        return ast_node_ref_span_end(ast_node_ref_from_expr_ref(expr_ref));
    }

    fn ast_stmt_handle(stmt: Vec<i64>) -> i64 {
        return ast_node_handle(stmt);
    }

    fn ast_stmt_ref_from_handle(handle: i64) -> AstStmtRef {
        return AstStmtRef { handle: handle };
    }

    fn ast_stmt_ref_from_node(stmt: Vec<i64>) -> AstStmtRef {
        return ast_stmt_ref_from_handle(ast_stmt_handle(stmt));
    }

    fn ast_stmt_ref_from_node_ref(node_ref: AstNodeRef) -> AstStmtRef {
        return ast_stmt_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_stmt_ref_handle(stmt_ref: AstStmtRef) -> i64 {
        return stmt_ref.handle;
    }

    fn ast_stmt_node_from_ref(stmt_ref: AstStmtRef) -> Vec<i64> {
        return ast_node_from_handle(ast_stmt_ref_handle(stmt_ref));
    }

    fn ast_stmt_ref_kind(stmt_ref: AstStmtRef) -> NodeKind {
        return ast_node_kind(ast_stmt_node_from_ref(stmt_ref));
    }

    fn ast_item_handle(item: Vec<i64>) -> i64 {
        return ast_node_handle(item);
    }

    fn ast_item_ref_from_handle(handle: i64) -> AstItemRef {
        return AstItemRef { handle: handle };
    }

    fn ast_item_ref_from_node(item: Vec<i64>) -> AstItemRef {
        return ast_item_ref_from_handle(ast_item_handle(item));
    }

    fn ast_item_ref_from_node_ref(node_ref: AstNodeRef) -> AstItemRef {
        return ast_item_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_item_ref_handle(item_ref: AstItemRef) -> i64 {
        return item_ref.handle;
    }

    fn ast_optional_item_ref_none() -> AstItemRef {
        return ast_item_ref_from_handle(ast_optional_none());
    }

    fn ast_item_ref_is_none(item_ref: AstItemRef) -> bool {
        return ast_optional_is_none(ast_item_ref_handle(item_ref));
    }

    fn ast_item_ref_is_some(item_ref: AstItemRef) -> bool {
        return ast_optional_is_some(ast_item_ref_handle(item_ref));
    }

    fn ast_item_node_from_ref(item_ref: AstItemRef) -> Vec<i64> {
        return ast_node_from_handle(ast_item_ref_handle(item_ref));
    }

    fn ast_item_ref_kind(item_ref: AstItemRef) -> NodeKind {
        return ast_node_kind(ast_item_node_from_ref(item_ref));
    }

    fn ast_block_handle(block: Vec<i64>) -> i64 {
        return ast_node_handle(block);
    }

    fn ast_block_ref_from_handle(handle: i64) -> AstBlockRef {
        return AstBlockRef { handle: handle };
    }

    fn ast_block_ref_from_node(block: Vec<i64>) -> AstBlockRef {
        return ast_block_ref_from_handle(ast_block_handle(block));
    }

    fn ast_block_ref_from_node_ref(node_ref: AstNodeRef) -> AstBlockRef {
        return ast_block_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_block_ref_handle(block_ref: AstBlockRef) -> i64 {
        return block_ref.handle;
    }

    fn ast_block_ref_to_optional_handle(block_ref: AstBlockRef) -> i64 {
        return ast_block_ref_handle(block_ref);
    }

    fn ast_block_node_from_ref(block_ref: AstBlockRef) -> Vec<i64> {
        return ast_node_from_handle(ast_block_ref_handle(block_ref));
    }

    fn ast_node_ref_from_type_ref(type_ref: AstTypeRef) -> AstNodeRef {
        return ast_node_ref_from_handle(ast_type_ref_handle(type_ref));
    }

    fn ast_node_ref_from_expr_ref(expr_ref: AstExprRef) -> AstNodeRef {
        return ast_node_ref_from_handle(ast_expr_ref_handle(expr_ref));
    }

    fn ast_node_ref_from_stmt_ref(stmt_ref: AstStmtRef) -> AstNodeRef {
        return ast_node_ref_from_handle(ast_stmt_ref_handle(stmt_ref));
    }

    fn ast_node_ref_from_item_ref(item_ref: AstItemRef) -> AstNodeRef {
        return ast_node_ref_from_handle(ast_item_ref_handle(item_ref));
    }

    fn ast_node_ref_from_block_ref(block_ref: AstBlockRef) -> AstNodeRef {
        return ast_node_ref_from_handle(ast_block_ref_handle(block_ref));
    }

    fn ast_block_ref_stmt_count(block_ref: AstBlockRef) -> i64 {
        return vec_len(ast_block_node_from_ref(block_ref)) - AST_NODE_DATA_START;
    }

    fn ast_pattern_handle(pattern: Vec<i64>) -> i64 {
        return pattern as i64;
    }

    fn ast_pattern_ref_from_handle(handle: i64) -> AstPatternRef {
        return AstPatternRef { handle: handle };
    }

    fn ast_pattern_ref_from_pattern(pattern: Vec<i64>) -> AstPatternRef {
        return ast_pattern_ref_from_handle(ast_pattern_handle(pattern));
    }

    fn ast_pattern_ref_handle(pattern_ref: AstPatternRef) -> i64 {
        return pattern_ref.handle;
    }

    fn ast_pattern_from_ref(pattern_ref: AstPatternRef) -> Vec<i64> {
        return ast_pattern_from_handle(ast_pattern_ref_handle(pattern_ref));
    }

    fn ast_pattern_ref_record(pattern_ref: AstPatternRef) -> AstPattern {
        return ast_pattern_unpack(ast_pattern_from_ref(pattern_ref));
    }

    fn ast_pattern_ref_kind(pattern_ref: AstPatternRef) -> PatternKind {
        let pattern: AstPattern = ast_pattern_ref_record(pattern_ref);
        return pattern.kind;
    }

    fn ast_pattern_ref_value(pattern_ref: AstPatternRef) -> i64 {
        let pattern: AstPattern = ast_pattern_ref_record(pattern_ref);
        return pattern.value;
    }

    fn ast_pattern_ref_aux(pattern_ref: AstPatternRef) -> i64 {
        let pattern: AstPattern = ast_pattern_ref_record(pattern_ref);
        return pattern.aux;
    }

    fn ast_pattern_ref_span_start(pattern_ref: AstPatternRef) -> i64 {
        let pattern: AstPattern = ast_pattern_ref_record(pattern_ref);
        return pattern.start;
    }

    fn ast_pattern_ref_span_end(pattern_ref: AstPatternRef) -> i64 {
        let pattern: AstPattern = ast_pattern_ref_record(pattern_ref);
        return pattern.end;
    }

    fn ast_pattern_from_handle(handle: i64) -> Vec<i64> {
        return handle as Vec<i64>;
    }

    fn ast_node_list_ref_from_handle(handle: i64) -> AstNodeListRef {
        return AstNodeListRef { handle: handle };
    }

    fn ast_node_list_ref_from_list(nodes: Vec<i64>) -> AstNodeListRef {
        return ast_node_list_ref_from_handle(nodes as i64);
    }

    fn ast_node_list_ref_handle(nodes_ref: AstNodeListRef) -> i64 {
        return nodes_ref.handle;
    }

    fn ast_node_list_from_ref(nodes_ref: AstNodeListRef) -> Vec<i64> {
        return ast_node_list_ref_handle(nodes_ref) as Vec<i64>;
    }

    fn ast_node_list_from_handle(handle: i64) -> Vec<i64> {
        return ast_node_list_from_ref(ast_node_list_ref_from_handle(handle));
