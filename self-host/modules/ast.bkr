    fn ast_type_kind_value(type_node: i64) -> TypeKind {
        if ast_optional_is_none(type_node) {
            return TYPE_UNKNOWN;
        }
        let rec: AstType = ast_type_unpack(ast_node_from_handle(type_node));
        return rec.kind;
    }

    fn ast_type_struct_name_idx_value(type_node: i64) -> i64 {
        if ast_optional_is_none(type_node) {
            return -1;
        }
        let rec: AstType = ast_type_unpack(ast_node_from_handle(type_node));
        if rec.kind == TypeKind.Struct {
            return rec.payload;
        }
        return -1;
    }

    fn ast_type_array_elem_kind_value(type_node: i64) -> TypeKind {
        if ast_optional_is_none(type_node) {
            return TYPE_UNKNOWN;
        }
        let rec: AstType = ast_type_unpack(ast_node_from_handle(type_node));
        if rec.kind == TypeKind.Array {
            return rec.payload;
        }
        return TYPE_UNKNOWN;
    }

    fn ast_type_array_len_value(type_node: i64) -> i64 {
        if ast_optional_is_none(type_node) {
            return -1;
        }
        let rec: AstType = ast_type_unpack(ast_node_from_handle(type_node));
        if rec.kind == TypeKind.Array {
            return rec.aux;
        }
        return -1;
    }

