    }

    fn ast_block_ref_stmt_ref(block_ref: AstBlockRef, index: i64) -> AstStmtRef {
        return ast_stmt_ref_from_node(ast_block_stmt(ast_block_node_from_ref(block_ref), index));
    }

    fn ast_block_last_stmt(block: Vec<i64>) -> Vec<i64> {
        return ast_block_stmt(block, ast_block_stmt_count(block) - 1);
    }

    fn ast_block_append_ref(block_ref: AstBlockRef, stmt_ref: AstStmtRef) -> AstBlockRef {
        ast_node_ref_push(ast_node_ref_from_handle(ast_block_ref_handle(block_ref)), ast_stmt_ref_handle(stmt_ref));
        return block_ref;
    }

    fn ast_block_append(block: Vec<i64>, stmt: Vec<i64>) -> Vec<i64> {
        ast_block_append_ref(ast_block_ref_from_node(block), ast_stmt_ref_from_node(stmt));
        return block;
    }

    fn ast_block_with_ref(stmt_ref: AstStmtRef) -> AstBlockRef {
        let stmt: Vec<i64> = ast_stmt_node_from_ref(stmt_ref);
        let block_ref: AstBlockRef = ast_block_ref();
        ast_node_ref_set_span(ast_node_ref_from_handle(ast_block_ref_handle(block_ref)), ast_node_span_start(stmt), ast_node_span_end(stmt));
        ast_block_append_ref(block_ref, stmt_ref);
        return block_ref;
    }

    fn ast_block_with(stmt: Vec<i64>) -> Vec<i64> {
        return ast_block_node_from_ref(ast_block_with_ref(ast_stmt_ref_from_node(stmt)));
    }

    fn ast_if_ref(cond_ref: AstExprRef, then_block_ref: AstBlockRef, else_block: i64) -> AstStmtRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_IF);
        ast_node_ref_push(node_ref, ast_expr_ref_handle(cond_ref));
        ast_node_ref_push(node_ref, ast_block_ref_handle(then_block_ref));
        ast_node_ref_push(node_ref, else_block);
        return ast_stmt_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_if(cond: Vec<i64>, then_block: Vec<i64>, else_block: i64) -> Vec<i64> {
        return ast_stmt_node_from_ref(ast_if_ref(ast_expr_ref_from_node(cond), ast_block_ref_from_node(then_block), else_block));
    }

    fn ast_for_ref(name_idx: i64, start_expr_ref: AstExprRef, end_expr_ref: AstExprRef, inclusive: i64, body_ref: AstBlockRef) -> AstStmtRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_FOR);
        ast_node_ref_push(node_ref, name_idx);
        ast_node_ref_push(node_ref, ast_expr_ref_handle(start_expr_ref));
        ast_node_ref_push(node_ref, ast_expr_ref_handle(end_expr_ref));
        ast_node_ref_push(node_ref, inclusive);
        ast_node_ref_push(node_ref, ast_block_ref_handle(body_ref));
        return ast_stmt_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_for(name_idx: i64, start_expr: Vec<i64>, end_expr: Vec<i64>, inclusive: i64, body: Vec<i64>) -> Vec<i64> {
        return ast_stmt_node_from_ref(ast_for_ref(name_idx, ast_expr_ref_from_node(start_expr), ast_expr_ref_from_node(end_expr), inclusive, ast_block_ref_from_node(body)));
    }

    fn ast_while_ref(cond_ref: AstExprRef, body_ref: AstBlockRef) -> AstStmtRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_WHILE);
        ast_node_ref_push(node_ref, ast_expr_ref_handle(cond_ref));
        ast_node_ref_push(node_ref, ast_block_ref_handle(body_ref));
        return ast_stmt_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_while(cond: Vec<i64>, body: Vec<i64>) -> Vec<i64> {
        return ast_stmt_node_from_ref(ast_while_ref(ast_expr_ref_from_node(cond), ast_block_ref_from_node(body)));
    }

    fn ast_loop_ref(body_ref: AstBlockRef) -> AstStmtRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_LOOP);
        ast_node_ref_push(node_ref, ast_block_ref_handle(body_ref));
        return ast_stmt_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_loop(body: Vec<i64>) -> Vec<i64> {
        return ast_stmt_node_from_ref(ast_loop_ref(ast_block_ref_from_node(body)));
    }

    fn ast_param_ref(name_idx: i64, type_ref: AstTypeRef) -> AstNodeRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_PARAM);
        ast_node_ref_push(node_ref, name_idx);
        ast_node_ref_push(node_ref, ast_type_ref_handle(type_ref));
        return node_ref;
    }

    fn ast_param(name_idx: i64, type_node: Vec<i64>) -> Vec<i64> {
        return ast_node_from_ref(ast_param_ref(name_idx, ast_type_ref_from_node(type_node)));
    }

    fn ast_fn_ref(name_idx: i64, params_ref: AstNodeListRef, ret_type: i64, body_ref: AstBlockRef) -> AstItemRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_FN);
        ast_node_ref_push(node_ref, name_idx);
        ast_node_ref_push(node_ref, ast_node_list_ref_handle(params_ref));
        ast_node_ref_push(node_ref, ret_type);
        ast_node_ref_push(node_ref, ast_block_ref_handle(body_ref));
        return ast_item_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_fn(name_idx: i64, params: Vec<i64>, ret_type: i64, body: Vec<i64>) -> Vec<i64> {
        return ast_item_node_from_ref(ast_fn_ref(name_idx, ast_node_list_ref_from_list(params), ret_type, ast_block_ref_from_node(body)));
    }

    fn ast_const_ref(name_idx: i64, type_node: i64, value: i64) -> AstItemRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_CONST);
        ast_node_ref_push(node_ref, name_idx);
        ast_node_ref_push(node_ref, type_node);
        ast_node_ref_push(node_ref, value);
        return ast_item_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_const(name_idx: i64, type_node: i64, value: i64) -> Vec<i64> {
        return ast_item_node_from_ref(ast_const_ref(name_idx, type_node, value));
    }

    fn ast_field_decl_ref(field_name: i64, field_type_ref: AstTypeRef) -> AstNodeRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_FIELD);
        ast_node_ref_push(node_ref, field_name);
        ast_node_ref_push(node_ref, ast_type_ref_handle(field_type_ref));
        return node_ref;
    }

    fn ast_field_decl(field_name: i64, field_type: Vec<i64>) -> Vec<i64> {
        return ast_node_from_ref(ast_field_decl_ref(field_name, ast_type_ref_from_node(field_type)));
    }

    fn ast_struct_ref(name_idx: i64, fields_ref: AstNodeListRef) -> AstItemRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_STRUCT);
        ast_node_ref_push(node_ref, name_idx);
        ast_node_ref_push(node_ref, ast_node_list_ref_handle(fields_ref));
        return ast_item_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_enum_ref(name_idx: i64, variants_ref: AstI64ListRef) -> AstItemRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_ENUM);
        ast_node_ref_push(node_ref, name_idx);
        ast_node_ref_push(node_ref, ast_i64_list_ref_handle(variants_ref));
        return ast_item_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_enum_ref_name_idx(item_ref: AstItemRef) -> i64 {
        return ast_field(ast_item_node_from_ref(item_ref), 1);
    }

    fn ast_enum_ref_variants_ref(item_ref: AstItemRef) -> AstI64ListRef {
        return ast_field_i64_list_ref(ast_item_node_from_ref(item_ref), 2);
    }

    fn ast_struct(name_idx: i64, fields: Vec<i64>) -> Vec<i64> {
        return ast_item_node_from_ref(ast_struct_ref(name_idx, ast_node_list_ref_from_list(fields)));
    }

    fn ast_kernel_ref(name_idx: i64, items_ref: AstNodeListRef, main_name_idx: i64, names_ref: AstStringListRef) -> AstNodeRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_KERNEL);
        ast_node_ref_push(node_ref, name_idx);
        ast_node_ref_push(node_ref, ast_node_list_ref_handle(items_ref));
        ast_node_ref_push(node_ref, main_name_idx);
        ast_node_ref_push(node_ref, ast_string_list_ref_handle(names_ref));
        return node_ref;
    }

    fn ast_kernel(name_idx: i64, items: Vec<i64>, main_name_idx: i64, names: Vec<str>) -> Vec<i64> {
        return ast_node_from_ref(ast_kernel_ref(name_idx, ast_node_list_ref_from_list(items), main_name_idx, ast_string_list_ref_from_list(names)));
    }
