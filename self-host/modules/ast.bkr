    fn ast_type_record(kind: TypeKind) -> AstType {
        return AstType {
            kind: kind,
            start: AST_SPAN_UNKNOWN,
            end: AST_SPAN_UNKNOWN,
            payload: 0,
            aux: -1
        };
    }

    fn ast_type_array_record(elem_kind: TypeKind, len_value: i64) -> AstType {
        return AstType {
            kind: TypeKind.Array,
            start: AST_SPAN_UNKNOWN,
            end: AST_SPAN_UNKNOWN,
            payload: elem_kind,
            aux: len_value
        };
    }

    fn ast_type_struct_record(name_idx: i64) -> AstType {
        return AstType {
            kind: TypeKind.Struct,
            start: AST_SPAN_UNKNOWN,
            end: AST_SPAN_UNKNOWN,
            payload: name_idx,
            aux: -1
        };
    }

    fn ast_type_pack(type_rec: AstType) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_TYPE);
        vec_push(node, type_rec.start);
        vec_push(node, type_rec.end);
        vec_push(node, type_rec.kind);
        if type_rec.kind == TypeKind.Array {
            vec_push(node, type_rec.payload);
            vec_push(node, type_rec.aux);
        }
        if type_rec.kind == TypeKind.Struct {
            vec_push(node, type_rec.payload);
        }
        return node;
    }

    fn ast_type_unpack(node: Vec<i64>) -> AstType {
        let kind: TypeKind = TYPE_UNKNOWN;
        let payload: i64 = 0;
        let aux: i64 = -1;
        if vec_len(node) > AST_NODE_DATA_START {
            kind = vec_get(node, AST_NODE_DATA_START);
        }
        if vec_len(node) > AST_NODE_DATA_START + 1 {
            payload = vec_get(node, AST_NODE_DATA_START + 1);
        }
        if vec_len(node) > AST_NODE_DATA_START + 2 {
            aux = vec_get(node, AST_NODE_DATA_START + 2);
        }
        return AstType {
            kind: kind,
            start: vec_get(node, AST_NODE_SPAN_START_INDEX),
            end: vec_get(node, AST_NODE_SPAN_END_INDEX),
            payload: payload,
            aux: aux
        };
    }

    fn ast_type_ref(kind: TypeKind) -> AstTypeRef {
        let rec: AstType = ast_type_record(kind);
        return ast_type_ref_from_handle(ast_type_pack(rec) as i64);
    }

    fn ast_type(kind: TypeKind) -> Vec<i64> {
        return ast_type_node_from_ref(ast_type_ref(kind));
    }

    fn ast_type_array_ref(elem_kind: TypeKind, len_value: i64) -> AstTypeRef {
        let rec: AstType = ast_type_array_record(elem_kind, len_value);
        return ast_type_ref_from_handle(ast_type_pack(rec) as i64);
    }

    fn ast_type_array(elem_kind: TypeKind, len_value: i64) -> Vec<i64> {
        return ast_type_node_from_ref(ast_type_array_ref(elem_kind, len_value));
    }

    fn ast_type_struct_ref(name_idx: i64) -> AstTypeRef {
        let rec: AstType = ast_type_struct_record(name_idx);
        return ast_type_ref_from_handle(ast_type_pack(rec) as i64);
    }

    fn ast_type_struct(name_idx: i64) -> Vec<i64> {
        return ast_type_node_from_ref(ast_type_struct_ref(name_idx));
    }

    fn ast_pattern(kind: PatternKind, value: i64) -> Vec<i64> {
        return ast_pattern_pack(ast_pattern_record(kind, value));
    }

    fn ast_pattern_span_start(pattern: Vec<i64>) -> i64 {
        let record: AstPattern = ast_pattern_unpack(pattern);
        return record.start;
    }

    fn ast_pattern_span_end(pattern: Vec<i64>) -> i64 {
        let record: AstPattern = ast_pattern_unpack(pattern);
        return record.end;
    }

    fn ast_set_pattern_span(pattern: Vec<i64>, start: i64, end: i64) -> Vec<i64> {
        ast_pattern_ref_set_span(ast_pattern_ref_from_pattern(pattern), start, end);
        return pattern;
    }

    fn ast_match_record(scrutinee: i64, patterns: i64, bodies: i64) -> AstMatch {
        return AstMatch {
            start: AST_SPAN_UNKNOWN,
            end: AST_SPAN_UNKNOWN,
            scrutinee: scrutinee,
            patterns: patterns,
            bodies: bodies
        };
    }

    fn ast_match_pack(expr: AstMatch) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_MATCH);
        vec_push(node, expr.start);
        vec_push(node, expr.end);
        vec_push(node, expr.scrutinee);
        vec_push(node, expr.patterns);
        vec_push(node, expr.bodies);
        return node;
    }

    fn ast_match_unpack(node: Vec<i64>) -> AstMatch {
        let scrutinee: i64 = 0;
        let patterns: i64 = 0;
        let bodies: i64 = 0;
        if vec_len(node) > AST_NODE_DATA_START {
            scrutinee = vec_get(node, AST_NODE_DATA_START);
        }
        if vec_len(node) > AST_NODE_DATA_START + 1 {
            patterns = vec_get(node, AST_NODE_DATA_START + 1);
        }
        if vec_len(node) > AST_NODE_DATA_START + 2 {
            bodies = vec_get(node, AST_NODE_DATA_START + 2);
        }
        return AstMatch {
            start: vec_get(node, AST_NODE_SPAN_START_INDEX),
            end: vec_get(node, AST_NODE_SPAN_END_INDEX),
            scrutinee: scrutinee,
            patterns: patterns,
            bodies: bodies
        };
    }

    fn ast_match_ref(scrutinee_ref: AstExprRef, patterns_ref: AstPatternListRef, bodies_ref: AstNodeListRef) -> AstExprRef {
        let rec: AstMatch = ast_match_record(ast_expr_ref_handle(scrutinee_ref), ast_pattern_list_ref_handle(patterns_ref), ast_node_list_ref_handle(bodies_ref));
        return ast_expr_ref_from_handle(ast_match_pack(rec) as i64);
    }

    fn ast_match(scrutinee: Vec<i64>, patterns: Vec<i64>, bodies: Vec<i64>) -> Vec<i64> {
        return ast_expr_node_from_ref(ast_match_ref(ast_expr_ref_from_node(scrutinee), ast_pattern_list_ref_from_list(patterns), ast_node_list_ref_from_list(bodies)));
    }

    fn ast_atom_record(kind: NodeKind, payload: i64) -> AstAtom {
        return AstAtom {
            kind: kind,
            start: AST_SPAN_UNKNOWN,
            end: AST_SPAN_UNKNOWN,
            payload: payload
        };
    }

    fn ast_atom_pack(atom: AstAtom) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, atom.kind);
        vec_push(node, atom.start);
        vec_push(node, atom.end);
        vec_push(node, atom.payload);
        return node;
