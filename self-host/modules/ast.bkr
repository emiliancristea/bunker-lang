    fn ast_type_struct_ref(name_idx: i64) -> AstTypeRef {
        let node_ref: AstNodeRef = ast_node_ref_new(NODE_TYPE);
        ast_node_ref_push(node_ref, TYPE_STRUCT);
        ast_node_ref_push(node_ref, name_idx);
        return ast_type_ref_from_handle(ast_node_ref_handle(node_ref));
    }

    fn ast_type_struct(name_idx: i64) -> Vec<i64> {
