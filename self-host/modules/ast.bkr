    }

    fn ast_const_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_const_type_node(node: Vec<i64>) -> i64 {
        return ast_const_type_handle(node);
    }

    fn ast_const_type_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_const_value(node: Vec<i64>) -> i64 {
        return ast_const_value_handle(node);
    }

    fn ast_const_value_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_struct_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_struct_fields(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node_list(node, 2);
    }

    fn ast_field_decl_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_field_decl_type_node(node: Vec<i64>) -> i64 {
        return ast_field_decl_type_handle(node);
    }

    fn ast_field_decl_type_handle(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_kernel_items(node: Vec<i64>) -> Vec<i64> {
        return ast_field_node_list(node, 2);
    }

    fn ast_kernel_entry_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_kernel_names(node: Vec<i64>) -> Vec<str> {
        return ast_field_string_list(node, 4);
    }

    // Typed collection bridge helpers. These still read bootstrap Vec storage,
    // but callers no longer need to know which fields are node arrays.

    fn ast_node_list_count(nodes: Vec<i64>) -> i64 {
        return vec_len(nodes);
    }

    fn ast_node_list_get(nodes: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_from_handle(vec_get(nodes, index));
    }

    fn ast_node_list_get_handle(nodes: Vec<i64>, index: i64) -> i64 {
        return vec_get(nodes, index);
    }

    fn ast_i64_list_count(values: Vec<i64>) -> i64 {
        return vec_len(values);
    }

    fn ast_i64_list_get(values: Vec<i64>, index: i64) -> i64 {
        return vec_get(values, index);
    }

    fn ast_pattern_list_count(patterns: Vec<i64>) -> i64 {
        return vec_len(patterns);
    }

    fn ast_pattern_list_get(patterns: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_pattern_from_handle(vec_get(patterns, index));
    }

    fn ast_kernel_item_count(kernel: Vec<i64>) -> i64 {
        return ast_node_list_count(ast_kernel_items(kernel));
    }

    fn ast_kernel_item(kernel: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_list_get(ast_kernel_items(kernel), index);
    }

    fn ast_kernel_item_handle(kernel: Vec<i64>, index: i64) -> i64 {
        return ast_node_list_get_handle(ast_kernel_items(kernel), index);
    }

    fn ast_fn_param_count(fn_node: Vec<i64>) -> i64 {
        return ast_node_list_count(ast_fn_params(fn_node));
    }

    fn ast_fn_param(fn_node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_list_get(ast_fn_params(fn_node), index);
    }

    fn ast_struct_field_count(struct_node: Vec<i64>) -> i64 {
        return ast_node_list_count(ast_struct_fields(struct_node));
    }

    fn ast_struct_field(struct_node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_list_get(ast_struct_fields(struct_node), index);
    }

    fn ast_call_arg_count(call_node: Vec<i64>) -> i64 {
        return ast_node_list_count(ast_call_args(call_node));
    }

    fn ast_call_arg(call_node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_list_get(ast_call_args(call_node), index);
    }

    fn ast_call_arg_handle(call_node: Vec<i64>, index: i64) -> i64 {
        return ast_node_list_get_handle(ast_call_args(call_node), index);
    }

    fn ast_array_element_count(array_node: Vec<i64>) -> i64 {
        return ast_node_list_count(ast_array_elements(array_node));
    }

    fn ast_array_element(array_node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_list_get(ast_array_elements(array_node), index);
    }

    fn ast_array_element_handle(array_node: Vec<i64>, index: i64) -> i64 {
        return ast_node_list_get_handle(ast_array_elements(array_node), index);
    }

    fn ast_match_arm_count(match_node: Vec<i64>) -> i64 {
        return ast_pattern_list_count(ast_match_patterns(match_node));
    }

    fn ast_match_pattern(match_node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_pattern_list_get(ast_match_patterns(match_node), index);
    }

    fn ast_match_body(match_node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_list_get(ast_match_bodies(match_node), index);
    }

    fn ast_match_body_handle(match_node: Vec<i64>, index: i64) -> i64 {
        return ast_node_list_get_handle(ast_match_bodies(match_node), index);
    }

    fn ast_struct_lit_field_count(node: Vec<i64>) -> i64 {
        return ast_i64_list_count(ast_struct_lit_field_names(node));
    }

    fn ast_struct_lit_field_name_idx(node: Vec<i64>, index: i64) -> i64 {
        return ast_i64_list_get(ast_struct_lit_field_names(node), index);
    }

    fn ast_struct_lit_field_value(node: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_list_get(ast_struct_lit_field_values(node), index);
    }

    fn ast_struct_lit_field_value_handle(node: Vec<i64>, index: i64) -> i64 {
        return ast_node_list_get_handle(ast_struct_lit_field_values(node), index);
    }

    fn ast_type(kind: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_TYPE);
        ast_push(node, kind);
        return node;
    }

    fn ast_type_array(elem_kind: i64, len_value: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_TYPE);
        ast_push(node, TYPE_ARRAY);
        ast_push(node, elem_kind);
        ast_push(node, len_value);
        return node;
    }

    fn ast_type_struct(name_idx: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_TYPE);
        ast_push(node, TYPE_STRUCT);
        ast_push(node, name_idx);
        return node;
    }

    fn ast_pattern(kind: i64, value: i64) -> Vec<i64> {
        let pattern: Vec<i64> = vec_new();
        vec_push(pattern, kind);
        vec_push(pattern, AST_SPAN_UNKNOWN);
        vec_push(pattern, AST_SPAN_UNKNOWN);
        vec_push(pattern, value);
        return pattern;
    }

    fn ast_pattern_span_start(pattern: Vec<i64>) -> i64 {
        return vec_get(pattern, AST_NODE_SPAN_START_INDEX);
    }

    fn ast_pattern_span_end(pattern: Vec<i64>) -> i64 {
        return vec_get(pattern, AST_NODE_SPAN_END_INDEX);
    }

    fn ast_set_pattern_span(pattern: Vec<i64>, start: i64, end: i64) -> Vec<i64> {
        vec_set(pattern, AST_NODE_SPAN_START_INDEX, start);
        vec_set(pattern, AST_NODE_SPAN_END_INDEX, end);
        return pattern;
    }

    fn ast_match(scrutinee: Vec<i64>, patterns: Vec<i64>, bodies: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_MATCH);
        ast_push(node, ast_expr_handle(scrutinee));
        ast_push(node, ast_i64_list_handle(patterns));
        ast_push(node, ast_node_list_handle(bodies));
        return node;
    }

    fn ast_int_lit(value: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_INT_LIT);
        ast_push(node, value);
        return node;
    }

    fn ast_float_lit(value: str) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FLOAT_LIT);
        ast_push(node, value as i64);
        return node;
    }

    fn ast_bool_lit(value: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_BOOL_LIT);
        ast_push(node, value);
        return node;
    }

    fn ast_str_lit(value: str) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_STR_LIT);
        ast_push(node, value as i64);
        return node;
    }

    fn ast_array_lit(elements: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_ARRAY_LIT);
        ast_push(node, ast_node_list_handle(elements));
        return node;
    }

    fn ast_struct_lit(name_idx: i64, field_names: Vec<i64>, field_values: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_STRUCT_LIT);
        ast_push(node, name_idx);
        ast_push(node, ast_i64_list_handle(field_names));
        ast_push(node, ast_node_list_handle(field_values));
        return node;
    }

    fn ast_call(name_idx: i64, args: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_CALL);
        ast_push(node, name_idx);
        ast_push(node, ast_node_list_handle(args));
        return node;
    }

    fn ast_ident(name_idx: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_IDENT);
        ast_push(node, name_idx);
        return node;
    }

    fn ast_unary(op: i64, operand: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_UNARY);
        ast_push(node, op);
        ast_push(node, ast_expr_handle(operand));
        return node;
    }

    fn ast_index(base: Vec<i64>, index: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_INDEX);
        ast_push(node, ast_expr_handle(base));
        ast_push(node, ast_expr_handle(index));
        return node;
    }

    fn ast_field_access(base: Vec<i64>, field_name: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FIELD_ACCESS);
        ast_push(node, ast_expr_handle(base));
        ast_push(node, field_name);
        return node;
    }

    fn ast_binary(op: i64, left: Vec<i64>, right: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_BINARY);
        ast_push(node, op);
        ast_push(node, ast_expr_handle(left));
        ast_push(node, ast_expr_handle(right));
        return node;
    }

    fn ast_ternary(cond: Vec<i64>, then_expr: Vec<i64>, else_expr: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_TERNARY);
        ast_push(node, ast_expr_handle(cond));
        ast_push(node, ast_expr_handle(then_expr));
        ast_push(node, ast_expr_handle(else_expr));
        return node;
    }

    fn ast_let(name_idx: i64, type_node: i64, init: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_LET);
        ast_push(node, name_idx);
        ast_push(node, type_node);
        ast_push(node, init);
        return node;
    }

    fn ast_return(expr: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_RETURN);
        ast_push(node, expr);
        return node;
    }

    fn ast_break() -> Vec<i64> {
        return ast_new(NODE_BREAK);
    }

    fn ast_continue() -> Vec<i64> {
        return ast_new(NODE_CONTINUE);
    }

    fn ast_assign(target: Vec<i64>, value: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_ASSIGN);
        ast_push(node, ast_expr_handle(target));
        ast_push(node, ast_expr_handle(value));
        return node;
    }

    fn ast_expr_stmt(expr: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_EXPR_STMT);
        ast_push(node, ast_expr_handle(expr));
        return node;
    }

    fn ast_block() -> Vec<i64> {
        return ast_new(NODE_BLOCK);
    }

    fn ast_block_stmt_count(block: Vec<i64>) -> i64 {
        return vec_len(block) - AST_NODE_DATA_START;
    }

    fn ast_block_stmt(block: Vec<i64>, index: i64) -> Vec<i64> {
        return ast_node_from_handle(vec_get(block, AST_NODE_DATA_START + index));
    }

    fn ast_block_last_stmt(block: Vec<i64>) -> Vec<i64> {
        return ast_block_stmt(block, ast_block_stmt_count(block) - 1);
    }

    fn ast_block_append(block: Vec<i64>, stmt: Vec<i64>) -> Vec<i64> {
        ast_push(block, ast_stmt_handle(stmt));
        return block;
    }

    fn ast_block_with(stmt: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_block();
        ast_set_span(node, ast_node_span_start(stmt), ast_node_span_end(stmt));
        ast_block_append(node, stmt);
        return node;
    }

    fn ast_if(cond: Vec<i64>, then_block: Vec<i64>, else_block: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_IF);
        ast_push(node, ast_expr_handle(cond));
        ast_push(node, ast_block_handle(then_block));
        ast_push(node, else_block);
        return node;
    }

    fn ast_for(name_idx: i64, start_expr: Vec<i64>, end_expr: Vec<i64>, inclusive: i64, body: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FOR);
        ast_push(node, name_idx);
        ast_push(node, ast_expr_handle(start_expr));
        ast_push(node, ast_expr_handle(end_expr));
        ast_push(node, inclusive);
        ast_push(node, ast_block_handle(body));
        return node;
    }

    fn ast_while(cond: Vec<i64>, body: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_WHILE);
        ast_push(node, ast_expr_handle(cond));
        ast_push(node, ast_block_handle(body));
        return node;
    }

    fn ast_loop(body: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_LOOP);
        ast_push(node, ast_block_handle(body));
        return node;
    }

    fn ast_param(name_idx: i64, type_node: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_PARAM);
        ast_push(node, name_idx);
        ast_push(node, ast_type_handle(type_node));
        return node;
    }

    fn ast_fn(name_idx: i64, params: Vec<i64>, ret_type: i64, body: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FN);
        ast_push(node, name_idx);
        ast_push(node, ast_node_list_handle(params));
        ast_push(node, ret_type);
        ast_push(node, ast_block_handle(body));
        return node;
    }

    fn ast_const(name_idx: i64, type_node: i64, value: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_CONST);
        ast_push(node, name_idx);
        ast_push(node, type_node);
        ast_push(node, value);
        return node;
    }

    fn ast_field_decl(field_name: i64, field_type: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FIELD);
        ast_push(node, field_name);
        ast_push(node, ast_type_handle(field_type));
        return node;
    }

    fn ast_struct(name_idx: i64, fields: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_STRUCT);
        ast_push(node, name_idx);
        ast_push(node, ast_node_list_handle(fields));
        return node;
    }

    fn ast_kernel(name_idx: i64, items: Vec<i64>, main_name_idx: i64, names: Vec<str>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_KERNEL);
        ast_push(node, name_idx);
        ast_push(node, ast_node_list_handle(items));
        ast_push(node, main_name_idx);
        ast_push(node, ast_string_list_handle(names));
        return node;
    }
