    // ========================================
    // AST LAYOUT HELPERS
    // ========================================
    //
    // The bootstrap compiler still represents AST nodes as Vec<i64>.
    // Keep all layout construction here so later slices can replace the
    // representation with real Bunker structs/enums behind one boundary.

    fn ast_new(kind: i64) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, kind);
        vec_push(node, AST_SPAN_UNKNOWN);
        vec_push(node, AST_SPAN_UNKNOWN);
        return node;
    }

    fn ast_push(node: Vec<i64>, value: i64) -> Vec<i64> {
        vec_push(node, value);
        return node;
    }

    fn ast_kind(node: Vec<i64>) -> i64 {
        return vec_get(node, 0);
    }

    fn ast_span(start: i64, end: i64) -> Vec<i64> {
        let span: Vec<i64> = vec_new();
        vec_push(span, start);
        vec_push(span, end);
        return span;
    }

    fn ast_span_unknown() -> Vec<i64> {
        return ast_span(AST_SPAN_UNKNOWN, AST_SPAN_UNKNOWN);
    }

    fn ast_span_start(span: Vec<i64>) -> i64 {
        if vec_len(span) < 1 {
            return AST_SPAN_UNKNOWN;
        }
        return vec_get(span, 0);
    }

    fn ast_span_end(span: Vec<i64>) -> i64 {
        if vec_len(span) < 2 {
            return AST_SPAN_UNKNOWN;
        }
        return vec_get(span, 1);
    }

    fn ast_span_is_known(span: Vec<i64>) -> bool {
        return ast_span_start(span) >= 0 && ast_span_end(span) >= 0;
    }

    fn ast_node_span_start(node: Vec<i64>) -> i64 {
        return vec_get(node, AST_NODE_SPAN_START_INDEX);
    }

    fn ast_node_span_end(node: Vec<i64>) -> i64 {
        return vec_get(node, AST_NODE_SPAN_END_INDEX);
    }

    fn ast_node_span(node: Vec<i64>) -> Vec<i64> {
        return ast_span(ast_node_span_start(node), ast_node_span_end(node));
    }

    fn ast_node_has_span(node: Vec<i64>) -> bool {
        return ast_span_is_known(ast_node_span(node));
    }

    fn ast_set_span(node: Vec<i64>, start: i64, end: i64) -> Vec<i64> {
        vec_set(node, AST_NODE_SPAN_START_INDEX, start);
        vec_set(node, AST_NODE_SPAN_END_INDEX, end);
        return node;
    }

    fn ast_set_span_from(node: Vec<i64>, span: Vec<i64>) -> Vec<i64> {
        return ast_set_span(node, ast_span_start(span), ast_span_end(span));
    }

    fn ast_has_field(node: Vec<i64>, index: i64) -> bool {
        return vec_len(node) > index + AST_NODE_DATA_OFFSET;
    }

    fn ast_node_kind_name(kind: i64) -> str {
        if kind == NODE_KERNEL { return "kernel"; }
        if kind == NODE_FN { return "function"; }
        if kind == NODE_PARAM { return "parameter"; }
        if kind == NODE_TYPE { return "type"; }
        if kind == NODE_BLOCK { return "block"; }
        if kind == NODE_LET { return "let"; }
        if kind == NODE_RETURN { return "return"; }
        if kind == NODE_IF { return "if"; }
        if kind == NODE_WHILE { return "while"; }
        if kind == NODE_EXPR_STMT { return "expression statement"; }
        if kind == NODE_ASSIGN { return "assignment"; }
        if kind == NODE_BREAK { return "break"; }
        if kind == NODE_CONTINUE { return "continue"; }
        if kind == NODE_FOR { return "for"; }
        if kind == NODE_LOOP { return "loop"; }
        if kind == NODE_BINARY { return "binary expression"; }
        if kind == NODE_UNARY { return "unary expression"; }
        if kind == NODE_CALL { return "call expression"; }
        if kind == NODE_IDENT { return "identifier"; }
        if kind == NODE_INT_LIT { return "integer literal"; }
        if kind == NODE_BOOL_LIT { return "boolean literal"; }
        if kind == NODE_STR_LIT { return "string literal"; }
        if kind == NODE_CONST { return "constant"; }
        if kind == NODE_TERNARY { return "ternary expression"; }
        if kind == NODE_FLOAT_LIT { return "float literal"; }
        if kind == NODE_ARRAY_LIT { return "array literal"; }
        if kind == NODE_INDEX { return "index expression"; }
        if kind == NODE_STRUCT { return "struct"; }
        if kind == NODE_FIELD { return "field"; }
        if kind == NODE_FIELD_ACCESS { return "field access"; }
        if kind == NODE_STRUCT_LIT { return "struct literal"; }
        if kind == NODE_MATCH { return "match expression"; }
        return "node " + int_to_string(kind);
    }

    fn ast_type_kind_name(kind: i64) -> str {
        if kind == TYPE_I32 { return "i32"; }
        if kind == TYPE_I64 { return "i64"; }
        if kind == TYPE_F64 { return "f64"; }
        if kind == TYPE_BOOL { return "bool"; }
        if kind == TYPE_STR { return "str"; }
        if kind == TYPE_VOID { return "void"; }
        if kind == TYPE_ARRAY { return "array"; }
        if kind == TYPE_STRUCT { return "struct"; }
        if kind == TYPE_UNKNOWN { return "unknown"; }
        return "type " + int_to_string(kind);
    }

    fn ast_pattern_kind_name(kind: i64) -> str {
        if kind == PAT_INT { return "integer pattern"; }
        if kind == PAT_BOOL { return "boolean pattern"; }
        if kind == PAT_BIND { return "binding pattern"; }
        if kind == PAT_WILDCARD { return "wildcard pattern"; }
        if kind == PAT_SOME { return "Some pattern"; }
        if kind == PAT_NONE { return "None pattern"; }
        return "pattern " + int_to_string(kind);
    }

    fn ast_category_name(category: i64) -> str {
        if category == AST_CAT_ITEM { return "item"; }
        if category == AST_CAT_STMT { return "statement"; }
        if category == AST_CAT_EXPR { return "expression"; }
        if category == AST_CAT_TYPE { return "type"; }
        if category == AST_CAT_DECL { return "declaration"; }
        return "unknown";
    }

    fn ast_node_category_kind(kind: i64) -> i64 {
        if kind == NODE_KERNEL || kind == NODE_FN || kind == NODE_CONST || kind == NODE_STRUCT {
            return AST_CAT_ITEM;
        }
        if kind == NODE_BLOCK || kind == NODE_LET || kind == NODE_RETURN || kind == NODE_IF ||
           kind == NODE_WHILE || kind == NODE_EXPR_STMT || kind == NODE_ASSIGN ||
           kind == NODE_BREAK || kind == NODE_CONTINUE || kind == NODE_FOR || kind == NODE_LOOP {
            return AST_CAT_STMT;
        }
        if kind == NODE_BINARY || kind == NODE_UNARY || kind == NODE_CALL || kind == NODE_IDENT ||
           kind == NODE_INT_LIT || kind == NODE_BOOL_LIT || kind == NODE_STR_LIT ||
           kind == NODE_TERNARY || kind == NODE_FLOAT_LIT || kind == NODE_ARRAY_LIT ||
           kind == NODE_INDEX || kind == NODE_FIELD_ACCESS || kind == NODE_STRUCT_LIT ||
           kind == NODE_MATCH {
            return AST_CAT_EXPR;
        }
        if kind == NODE_TYPE {
            return AST_CAT_TYPE;
        }
        if kind == NODE_PARAM || kind == NODE_FIELD {
            return AST_CAT_DECL;
        }
        return AST_CAT_UNKNOWN;
    }

    fn ast_node_category(node: Vec<i64>) -> i64 {
        return ast_node_category_kind(ast_kind(node));
    }

    fn ast_is_item_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_ITEM;
    }

    fn ast_is_stmt_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_STMT;
    }

    fn ast_is_expr_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_EXPR;
    }

    fn ast_is_type_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_TYPE;
    }

    fn ast_is_decl_kind(kind: i64) -> bool {
        return ast_node_category_kind(kind) == AST_CAT_DECL;
    }

    fn ast_is_item(node: Vec<i64>) -> bool {
        return ast_is_item_kind(ast_kind(node));
    }

    fn ast_is_stmt(node: Vec<i64>) -> bool {
        return ast_is_stmt_kind(ast_kind(node));
    }

    fn ast_is_expr(node: Vec<i64>) -> bool {
        return ast_is_expr_kind(ast_kind(node));
    }

    fn ast_is_type_node(node: Vec<i64>) -> bool {
        return ast_is_type_kind(ast_kind(node));
    }

    fn ast_debug_label(node: Vec<i64>) -> str {
        let category = ast_node_category(node);
        return ast_category_name(category) + ":" + ast_node_kind_name(ast_kind(node));
    }

    fn ast_is_ident(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_IDENT;
    }

    fn ast_is_call(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_CALL;
    }

    fn ast_is_block(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_BLOCK;
    }

    fn ast_is_expr_stmt(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_EXPR_STMT;
    }

    fn ast_is_fn_item(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_FN;
    }

    fn ast_is_const_item(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_CONST;
    }

    fn ast_is_struct_item(node: Vec<i64>) -> bool {
        return ast_kind(node) == NODE_STRUCT;
    }

    fn ast_field(node: Vec<i64>, index: i64) -> i64 {
        return vec_get(node, index + AST_NODE_DATA_OFFSET);
    }

    fn ast_type_kind_value(type_node: i64) -> i64 {
        if type_node == 0 {
            return TYPE_UNKNOWN;
        }
        return ast_field(type_node as Vec<i64>, 1);
    }

    fn ast_type_struct_name_idx_value(type_node: i64) -> i64 {
        if type_node == 0 {
            return -1;
        }
        let node = type_node as Vec<i64>;
        if ast_has_field(node, 2) && ast_type_kind_value(type_node) == TYPE_STRUCT {
            return ast_field(node, 2);
        }
        return -1;
    }

    fn ast_type_array_elem_kind_value(type_node: i64) -> i64 {
        if type_node == 0 {
            return TYPE_UNKNOWN;
        }
        let node = type_node as Vec<i64>;
        if ast_has_field(node, 2) && ast_type_kind_value(type_node) == TYPE_ARRAY {
            return ast_field(node, 2);
        }
        return TYPE_UNKNOWN;
    }

    fn ast_type_array_len_value(type_node: i64) -> i64 {
        if type_node == 0 {
            return -1;
        }
        let node = type_node as Vec<i64>;
        if ast_has_field(node, 3) && ast_type_kind_value(type_node) == TYPE_ARRAY {
            return ast_field(node, 3);
        }
        return -1;
    }

    fn ast_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_value(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_type_node(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_init_expr(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_binary_op(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_binary_left(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_binary_right(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 3) as Vec<i64>;
    }

    fn ast_unary_op(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_unary_operand(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_call_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_call_args(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_array_elements(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_index_base(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_index_expr(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_field_base(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_field_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_struct_lit_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_struct_lit_field_names(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_struct_lit_field_values(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 3) as Vec<i64>;
    }

    fn ast_ternary_cond(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_ternary_then(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_ternary_else(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 3) as Vec<i64>;
    }

    fn ast_match_scrutinee(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_match_patterns(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_match_bodies(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 3) as Vec<i64>;
    }

    fn ast_pattern_kind(pattern: Vec<i64>) -> i64 {
        return vec_get(pattern, 0);
    }

    fn ast_pattern_value(pattern: Vec<i64>) -> i64 {
        return vec_get(pattern, AST_NODE_DATA_START);
    }

    fn ast_let_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_let_type_node(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_let_init(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_return_expr(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_if_cond(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_if_then(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_if_else(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_for_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_for_start(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_for_end(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 3) as Vec<i64>;
    }

    fn ast_for_inclusive(node: Vec<i64>) -> i64 {
        return ast_field(node, 4);
    }

    fn ast_for_body(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 5) as Vec<i64>;
    }

    fn ast_loop_body(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_while_cond(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_while_body(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_assign_target(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_assign_value(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_expr_stmt_expr(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 1) as Vec<i64>;
    }

    fn ast_param_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_param_type_node(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_fn_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_fn_params(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_fn_return_type(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_fn_body(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 4) as Vec<i64>;
    }

    fn ast_const_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_const_type_node(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_const_value(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_struct_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_struct_fields(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_field_decl_name_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 1);
    }

    fn ast_field_decl_type_node(node: Vec<i64>) -> i64 {
        return ast_field(node, 2);
    }

    fn ast_kernel_items(node: Vec<i64>) -> Vec<i64> {
        return ast_field(node, 2) as Vec<i64>;
    }

    fn ast_kernel_entry_idx(node: Vec<i64>) -> i64 {
        return ast_field(node, 3);
    }

    fn ast_kernel_names(node: Vec<i64>) -> Vec<str> {
        return ast_field(node, 4) as Vec<str>;
    }

    fn ast_type(kind: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_TYPE);
        ast_push(node, kind);
        return node;
    }

    fn ast_type_array(elem_kind: i64, len_value: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_TYPE);
        ast_push(node, TYPE_ARRAY);
        ast_push(node, elem_kind);
        ast_push(node, len_value);
        return node;
    }

    fn ast_type_struct(name_idx: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_TYPE);
        ast_push(node, TYPE_STRUCT);
        ast_push(node, name_idx);
        return node;
    }

    fn ast_pattern(kind: i64, value: i64) -> Vec<i64> {
        let pattern: Vec<i64> = vec_new();
        vec_push(pattern, kind);
        vec_push(pattern, AST_SPAN_UNKNOWN);
        vec_push(pattern, AST_SPAN_UNKNOWN);
        vec_push(pattern, value);
        return pattern;
    }

    fn ast_pattern_span_start(pattern: Vec<i64>) -> i64 {
        return vec_get(pattern, AST_NODE_SPAN_START_INDEX);
    }

    fn ast_pattern_span_end(pattern: Vec<i64>) -> i64 {
        return vec_get(pattern, AST_NODE_SPAN_END_INDEX);
    }

    fn ast_set_pattern_span(pattern: Vec<i64>, start: i64, end: i64) -> Vec<i64> {
        vec_set(pattern, AST_NODE_SPAN_START_INDEX, start);
        vec_set(pattern, AST_NODE_SPAN_END_INDEX, end);
        return pattern;
    }

    fn ast_match(scrutinee: Vec<i64>, patterns: Vec<i64>, bodies: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_MATCH);
        ast_push(node, scrutinee as i64);
        ast_push(node, patterns as i64);
        ast_push(node, bodies as i64);
        return node;
    }

    fn ast_int_lit(value: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_INT_LIT);
        ast_push(node, value);
        return node;
    }

    fn ast_float_lit(value: str) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FLOAT_LIT);
        ast_push(node, value as i64);
        return node;
    }

    fn ast_bool_lit(value: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_BOOL_LIT);
        ast_push(node, value);
        return node;
    }

    fn ast_str_lit(value: str) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_STR_LIT);
        ast_push(node, value as i64);
        return node;
    }

    fn ast_array_lit(elements: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_ARRAY_LIT);
        ast_push(node, elements as i64);
        return node;
    }

    fn ast_struct_lit(name_idx: i64, field_names: Vec<i64>, field_values: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_STRUCT_LIT);
        ast_push(node, name_idx);
        ast_push(node, field_names as i64);
        ast_push(node, field_values as i64);
        return node;
    }

    fn ast_call(name_idx: i64, args: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_CALL);
        ast_push(node, name_idx);
        ast_push(node, args as i64);
        return node;
    }

    fn ast_ident(name_idx: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_IDENT);
        ast_push(node, name_idx);
        return node;
    }

    fn ast_unary(op: i64, operand: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_UNARY);
        ast_push(node, op);
        ast_push(node, operand as i64);
        return node;
    }

    fn ast_index(base: Vec<i64>, index: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_INDEX);
        ast_push(node, base as i64);
        ast_push(node, index as i64);
        return node;
    }

    fn ast_field_access(base: Vec<i64>, field_name: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FIELD_ACCESS);
        ast_push(node, base as i64);
        ast_push(node, field_name);
        return node;
    }

    fn ast_binary(op: i64, left: Vec<i64>, right: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_BINARY);
        ast_push(node, op);
        ast_push(node, left as i64);
        ast_push(node, right as i64);
        return node;
    }

    fn ast_ternary(cond: Vec<i64>, then_expr: Vec<i64>, else_expr: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_TERNARY);
        ast_push(node, cond as i64);
        ast_push(node, then_expr as i64);
        ast_push(node, else_expr as i64);
        return node;
    }

    fn ast_let(name_idx: i64, type_node: i64, init: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_LET);
        ast_push(node, name_idx);
        ast_push(node, type_node);
        ast_push(node, init);
        return node;
    }

    fn ast_return(expr: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_RETURN);
        ast_push(node, expr);
        return node;
    }

    fn ast_break() -> Vec<i64> {
        return ast_new(NODE_BREAK);
    }

    fn ast_continue() -> Vec<i64> {
        return ast_new(NODE_CONTINUE);
    }

    fn ast_assign(target: Vec<i64>, value: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_ASSIGN);
        ast_push(node, target as i64);
        ast_push(node, value as i64);
        return node;
    }

    fn ast_expr_stmt(expr: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_EXPR_STMT);
        ast_push(node, expr as i64);
        return node;
    }

    fn ast_block() -> Vec<i64> {
        return ast_new(NODE_BLOCK);
    }

    fn ast_block_stmt_count(block: Vec<i64>) -> i64 {
        return vec_len(block) - AST_NODE_DATA_START;
    }

    fn ast_block_stmt(block: Vec<i64>, index: i64) -> Vec<i64> {
        return vec_get(block, AST_NODE_DATA_START + index) as Vec<i64>;
    }

    fn ast_block_last_stmt(block: Vec<i64>) -> Vec<i64> {
        return ast_block_stmt(block, ast_block_stmt_count(block) - 1);
    }

    fn ast_block_append(block: Vec<i64>, stmt: Vec<i64>) -> Vec<i64> {
        ast_push(block, stmt as i64);
        return block;
    }

    fn ast_block_with(stmt: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_block();
        ast_set_span(node, ast_node_span_start(stmt), ast_node_span_end(stmt));
        ast_block_append(node, stmt);
        return node;
    }

    fn ast_if(cond: Vec<i64>, then_block: Vec<i64>, else_block: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_IF);
        ast_push(node, cond as i64);
        ast_push(node, then_block as i64);
        ast_push(node, else_block);
        return node;
    }

    fn ast_for(name_idx: i64, start_expr: Vec<i64>, end_expr: Vec<i64>, inclusive: i64, body: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FOR);
        ast_push(node, name_idx);
        ast_push(node, start_expr as i64);
        ast_push(node, end_expr as i64);
        ast_push(node, inclusive);
        ast_push(node, body as i64);
        return node;
    }

    fn ast_while(cond: Vec<i64>, body: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_WHILE);
        ast_push(node, cond as i64);
        ast_push(node, body as i64);
        return node;
    }

    fn ast_loop(body: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_LOOP);
        ast_push(node, body as i64);
        return node;
    }

    fn ast_param(name_idx: i64, type_node: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_PARAM);
        ast_push(node, name_idx);
        ast_push(node, type_node as i64);
        return node;
    }

    fn ast_fn(name_idx: i64, params: Vec<i64>, ret_type: i64, body: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FN);
        ast_push(node, name_idx);
        ast_push(node, params as i64);
        ast_push(node, ret_type);
        ast_push(node, body as i64);
        return node;
    }

    fn ast_const(name_idx: i64, type_node: i64, value: i64) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_CONST);
        ast_push(node, name_idx);
        ast_push(node, type_node);
        ast_push(node, value);
        return node;
    }

    fn ast_field_decl(field_name: i64, field_type: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_FIELD);
        ast_push(node, field_name);
        ast_push(node, field_type as i64);
        return node;
    }

    fn ast_struct(name_idx: i64, fields: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_STRUCT);
        ast_push(node, name_idx);
        ast_push(node, fields as i64);
        return node;
    }

    fn ast_kernel(name_idx: i64, items: Vec<i64>, main_name_idx: i64, names: Vec<str>) -> Vec<i64> {
        let node: Vec<i64> = ast_new(NODE_KERNEL);
        ast_push(node, name_idx);
        ast_push(node, items as i64);
        ast_push(node, main_name_idx);
        ast_push(node, names as i64);
        return node;
    }
