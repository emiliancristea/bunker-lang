    // ========================================
    // C CODEGEN STATE HELPERS
    // ========================================
    //
    // C codegen state is still represented as Vec<i64> during bootstrap.
    // Keep its layout behind this module so the code generator can later move
    // to a typed Bunker struct without changing emission logic.
    //
    // Layout:
    // [output_lines, indent, kernel_name, names, local_names, local_types,
    //  fn_names, fn_types, global_names, global_types,
    //  array_names, array_lengths, array_elem_types, kernel_handle]

    struct CgenStateRef {
        handle: i64,
    }

    fn cgen_new(kernel_name: str, names: Vec<str>) -> Vec<i64> {
        return cgen_state_from_ref(cgen_new_ref(kernel_name, names));
    }

    fn cgen_new_ref(kernel_name: str, names: Vec<str>) -> CgenStateRef {
        let state: Vec<i64> = vec_new();
        let lines: Vec<str> = vec_new();
        let local_names: Vec<i64> = vec_new();
        let local_types: Vec<i64> = vec_new();
        let fn_names: Vec<i64> = vec_new();
        let fn_types: Vec<i64> = vec_new();
        let global_names: Vec<i64> = vec_new();
        let global_types: Vec<i64> = vec_new();
        let array_names: Vec<i64> = vec_new();
        let array_lengths: Vec<i64> = vec_new();
        let array_elem_types: Vec<i64> = vec_new();
        vec_push(state, lines as i64);
        vec_push(state, 0);
        vec_push(state, kernel_name as i64);
        vec_push(state, names as i64);
        vec_push(state, local_names as i64);
        vec_push(state, local_types as i64);
        vec_push(state, fn_names as i64);
        vec_push(state, fn_types as i64);
        vec_push(state, global_names as i64);
        vec_push(state, global_types as i64);
        vec_push(state, array_names as i64);
        vec_push(state, array_lengths as i64);
        vec_push(state, array_elem_types as i64);
        vec_push(state, 0);
        return cgen_state_ref_from_state(state);
    }

    fn cgen_attach_kernel_handle(state_ref: CgenStateRef, kernel_handle: i64) -> CgenStateRef {
        let state: Vec<i64> = cgen_state_from_ref(state_ref);
        if vec_len(state) < 14 {
            vec_push(state, kernel_handle);
        } else {
            vec_set(state, 13, kernel_handle);
        }
        return state_ref;
    }

    fn cgen_kernel_handle(state_ref: CgenStateRef) -> i64 {
        let state: Vec<i64> = cgen_state_from_ref(state_ref);
        if vec_len(state) < 14 {
            return 0;
        }
        return vec_get(state, 13);
    }

    fn cgen_state_ref_from_state(state: Vec<i64>) -> CgenStateRef {
        return CgenStateRef { handle: state as i64 };
    }

    fn cgen_state_from_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return state_ref.handle as Vec<i64>;
    }

    fn cgen_lines(state: Vec<i64>) -> Vec<str> {
        return cgen_lines_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_lines_ref(state_ref: CgenStateRef) -> Vec<str> {
        return vec_get(cgen_state_from_ref(state_ref), 0) as Vec<str>;
    }

    fn cgen_indent_level(state: Vec<i64>) -> i64 {
        return cgen_indent_level_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_indent_level_ref(state_ref: CgenStateRef) -> i64 {
        return vec_get(cgen_state_from_ref(state_ref), 1);
    }

    fn cgen_set_indent_level(state: Vec<i64>, indent: i64) -> Vec<i64> {
        cgen_set_indent_level_ref(cgen_state_ref_from_state(state), indent);
        return state;
    }

    fn cgen_set_indent_level_ref(state_ref: CgenStateRef, indent: i64) -> CgenStateRef {
        vec_set(cgen_state_from_ref(state_ref), 1, indent);
        return state_ref;
    }

    fn cgen_names(state: Vec<i64>) -> Vec<str> {
        return cgen_names_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_names_ref(state_ref: CgenStateRef) -> Vec<str> {
        return vec_get(cgen_state_from_ref(state_ref), 3) as Vec<str>;
    }

    fn cgen_local_names(state: Vec<i64>) -> Vec<i64> {
        return cgen_local_names_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_local_names_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return vec_get(cgen_state_from_ref(state_ref), 4) as Vec<i64>;
    }

    fn cgen_local_types(state: Vec<i64>) -> Vec<i64> {
        return cgen_local_types_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_local_types_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return vec_get(cgen_state_from_ref(state_ref), 5) as Vec<i64>;
    }

    fn cgen_fn_names(state: Vec<i64>) -> Vec<i64> {
        return cgen_fn_names_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_fn_names_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return vec_get(cgen_state_from_ref(state_ref), 6) as Vec<i64>;
    }

    fn cgen_fn_types(state: Vec<i64>) -> Vec<i64> {
        return cgen_fn_types_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_fn_types_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return vec_get(cgen_state_from_ref(state_ref), 7) as Vec<i64>;
    }

    fn cgen_global_names(state: Vec<i64>) -> Vec<i64> {
        return cgen_global_names_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_global_names_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return vec_get(cgen_state_from_ref(state_ref), 8) as Vec<i64>;
    }

    fn cgen_global_types(state: Vec<i64>) -> Vec<i64> {
        return cgen_global_types_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_global_types_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return vec_get(cgen_state_from_ref(state_ref), 9) as Vec<i64>;
    }

    fn cgen_array_names(state: Vec<i64>) -> Vec<i64> {
        return cgen_array_names_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_array_names_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return vec_get(cgen_state_from_ref(state_ref), 10) as Vec<i64>;
    }

    fn cgen_array_lengths(state: Vec<i64>) -> Vec<i64> {
        return cgen_array_lengths_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_array_lengths_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return vec_get(cgen_state_from_ref(state_ref), 11) as Vec<i64>;
    }

    fn cgen_array_elem_types(state: Vec<i64>) -> Vec<i64> {
        return cgen_array_elem_types_ref(cgen_state_ref_from_state(state));
    }

    fn cgen_array_elem_types_ref(state_ref: CgenStateRef) -> Vec<i64> {
        return vec_get(cgen_state_from_ref(state_ref), 12) as Vec<i64>;
    }

    fn cgen_emit(state: Vec<i64>, line: str) -> Vec<i64> {
        cgen_emit_ref(cgen_state_ref_from_state(state), line);
        return state;
    }

    fn cgen_emit_ref(state_ref: CgenStateRef, line: str) -> CgenStateRef {
        let lines: Vec<str> = cgen_lines_ref(state_ref);
        let indent: i64 = cgen_indent_level_ref(state_ref);
        let prefix: str = "";
        let i: i64 = 0;
        while i < indent {
            prefix = prefix + "    ";
            i = i + 1;
        }
        vec_push(lines, prefix + line);
        return state_ref;
    }

    fn cgen_indent(state: Vec<i64>) -> Vec<i64> {
        cgen_indent_ref(cgen_state_ref_from_state(state));
        return state;
    }

    fn cgen_indent_ref(state_ref: CgenStateRef) -> CgenStateRef {
        cgen_set_indent_level_ref(state_ref, cgen_indent_level_ref(state_ref) + 1);
        return state_ref;
    }

    fn cgen_dedent(state: Vec<i64>) -> Vec<i64> {
        cgen_dedent_ref(cgen_state_ref_from_state(state));
        return state;
    }

    fn cgen_dedent_ref(state_ref: CgenStateRef) -> CgenStateRef {
        cgen_set_indent_level_ref(state_ref, cgen_indent_level_ref(state_ref) - 1);
        return state_ref;
    }

    fn cgen_clear_locals(state: Vec<i64>) -> Vec<i64> {
        cgen_clear_locals_ref(cgen_state_ref_from_state(state));
        return state;
    }

    fn cgen_clear_locals_ref(state_ref: CgenStateRef) -> CgenStateRef {
        let state: Vec<i64> = cgen_state_from_ref(state_ref);
        let local_names: Vec<i64> = vec_new();
        let local_types: Vec<i64> = vec_new();
        let array_names: Vec<i64> = vec_new();
        let array_lengths: Vec<i64> = vec_new();
        let array_elem_types: Vec<i64> = vec_new();
        vec_set(state, 4, local_names as i64);
        vec_set(state, 5, local_types as i64);
        vec_set(state, 10, array_names as i64);
        vec_set(state, 11, array_lengths as i64);
        vec_set(state, 12, array_elem_types as i64);
        return state_ref;
    }

    fn cgen_add_local_type(state: Vec<i64>, name_idx: i64, kind: i64) -> Vec<i64> {
        cgen_add_local_type_ref(cgen_state_ref_from_state(state), name_idx, kind);
        return state;
    }

    fn cgen_add_local_type_ref(state_ref: CgenStateRef, name_idx: i64, kind: i64) -> CgenStateRef {
        let local_names: Vec<i64> = cgen_local_names_ref(state_ref);
        let local_types: Vec<i64> = cgen_local_types_ref(state_ref);
        vec_push(local_names, name_idx);
        vec_push(local_types, kind);
        return state_ref;
    }

    fn cgen_add_fn_type(state: Vec<i64>, name_idx: i64, kind: i64) -> Vec<i64> {
        cgen_add_fn_type_ref(cgen_state_ref_from_state(state), name_idx, kind);
        return state;
    }

    fn cgen_add_fn_type_ref(state_ref: CgenStateRef, name_idx: i64, kind: i64) -> CgenStateRef {
        let fn_names: Vec<i64> = cgen_fn_names_ref(state_ref);
        let fn_types: Vec<i64> = cgen_fn_types_ref(state_ref);
        vec_push(fn_names, name_idx);
        vec_push(fn_types, kind);
        return state_ref;
    }

    fn cgen_add_global_type(state: Vec<i64>, name_idx: i64, kind: i64) -> Vec<i64> {
        cgen_add_global_type_ref(cgen_state_ref_from_state(state), name_idx, kind);
        return state;
    }

    fn cgen_add_global_type_ref(state_ref: CgenStateRef, name_idx: i64, kind: i64) -> CgenStateRef {
        let global_names: Vec<i64> = cgen_global_names_ref(state_ref);
        let global_types: Vec<i64> = cgen_global_types_ref(state_ref);
        vec_push(global_names, name_idx);
        vec_push(global_types, kind);
        return state_ref;
    }

    fn cgen_add_array_type(state: Vec<i64>, name_idx: i64, elem_kind: i64, len_value: i64) -> Vec<i64> {
        cgen_add_array_type_ref(cgen_state_ref_from_state(state), name_idx, elem_kind, len_value);
        return state;
    }

    fn cgen_add_array_type_ref(state_ref: CgenStateRef, name_idx: i64, elem_kind: i64, len_value: i64) -> CgenStateRef {
        let array_names: Vec<i64> = cgen_array_names_ref(state_ref);
        let array_lengths: Vec<i64> = cgen_array_lengths_ref(state_ref);
        let array_elem_types: Vec<i64> = cgen_array_elem_types_ref(state_ref);
        vec_push(array_names, name_idx);
        vec_push(array_lengths, len_value);
        vec_push(array_elem_types, elem_kind);
        return state_ref;
    }

    fn cgen_lookup_array_length(state: Vec<i64>, name_idx: i64) -> i64 {
        return cgen_lookup_array_length_ref(cgen_state_ref_from_state(state), name_idx);
    }

    fn cgen_lookup_array_length_ref(state_ref: CgenStateRef, name_idx: i64) -> i64 {
        let array_names: Vec<i64> = cgen_array_names_ref(state_ref);
        let array_lengths: Vec<i64> = cgen_array_lengths_ref(state_ref);
        let result: i64 = -1;
        let i: i64 = 0;
        while i < vec_len(array_names) {
            if vec_get(array_names, i) == name_idx {
                result = vec_get(array_lengths, i);
            }
            i = i + 1;
        }
        return result;
    }

    fn cgen_lookup_array_elem_type(state: Vec<i64>, name_idx: i64) -> i64 {
        return cgen_lookup_array_elem_type_ref(cgen_state_ref_from_state(state), name_idx);
    }

    fn cgen_lookup_array_elem_type_ref(state_ref: CgenStateRef, name_idx: i64) -> i64 {
        let array_names: Vec<i64> = cgen_array_names_ref(state_ref);
        let array_elem_types: Vec<i64> = cgen_array_elem_types_ref(state_ref);
        let result: i64 = TYPE_UNKNOWN;
        let i: i64 = 0;
        while i < vec_len(array_names) {
            if vec_get(array_names, i) == name_idx {
                result = vec_get(array_elem_types, i);
            }
            i = i + 1;
        }
        return result;
    }

    fn cgen_lookup_pair(names: Vec<i64>, types: Vec<i64>, name_idx: i64) -> i64 {
        let result: i64 = TYPE_UNKNOWN;
        let i: i64 = 0;
        while i < vec_len(names) {
            if vec_get(names, i) == name_idx {
                result = vec_get(types, i);
            }
            i = i + 1;
        }
        return result;
    }

    fn cgen_lookup_name_type(state: Vec<i64>, name_idx: i64) -> i64 {
        return cgen_lookup_name_type_ref(cgen_state_ref_from_state(state), name_idx);
    }

    fn cgen_lookup_name_type_ref(state_ref: CgenStateRef, name_idx: i64) -> i64 {
        let local_kind: i64 = cgen_lookup_pair(cgen_local_names_ref(state_ref), cgen_local_types_ref(state_ref), name_idx);
        if local_kind != TYPE_UNKNOWN {
            return local_kind;
        }

        return cgen_lookup_pair(cgen_global_names_ref(state_ref), cgen_global_types_ref(state_ref), name_idx);
    }

    fn cgen_lookup_fn_type(state: Vec<i64>, name_idx: i64) -> i64 {
        return cgen_lookup_fn_type_ref(cgen_state_ref_from_state(state), name_idx);
    }

    fn cgen_lookup_fn_type_ref(state_ref: CgenStateRef, name_idx: i64) -> i64 {
        return cgen_lookup_pair(cgen_fn_names_ref(state_ref), cgen_fn_types_ref(state_ref), name_idx);
    }
