    // ========================================
    // SELF-HOST AST REPORT
    // ========================================
    //
    // Produces BUNKER_AST_JSON from typed AST refs over the bootstrap layout.

    fn source_line_count(source: str) -> i64 {
        let count: i64 = 1;
        let i: i64 = 0;
        while i < len(source) {
            if char_code_at(source, i) == 10 {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    fn ast_report_item_name_idx(item: Vec<i64>) -> i64 {
        return ast_report_item_ref_name_idx(ast_item_ref_from_node(item));
    }

    fn ast_report_item_ref_name_idx(item_ref: AstItemRef) -> i64 {
        let kind: i64 = ast_item_ref_kind(item_ref);
        if kind == NODE_FN {
            return ast_fn_ref_name_idx(item_ref);
        }
        if kind == NODE_CONST {
            return ast_const_ref_name_idx(item_ref);
        }
        if kind == NODE_STRUCT {
            return ast_struct_ref_name_idx(item_ref);
        }
        if kind == NODE_ENUM {
            return ast_enum_ref_name_idx(item_ref);
        }
        return -1;
    }

    fn ast_report_item_param_count(item: Vec<i64>) -> i64 {
        return ast_report_item_ref_param_count(ast_item_ref_from_node(item));
    }

    fn ast_report_item_ref_param_count(item_ref: AstItemRef) -> i64 {
        if ast_item_ref_kind(item_ref) == NODE_FN {
            return ast_node_list_ref_count(ast_fn_ref_params_ref(item_ref));
        }
        return 0;
    }

    fn ast_report_item_field_count(item: Vec<i64>) -> i64 {
        return ast_report_item_ref_field_count(ast_item_ref_from_node(item));
    }

    fn ast_report_item_ref_field_count(item_ref: AstItemRef) -> i64 {
        if ast_item_ref_kind(item_ref) == NODE_STRUCT {
            return ast_node_list_ref_count(ast_struct_ref_fields_ref(item_ref));
        }
        return 0;
    }

    fn ast_report_item_stmt_count(item: Vec<i64>) -> i64 {
        return ast_report_item_ref_stmt_count(ast_item_ref_from_node(item));
    }

    fn ast_report_item_ref_stmt_count(item_ref: AstItemRef) -> i64 {
        if ast_item_ref_kind(item_ref) == NODE_FN {
            return ast_block_ref_stmt_count(ast_fn_ref_body_ref(item_ref));
        }
        return 0;
    }

    fn ast_report_item_json(names: Vec<str>, item: Vec<i64>) -> str {
        return ast_report_item_ref_json(names, ast_item_ref_from_node(item));
    }

    fn ast_report_item_ref_json(names: Vec<str>, item_ref: AstItemRef) -> str {
        let item_node_ref: AstNodeRef = ast_node_ref_from_item_ref(item_ref);
        let comma: str = ",";
        return "{" +
            json_field_str("kind", ast_node_kind_name(ast_item_ref_kind(item_ref))) + comma +
            json_field_str("category", ast_category_name(ast_node_category_kind(ast_item_ref_kind(item_ref)))) + comma +
            json_field_str("name", ast_report_name(names, ast_report_item_ref_name_idx(item_ref))) + comma +
            json_field_i64("source_start", ast_node_ref_span_start(item_node_ref)) + comma +
            json_field_i64("source_end", ast_node_ref_span_end(item_node_ref)) + comma +
            json_field_bool("span_known", ast_node_ref_span_start(item_node_ref) != AST_SPAN_UNKNOWN && ast_node_ref_span_end(item_node_ref) != AST_SPAN_UNKNOWN) + comma +
            json_field_i64("param_count", ast_report_item_ref_param_count(item_ref)) + comma +
            json_field_i64("field_count", ast_report_item_ref_field_count(item_ref)) + comma +
            json_field_i64("statement_count", ast_report_item_ref_stmt_count(item_ref)) +
            "}";
    }

    fn ast_report_count_kind(items: Vec<i64>, kind: i64) -> i64 {
        return ast_report_count_kind_ref(ast_node_list_ref_from_list(items), kind);
    }

    fn ast_report_count_kind_ref(items_ref: AstNodeListRef, kind: i64) -> i64 {
        let count: i64 = 0;
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            let item_ref: AstNodeRef = ast_node_list_ref_get_ref(items_ref, i);
            if ast_node_ref_kind(item_ref) == kind {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    fn ast_report_items_json(kernel: Vec<i64>) -> str {
        let kernel_ref: AstNodeRef = ast_node_ref_from_node(kernel);
        return ast_report_items_json_ref(ast_kernel_ref_names(kernel_ref), ast_kernel_ref_items_ref(kernel_ref));
    }

    fn ast_report_items_json_ref(names: Vec<str>, items_ref: AstNodeListRef) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_node_list_ref_count(items_ref) {
            if i > 0 {
                result = result + ",";
            }
            result = result + ast_report_item_ref_json(names, ast_node_list_ref_get_item_ref(items_ref, i));
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_node_array_json(names: Vec<str>, nodes: Vec<i64>) -> str {
        return ast_report_node_array_json_ref(names, ast_node_list_ref_from_list(nodes));
    }

    fn ast_report_node_array_json_ref(names: Vec<str>, nodes_ref: AstNodeListRef) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_node_list_ref_count(nodes_ref) {
            if i > 0 {
                result = result + ",";
            }
            result = result + ast_report_node_ref_json(names, ast_node_list_ref_get_ref(nodes_ref, i));
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_optional_node_json(names: Vec<str>, node_value: i64) -> str {
        if ast_optional_is_none(node_value) {
            return "null";
        }
        return ast_report_node_ref_json(names, ast_node_ref_from_optional_handle(node_value));
    }

    fn ast_report_block_statements_json(names: Vec<str>, block: Vec<i64>) -> str {
        return ast_report_block_statements_ref_json(names, ast_block_ref_from_node(block));
    }

    fn ast_report_block_statements_ref_json(names: Vec<str>, block_ref: AstBlockRef) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_block_ref_stmt_count(block_ref) {
            if i > 0 {
                result = result + ",";
            }
            result = result + ast_report_node_ref_json(names, ast_node_ref_from_stmt_ref(ast_block_ref_stmt_ref(block_ref, i)));
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_pattern_json(names: Vec<str>, pattern: Vec<i64>) -> str {
        return ast_report_pattern_ref_json(names, ast_pattern_ref_from_pattern(pattern));
    }

    fn ast_report_pattern_ref_json(names: Vec<str>, pattern_ref: AstPatternRef) -> str {
        let comma = ",";
        let kind: i64 = ast_pattern_ref_kind(pattern_ref);
        let value: i64 = ast_pattern_ref_value(pattern_ref);
        let result = "{" +
            json_field_str("kind", ast_pattern_kind_name(kind)) + comma +
            json_field_i64("source_start", ast_pattern_ref_span_start(pattern_ref)) + comma +
            json_field_i64("source_end", ast_pattern_ref_span_end(pattern_ref)) + comma +
            json_field_bool("span_known", ast_pattern_ref_span_start(pattern_ref) != AST_SPAN_UNKNOWN && ast_pattern_ref_span_end(pattern_ref) != AST_SPAN_UNKNOWN);

        if kind == PAT_INT {
            result = result + comma + json_field_i64("value", value);
        } else if kind == PAT_BOOL {
            result = result + comma + json_field_bool("value", value == 1);
        } else if kind == PAT_BIND || kind == PAT_SOME {
            result = result + comma + json_field_str("binding", ast_report_name(names, value));
        }

        return result + "}";
    }

    fn ast_report_match_arms_json(names: Vec<str>, patterns: Vec<i64>, bodies: Vec<i64>) -> str {
        return ast_report_match_arms_json_ref(names, ast_pattern_list_ref_from_list(patterns), ast_node_list_ref_from_list(bodies));
    }

    fn ast_report_match_arms_json_ref(names: Vec<str>, patterns_ref: AstPatternListRef, bodies_ref: AstNodeListRef) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_pattern_list_ref_count(patterns_ref) {
            if i > 0 {
                result = result + ",";
            }
            result = result + "{" +
                json_field_raw("pattern", ast_report_pattern_ref_json(names, ast_pattern_list_ref_get_ref(patterns_ref, i))) + "," +
                json_field_raw("body", ast_report_node_ref_json(names, ast_node_list_ref_get_ref(bodies_ref, i))) +
                "}";
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_struct_lit_fields_json(names: Vec<str>, node: Vec<i64>) -> str {
        return ast_report_struct_lit_fields_json_ref(names, ast_expr_ref_from_node(node));
    }

    fn ast_report_struct_lit_fields_json_ref(names: Vec<str>, expr_ref: AstExprRef) -> str {
        let field_names_ref: AstI64ListRef = ast_struct_lit_ref_field_names_ref(expr_ref);
        let field_values_ref: AstNodeListRef = ast_struct_lit_ref_field_values_ref(expr_ref);
        let result = "[";
        let i: i64 = 0;
        while i < ast_i64_list_ref_count(field_names_ref) {
            if i > 0 {
                result = result + ",";
            }
            result = result + "{" +
                json_field_str("name", ast_report_name(names, ast_i64_list_ref_get(field_names_ref, i))) + "," +
                json_field_raw("value", ast_report_node_ref_json(names, ast_node_list_ref_get_ref(field_values_ref, i))) +
                "}";
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_expr_handle_json(names: Vec<str>, expr_handle: i64) -> str {
        let expr_ref: AstExprRef = ast_expr_ref_from_handle(expr_handle);
        return ast_report_node_ref_json(names, ast_node_ref_from_expr_ref(expr_ref));
    }

    fn ast_report_node_json(names: Vec<str>, node: Vec<i64>) -> str {
        return ast_report_node_ref_json(names, ast_node_ref_from_node(node));
    }

    fn ast_report_node_ref_json(names: Vec<str>, node_ref: AstNodeRef) -> str {
        let comma = ",";
        let kind: i64 = ast_node_ref_kind(node_ref);
        let result = "{" +
            json_field_str("kind", ast_node_kind_name(kind)) + comma +
            json_field_str("category", ast_category_name(ast_node_ref_category(node_ref))) + comma +
            json_field_i64("source_start", ast_node_ref_span_start(node_ref)) + comma +
            json_field_i64("source_end", ast_node_ref_span_end(node_ref)) + comma +
            json_field_bool("span_known", ast_node_ref_span_start(node_ref) != AST_SPAN_UNKNOWN && ast_node_ref_span_end(node_ref) != AST_SPAN_UNKNOWN);

        if kind == NODE_KERNEL {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_node_ref_name_idx(node_ref))) + comma +
                json_field_str("entry", ast_report_name(names, ast_kernel_ref_entry_idx(node_ref))) + comma +
                json_field_raw("items", ast_report_node_array_json_ref(names, ast_kernel_ref_items_ref(node_ref)));
        } else if kind == NODE_FN {
            let item_ref: AstItemRef = ast_item_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_fn_ref_name_idx(item_ref))) + comma +
                json_field_raw("params", ast_report_node_array_json_ref(names, ast_fn_ref_params_ref(item_ref))) + comma +
                json_field_raw("return_type", ast_report_optional_node_json(names, ast_fn_ref_return_type_handle(item_ref))) + comma +
                json_field_raw("body", ast_report_node_ref_json(names, ast_node_ref_from_block_ref(ast_fn_ref_body_ref(item_ref))));
        } else if kind == NODE_PARAM {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_param_ref_name_idx(node_ref))) + comma +
                json_field_raw("type", ast_report_node_ref_json(names, ast_node_ref_from_type_ref(ast_param_ref_type_ref(node_ref))));
        } else if kind == NODE_TYPE {
            let type_ref: AstTypeRef = ast_type_ref_from_node_ref(node_ref);
            let type_kind = ast_type_ref_kind_value(type_ref);
            result = result + comma +
                json_field_str("type_kind", ast_type_kind_name(type_kind)) + comma +
                json_field_i64("type_tag", type_kind);
            if type_kind == TYPE_STRUCT {
                result = result + comma + json_field_str("struct_name", ast_report_name(names, ast_type_ref_struct_name_idx_value(type_ref)));
            } else if type_kind == TYPE_ARRAY {
                result = result + comma +
                    json_field_str("element_type_kind", ast_type_kind_name(ast_type_ref_array_elem_kind_value(type_ref))) + comma +
                    json_field_i64("array_len", ast_type_ref_array_len_value(type_ref));
            }
        } else if kind == NODE_BLOCK {
            result = result + comma + json_field_raw("statements", ast_report_block_statements_ref_json(names, ast_block_ref_from_node_ref(node_ref)));
        } else if kind == NODE_LET {
            let stmt_ref: AstStmtRef = ast_stmt_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_let_ref_name_idx(stmt_ref))) + comma +
                json_field_raw("declared_type", ast_report_optional_node_json(names, ast_let_ref_type_handle(stmt_ref))) + comma +
                json_field_raw("init", ast_report_optional_node_json(names, ast_let_ref_init_handle(stmt_ref)));
        } else if kind == NODE_RETURN {
            let stmt_ref: AstStmtRef = ast_stmt_ref_from_node_ref(node_ref);
            result = result + comma + json_field_raw("expr", ast_report_optional_node_json(names, ast_return_ref_expr_handle(stmt_ref)));
        } else if kind == NODE_IF {
            let stmt_ref: AstStmtRef = ast_stmt_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_raw("condition", ast_report_expr_handle_json(names, ast_if_ref_cond_handle(stmt_ref))) + comma +
                json_field_raw("then", ast_report_node_ref_json(names, ast_node_ref_from_block_ref(ast_if_ref_then_block_ref(stmt_ref)))) + comma +
                json_field_raw("else", ast_report_optional_node_json(names, ast_if_ref_else_handle(stmt_ref)));
        } else if kind == NODE_WHILE {
            let stmt_ref: AstStmtRef = ast_stmt_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_raw("condition", ast_report_expr_handle_json(names, ast_while_ref_cond_handle(stmt_ref))) + comma +
                json_field_raw("body", ast_report_node_ref_json(names, ast_node_ref_from_block_ref(ast_while_ref_body_ref(stmt_ref))));
        } else if kind == NODE_EXPR_STMT {
            let stmt_ref: AstStmtRef = ast_stmt_ref_from_node_ref(node_ref);
            result = result + comma + json_field_raw("expr", ast_report_expr_handle_json(names, ast_expr_stmt_ref_expr_handle(stmt_ref)));
        } else if kind == NODE_ASSIGN {
            let stmt_ref: AstStmtRef = ast_stmt_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_raw("target", ast_report_expr_handle_json(names, ast_assign_ref_target_handle(stmt_ref))) + comma +
                json_field_raw("value", ast_report_expr_handle_json(names, ast_assign_ref_value_handle(stmt_ref)));
        } else if kind == NODE_FOR {
            let stmt_ref: AstStmtRef = ast_stmt_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("binding", ast_report_name(names, ast_for_ref_name_idx(stmt_ref))) + comma +
                json_field_raw("start", ast_report_expr_handle_json(names, ast_for_ref_start_handle(stmt_ref))) + comma +
                json_field_raw("end", ast_report_expr_handle_json(names, ast_for_ref_end_handle(stmt_ref))) + comma +
                json_field_bool("inclusive", ast_for_ref_inclusive(stmt_ref) == 1) + comma +
                json_field_raw("body", ast_report_node_ref_json(names, ast_node_ref_from_block_ref(ast_for_ref_body_ref(stmt_ref))));
        } else if kind == NODE_LOOP {
            let stmt_ref: AstStmtRef = ast_stmt_ref_from_node_ref(node_ref);
            result = result + comma + json_field_raw("body", ast_report_node_ref_json(names, ast_node_ref_from_block_ref(ast_loop_ref_body_ref(stmt_ref))));
        } else if kind == NODE_BINARY {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("op", token_name(ast_binary_ref_op(expr_ref))) + comma +
                json_field_raw("left", ast_report_expr_handle_json(names, ast_binary_ref_left_handle(expr_ref))) + comma +
                json_field_raw("right", ast_report_expr_handle_json(names, ast_binary_ref_right_handle(expr_ref)));
        } else if kind == NODE_UNARY {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("op", token_name(ast_unary_ref_op(expr_ref))) + comma +
                json_field_raw("operand", ast_report_expr_handle_json(names, ast_unary_ref_operand_handle(expr_ref)));
        } else if kind == NODE_CALL {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("callee", ast_report_name(names, ast_call_ref_name_idx(expr_ref))) + comma +
                json_field_raw("args", ast_report_node_array_json_ref(names, ast_call_ref_args_ref(expr_ref)));
        } else if kind == NODE_IDENT {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma + json_field_str("name", ast_report_name(names, ast_expr_ref_name_idx(expr_ref)));
        } else if kind == NODE_INT_LIT {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma + json_field_i64("value", ast_expr_ref_value(expr_ref));
        } else if kind == NODE_BOOL_LIT {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma + json_field_bool("value", ast_expr_ref_value(expr_ref) == 1);
        } else if kind == NODE_STR_LIT {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma + json_field_str("value", ast_expr_ref_value(expr_ref) as str);
        } else if kind == NODE_CONST {
            let item_ref: AstItemRef = ast_item_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_const_ref_name_idx(item_ref))) + comma +
                json_field_raw("type", ast_report_optional_node_json(names, ast_const_ref_type_handle(item_ref))) + comma +
                json_field_raw("value", ast_report_optional_node_json(names, ast_const_ref_value_handle(item_ref)));
        } else if kind == NODE_TERNARY {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_raw("condition", ast_report_expr_handle_json(names, ast_ternary_ref_cond_handle(expr_ref))) + comma +
                json_field_raw("then", ast_report_expr_handle_json(names, ast_ternary_ref_then_handle(expr_ref))) + comma +
                json_field_raw("else", ast_report_expr_handle_json(names, ast_ternary_ref_else_handle(expr_ref)));
        } else if kind == NODE_FLOAT_LIT {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma + json_field_str("value", ast_expr_ref_value(expr_ref) as str);
        } else if kind == NODE_ARRAY_LIT {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma + json_field_raw("elements", ast_report_node_array_json_ref(names, ast_array_lit_ref_elements_ref(expr_ref)));
        } else if kind == NODE_INDEX {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_raw("base", ast_report_expr_handle_json(names, ast_index_ref_base_handle(expr_ref))) + comma +
                json_field_raw("index", ast_report_expr_handle_json(names, ast_index_ref_expr_handle(expr_ref)));
        } else if kind == NODE_STRUCT {
            let item_ref: AstItemRef = ast_item_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_struct_ref_name_idx(item_ref))) + comma +
                json_field_raw("fields", ast_report_node_array_json_ref(names, ast_struct_ref_fields_ref(item_ref)));
        } else if kind == NODE_ENUM {
            let item_ref: AstItemRef = ast_item_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_enum_ref_name_idx(item_ref))) + comma +
                json_field_i64("variant_count", ast_i64_list_ref_count(ast_enum_ref_variants_ref(item_ref)));
        } else if kind == NODE_FIELD {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_field_decl_ref_name_idx(node_ref))) + comma +
                json_field_raw("type", ast_report_optional_node_json(names, ast_field_decl_ref_type_handle(node_ref)));
        } else if kind == NODE_FIELD_ACCESS {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_raw("base", ast_report_expr_handle_json(names, ast_field_access_ref_base_handle(expr_ref))) + comma +
                json_field_str("field", ast_report_name(names, ast_field_access_ref_name_idx(expr_ref)));
        } else if kind == NODE_STRUCT_LIT {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_struct_lit_ref_name_idx(expr_ref))) + comma +
                json_field_raw("fields", ast_report_struct_lit_fields_json_ref(names, expr_ref));
        } else if kind == NODE_MATCH {
            let expr_ref: AstExprRef = ast_expr_ref_from_node_ref(node_ref);
            result = result + comma +
                json_field_raw("scrutinee", ast_report_expr_handle_json(names, ast_match_ref_scrutinee_handle(expr_ref))) + comma +
                json_field_raw("arms", ast_report_match_arms_json_ref(names, ast_match_ref_patterns_ref(expr_ref), ast_match_ref_bodies_ref(expr_ref)));
        }

        return result + "}";
    }

    fn self_host_ast_json(source: str, kernel: Vec<i64>) -> str {
        let comma = ",";
        let kernel_ref: AstNodeRef = ast_node_ref_from_node(kernel);
        let names = ast_kernel_ref_names(kernel_ref);
        let items_ref: AstNodeListRef = ast_kernel_ref_items_ref(kernel_ref);
        let root = "{" +
            json_field_str("kind", ast_node_kind_name(ast_node_ref_kind(kernel_ref))) + comma +
            json_field_str("name", ast_report_name(names, ast_node_ref_name_idx(kernel_ref))) + comma +
            json_field_str("entry", ast_report_name(names, ast_kernel_ref_entry_idx(kernel_ref))) + comma +
            json_field_i64("source_start", ast_node_ref_span_start(kernel_ref)) + comma +
            json_field_i64("source_end", ast_node_ref_span_end(kernel_ref)) + comma +
            json_field_bool("span_known", ast_node_ref_span_start(kernel_ref) != AST_SPAN_UNKNOWN && ast_node_ref_span_end(kernel_ref) != AST_SPAN_UNKNOWN) +
            "}";
        let summary = "{" +
            json_field_i64("source_bytes", len(source)) + comma +
            json_field_i64("source_lines", source_line_count(source)) + comma +
            json_field_i64("item_count", ast_node_list_ref_count(items_ref)) + comma +
            json_field_i64("function_count", ast_report_count_kind_ref(items_ref, NODE_FN)) + comma +
            json_field_i64("struct_count", ast_report_count_kind_ref(items_ref, NODE_STRUCT)) + comma +
            json_field_i64("enum_count", ast_report_count_kind_ref(items_ref, NODE_ENUM)) + comma +
            json_field_i64("const_count", ast_report_count_kind_ref(items_ref, NODE_CONST)) +
            "}";
        let full_walk: bool = ast_report_full_walk(kernel_ref);
        let items_json: str = "[]";
        let tree_json: str = root;
        if full_walk {
            items_json = ast_report_items_json_ref(names, items_ref);
            tree_json = ast_report_node_ref_json(names, ast_node_ref_from_node(kernel));
        }
        return "{" +
            json_field_str("schema_version", "bunker.self_host.ast.v1") + comma +
            json_field_str("representation", "bootstrap_vec_i64") + comma +
            json_field_bool("source_byte_spans", true) + comma +
            json_field_bool("complete_tree", full_walk) + comma +
            json_field_bool("truncated", !full_walk) + comma +
            json_field_raw("root", root) + comma +
            json_field_raw("summary", summary) + comma +
            json_field_raw("items", items_json) + comma +
            json_field_raw("tree", tree_json) +
            "}";
    }

    fn build_ast_report_comment(source: str, kernel: Vec<i64>) -> str {
        return "/* BUNKER_AST_JSON: " + self_host_ast_json(source, kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }
