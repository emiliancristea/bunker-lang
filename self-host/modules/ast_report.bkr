    // ========================================
    // SELF-HOST AST REPORT
    // ========================================
    //
    // Produces BUNKER_AST_JSON from the bootstrap raw Vec<i64> AST layout.

    fn source_line_count(source: str) -> i64 {
        let count: i64 = 1;
        let i: i64 = 0;
        while i < len(source) {
            if char_code_at(source, i) == 10 {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    fn ast_report_item_name_idx(item: Vec<i64>) -> i64 {
        if ast_is_fn_item(item) {
            return ast_fn_name_idx(item);
        }
        if ast_is_const_item(item) {
            return ast_const_name_idx(item);
        }
        if ast_is_struct_item(item) {
            return ast_struct_name_idx(item);
        }
        return -1;
    }

    fn ast_report_item_param_count(item: Vec<i64>) -> i64 {
        if ast_is_fn_item(item) {
            return ast_fn_param_count(item);
        }
        return 0;
    }

    fn ast_report_item_field_count(item: Vec<i64>) -> i64 {
        if ast_is_struct_item(item) {
            return ast_struct_field_count(item);
        }
        return 0;
    }

    fn ast_report_item_stmt_count(item: Vec<i64>) -> i64 {
        if ast_is_fn_item(item) {
            return ast_block_stmt_count(ast_fn_body(item));
        }
        return 0;
    }

    fn ast_report_item_json(names: Vec<str>, item: Vec<i64>) -> str {
        let comma = ",";
        return "{" +
            json_field_str("kind", ast_node_kind_name(ast_kind(item))) + comma +
            json_field_str("category", ast_category_name(ast_node_category(item))) + comma +
            json_field_str("name", ast_report_name(names, ast_report_item_name_idx(item))) + comma +
            json_field_i64("source_start", ast_node_span_start(item)) + comma +
            json_field_i64("source_end", ast_node_span_end(item)) + comma +
            json_field_bool("span_known", ast_node_has_span(item)) + comma +
            json_field_i64("param_count", ast_report_item_param_count(item)) + comma +
            json_field_i64("field_count", ast_report_item_field_count(item)) + comma +
            json_field_i64("statement_count", ast_report_item_stmt_count(item)) +
            "}";
    }

    fn ast_report_count_kind(items: Vec<i64>, kind: i64) -> i64 {
        let count: i64 = 0;
        let i: i64 = 0;
        while i < ast_node_list_count(items) {
            let item = ast_node_list_get(items, i);
            if ast_kind(item) == kind {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    }

    fn ast_report_items_json(kernel: Vec<i64>) -> str {
        let names = ast_kernel_names(kernel);
        let result = "[";
        let i: i64 = 0;
        while i < ast_kernel_item_count(kernel) {
            if i > 0 {
                result = result + ",";
            }
            result = result + ast_report_item_json(names, ast_kernel_item(kernel, i));
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_node_array_json(names: Vec<str>, nodes: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_node_list_count(nodes) {
            if i > 0 {
                result = result + ",";
            }
            result = result + ast_report_node_json(names, ast_node_list_get(nodes, i));
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_optional_node_json(names: Vec<str>, node_value: i64) -> str {
        if node_value == 0 {
            return "null";
        }
        return ast_report_node_json(names, node_value as Vec<i64>);
    }

    fn ast_report_block_statements_json(names: Vec<str>, block: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_block_stmt_count(block) {
            if i > 0 {
                result = result + ",";
            }
            result = result + ast_report_node_json(names, ast_block_stmt(block, i));
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_pattern_json(names: Vec<str>, pattern: Vec<i64>) -> str {
        let comma = ",";
        let kind = ast_pattern_kind(pattern);
        let result = "{" +
            json_field_str("kind", ast_pattern_kind_name(kind)) + comma +
            json_field_i64("source_start", ast_pattern_span_start(pattern)) + comma +
            json_field_i64("source_end", ast_pattern_span_end(pattern)) + comma +
            json_field_bool("span_known", ast_pattern_span_start(pattern) != AST_SPAN_UNKNOWN && ast_pattern_span_end(pattern) != AST_SPAN_UNKNOWN);

        if kind == PAT_INT {
            result = result + comma + json_field_i64("value", ast_pattern_value(pattern));
        } else if kind == PAT_BOOL {
            result = result + comma + json_field_bool("value", ast_pattern_value(pattern) == 1);
        } else if kind == PAT_BIND || kind == PAT_SOME {
            result = result + comma + json_field_str("binding", ast_report_name(names, ast_pattern_value(pattern)));
        }

        return result + "}";
    }

    fn ast_report_match_arms_json(names: Vec<str>, patterns: Vec<i64>, bodies: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_node_list_count(patterns) {
            if i > 0 {
                result = result + ",";
            }
            result = result + "{" +
                json_field_raw("pattern", ast_report_pattern_json(names, ast_node_list_get(patterns, i))) + "," +
                json_field_raw("body", ast_report_node_json(names, ast_node_list_get(bodies, i))) +
                "}";
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_struct_lit_fields_json(names: Vec<str>, node: Vec<i64>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < ast_struct_lit_field_count(node) {
            if i > 0 {
                result = result + ",";
            }
            result = result + "{" +
                json_field_str("name", ast_report_name(names, ast_struct_lit_field_name_idx(node, i))) + "," +
                json_field_raw("value", ast_report_node_json(names, ast_struct_lit_field_value(node, i))) +
                "}";
            i = i + 1;
        }
        return result + "]";
    }

    fn ast_report_node_json(names: Vec<str>, node: Vec<i64>) -> str {
        let comma = ",";
        let kind = ast_kind(node);
        let result = "{" +
            json_field_str("kind", ast_node_kind_name(kind)) + comma +
            json_field_str("category", ast_category_name(ast_node_category(node))) + comma +
            json_field_i64("source_start", ast_node_span_start(node)) + comma +
            json_field_i64("source_end", ast_node_span_end(node)) + comma +
            json_field_bool("span_known", ast_node_has_span(node));

        if kind == NODE_KERNEL {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_name_idx(node))) + comma +
                json_field_str("entry", ast_report_name(names, ast_kernel_entry_idx(node))) + comma +
                json_field_raw("items", ast_report_node_array_json(names, ast_kernel_items(node)));
        } else if kind == NODE_FN {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_fn_name_idx(node))) + comma +
                json_field_raw("params", ast_report_node_array_json(names, ast_fn_params(node))) + comma +
                json_field_raw("return_type", ast_report_optional_node_json(names, ast_fn_return_type(node))) + comma +
                json_field_raw("body", ast_report_node_json(names, ast_fn_body(node)));
        } else if kind == NODE_PARAM {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_param_name_idx(node))) + comma +
                json_field_raw("type", ast_report_node_json(names, ast_param_type_node(node)));
        } else if kind == NODE_TYPE {
            let type_kind = ast_type_kind_value(node as i64);
            result = result + comma +
                json_field_str("type_kind", ast_type_kind_name(type_kind)) + comma +
                json_field_i64("type_tag", type_kind);
            if type_kind == TYPE_STRUCT {
                result = result + comma + json_field_str("struct_name", ast_report_name(names, ast_type_struct_name_idx_value(node as i64)));
            } else if type_kind == TYPE_ARRAY {
                result = result + comma +
                    json_field_str("element_type_kind", ast_type_kind_name(ast_type_array_elem_kind_value(node as i64))) + comma +
                    json_field_i64("array_len", ast_type_array_len_value(node as i64));
            }
        } else if kind == NODE_BLOCK {
            result = result + comma + json_field_raw("statements", ast_report_block_statements_json(names, node));
        } else if kind == NODE_LET {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_let_name_idx(node))) + comma +
                json_field_raw("declared_type", ast_report_optional_node_json(names, ast_let_type_node(node))) + comma +
                json_field_raw("init", ast_report_optional_node_json(names, ast_let_init(node)));
        } else if kind == NODE_RETURN {
            result = result + comma + json_field_raw("expr", ast_report_optional_node_json(names, ast_return_expr(node)));
        } else if kind == NODE_IF {
            result = result + comma +
                json_field_raw("condition", ast_report_node_json(names, ast_if_cond(node))) + comma +
                json_field_raw("then", ast_report_node_json(names, ast_if_then(node))) + comma +
                json_field_raw("else", ast_report_optional_node_json(names, ast_if_else(node)));
        } else if kind == NODE_WHILE {
            result = result + comma +
                json_field_raw("condition", ast_report_node_json(names, ast_while_cond(node))) + comma +
                json_field_raw("body", ast_report_node_json(names, ast_while_body(node)));
        } else if kind == NODE_EXPR_STMT {
            result = result + comma + json_field_raw("expr", ast_report_node_json(names, ast_expr_stmt_expr(node)));
        } else if kind == NODE_ASSIGN {
            result = result + comma +
                json_field_raw("target", ast_report_node_json(names, ast_assign_target(node))) + comma +
                json_field_raw("value", ast_report_node_json(names, ast_assign_value(node)));
        } else if kind == NODE_FOR {
            result = result + comma +
                json_field_str("binding", ast_report_name(names, ast_for_name_idx(node))) + comma +
                json_field_raw("start", ast_report_node_json(names, ast_for_start(node))) + comma +
                json_field_raw("end", ast_report_node_json(names, ast_for_end(node))) + comma +
                json_field_bool("inclusive", ast_for_inclusive(node) == 1) + comma +
                json_field_raw("body", ast_report_node_json(names, ast_for_body(node)));
        } else if kind == NODE_LOOP {
            result = result + comma + json_field_raw("body", ast_report_node_json(names, ast_loop_body(node)));
        } else if kind == NODE_BINARY {
            result = result + comma +
                json_field_str("op", token_name(ast_binary_op(node))) + comma +
                json_field_raw("left", ast_report_node_json(names, ast_binary_left(node))) + comma +
                json_field_raw("right", ast_report_node_json(names, ast_binary_right(node)));
        } else if kind == NODE_UNARY {
            result = result + comma +
                json_field_str("op", token_name(ast_unary_op(node))) + comma +
                json_field_raw("operand", ast_report_node_json(names, ast_unary_operand(node)));
        } else if kind == NODE_CALL {
            result = result + comma +
                json_field_str("callee", ast_report_name(names, ast_call_name_idx(node))) + comma +
                json_field_raw("args", ast_report_node_array_json(names, ast_call_args(node)));
        } else if kind == NODE_IDENT {
            result = result + comma + json_field_str("name", ast_report_name(names, ast_name_idx(node)));
        } else if kind == NODE_INT_LIT {
            result = result + comma + json_field_i64("value", ast_value(node));
        } else if kind == NODE_BOOL_LIT {
            result = result + comma + json_field_bool("value", ast_value(node) == 1);
        } else if kind == NODE_STR_LIT {
            result = result + comma + json_field_str("value", ast_value(node) as str);
        } else if kind == NODE_CONST {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_const_name_idx(node))) + comma +
                json_field_raw("type", ast_report_optional_node_json(names, ast_const_type_node(node))) + comma +
                json_field_raw("value", ast_report_optional_node_json(names, ast_const_value(node)));
        } else if kind == NODE_TERNARY {
            result = result + comma +
                json_field_raw("condition", ast_report_node_json(names, ast_ternary_cond(node))) + comma +
                json_field_raw("then", ast_report_node_json(names, ast_ternary_then(node))) + comma +
                json_field_raw("else", ast_report_node_json(names, ast_ternary_else(node)));
        } else if kind == NODE_FLOAT_LIT {
            result = result + comma + json_field_str("value", ast_value(node) as str);
        } else if kind == NODE_ARRAY_LIT {
            result = result + comma + json_field_raw("elements", ast_report_node_array_json(names, ast_array_elements(node)));
        } else if kind == NODE_INDEX {
            result = result + comma +
                json_field_raw("base", ast_report_node_json(names, ast_index_base(node))) + comma +
                json_field_raw("index", ast_report_node_json(names, ast_index_expr(node)));
        } else if kind == NODE_STRUCT {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_struct_name_idx(node))) + comma +
                json_field_raw("fields", ast_report_node_array_json(names, ast_struct_fields(node)));
        } else if kind == NODE_FIELD {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_field_decl_name_idx(node))) + comma +
                json_field_raw("type", ast_report_optional_node_json(names, ast_field_decl_type_node(node)));
        } else if kind == NODE_FIELD_ACCESS {
            result = result + comma +
                json_field_raw("base", ast_report_node_json(names, ast_field_base(node))) + comma +
                json_field_str("field", ast_report_name(names, ast_field_name_idx(node)));
        } else if kind == NODE_STRUCT_LIT {
            result = result + comma +
                json_field_str("name", ast_report_name(names, ast_struct_lit_name_idx(node))) + comma +
                json_field_raw("fields", ast_report_struct_lit_fields_json(names, node));
        } else if kind == NODE_MATCH {
            result = result + comma +
                json_field_raw("scrutinee", ast_report_node_json(names, ast_match_scrutinee(node))) + comma +
                json_field_raw("arms", ast_report_match_arms_json(names, ast_match_patterns(node), ast_match_bodies(node)));
        }

        return result + "}";
    }

    fn self_host_ast_json(source: str, kernel: Vec<i64>) -> str {
        let comma = ",";
        let names = ast_kernel_names(kernel);
        let items = ast_kernel_items(kernel);
        let root = "{" +
            json_field_str("kind", ast_node_kind_name(ast_kind(kernel))) + comma +
            json_field_str("name", ast_report_name(names, ast_name_idx(kernel))) + comma +
            json_field_str("entry", ast_report_name(names, ast_kernel_entry_idx(kernel))) + comma +
            json_field_i64("source_start", ast_node_span_start(kernel)) + comma +
            json_field_i64("source_end", ast_node_span_end(kernel)) + comma +
            json_field_bool("span_known", ast_node_has_span(kernel)) +
            "}";
        let summary = "{" +
            json_field_i64("source_bytes", len(source)) + comma +
            json_field_i64("source_lines", source_line_count(source)) + comma +
            json_field_i64("item_count", ast_kernel_item_count(kernel)) + comma +
            json_field_i64("function_count", ast_report_count_kind(items, NODE_FN)) + comma +
            json_field_i64("struct_count", ast_report_count_kind(items, NODE_STRUCT)) + comma +
            json_field_i64("const_count", ast_report_count_kind(items, NODE_CONST)) +
            "}";
        return "{" +
            json_field_str("schema_version", "bunker.self_host.ast.v1") + comma +
            json_field_str("representation", "bootstrap_vec_i64") + comma +
            json_field_bool("source_byte_spans", true) + comma +
            json_field_bool("complete_tree", true) + comma +
            json_field_raw("root", root) + comma +
            json_field_raw("summary", summary) + comma +
            json_field_raw("items", ast_report_items_json(kernel)) + comma +
            json_field_raw("tree", ast_report_node_json(names, kernel)) +
            "}";
    }

    fn build_ast_report_comment(source: str, kernel: Vec<i64>) -> str {
        return "/* BUNKER_AST_JSON: " + self_host_ast_json(source, kernel) + from_char_code(10) +
            "*/" + from_char_code(10);
    }
