    // ========================================
    // PARSER
    // ========================================

    fn token_name(tok: TokenKind) -> str {
        return token_kind_name(tok);
    }

    fn is_name_token(tok: TokenKind) -> bool {
        return token_is_name_kind(tok);
    }

    fn parser_token_end_for_pos(p: Vec<i64>, pos: i64) -> i64 {
        return parser_token_end_for_pos_ref(parser_state_ref_from_state(p), pos);
    }

    fn parser_token_end_for_pos_ref(p: ParserStateRef, pos: i64) -> i64 {
        let tokens = parser_tokens_ref(p);
        let idx = pos * 3;
        if pos < 0 || idx + 2 >= vec_len(tokens) {
            return 0;
        }
        return vec_get(tokens, idx + 2);
    }

    fn parser_token_start_for_pos(p: Vec<i64>, pos: i64) -> i64 {
        return parser_token_start_for_pos_ref(parser_state_ref_from_state(p), pos);
    }

    fn parser_token_start_for_pos_ref(p: ParserStateRef, pos: i64) -> i64 {
        let tokens = parser_tokens_ref(p);
        let idx = pos * 3;
        if pos < 0 || idx + 2 >= vec_len(tokens) {
            return 0;
        }

        let tok = vec_get(tokens, idx);
        let value = vec_get(tokens, idx + 1);
        let end = vec_get(tokens, idx + 2);

        if tok == TOK_EOF {
            return end;
        }
        if tok == TOK_IDENT {
            return end - len(parser_get_name_ref(p, value));
        }
        if tok == TOK_INT {
            return end - len(int_to_string(parser_get_value_ref(p, value)));
        }
        if tok == TOK_STR {
            return end - len(parser_get_string_ref(p, value)) - 2;
        }
        if tok == TOK_FLOAT {
            return end - len(parser_get_string_ref(p, value));
        }
        if is_name_token(tok) {
            return end - len(token_name(tok));
        }

        return value;
    }

    fn parser_current_token_start(p: ParserStateRef) -> i64 {
        return parser_token_start_for_pos_ref(p, parser_position_ref(p));
    }

    fn parser_previous_token_end(p: ParserStateRef) -> i64 {
        let pos = parser_position_ref(p) - 1;
        if pos < 0 {
            return parser_current_token_start(p);
        }
        return parser_token_end_for_pos_ref(p, pos);
    }

    fn parser_end_for_span(p: ParserStateRef, start: i64) -> i64 {
        let end = parser_previous_token_end(p);
        if end < start {
            return parser_token_end_for_pos_ref(p, parser_position_ref(p));
        }
        return end;
    }

    fn parser_span_from_start(p: ParserStateRef, start: i64) -> AstSpan {
        return ast_span(start, parser_end_for_span(p, start));
    }

    fn parser_set_node_ref_span_from_start(p: ParserStateRef, node_ref: AstNodeRef, start: i64) -> AstNodeRef {
        return ast_node_ref_set_span(node_ref, start, parser_end_for_span(p, start));
    }

    fn parser_set_node_ref_span(node_ref: AstNodeRef, start: i64, end: i64) -> AstNodeRef {
        return ast_node_ref_set_span(node_ref, start, end);
    }

    fn parser_set_type_ref_span_from_start(p: ParserStateRef, type_ref: AstTypeRef, start: i64) -> AstTypeRef {
        parser_set_node_ref_span_from_start(p, ast_node_ref_from_type_ref(type_ref), start);
        return type_ref;
    }

    fn parser_set_expr_ref_span_from_start(p: ParserStateRef, expr_ref: AstExprRef, start: i64) -> AstExprRef {
        parser_set_node_ref_span_from_start(p, ast_node_ref_from_expr_ref(expr_ref), start);
        return expr_ref;
    }

    fn parser_set_expr_ref_span(expr_ref: AstExprRef, start: i64, end: i64) -> AstExprRef {
        parser_set_node_ref_span(ast_node_ref_from_expr_ref(expr_ref), start, end);
        return expr_ref;
    }

    fn parser_set_stmt_ref_span_from_start(p: ParserStateRef, stmt_ref: AstStmtRef, start: i64) -> AstStmtRef {
        parser_set_node_ref_span_from_start(p, ast_node_ref_from_stmt_ref(stmt_ref), start);
        return stmt_ref;
    }

    fn parser_set_stmt_ref_span(stmt_ref: AstStmtRef, start: i64, end: i64) -> AstStmtRef {
        parser_set_node_ref_span(ast_node_ref_from_stmt_ref(stmt_ref), start, end);
        return stmt_ref;
    }

    fn parser_set_item_ref_span_from_start(p: ParserStateRef, item_ref: AstItemRef, start: i64) -> AstItemRef {
        parser_set_node_ref_span_from_start(p, ast_node_ref_from_item_ref(item_ref), start);
        return item_ref;
    }

    fn parser_set_block_ref_span_from_start(p: ParserStateRef, block_ref: AstBlockRef, start: i64) -> AstBlockRef {
        parser_set_node_ref_span_from_start(p, ast_node_ref_from_block_ref(block_ref), start);
        return block_ref;
    }

    fn parser_set_node_span_from_start(p: ParserStateRef, node: Vec<i64>, start: i64) -> Vec<i64> {
        return parser_node_ref_to_compat_node(parser_set_node_ref_span_from_start(p, ast_node_ref_from_node(node), start));
    }

    fn parser_set_pattern_ref_span_from_start(p: ParserStateRef, pattern_ref: AstPatternRef, start: i64) -> AstPatternRef {
        return ast_pattern_ref_set_span(pattern_ref, start, parser_end_for_span(p, start));
    }

    fn parser_set_pattern_span_from_start(p: ParserStateRef, pattern: Vec<i64>, start: i64) -> Vec<i64> {
        return parser_pattern_ref_to_compat_pattern(parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_from_pattern(pattern), start));
    }

    fn parser_node_ref_to_compat_node(node_ref: AstNodeRef) -> Vec<i64> {
        return ast_node_from_ref(node_ref);
    }

    fn parser_type_ref_to_compat_node(type_ref: AstTypeRef) -> Vec<i64> {
        return ast_type_node_from_ref(type_ref);
    }

    fn parser_expr_ref_to_compat_node(expr_ref: AstExprRef) -> Vec<i64> {
        return ast_expr_node_from_ref(expr_ref);
    }

    fn parser_stmt_ref_to_compat_node(stmt_ref: AstStmtRef) -> Vec<i64> {
        return ast_stmt_node_from_ref(stmt_ref);
    }

    fn parser_item_ref_to_compat_node(item_ref: AstItemRef) -> Vec<i64> {
        return ast_item_node_from_ref(item_ref);
    }

    fn parser_block_ref_to_compat_node(block_ref: AstBlockRef) -> Vec<i64> {
        return ast_block_node_from_ref(block_ref);
    }

    fn parser_pattern_ref_to_compat_pattern(pattern_ref: AstPatternRef) -> Vec<i64> {
        return ast_pattern_from_ref(pattern_ref);
    }

    fn parser_node_list_ref_to_compat_list(nodes_ref: AstNodeListRef) -> Vec<i64> {
        return ast_node_list_from_ref(nodes_ref);
    }

    fn parser_error_span(p: Vec<i64>) -> AstSpan {
        return parser_error_span_ref(parser_state_ref_from_state(p));
    }

    fn parser_error_span_ref(p: ParserStateRef) -> AstSpan {
        let pos = parser_error_position_ref(p);
        return ast_span(parser_token_start_for_pos_ref(p, pos), parser_token_end_for_pos_ref(p, pos));
    }

    fn parser_error_token_end(p: Vec<i64>) -> i64 {
        return parser_error_token_end_ref(parser_state_ref_from_state(p));
    }

    fn parser_error_token_end_ref(p: ParserStateRef) -> i64 {
        return ast_span_end(parser_error_span_ref(p));
    }

    fn parser_error_token_start(p: Vec<i64>) -> i64 {
        return parser_error_token_start_ref(parser_state_ref_from_state(p));
    }

    fn parser_error_token_start_ref(p: ParserStateRef) -> i64 {
        return ast_span_start(parser_error_span_ref(p));
    }

    fn parser_expect_name(p: ParserStateRef) -> i64 {
        let value = parser_peek_value_ref(p);
        if is_name_token(parser_peek_ref(p)) {
            parser_advance_ref(p);
            return value;
        }
        parser_mark_error_ref(p, TOK_IDENT);
        return value;
    }

    fn parser_peek_ident_is(p: ParserStateRef, name: str) -> bool {
        if parser_peek_ref(p) != TOK_IDENT {
            return false;
        }
        return parser_get_name_ref(p, parser_peek_value_ref(p)) == name;
    }

    fn skip_type_tail(p: ParserStateRef) -> ParserStateRef {
        if parser_peek_ref(p) == TOK_LT {
            let depth: i64 = 0;
            while parser_peek_ref(p) != TOK_EOF {
                let tok = parser_peek_ref(p);
                if tok == TOK_LT {
                    depth = depth + 1;
                }
                if tok == TOK_GT {
                    depth = depth - 1;
                }
                parser_advance_ref(p);
                if depth <= 0 {
                    return p;
                }
            }
        }
        return p;
    }

    // Parse type
    fn parse_type(p: ParserStateRef) -> Vec<i64> {
        return parser_type_ref_to_compat_node(parse_type_ref(p));
    }

    fn parse_type_ref(p: ParserStateRef) -> AstTypeRef {
        let start = parser_current_token_start(p);
        let tok = parser_peek_ref(p);
        let kind: i64 = TYPE_I64;
        let consumed = false;
        if tok == TOK_LBRACKET {
            parser_advance_ref(p);
            let elem_type_ref: AstTypeRef = parse_type_ref(p);
            parser_expect_ref(p, TOK_SEMICOLON);
            let len_value: i64 = 0;
            if parser_peek_ref(p) == TOK_INT {
                len_value = parser_get_value_ref(p, parser_peek_value_ref(p));
                parser_advance_ref(p);
            } else {
                parser_mark_error_ref(p, TOK_INT);
            }
            parser_expect_ref(p, TOK_RBRACKET);
            return parser_set_type_ref_span_from_start(p, ast_type_array_ref(ast_type_ref_kind_value(elem_type_ref), len_value), start);
        }
        if tok == TOK_I32 { kind = TYPE_I32; parser_advance_ref(p); consumed = true; }
        if tok == TOK_I64 { kind = TYPE_I64; parser_advance_ref(p); consumed = true; }
        if tok == TOK_F64 { kind = TYPE_F64; parser_advance_ref(p); consumed = true; }
        if tok == TOK_BOOL { kind = TYPE_BOOL; parser_advance_ref(p); consumed = true; }
        if tok == TOK_STR_TYPE { kind = TYPE_STR; parser_advance_ref(p); consumed = true; }
        if tok == TOK_IDENT {
            let name_idx = parser_peek_value_ref(p);
            parser_advance_ref(p);
            if parser_peek_ref(p) == TOK_LT {
                // Bootstrap generics such as Vec<i64> are represented as handles.
                skip_type_tail(p);
                consumed = true;
            } else {
                return parser_set_type_ref_span_from_start(p, ast_type_struct_ref(name_idx), start);
            }
        }
        if !consumed && tok != TOK_EOF {
            parser_advance_ref(p);
        }
        return parser_set_type_ref_span_from_start(p, ast_type_ref(kind), start);
    }

    fn parse_match_pattern(p: ParserStateRef) -> Vec<i64> {
        return parser_pattern_ref_to_compat_pattern(parse_match_pattern_ref(p));
    }

    fn parse_match_pattern_ref(p: ParserStateRef) -> AstPatternRef {
        let start = parser_current_token_start(p);
        let tok = parser_peek_ref(p);

        if tok == TOK_INT {
            let val_idx = parser_peek_value_ref(p);
            let val = parser_get_value_ref(p, val_idx);
            parser_advance_ref(p);
            return parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_new(PAT_INT, val), start);
        }

        if tok == TOK_TRUE {
            parser_advance_ref(p);
            return parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_new(PAT_BOOL, 1), start);
        }

        if tok == TOK_FALSE {
            parser_advance_ref(p);
            return parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_new(PAT_BOOL, 0), start);
        }

        if is_name_token(tok) {
            let name_idx = parser_peek_value_ref(p);
            let raw_name = parser_get_name_ref(p, name_idx);
            parser_advance_ref(p);

            if parser_peek_ref(p) == TOK_DOT {
                parser_advance_ref(p);
                let variant_idx = parser_expect_name(p);
                let bind_idx: i64 = -1;
                if parser_peek_ref(p) == TOK_LPAREN {
                    parser_advance_ref(p);
                    bind_idx = parser_expect_name(p);
                    parser_expect_ref(p, TOK_RPAREN);
                }
                return parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_new3(PAT_ENUM_VARIANT, name_idx, variant_idx, bind_idx), start);
            }

            if raw_name == "_" {
                return parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_new(PAT_WILDCARD, 0), start);
            }

            if raw_name == "Some" && parser_peek_ref(p) == TOK_LPAREN {
                parser_advance_ref(p);
                let bind_idx = parser_expect_name(p);
                parser_expect_ref(p, TOK_RPAREN);
                return parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_new(PAT_SOME, bind_idx), start);
            }

            if raw_name == "None" {
                return parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_new(PAT_NONE, 0), start);
            }

            return parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_new(PAT_BIND, name_idx), start);
        }

        parser_mark_error_ref(p, TOK_IDENT);
        if tok != TOK_EOF {
            parser_advance_ref(p);
        }
        return parser_set_pattern_ref_span_from_start(p, ast_pattern_ref_new(PAT_WILDCARD, 0), start);
    }

    fn parse_match_expr(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_match_expr_ref(p));
    }

    fn parse_match_expr_ref(p: ParserStateRef) -> AstExprRef {
        let start = parser_current_token_start(p);
        parser_expect_ref(p, TOK_MATCH);
        let scrutinee_ref: AstExprRef = parse_expr_ref(p);
        parser_expect_ref(p, TOK_LBRACE);

        let patterns: Vec<i64> = vec_new();
        let bodies: Vec<i64> = vec_new();
        let patterns_ref: AstPatternListRef = ast_pattern_list_ref_from_list(patterns);
        let bodies_ref: AstNodeListRef = ast_node_list_ref_from_list(bodies);

        while parser_peek_ref(p) != TOK_RBRACE && parser_peek_ref(p) != TOK_EOF {
            let pattern_ref: AstPatternRef = parse_match_pattern_ref(p);
            parser_expect_ref(p, TOK_FAT_ARROW);

            if parser_peek_ref(p) == TOK_LBRACE {
                ast_node_list_append_block_ref(bodies_ref, parse_block_ref(p));
                if parser_peek_ref(p) == TOK_SEMICOLON || parser_peek_ref(p) == TOK_COMMA {
                    parser_advance_ref(p);
                }
            } else {
                ast_node_list_append_expr_ref(bodies_ref, parse_expr_ref(p));
                parser_expect_ref(p, TOK_SEMICOLON);
            }

            ast_pattern_list_append_pattern_ref(patterns_ref, pattern_ref);
        }

        parser_expect_ref(p, TOK_RBRACE);

        return parser_set_expr_ref_span_from_start(p, ast_match_ref(scrutinee_ref, patterns_ref, bodies_ref), start);
    }

    fn parse_atom(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_atom_ref(p));
    }

    fn parse_atom_ref(p: ParserStateRef) -> AstExprRef {
        let start = parser_current_token_start(p);
        let tok = parser_peek_ref(p);

        if tok == TOK_MATCH {
            return parse_match_expr_ref(p);
        }

        if tok == TOK_INT {
            let val_idx = parser_peek_value_ref(p);
            let val = parser_get_value_ref(p, val_idx);
            parser_advance_ref(p);
            return parser_set_expr_ref_span_from_start(p, ast_int_lit_ref(val), start);
        }

        if tok == TOK_FLOAT {
            let str_idx = parser_peek_value_ref(p);
            parser_advance_ref(p);
            return parser_set_expr_ref_span_from_start(p, ast_float_lit_ref(parser_get_string_ref(p, str_idx)), start);
        }

        if tok == TOK_TRUE {
            parser_advance_ref(p);
            return parser_set_expr_ref_span_from_start(p, ast_bool_lit_ref(1), start);
        }

        if tok == TOK_FALSE {
            parser_advance_ref(p);
            return parser_set_expr_ref_span_from_start(p, ast_bool_lit_ref(0), start);
        }

        if tok == TOK_STR {
            let str_idx = parser_peek_value_ref(p);
            parser_advance_ref(p);
            return parser_set_expr_ref_span_from_start(p, ast_str_lit_ref(parser_get_string_ref(p, str_idx)), start);
        }

        if tok == TOK_LPAREN {
            parser_advance_ref(p);
            let expr_ref: AstExprRef = parse_expr_ref(p);
            parser_expect_ref(p, TOK_RPAREN);
            return parser_set_expr_ref_span_from_start(p, expr_ref, start);
        }

        if tok == TOK_LBRACKET {
            parser_advance_ref(p);
            let elements: Vec<i64> = vec_new();
            let elements_ref: AstNodeListRef = ast_node_list_ref_from_list(elements);
            while parser_peek_ref(p) != TOK_RBRACKET && parser_peek_ref(p) != TOK_EOF {
                let elem_ref: AstExprRef = parse_expr_ref(p);
                ast_node_list_append_expr_ref(elements_ref, elem_ref);
                if parser_peek_ref(p) == TOK_COMMA {
                    parser_advance_ref(p);
                }
            }
            parser_expect_ref(p, TOK_RBRACKET);
            return parser_set_expr_ref_span_from_start(p, ast_array_lit_ref(elements_ref), start);
        }

        if is_name_token(tok) {
            let name_idx = parser_peek_value_ref(p);
            parser_advance_ref(p);

            let raw_name = parser_get_name_ref(p, name_idx);
            let is_type_name = len(raw_name) > 0 && char_code_at(raw_name, 0) >= 65 && char_code_at(raw_name, 0) <= 90;
            let after_lbrace = parser_peek_at_ref(p, 1);
            let after_field = parser_peek_at_ref(p, 2);
            let looks_like_struct_literal = parser_peek_ref(p) == TOK_LBRACE && is_type_name &&
                (after_lbrace == TOK_RBRACE || (is_name_token(after_lbrace) && after_field == TOK_COLON));
            if looks_like_struct_literal {
                parser_advance_ref(p);
                let field_names: Vec<i64> = vec_new();
                let field_values: Vec<i64> = vec_new();
                let field_names_ref: AstI64ListRef = ast_i64_list_ref_from_list(field_names);
                let field_values_ref: AstNodeListRef = ast_node_list_ref_from_list(field_values);
                while parser_peek_ref(p) != TOK_RBRACE && parser_peek_ref(p) != TOK_EOF {
                    let field_name = parser_expect_name(p);
                    parser_expect_ref(p, TOK_COLON);
                    let field_value_ref: AstExprRef = parse_expr_ref(p);
                    ast_i64_list_append_ref(field_names_ref, field_name);
                    ast_node_list_append_expr_ref(field_values_ref, field_value_ref);
                    if parser_peek_ref(p) == TOK_COMMA {
                        parser_advance_ref(p);
                    }
                }
                parser_expect_ref(p, TOK_RBRACE);
                return parser_set_expr_ref_span_from_start(p, ast_struct_lit_ref(name_idx, field_names_ref, field_values_ref), start);
            }

            // Check for function call with simple args
            if parser_peek_ref(p) == TOK_LPAREN {
                parser_advance_ref(p);
                let args: Vec<i64> = vec_new();
                let args_ref: AstNodeListRef = ast_node_list_ref_from_list(args);

                // Parse function call arguments as full expressions
                while parser_peek_ref(p) != TOK_RPAREN && parser_peek_ref(p) != TOK_EOF {
                    let arg_ref: AstExprRef = parse_expr_ref(p);
                    ast_node_list_append_expr_ref(args_ref, arg_ref);
                    if parser_peek_ref(p) == TOK_COMMA {
                        parser_advance_ref(p);
                    }
                }
                parser_expect_ref(p, TOK_RPAREN);

                return parser_set_expr_ref_span_from_start(p, ast_call_ref(name_idx, args_ref), start);
            }

            return parser_set_expr_ref_span_from_start(p, ast_ident_ref(name_idx), start);
        }

        if tok == TOK_NOT {
            parser_advance_ref(p);
            let operand_ref: AstExprRef = parse_atom_ref(p);
            return parser_set_expr_ref_span_from_start(p, ast_unary_ref(TOK_NOT, operand_ref), start);
        }

        if tok == TOK_MINUS {
            parser_advance_ref(p);
            let operand_ref: AstExprRef = parse_atom_ref(p);
            return parser_set_expr_ref_span_from_start(p, ast_unary_ref(TOK_MINUS, operand_ref), start);
        }

        // Default: consume the unexpected token so callers always make progress.
        if tok != TOK_EOF {
            parser_advance_ref(p);
        }
        return parser_set_expr_ref_span_from_start(p, ast_int_lit_ref(0), start);
    }

    fn parse_postfix(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_postfix_ref(p));
    }

    fn parse_postfix_ref(p: ParserStateRef) -> AstExprRef {
        let base_ref: AstExprRef = parse_atom_ref(p);
        while parser_peek_ref(p) == TOK_LBRACKET {
            let start = ast_expr_ref_span_start(base_ref);
            parser_advance_ref(p);
            let idx_ref: AstExprRef = parse_expr_ref(p);
            parser_expect_ref(p, TOK_RBRACKET);
            let index_ref: AstExprRef = ast_index_ref(base_ref, idx_ref);
            base_ref = parser_set_expr_ref_span(index_ref, start, parser_previous_token_end(p));
        }
        while parser_peek_ref(p) == TOK_DOT {
            let start = ast_expr_ref_span_start(base_ref);
            parser_advance_ref(p);
            let field_name = parser_expect_name(p);
            let field_ref: AstExprRef = ast_field_access_ref(base_ref, field_name);
            base_ref = parser_set_expr_ref_span(field_ref, start, parser_previous_token_end(p));
        }
        if parser_peek_ref(p) == TOK_LPAREN {
            let start = ast_expr_ref_span_start(base_ref);
            parser_advance_ref(p);
            if parser_peek_ref(p) != TOK_RPAREN {
                let payload_ref: AstExprRef = parse_expr_ref(p);
                parser_expect_ref(p, TOK_RPAREN);
                let eight_ref: AstExprRef = ast_int_lit_ref(8);
                let shift_ref: AstExprRef = ast_binary_ref(TOK_SHL, payload_ref, eight_ref);
                let pack_ref: AstExprRef = ast_binary_ref(TOK_BIT_OR, shift_ref, base_ref);
                base_ref = parser_set_expr_ref_span(pack_ref, start, parser_previous_token_end(p));
            } else {
                parser_advance_ref(p);
            }
        }
        return base_ref;
    }

    fn parse_mul(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_mul_ref(p));
    }

    fn parse_mul_ref(p: ParserStateRef) -> AstExprRef {
        let left_ref: AstExprRef = parse_postfix_ref(p);
        while parser_peek_ref(p) == TOK_STAR || parser_peek_ref(p) == TOK_SLASH || parser_peek_ref(p) == TOK_PERCENT {
            let op = parser_peek_ref(p);
            let start = ast_expr_ref_span_start(left_ref);
            parser_advance_ref(p);
            let right_ref: AstExprRef = parse_postfix_ref(p);
            let binary_ref: AstExprRef = ast_binary_ref(op, left_ref, right_ref);
            left_ref = parser_set_expr_ref_span(binary_ref, start, ast_expr_ref_span_end(right_ref));
        }
        return left_ref;
    }

    fn parse_add(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_add_ref(p));
    }

    fn parse_add_ref(p: ParserStateRef) -> AstExprRef {
        let left_ref: AstExprRef = parse_mul_ref(p);
        while parser_peek_ref(p) == TOK_PLUS || parser_peek_ref(p) == TOK_MINUS {
            let op = parser_peek_ref(p);
            let start = ast_expr_ref_span_start(left_ref);
            parser_advance_ref(p);
            let right_ref: AstExprRef = parse_mul_ref(p);
            let binary_ref: AstExprRef = ast_binary_ref(op, left_ref, right_ref);
            left_ref = parser_set_expr_ref_span(binary_ref, start, ast_expr_ref_span_end(right_ref));
        }
        return left_ref;
    }

    fn parse_shift(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_shift_ref(p));
    }

    fn parse_shift_ref(p: ParserStateRef) -> AstExprRef {
        let left_ref: AstExprRef = parse_add_ref(p);
        while parser_peek_ref(p) == TOK_SHL || parser_peek_ref(p) == TOK_SHR {
            let op = parser_peek_ref(p);
            let start = ast_expr_ref_span_start(left_ref);
            parser_advance_ref(p);
            let right_ref: AstExprRef = parse_add_ref(p);
            let binary_ref: AstExprRef = ast_binary_ref(op, left_ref, right_ref);
            left_ref = parser_set_expr_ref_span(binary_ref, start, ast_expr_ref_span_end(right_ref));
        }
        return left_ref;
    }

    fn parse_bit_and(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_bit_and_ref(p));
    }

    fn parse_bit_and_ref(p: ParserStateRef) -> AstExprRef {
        let left_ref: AstExprRef = parse_shift_ref(p);
        while parser_peek_ref(p) == TOK_BIT_AND {
            let start = ast_expr_ref_span_start(left_ref);
            parser_advance_ref(p);
            let right_ref: AstExprRef = parse_shift_ref(p);
            let binary_ref: AstExprRef = ast_binary_ref(TOK_BIT_AND, left_ref, right_ref);
            left_ref = parser_set_expr_ref_span(binary_ref, start, ast_expr_ref_span_end(right_ref));
        }
        return left_ref;
    }

    fn parse_bit_xor(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_bit_xor_ref(p));
    }

    fn parse_bit_xor_ref(p: ParserStateRef) -> AstExprRef {
        let left_ref: AstExprRef = parse_bit_and_ref(p);
        while parser_peek_ref(p) == TOK_BIT_XOR {
            let start = ast_expr_ref_span_start(left_ref);
            parser_advance_ref(p);
            let right_ref: AstExprRef = parse_bit_and_ref(p);
            let binary_ref: AstExprRef = ast_binary_ref(TOK_BIT_XOR, left_ref, right_ref);
            left_ref = parser_set_expr_ref_span(binary_ref, start, ast_expr_ref_span_end(right_ref));
        }
        return left_ref;
    }

    fn parse_bit_or(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_bit_or_ref(p));
    }

    fn parse_bit_or_ref(p: ParserStateRef) -> AstExprRef {
        let left_ref: AstExprRef = parse_bit_xor_ref(p);
        while parser_peek_ref(p) == TOK_BIT_OR {
            let start = ast_expr_ref_span_start(left_ref);
            parser_advance_ref(p);
            let right_ref: AstExprRef = parse_bit_xor_ref(p);
            let binary_ref: AstExprRef = ast_binary_ref(TOK_BIT_OR, left_ref, right_ref);
            left_ref = parser_set_expr_ref_span(binary_ref, start, ast_expr_ref_span_end(right_ref));
        }
        return left_ref;
    }

    fn parse_comparison(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_comparison_ref(p));
    }

    fn parse_comparison_ref(p: ParserStateRef) -> AstExprRef {
        let left_ref: AstExprRef = parse_bit_or_ref(p);
        let tok = parser_peek_ref(p);
        if tok == TOK_EQ || tok == TOK_NE || tok == TOK_LT || tok == TOK_GT || tok == TOK_LE || tok == TOK_GE {
            let start = ast_expr_ref_span_start(left_ref);
            parser_advance_ref(p);
            let right_ref: AstExprRef = parse_bit_or_ref(p);
            let binary_ref: AstExprRef = ast_binary_ref(tok, left_ref, right_ref);
            return parser_set_expr_ref_span(binary_ref, start, ast_expr_ref_span_end(right_ref));
        }
        return left_ref;
    }

    fn parse_and(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_and_ref(p));
    }

    fn parse_and_ref(p: ParserStateRef) -> AstExprRef {
        let left_ref: AstExprRef = parse_comparison_ref(p);
        while parser_peek_ref(p) == TOK_AND {
            let start = ast_expr_ref_span_start(left_ref);
            parser_advance_ref(p);
            let right_ref: AstExprRef = parse_comparison_ref(p);
            let binary_ref: AstExprRef = ast_binary_ref(TOK_AND, left_ref, right_ref);
            left_ref = parser_set_expr_ref_span(binary_ref, start, ast_expr_ref_span_end(right_ref));
        }
        return left_ref;
    }

    fn parse_or(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_or_ref(p));
    }

    fn parse_or_ref(p: ParserStateRef) -> AstExprRef {
        let left_ref: AstExprRef = parse_and_ref(p);
        while parser_peek_ref(p) == TOK_OR {
            let start = ast_expr_ref_span_start(left_ref);
            parser_advance_ref(p);
            let right_ref: AstExprRef = parse_and_ref(p);
            let binary_ref: AstExprRef = ast_binary_ref(TOK_OR, left_ref, right_ref);
            left_ref = parser_set_expr_ref_span(binary_ref, start, ast_expr_ref_span_end(right_ref));
        }
        return left_ref;
    }

    fn parse_ternary(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_ternary_ref(p));
    }

    fn parse_ternary_ref(p: ParserStateRef) -> AstExprRef {
        let cond_ref: AstExprRef = parse_or_ref(p);
        if parser_peek_ref(p) == TOK_QUESTION {
            parser_advance_ref(p);
            let then_expr_ref: AstExprRef = parse_expr_ref(p);
            parser_expect_ref(p, TOK_COLON);
            let else_expr_ref: AstExprRef = parse_expr_ref(p);
            let ternary_ref: AstExprRef = ast_ternary_ref(cond_ref, then_expr_ref, else_expr_ref);
            return parser_set_expr_ref_span(ternary_ref, ast_expr_ref_span_start(cond_ref), ast_expr_ref_span_end(else_expr_ref));
        }
        return cond_ref;
    }

    fn parse_expr(p: ParserStateRef) -> Vec<i64> {
        return parser_expr_ref_to_compat_node(parse_expr_ref(p));
    }

    fn parse_expr_ref(p: ParserStateRef) -> AstExprRef {
        let expr_ref: AstExprRef = parse_ternary_ref(p);
        while parser_peek_ident_is(p, "as") {
            parser_advance_ref(p);
            parse_type_ref(p);
        }
        return expr_ref;
    }

    fn parse_let_stmt(p: ParserStateRef) -> Vec<i64> {
        return parser_stmt_ref_to_compat_node(parse_let_stmt_ref(p));
    }

    fn parse_let_stmt_ref(p: ParserStateRef) -> AstStmtRef {
        let start = parser_current_token_start(p);
        parser_advance_ref(p);
        let name_idx = parser_expect_name(p);

        let type_node: i64 = ast_optional_none();
        if parser_peek_ref(p) == TOK_COLON {
            parser_advance_ref(p);
            type_node = ast_type_ref_to_optional_handle(parse_type_ref(p));
        }

        let init: i64 = ast_optional_none();
        if parser_peek_ref(p) == TOK_ASSIGN {
            parser_advance_ref(p);
            init = ast_expr_ref_to_optional_handle(parse_expr_ref(p));
        }
        parser_expect_ref(p, TOK_SEMICOLON);

        let let_ref: AstStmtRef = ast_let_ref(name_idx, type_node, init);
        return parser_set_stmt_ref_span_from_start(p, let_ref, start);
    }

    fn parse_return_stmt(p: ParserStateRef) -> Vec<i64> {
        return parser_stmt_ref_to_compat_node(parse_return_stmt_ref(p));
    }

    fn parse_return_stmt_ref(p: ParserStateRef) -> AstStmtRef {
        let start = parser_current_token_start(p);
        parser_advance_ref(p);
        let expr: i64 = ast_optional_none();
        if parser_peek_ref(p) != TOK_SEMICOLON {
            expr = ast_expr_ref_to_optional_handle(parse_expr_ref(p));
        }
        parser_expect_ref(p, TOK_SEMICOLON);
        let return_ref: AstStmtRef = ast_return_ref(expr);
        return parser_set_stmt_ref_span_from_start(p, return_ref, start);
    }

    // Simplified statement that doesn't recurse into blocks
    fn parse_simple_stmt(p: ParserStateRef) -> Vec<i64> {
        return parser_stmt_ref_to_compat_node(parse_simple_stmt_ref(p));
    }

    fn parse_simple_stmt_ref(p: ParserStateRef) -> AstStmtRef {
        let start = parser_current_token_start(p);
        let tok = parser_peek_ref(p);

        if tok == TOK_LET {
            return parse_let_stmt_ref(p);
        }

        if tok == TOK_RETURN {
            return parse_return_stmt_ref(p);
        }

        if tok == TOK_BREAK {
            parser_advance_ref(p);
            parser_expect_ref(p, TOK_SEMICOLON);
            let break_ref: AstStmtRef = ast_break_ref();
            return parser_set_stmt_ref_span_from_start(p, break_ref, start);
        }

        if tok == TOK_CONTINUE {
            parser_advance_ref(p);
            parser_expect_ref(p, TOK_SEMICOLON);
            let continue_ref: AstStmtRef = ast_continue_ref();
            return parser_set_stmt_ref_span_from_start(p, continue_ref, start);
        }

        // Expression statement or assignment
        let expr_ref: AstExprRef = parse_expr_ref(p);
        if parser_peek_ref(p) == TOK_ASSIGN {
            let assign_start = ast_expr_ref_span_start(expr_ref);
            parser_advance_ref(p);
            let value_ref: AstExprRef = parse_expr_ref(p);
            parser_expect_ref(p, TOK_SEMICOLON);
            let assign_ref: AstStmtRef = ast_assign_ref(expr_ref, value_ref);
            return parser_set_stmt_ref_span(assign_ref, assign_start, parser_previous_token_end(p));
        }

        if !parser_expect_ref(p, TOK_SEMICOLON) {
            // Recovery: consume tokens until the next statement boundary
            while parser_peek_ref(p) != TOK_SEMICOLON && parser_peek_ref(p) != TOK_RBRACE && parser_peek_ref(p) != TOK_EOF {
                parser_advance_ref(p);
            }
            if parser_peek_ref(p) == TOK_SEMICOLON {
                parser_advance_ref(p);
            }
        }

        let expr_stmt_ref: AstStmtRef = ast_expr_stmt_ref(expr_ref);
        return parser_set_stmt_ref_span(expr_stmt_ref, ast_expr_ref_span_start(expr_ref), parser_previous_token_end(p));
    }

    fn parse_if_stmt(p: ParserStateRef) -> Vec<i64> {
        return parser_stmt_ref_to_compat_node(parse_if_stmt_ref(p));
    }

    fn parse_if_stmt_ref(p: ParserStateRef) -> AstStmtRef {
        let start = parser_current_token_start(p);
        parser_expect_ref(p, TOK_IF);
        let cond_ref: AstExprRef = parse_expr_ref(p);
        let then_block_ref: AstBlockRef = parse_block_ref(p);
        let else_block: i64 = ast_optional_none();
        if parser_peek_ref(p) == TOK_ELSE {
            parser_advance_ref(p);
            if parser_peek_ref(p) == TOK_IF {
                let nested_if_ref: AstStmtRef = parse_if_stmt_ref(p);
                else_block = ast_block_ref_to_optional_handle(ast_block_with_ref(nested_if_ref));
            } else {
                else_block = ast_block_ref_to_optional_handle(parse_block_ref(p));
            }
        }
        let if_ref: AstStmtRef = ast_if_ref(cond_ref, then_block_ref, else_block);
        return parser_set_stmt_ref_span_from_start(p, if_ref, start);
    }

    fn parse_for_stmt(p: ParserStateRef) -> Vec<i64> {
        return parser_stmt_ref_to_compat_node(parse_for_stmt_ref(p));
    }

    fn parse_for_stmt_ref(p: ParserStateRef) -> AstStmtRef {
        let start = parser_current_token_start(p);
        parser_expect_ref(p, TOK_FOR);
        let name_idx = parser_expect_name(p);
        parser_expect_ref(p, TOK_IN);
        let start_expr_ref: AstExprRef = parse_expr_ref(p);

        let inclusive: i64 = 0;
        if parser_peek_ref(p) == TOK_DOT_DOT_EQ {
            inclusive = 1;
            parser_advance_ref(p);
        } else {
            parser_expect_ref(p, TOK_DOT_DOT);
        }

        let end_expr_ref: AstExprRef = parse_expr_ref(p);
        let body_ref: AstBlockRef = parse_block_ref(p);

        let for_ref: AstStmtRef = ast_for_ref(name_idx, start_expr_ref, end_expr_ref, inclusive, body_ref);
        return parser_set_stmt_ref_span_from_start(p, for_ref, start);
    }

    // Parse a block (handles if/while inside)
    fn parse_block(p: ParserStateRef) -> Vec<i64> {
        return parser_block_ref_to_compat_node(parse_block_ref(p));
    }

    fn parse_block_ref(p: ParserStateRef) -> AstBlockRef {
        let start = parser_current_token_start(p);
        let block_ref: AstBlockRef = ast_block_ref();
        parser_expect_ref(p, TOK_LBRACE);

        while parser_peek_ref(p) != TOK_RBRACE && parser_peek_ref(p) != TOK_EOF {
            let tok = parser_peek_ref(p);

            if tok == TOK_IF {
                ast_block_append_ref(block_ref, parse_if_stmt_ref(p));
            } else if tok == TOK_FOR {
                ast_block_append_ref(block_ref, parse_for_stmt_ref(p));
            } else if tok == TOK_WHILE {
                let stmt_start = parser_current_token_start(p);
                parser_advance_ref(p);
                let cond_ref: AstExprRef = parse_expr_ref(p);
                let body_ref: AstBlockRef = parse_block_ref(p);
                let while_ref: AstStmtRef = ast_while_ref(cond_ref, body_ref);
                ast_block_append_ref(block_ref, parser_set_stmt_ref_span(while_ref, stmt_start, parser_previous_token_end(p)));
            } else if tok == TOK_LOOP {
                let stmt_start = parser_current_token_start(p);
                parser_advance_ref(p);
                let body_ref: AstBlockRef = parse_block_ref(p);
                let loop_ref: AstStmtRef = ast_loop_ref(body_ref);
                ast_block_append_ref(block_ref, parser_set_stmt_ref_span(loop_ref, stmt_start, parser_previous_token_end(p)));
            } else {
                ast_block_append_ref(block_ref, parse_simple_stmt_ref(p));
            }
        }
        parser_expect_ref(p, TOK_RBRACE);
        return parser_set_block_ref_span_from_start(p, block_ref, start);
    }

    fn parse_params(p: ParserStateRef) -> Vec<i64> {
        return parser_node_list_ref_to_compat_list(parse_params_ref(p));
    }

    fn parse_params_ref(p: ParserStateRef) -> AstNodeListRef {
        let params: Vec<i64> = vec_new();
        let params_ref: AstNodeListRef = ast_node_list_ref_from_list(params);
        parser_expect_ref(p, TOK_LPAREN);
        if parser_peek_ref(p) != TOK_RPAREN {
            // First param
            let param_start = parser_current_token_start(p);
            let name_idx = parser_expect_name(p);
            parser_expect_ref(p, TOK_COLON);
            let ptype_ref: AstTypeRef = parse_type_ref(p);

            let param_ref: AstNodeRef = parser_set_node_ref_span(ast_param_ref(name_idx, ptype_ref), param_start, parser_previous_token_end(p));
            ast_node_list_append_node_ref(params_ref, param_ref);

            while parser_peek_ref(p) == TOK_COMMA {
                parser_advance_ref(p);
                let param2_start = parser_current_token_start(p);
                let name_idx2 = parser_expect_name(p);
                parser_expect_ref(p, TOK_COLON);
                let ptype2_ref: AstTypeRef = parse_type_ref(p);

                let param2_ref: AstNodeRef = parser_set_node_ref_span(ast_param_ref(name_idx2, ptype2_ref), param2_start, parser_previous_token_end(p));
                ast_node_list_append_node_ref(params_ref, param2_ref);
            }
        }
        parser_expect_ref(p, TOK_RPAREN);
        return params_ref;
    }

    fn parse_fn(p: ParserStateRef) -> Vec<i64> {
        return parser_item_ref_to_compat_node(parse_fn_ref(p));
    }

    fn parse_fn_ref(p: ParserStateRef) -> AstItemRef {
        let start = parser_current_token_start(p);
        parser_expect_ref(p, TOK_FN);
        let name_idx = parser_expect_name(p);
        let params_ref: AstNodeListRef = parse_params_ref(p);

        let ret_type: i64 = ast_optional_none();
        if parser_peek_ref(p) == TOK_ARROW {
            parser_advance_ref(p);
            ret_type = ast_type_ref_to_optional_handle(parse_type_ref(p));
        }

        let body_ref: AstBlockRef = parse_block_ref(p);

        let fn_ref: AstItemRef = ast_fn_ref(name_idx, params_ref, ret_type, body_ref);
        return parser_set_item_ref_span_from_start(p, fn_ref, start);
    }

    fn parse_const(p: ParserStateRef) -> Vec<i64> {
        return parser_item_ref_to_compat_node(parse_const_ref(p));
    }

    fn parse_const_ref(p: ParserStateRef) -> AstItemRef {
        let start = parser_current_token_start(p);
        parser_expect_ref(p, TOK_CONST);
        let name_idx = parser_expect_name(p);

        let type_node: i64 = ast_optional_none();
        if parser_peek_ref(p) == TOK_COLON {
            parser_advance_ref(p);
            type_node = ast_type_ref_to_optional_handle(parse_type_ref(p));
        }

        let value: i64 = ast_optional_none();
        if parser_peek_ref(p) == TOK_ASSIGN {
            parser_advance_ref(p);
            value = ast_expr_ref_to_optional_handle(parse_expr_ref(p));
        }

        parser_expect_ref(p, TOK_SEMICOLON);

        let const_ref: AstItemRef = ast_const_ref(name_idx, type_node, value);
        return parser_set_item_ref_span_from_start(p, const_ref, start);
    }

    fn parse_enum(p: ParserStateRef) -> Vec<i64> {
        return parser_item_ref_to_compat_node(parse_enum_ref(p));
    }

    fn parse_enum_ref(p: ParserStateRef) -> AstItemRef {
        let start = parser_current_token_start(p);
        parser_expect_ref(p, TOK_ENUM);
        let name_idx = parser_expect_name(p);
        parser_expect_ref(p, TOK_LBRACE);

        let variants: Vec<i64> = vec_new();
        let variants_ref: AstI64ListRef = ast_i64_list_ref_from_list(variants);
        let payloads: Vec<i64> = vec_new();
        let payloads_ref: AstI64ListRef = ast_i64_list_ref_from_list(payloads);
        while parser_peek_ref(p) != TOK_RBRACE && parser_peek_ref(p) != TOK_EOF {
            ast_i64_list_append_ref(variants_ref, parser_expect_name(p));
            let payload: i64 = ast_optional_none();
            if parser_peek_ref(p) == TOK_LPAREN {
                parser_advance_ref(p);
                payload = ast_type_ref_to_optional_handle(parse_type_ref(p));
                parser_expect_ref(p, TOK_RPAREN);
            }
            ast_i64_list_append_ref(payloads_ref, payload);
            if parser_peek_ref(p) == TOK_COMMA {
                parser_advance_ref(p);
            }
        }

        parser_expect_ref(p, TOK_RBRACE);
        return parser_set_item_ref_span_from_start(p, ast_enum_ref(name_idx, variants_ref, payloads_ref), start);
    }

    fn parse_struct(p: ParserStateRef) -> Vec<i64> {
        return parser_item_ref_to_compat_node(parse_struct_ref(p));
    }

    fn parse_struct_ref(p: ParserStateRef) -> AstItemRef {
        let start = parser_current_token_start(p);
        parser_expect_ref(p, TOK_STRUCT);
        let name_idx = parser_expect_name(p);
        parser_expect_ref(p, TOK_LBRACE);

        let fields: Vec<i64> = vec_new();
        let fields_ref: AstNodeListRef = ast_node_list_ref_from_list(fields);
        while parser_peek_ref(p) != TOK_RBRACE && parser_peek_ref(p) != TOK_EOF {
            let field_start = parser_current_token_start(p);
            let field_name = parser_expect_name(p);
            parser_expect_ref(p, TOK_COLON);
            let field_type_ref: AstTypeRef = parse_type_ref(p);

            let field_ref: AstNodeRef = parser_set_node_ref_span(ast_field_decl_ref(field_name, field_type_ref), field_start, parser_previous_token_end(p));
            ast_node_list_append_node_ref(fields_ref, field_ref);

            if parser_peek_ref(p) == TOK_COMMA {
                parser_advance_ref(p);
            }
        }

        parser_expect_ref(p, TOK_RBRACE);

        let struct_ref: AstItemRef = ast_struct_ref(name_idx, fields_ref);
        return parser_set_item_ref_span_from_start(p, struct_ref, start);
    }

    fn parse_kernel(p: Vec<i64>) -> Vec<i64> {
        return parse_kernel_ref(parser_state_ref_from_state(p));
    }

    fn parse_kernel_ref(p: ParserStateRef) -> Vec<i64> {
        let start = parser_current_token_start(p);
        parser_expect_ref(p, TOK_KERNEL);
        let name_idx = parser_expect_name(p);
        parser_expect_ref(p, TOK_LBRACE);

        let items: Vec<i64> = vec_new();
        let items_ref: AstNodeListRef = ast_node_list_ref_from_list(items);
        let main_name_idx: i64 = -1;
        while parser_peek_ref(p) != TOK_RBRACE && parser_peek_ref(p) != TOK_EOF {
            let tok = parser_peek_ref(p);
            if tok == TOK_FN {
                let fn_ref: AstItemRef = parse_fn_ref(p);
                let fn_name_idx = ast_fn_ref_name_idx(fn_ref);
                if parser_get_name_ref(p, fn_name_idx) == "main" {
                    main_name_idx = fn_name_idx;
                }
                ast_node_list_append_item_ref(items_ref, fn_ref);
            } else if tok == TOK_CONST {
                ast_node_list_append_item_ref(items_ref, parse_const_ref(p));
            } else if tok == TOK_STRUCT {
                ast_node_list_append_item_ref(items_ref, parse_struct_ref(p));
            } else if tok == TOK_ENUM {
                ast_node_list_append_item_ref(items_ref, parse_enum_ref(p));
            } else {
                parser_advance_ref(p);  // skip unknown
            }
        }
        parser_expect_ref(p, TOK_RBRACE);

        let names_ref: AstStringListRef = ast_string_list_ref_from_list(parser_names_ref(p));
        let kernel_ref: AstNodeRef = ast_kernel_ref(name_idx, items_ref, main_name_idx, names_ref);
        return parser_node_ref_to_compat_node(parser_set_node_ref_span_from_start(p, kernel_ref, start));
    }
