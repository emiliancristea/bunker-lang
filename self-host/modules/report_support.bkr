    // ========================================
    // REPORT SUPPORT HELPERS
    // ========================================
    //
    // Shared JSON/report helpers used by the driver-owned bootstrap reports.
    // Keeping these helpers outside driver.bkr makes resolver/typecheck report
    // extraction possible without duplicating diagnostic plumbing.

    fn ast_report_full_walk(kernel_ref: AstNodeRef) -> bool {
        return vec_len(ast_kernel_ref_names(kernel_ref)) <= AST_REPORT_FULL_WALK_NAME_LIMIT;
    }

    fn json_escape_string(raw: str) -> str {
        return json_val_str(raw);
    }

    fn diagnostic_text_edit_json(kind: str, source_start: i64, source_end: i64,
                                 replacement: str, applicability: str, confidence: str) -> str {
        let comma = ",";
        return "{" +
            json_field_str("kind", kind) + comma +
            json_field_i64("source_start", source_start) + comma +
            json_field_i64("source_end", source_end) + comma +
            json_field_str("replacement", replacement) + comma +
            json_field_str("applicability", applicability) + comma +
            json_field_str("confidence", confidence) +
            "}";
    }

    fn diagnostic_no_edits_json() -> str {
        return "[]";
    }

    fn diagnostic_single_edit_json(edit_json: str) -> str {
        return "[" + edit_json + "]";
    }

    fn ast_report_name(names: Vec<str>, idx: i64) -> str {
        if idx >= 0 && idx < vec_len(names) {
            return vec_get(names, idx);
        }
        return "";
    }

    fn resolver_state_new() -> Vec<str> {
        let state: Vec<str> = vec_new();
        return state;
    }

    fn resolver_state_json(state: Vec<str>) -> str {
        let result = "[";
        let i: i64 = 0;
        while i < vec_len(state) {
            if i > 0 {
                result = result + ",";
            }
            let diagnostic: str = vec_get(state, i);
            result = result + diagnostic;
            i = i + 1;
        }
        return result + "]";
    }

    fn resolver_state_count(state: Vec<str>) -> i64 {
        return vec_len(state);
    }

    fn resolver_state_append(state: Vec<str>, diagnostic: str) -> Vec<str> {
        vec_push(state, diagnostic);
        return state;
    }

    fn resolver_i64_vec_contains(values: Vec<i64>, value: i64) -> bool {
        let i: i64 = 0;
        while i < vec_len(values) {
            if vec_get(values, i) == value {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn resolver_empty_i64_vec() -> Vec<i64> {
        let values: Vec<i64> = vec_new();
        return values;
    }

    fn resolver_i64_vec_copy(values: Vec<i64>) -> Vec<i64> {
        let result: Vec<i64> = vec_new();
        let i: i64 = 0;
        while i < vec_len(values) {
            let copied_value: i64 = vec_get(values, i);
            vec_push(result, copied_value);
            i = i + 1;
        }
        return result;
    }

    fn resolver_i64_vec_with(values: Vec<i64>, value: i64) -> Vec<i64> {
        let result: Vec<i64> = resolver_i64_vec_copy(values);
        vec_push(result, value);
        return result;
    }
