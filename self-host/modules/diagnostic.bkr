    // ========================================
    // STRUCTURED DIAGNOSTICS BUILDER (A-001..A-008, R-012)
    // ========================================
    //
    // Provides pure Bunker compiler diagnostic structures conforming strictly
    // to the canonical bunker.diagnostics.v1 schema for AI-repair loops.
    // Supports stable diagnostic codes, dual-compiler parity, exact source
    // spans, expected/found details, suggested fix edits, calibrated confidence,
    // related spans, and prompt-ready explanations.

    struct DiagnosticTextEdit {
        kind: str,
        source_start: i64,
        source_end: i64,
        replacement: str,
        applicability: str,
        confidence: str
    }

    struct DiagnosticRelated {
        file: str,
        line: i64,
        column: i64,
        source_start: i64,
        source_end: i64,
        message: str
    }

    struct Diagnostic {
        error_code: str,
        rule_id: str,
        severity: str,
        phase: str,
        category: str,
        message: str,
        file: str,
        line: i64,
        column: i64,
        source_start: i64,
        source_end: i64,
        context: str,
        source_line: str,
        ai_prompt_hint: str,
        expected_type: str,
        found_type: str,
        has_suggestion: bool,
        suggestion_msg: str,
        suggestion_edit: DiagnosticTextEdit,
        has_related: bool,
        related: DiagnosticRelated
    }

    struct DiagnosticReport {
        schema_version: str,
        file: str,
        diagnostics: Vec<Diagnostic>,
        error_count: i64,
        warning_count: i64
    }

    fn diag_empty_edit() -> DiagnosticTextEdit {
        return DiagnosticTextEdit {
            kind: "",
            source_start: 0,
            source_end: 0,
            replacement: "",
            applicability: "",
            confidence: ""
        };
    }

    fn diag_empty_related() -> DiagnosticRelated {
        return DiagnosticRelated {
            file: "",
            line: 0,
            column: 0,
            source_start: 0,
            source_end: 0,
            message: ""
        };
    }

    // ========================================================================
    // Stable Diagnostic Code Registry Parity (A-002)
    // ========================================================================

    fn diag_code_to_rule_id(code: str) -> str {
        if code == "E0101" { return "BKR_SELF_PARSE"; }
        if code == "E0201" { return "BKR_SELF_TYPE_MISMATCH"; }
        if code == "E0202" { return "BKR_SELF_UNRESOLVED_SYMBOL"; }
        if code == "E0203" { return "BKR_SELF_UNRESOLVED_SYMBOL"; }
        if code == "E0204" { return "BKR_SELF_ARITY_MISMATCH"; }
        if code == "E0205" { return "BKR_SELF_TYPE_MISMATCH"; }
        if code == "E0206" { return "BKR_SELF_RETURN_PATH"; }
        if code == "E0207" { return "BKR_SELF_CONTROL_FLOW"; }
        if code == "E0208" { return "BKR_SELF_TYPE_MISMATCH"; }
        if code == "E0209" { return "BKR_SELF_STRUCT_LITERAL"; }
        if code == "E0210" { return "BKR_SELF_STRUCT_LITERAL"; }
        if code == "E0211" { return "BKR_SELF_AMBIGUOUS_TYPE"; }
        if code == "E0212" { return "BKR_SELF_MATCH_PATTERN"; }
        if code == "E0213" { return "BKR_SELF_VOID_VALUE"; }
        if code == "E0214" { return "BKR_SELF_UNREACHABLE_CODE"; }
        if code == "E0301" { return "BKR_SELF_CONTRACT"; }
        if code == "E0302" { return "BKR_SELF_CONTRACT"; }
        if code == "E0303" { return "BKR_SELF_SMT_TIMEOUT"; }
        if code == "E0304" { return "BKR_SELF_SMT_UNAVAILABLE"; }
        if code == "E0401" { return "BKR_SELF_USE_AFTER_MOVE"; }
        if code == "E0501" { return "BKR_SELF_ASSIGNMENT_TARGET"; }
        if code == "E0502" { return "BKR_SELF_CONST_ASSIGNMENT"; }
        if code == "E0601" { return "BKR_SELF_VIEW_BINDING"; }
        if code == "E0602" { return "BKR_SELF_VIEW_BINDING"; }
        if code == "E0701" { return "BKR_SELF_IMPORT"; }
        if code == "E0702" { return "BKR_SELF_IMPORT_CYCLE"; }
        if code == "E0703" { return "BKR_SELF_IMPORT_PATH"; }
        if code == "E0801" { return "BKR_SELF_GENERIC_ARITY"; }
        if code == "E0802" { return "BKR_SELF_GENERIC_INFERENCE"; }
        if code == "E0803" { return "BKR_SELF_GENERIC_LIMIT"; }
        if code == "E0804" { return "BKR_SELF_GENERIC_PARAM"; }
        return code;
    }

    fn diag_rule_id_to_code(rule_id: str) -> str {
        if rule_id == "BKR_SELF_PARSE" { return "E0101"; }
        if rule_id == "BKR_SELF_TYPE_MISMATCH" { return "E0201"; }
        if rule_id == "BKR_SELF_UNRESOLVED_SYMBOL" { return "E0202"; }
        if rule_id == "BKR_SELF_DUPLICATE_SYMBOL" { return "E0202"; }
        if rule_id == "BKR_SELF_ARITY_MISMATCH" { return "E0204"; }
        if rule_id == "BKR_SELF_RETURN_PATH" { return "E0206"; }
        if rule_id == "BKR_SELF_CONTROL_FLOW" { return "E0207"; }
        if rule_id == "BKR_SELF_MATCH_PATTERN" { return "E0212"; }
        if rule_id == "BKR_SELF_EXHAUSTIVENESS" { return "E0212"; }
        if rule_id == "BKR_SELF_STRUCT_LITERAL" { return "E0210"; }
        if rule_id == "BKR_SELF_AMBIGUOUS_TYPE" { return "E0211"; }
        if rule_id == "BKR_SELF_VOID_VALUE" { return "E0213"; }
        if rule_id == "BKR_SELF_UNREACHABLE_CODE" { return "E0214"; }
        if rule_id == "BKR_SELF_CONTRACT" { return "E0301"; }
        if rule_id == "BKR_SELF_SMT_TIMEOUT" { return "E0303"; }
        if rule_id == "BKR_SELF_SMT_UNAVAILABLE" { return "E0304"; }
        if rule_id == "BKR_SELF_USE_AFTER_MOVE" { return "E0401"; }
        if rule_id == "BKR_SELF_ASSIGNMENT_TARGET" { return "E0501"; }
        if rule_id == "BKR_SELF_CONST_ASSIGNMENT" { return "E0502"; }
        if rule_id == "BKR_SELF_VIEW_BINDING" { return "E0601"; }
        if rule_id == "BKR_SELF_IMPORT" { return "E0701"; }
        if rule_id == "BKR_SELF_IMPORT_CYCLE" { return "E0702"; }
        if rule_id == "BKR_SELF_IMPORT_PATH" { return "E0703"; }
        if rule_id == "BKR_SELF_GENERIC_ARITY" { return "E0801"; }
        if rule_id == "BKR_SELF_GENERIC_INFERENCE" { return "E0802"; }
        if rule_id == "BKR_SELF_GENERIC_LIMIT" { return "E0803"; }
        if rule_id == "BKR_SELF_GENERIC_PARAM" { return "E0804"; }
        return rule_id;
    }

    fn diag_code_category(code: str) -> str {
        if starts_with(code, "E01") || code == "BKR_SELF_PARSE" { return "syntax"; }
        if starts_with(code, "E02") || starts_with(code, "BKR_SELF_TYPE_") || starts_with(code, "BKR_SELF_ARITY_") { return "type_system"; }
        if code == "BKR_SELF_UNRESOLVED_SYMBOL" || code == "BKR_SELF_DUPLICATE_SYMBOL" { return "name_resolution"; }
        if starts_with(code, "E03") || code == "BKR_SELF_CONTRACT" { return "contract"; }
        if starts_with(code, "E04") || code == "BKR_SELF_USE_AFTER_MOVE" { return "linear_types"; }
        if starts_with(code, "E05") || code == "BKR_SELF_CONTROL_FLOW" || code == "BKR_SELF_RETURN_PATH" || code == "BKR_SELF_UNREACHABLE_CODE" || code == "E0214" { return "control_flow"; }
        if starts_with(code, "E06") || code == "BKR_SELF_VIEW_BINDING" { return "reactive_state"; }
        if starts_with(code, "E07") || starts_with(code, "BKR_SELF_IMPORT") { return "module"; }
        if starts_with(code, "E08") || starts_with(code, "BKR_SELF_GENERIC_") { return "generics"; }
        return "compiler";
    }

    fn diag_code_phase(code: str) -> str {
        if starts_with(code, "E01") || code == "BKR_SELF_PARSE" { return "parse"; }
        if code == "E0202" || code == "E0203" || code == "BKR_SELF_UNRESOLVED_SYMBOL" || code == "BKR_SELF_DUPLICATE_SYMBOL" { return "resolver"; }
        if starts_with(code, "E02") || starts_with(code, "BKR_SELF_TYPE_") || starts_with(code, "BKR_SELF_ARITY_") { return "typecheck"; }
        if starts_with(code, "E03") || code == "BKR_SELF_CONTRACT" { return "verify"; }
        if starts_with(code, "E04") || code == "BKR_SELF_USE_AFTER_MOVE" { return "ownership"; }
        if starts_with(code, "E05") || code == "BKR_SELF_CONTROL_FLOW" || code == "BKR_SELF_RETURN_PATH" || code == "BKR_SELF_UNREACHABLE_CODE" || code == "E0214" { return "typecheck"; }
        if starts_with(code, "E06") || code == "BKR_SELF_VIEW_BINDING" { return "view"; }
        if starts_with(code, "E07") || starts_with(code, "BKR_SELF_IMPORT") { return "import"; }
        if starts_with(code, "E08") || starts_with(code, "BKR_SELF_GENERIC_") { return "typecheck"; }
        return "typecheck";
    }

    fn diag_code_description(code: str) -> str {
        if code == "E0101" || code == "BKR_SELF_PARSE" { return "Parse error with expected and actual token details."; }
        if code == "E0201" || code == "BKR_SELF_TYPE_MISMATCH" { return "Type mismatch in expression or statement."; }
        if code == "E0202" || code == "BKR_SELF_UNRESOLVED_SYMBOL" { return "Undefined variable in current scope."; }
        if code == "E0203" { return "Undefined function in current scope."; }
        if code == "E0204" || code == "BKR_SELF_ARITY_MISMATCH" { return "Function call argument count mismatch."; }
        if code == "E0205" { return "Function call argument type mismatch."; }
        if code == "E0206" || code == "BKR_SELF_RETURN_PATH" { return "Return statement type mismatch with function signature."; }
        if code == "E0207" || code == "BKR_SELF_CONTROL_FLOW" { return "Condition expression must evaluate to boolean."; }
        if code == "E0208" { return "Cannot index non-indexable type."; }
        if code == "E0209" { return "No such field on struct or type."; }
        if code == "E0210" || code == "BKR_SELF_STRUCT_LITERAL" { return "Unknown struct type in literal or declaration."; }
        if code == "E0211" || code == "BKR_SELF_AMBIGUOUS_TYPE" { return "None requires explicit Option<T> type annotation."; }
        if code == "E0212" || code == "BKR_SELF_MATCH_PATTERN" { return "Match arm pattern type incompatible with scrutinee."; }
        if code == "E0213" || code == "BKR_SELF_VOID_VALUE" { return "Match block expression does not produce a value."; }
        if code == "E0214" || code == "BKR_SELF_UNREACHABLE_CODE" { return "Statement cannot execute because a previous statement terminates control flow."; }
        if code == "E0301" || code == "BKR_SELF_CONTRACT" { return "Contract precondition or postcondition violated."; }
        if code == "E0302" { return "Unsupported postcondition in verification mode."; }
        if code == "E0303" || code == "BKR_SELF_SMT_TIMEOUT" { return "SMT solver query timed out."; }
        if code == "E0304" || code == "BKR_SELF_SMT_UNAVAILABLE" { return "Z3 SMT solver unavailable or disabled."; }
        if code == "E0401" || code == "BKR_SELF_USE_AFTER_MOVE" { return "Use of value after ownership transfer."; }
        if code == "E0501" || code == "BKR_SELF_ASSIGNMENT_TARGET" { return "Assignment to non-assignable expression."; }
        if code == "E0502" || code == "BKR_SELF_CONST_ASSIGNMENT" { return "Assignment attempts to modify a constant."; }
        if code == "E0601" || code == "BKR_SELF_VIEW_BINDING" { return "Unknown state field in view component binding."; }
        if code == "E0602" { return "Unknown view agent binding."; }
        if code == "E0701" || code == "BKR_SELF_IMPORT" { return "Missing imported module."; }
        if code == "E0702" || code == "BKR_SELF_IMPORT_CYCLE" { return "Circular import dependency detected."; }
        if code == "E0703" || code == "BKR_SELF_IMPORT_PATH" { return "Invalid normalized relative import path."; }
        if code == "E0801" || code == "BKR_SELF_GENERIC_ARITY" { return "Generic type argument count mismatch."; }
        if code == "E0802" || code == "BKR_SELF_GENERIC_INFERENCE" { return "Generic type parameter inference failed."; }
        if code == "E0803" || code == "BKR_SELF_GENERIC_LIMIT" { return "Generic monomorphization recursion limit exceeded."; }
        if code == "E0804" || code == "BKR_SELF_GENERIC_PARAM" { return "Unknown generic type parameter."; }
        return "Compiler diagnostic.";
    }

    fn diag_confidence_score(confidence: str) -> i64 {
        if confidence == "high" { return 95; }
        if confidence == "medium" { return 75; }
        if confidence == "low" { return 40; }
        return 50;
    }

    // ========================================================================
    // Fluent Builder Interface (A-001..A-008, R-012)
    // ========================================================================

    fn diag_error(code: str, phase: str, msg: str, file: str, line: i64, col: i64) -> Diagnostic {
        let rule_id = diag_code_to_rule_id(code);
        let mut eff_phase = phase;
        if len(eff_phase) <= 0 {
            eff_phase = diag_code_phase(code);
        }
        let category = diag_code_category(code);

        return Diagnostic {
            error_code: code,
            rule_id: rule_id,
            severity: "error",
            phase: eff_phase,
            category: category,
            message: msg,
            file: file,
            line: line,
            column: col,
            source_start: 0,
            source_end: 0,
            context: "",
            source_line: "",
            ai_prompt_hint: "",
            expected_type: "",
            found_type: "",
            has_suggestion: false,
            suggestion_msg: "",
            suggestion_edit: diag_empty_edit(),
            has_related: false,
            related: diag_empty_related()
        };
    }

    fn diag_warning(code: str, phase: str, msg: str, file: str, line: i64, col: i64) -> Diagnostic {
        let rule_id = diag_code_to_rule_id(code);
        let mut eff_phase = phase;
        if len(eff_phase) <= 0 {
            eff_phase = diag_code_phase(code);
        }
        let category = diag_code_category(code);

        return Diagnostic {
            error_code: code,
            rule_id: rule_id,
            severity: "warning",
            phase: eff_phase,
            category: category,
            message: msg,
            file: file,
            line: line,
            column: col,
            source_start: 0,
            source_end: 0,
            context: "",
            source_line: "",
            ai_prompt_hint: "",
            expected_type: "",
            found_type: "",
            has_suggestion: false,
            suggestion_msg: "",
            suggestion_edit: diag_empty_edit(),
            has_related: false,
            related: diag_empty_related()
        };
    }

    fn diag_with_rule_id(diag: Diagnostic, rule_id: str) -> Diagnostic {
        let mut d = diag;
        d.rule_id = rule_id;
        return d;
    }

    fn diag_with_category(diag: Diagnostic, category: str) -> Diagnostic {
        let mut d = diag;
        d.category = category;
        return d;
    }

    fn diag_with_span(diag: Diagnostic, start: i64, end: i64) -> Diagnostic {
        let mut d = diag;
        d.source_start = start;
        d.source_end = end;
        return d;
    }

    fn diag_with_source(diag: Diagnostic, source_line: str, context: str) -> Diagnostic {
        let mut d = diag;
        d.source_line = source_line;
        d.context = context;
        return d;
    }

    fn diag_with_types(diag: Diagnostic, expected: str, found: str) -> Diagnostic {
        let mut d = diag;
        d.expected_type = expected;
        d.found_type = found;
        return d;
    }

    fn diag_with_hint(diag: Diagnostic, hint: str) -> Diagnostic {
        let mut d = diag;
        d.ai_prompt_hint = hint;
        return d;
    }

    fn diag_with_suggestion(diag: Diagnostic, msg: str, kind: str, start: i64, end: i64,
                            replacement: str, applicability: str, confidence: str) -> Diagnostic {
        let mut d = diag;
        d.has_suggestion = true;
        d.suggestion_msg = msg;
        d.suggestion_edit = DiagnosticTextEdit {
            kind: kind,
            source_start: start,
            source_end: end,
            replacement: replacement,
            applicability: applicability,
            confidence: confidence
        };
        return d;
    }

    fn diag_with_related(diag: Diagnostic, file: str, line: i64, col: i64, start: i64, end: i64, msg: str) -> Diagnostic {
        let mut d = diag;
        d.has_related = true;
        d.related = DiagnosticRelated {
            file: file,
            line: line,
            column: col,
            source_start: start,
            source_end: end,
            message: msg
        };
        return d;
    }

    // ========================================================================
    // JSON Serialization conforming to bunker.diagnostics.v1 (A-001)
    // ========================================================================

    fn diag_to_json(diag: Diagnostic) -> str {
        let mut loc_obj = json_object_new();
        json_object_set_str(loc_obj, "file", diag.file);
        json_object_set_i64(loc_obj, "line", diag.line);
        json_object_set_i64(loc_obj, "column", diag.column);
        if diag.source_start > 0 || diag.source_end > 0 {
            json_object_set_i64(loc_obj, "source_start", diag.source_start);
            json_object_set_i64(loc_obj, "source_end", diag.source_end);
        }
        if len(diag.context) > 0 {
            json_object_set_str(loc_obj, "context", diag.context);
        }
        if len(diag.source_line) > 0 {
            json_object_set_str(loc_obj, "source_line", diag.source_line);
        }

        let mut out_obj = json_object_new();
        json_object_set_str(out_obj, "error_code", diag.error_code);
        json_object_set_str(out_obj, "rule_id", diag.rule_id);
        json_object_set_str(out_obj, "severity", diag.severity);
        json_object_set_str(out_obj, "phase", diag.phase);
        json_object_set_str(out_obj, "category", diag.category);
        json_object_set_str(out_obj, "message", diag.message);
        json_object_set_raw(out_obj, "location", json_object_to_json(loc_obj));

        if len(diag.ai_prompt_hint) > 0 {
            json_object_set_str(out_obj, "ai_prompt_hint", diag.ai_prompt_hint);
        }

        if len(diag.expected_type) > 0 {
            let mut exp_obj = json_object_new();
            json_object_set_str(exp_obj, "type", diag.expected_type);
            json_object_set_raw(out_obj, "expected", json_object_to_json(exp_obj));
        }

        if len(diag.found_type) > 0 {
            let mut fnd_obj = json_object_new();
            json_object_set_str(fnd_obj, "type", diag.found_type);
            json_object_set_raw(out_obj, "found", json_object_to_json(fnd_obj));
        }

        if diag.has_suggestion {
            let mut sugg_arr = json_array_new();
            let mut sugg_obj = json_object_new();
            json_object_set_str(sugg_obj, "message", diag.suggestion_msg);
            json_object_set_str(sugg_obj, "kind", diag.suggestion_edit.kind);
            json_object_set_i64(sugg_obj, "source_start", diag.suggestion_edit.source_start);
            json_object_set_i64(sugg_obj, "source_end", diag.suggestion_edit.source_end);
            json_object_set_str(sugg_obj, "replacement", diag.suggestion_edit.replacement);
            json_object_set_str(sugg_obj, "applicability", diag.suggestion_edit.applicability);
            json_object_set_str(sugg_obj, "confidence", diag.suggestion_edit.confidence);
            json_array_push_raw(sugg_arr, json_object_to_json(sugg_obj));
            json_object_set_raw(out_obj, "suggestions", json_array_to_json(sugg_arr));
        }

        if diag.has_related {
            let mut rel_arr = json_array_new();
            let mut rel_obj = json_object_new();
            let mut rel_loc = json_object_new();
            json_object_set_str(rel_loc, "file", diag.related.file);
            json_object_set_i64(rel_loc, "line", diag.related.line);
            json_object_set_i64(rel_loc, "column", diag.related.column);
            if diag.related.source_start > 0 || diag.related.source_end > 0 {
                json_object_set_i64(rel_loc, "source_start", diag.related.source_start);
                json_object_set_i64(rel_loc, "source_end", diag.related.source_end);
            }
            json_object_set_raw(rel_obj, "location", json_object_to_json(rel_loc));
            json_object_set_str(rel_obj, "message", diag.related.message);
            json_array_push_raw(rel_arr, json_object_to_json(rel_obj));
            json_object_set_raw(out_obj, "related", json_array_to_json(rel_arr));
        }

        return json_object_to_json(out_obj);
    }

    fn diag_report_new(file: str) -> DiagnosticReport {
        let diags: Vec<Diagnostic> = vec_new();
        return DiagnosticReport {
            schema_version: "bunker.diagnostics.v1",
            file: file,
            diagnostics: diags,
            error_count: 0,
            warning_count: 0
        };
    }

    fn diag_report_add(report: DiagnosticReport, diag: Diagnostic) {
        vec_push(report.diagnostics, diag);
        if diag.severity == "error" {
            report.error_count = report.error_count + 1;
        } else if diag.severity == "warning" {
            report.warning_count = report.warning_count + 1;
        }
    }

    fn diag_report_has_errors(report: DiagnosticReport) -> bool {
        return report.error_count > 0;
    }

    fn diag_build_ai_prompt_context(report: DiagnosticReport) -> str {
        let mut prompt_obj = json_object_new();
        json_object_set_str(prompt_obj, "purpose", "Compiler feedback for AI repair loops");

        let mut summary_text = "Bunker check failed with " + int_to_string(report.error_count) + " error(s) and " + int_to_string(report.warning_count) + " warning(s).";
        if report.error_count == 0 {
            summary_text = "Bunker check succeeded with " + int_to_string(report.warning_count) + " warning(s).";
        }
        json_object_set_str(prompt_obj, "summary", summary_text);

        let mut instr_arr = json_array_new();
        json_array_push_raw(instr_arr, json_val_str("Use diagnostics as authoritative constraints."));
        json_array_push_raw(instr_arr, json_val_str("Do not silence errors with raw i64 handle casts unless a diagnostic explicitly recommends an explicit typed roundtrip."));
        json_array_push_raw(instr_arr, json_val_str("Prefer adding explicit type annotations over relying on inference when the compiler asks for context."));
        json_array_push_raw(instr_arr, json_val_str("After editing, rerun bunker check with --format=json and use the new diagnostics as the next prompt addition."));
        json_object_set_raw(prompt_obj, "instructions", json_array_to_json(instr_arr));

        let mut prompt_lines = summary_text;
        if report.error_count > 0 {
            prompt_lines = prompt_lines + from_char_code(10) +
                "Repair the source while preserving the user's intent. Prefer the smallest code change that satisfies the compiler.";
            let total = vec_len(report.diagnostics);
            let mut i: i64 = 0;
            while i < total && i < 10 {
                let d: Diagnostic = vec_get(report.diagnostics, i);
                prompt_lines = prompt_lines + from_char_code(10) +
                    int_to_string(i + 1) + ". [" + d.error_code + "] " + d.message + " at " +
                    d.file + ":" + int_to_string(d.line) + ":" + int_to_string(d.column);
                if len(d.ai_prompt_hint) > 0 {
                    prompt_lines = prompt_lines + from_char_code(10) + "   Hint: " + d.ai_prompt_hint;
                }
                if len(d.expected_type) > 0 {
                    prompt_lines = prompt_lines + from_char_code(10) + "   Expected: " + d.expected_type;
                }
                if len(d.found_type) > 0 {
                    prompt_lines = prompt_lines + from_char_code(10) + "   Found: " + d.found_type;
                }
                i = i + 1;
            }
        }
        json_object_set_str(prompt_obj, "prompt_addition", prompt_lines);

        return json_object_to_json(prompt_obj);
    }

    fn diag_report_to_json(report: DiagnosticReport) -> str {
        let mut report_obj = json_object_new();
        json_object_set_str(report_obj, "schema_version", report.schema_version);
        json_object_set_str(report_obj, "file", report.file);
        json_object_set_bool(report_obj, "success", report.error_count == 0);

        let mut summary_obj = json_object_new();
        json_object_set_i64(summary_obj, "total", vec_len(report.diagnostics));
        json_object_set_i64(summary_obj, "errors", report.error_count);
        json_object_set_i64(summary_obj, "warnings", report.warning_count);
        json_object_set_raw(report_obj, "summary", json_object_to_json(summary_obj));

        let mut diag_arr = json_array_new();
        let total: i64 = vec_len(report.diagnostics);
        let mut i: i64 = 0;
        while i < total {
            let d: Diagnostic = vec_get(report.diagnostics, i);
            json_array_push_raw(diag_arr, diag_to_json(d));
            i = i + 1;
        }
        json_object_set_raw(report_obj, "diagnostics", json_array_to_json(diag_arr));
        json_object_set_raw(report_obj, "ai_prompt_context", diag_build_ai_prompt_context(report));

        return json_object_to_json(report_obj);
    }
