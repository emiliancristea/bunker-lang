// Bunker Compiler Driver (bkrc)
// Compiles Bunker source to C code.
// This entrypoint is intentionally small: it composes the self-host compiler modules in dependency order.

kernel BunkerCompiler {
    import "modules/constants.bkr";

    import "modules/ast.bkr";

    import "modules/lexer_result.bkr";

    import "modules/lexer.bkr";

    import "modules/parser_state.bkr";

    import "modules/parser.bkr";

    import "modules/cgen_state.bkr";

    import "modules/c_codegen.bkr";

    import "modules/report_support.bkr";

    import "modules/driver.bkr";
}
