// Bunker Compiler Driver (bkrc)
// Compiles Bunker source to C code
// Usage: bunker-cli run bkrc.bkr  (compiles test.bkr to test.c)
// Module layout: constants and driver remain here; lexer, parser, and C codegen
// are imported from self-host/modules.

kernel BunkerCompiler {
    // ===== Token Constants =====
    const TOK_EOF: i64 = 0;
    const TOK_IDENT: i64 = 10;
    const TOK_INT: i64 = 11;
    const TOK_STR: i64 = 12;
    const TOK_FLOAT: i64 = 13;
    const TOK_TRUE: i64 = 14;
    const TOK_FALSE: i64 = 15;
    const TOK_KERNEL: i64 = 20;
    const TOK_STRUCT: i64 = 22;
    const TOK_FN: i64 = 23;
    const TOK_LET: i64 = 24;
    const TOK_IF: i64 = 25;
    const TOK_ELSE: i64 = 26;
    const TOK_FOR: i64 = 27;
    const TOK_IN: i64 = 28;
    const TOK_WHILE: i64 = 29;
    const TOK_BREAK: i64 = 30;
    const TOK_CONTINUE: i64 = 31;
    const TOK_LOOP: i64 = 32;
    const TOK_RETURN: i64 = 33;
    const TOK_MATCH: i64 = 34;
    const TOK_CONST: i64 = 35;
    const TOK_I32: i64 = 60;
    const TOK_I64: i64 = 61;
    const TOK_F64: i64 = 62;
    const TOK_BOOL: i64 = 63;
    const TOK_STR_TYPE: i64 = 64;
    const TOK_PLUS: i64 = 80;
    const TOK_MINUS: i64 = 81;
    const TOK_STAR: i64 = 82;
    const TOK_SLASH: i64 = 83;
    const TOK_PERCENT: i64 = 84;
    const TOK_EQ: i64 = 85;
    const TOK_NE: i64 = 86;
    const TOK_LT: i64 = 87;
    const TOK_GT: i64 = 88;
    const TOK_LE: i64 = 89;
    const TOK_GE: i64 = 90;
    const TOK_AND: i64 = 91;
    const TOK_OR: i64 = 92;
    const TOK_NOT: i64 = 93;
    const TOK_BIT_AND: i64 = 94;
    const TOK_BIT_OR: i64 = 95;
    const TOK_BIT_XOR: i64 = 96;
    const TOK_SHL: i64 = 97;
    const TOK_SHR: i64 = 98;
    const TOK_ASSIGN: i64 = 99;
    const TOK_ARROW: i64 = 101;
    const TOK_DOT_DOT: i64 = 102;
    const TOK_DOT_DOT_EQ: i64 = 103;
    const TOK_DOT: i64 = 104;
    const TOK_LPAREN: i64 = 110;
    const TOK_RPAREN: i64 = 111;
    const TOK_LBRACE: i64 = 112;
    const TOK_RBRACE: i64 = 113;
    const TOK_LBRACKET: i64 = 114;
    const TOK_RBRACKET: i64 = 115;
    const TOK_COMMA: i64 = 116;
    const TOK_SEMICOLON: i64 = 117;
    const TOK_COLON: i64 = 118;
    const TOK_QUESTION: i64 = 119;
    const TOK_FAT_ARROW: i64 = 120;

    // ===== AST Node Constants =====
    const NODE_KERNEL: i64 = 1;
    const NODE_FN: i64 = 2;
    const NODE_PARAM: i64 = 3;
    const NODE_TYPE: i64 = 4;
    const NODE_BLOCK: i64 = 5;
    const NODE_LET: i64 = 6;
    const NODE_RETURN: i64 = 7;
    const NODE_IF: i64 = 8;
    const NODE_WHILE: i64 = 9;
    const NODE_EXPR_STMT: i64 = 10;
    const NODE_ASSIGN: i64 = 11;
    const NODE_BREAK: i64 = 12;
    const NODE_CONTINUE: i64 = 13;
    const NODE_FOR: i64 = 14;
    const NODE_LOOP: i64 = 15;
    const NODE_BINARY: i64 = 20;
    const NODE_UNARY: i64 = 21;
    const NODE_CALL: i64 = 22;
    const NODE_IDENT: i64 = 23;
    const NODE_INT_LIT: i64 = 24;
    const NODE_BOOL_LIT: i64 = 25;
    const NODE_STR_LIT: i64 = 26;
    const NODE_CONST: i64 = 27;
    const NODE_TERNARY: i64 = 28;
    const NODE_FLOAT_LIT: i64 = 29;
    const NODE_ARRAY_LIT: i64 = 30;
    const NODE_INDEX: i64 = 31;
    const NODE_STRUCT: i64 = 32;
    const NODE_FIELD: i64 = 33;
    const NODE_FIELD_ACCESS: i64 = 34;
    const NODE_STRUCT_LIT: i64 = 35;
    const NODE_MATCH: i64 = 36;

    // ===== Pattern Constants =====
    const PAT_INT: i64 = 1;
    const PAT_BOOL: i64 = 2;
    const PAT_BIND: i64 = 3;
    const PAT_WILDCARD: i64 = 4;
    const PAT_SOME: i64 = 5;
    const PAT_NONE: i64 = 6;

    // ===== Type Constants =====
    const TYPE_I32: i64 = 0;
    const TYPE_I64: i64 = 1;
    const TYPE_F64: i64 = 2;
    const TYPE_BOOL: i64 = 3;
    const TYPE_STR: i64 = 4;
    const TYPE_VOID: i64 = 5;
    const TYPE_ARRAY: i64 = 6;
    const TYPE_STRUCT: i64 = 7;
    const TYPE_UNKNOWN: i64 = 99;

    import "modules/lexer.bkr";

    import "modules/parser.bkr";

    import "modules/c_codegen.bkr";

    // ========================================
    // COMPILER DRIVER
    // ========================================

    fn is_import_line(line: str) -> bool {
        let trimmed_line = trim(line);
        let n = len(trimmed_line);
        if n < 11 { return false; }
        if !starts_with(trimmed_line, "import ") { return false; }
        if char_code_at(trimmed_line, 7) != 34 { return false; }
        if char_code_at(trimmed_line, n - 2) != 34 { return false; }
        if char_code_at(trimmed_line, n - 1) != 59 { return false; }
        return true;
    }

    fn import_path_from_line(line: str) -> str {
        let trimmed_line = trim(line);
        return substring(trimmed_line, 8, len(trimmed_line) - 2);
    }

    fn append_expanded_line(output: str, line: str) -> str {
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !file_exists(import_path) {
                return output + "// Missing import: " + import_path + from_char_code(10);
            }
            let imported = read_file(import_path);
            let result = output + imported;
            if len(result) > 0 && char_code_at(result, len(result) - 1) != 10 {
                result = result + from_char_code(10);
            }
            return result;
        }
        return output + line + from_char_code(10);
    }

    fn expand_imports(source: str) -> str {
        let output = "";
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                output = append_expanded_line(output, substring(source, start, pos));
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            output = append_expanded_line(output, substring(source, start, source_len));
        }

        return output;
    }

    fn missing_import_in_line(line: str) -> str {
        if is_import_line(line) {
            let import_path = import_path_from_line(line);
            if !file_exists(import_path) {
                return import_path;
            }
        }
        return "";
    }

    fn first_missing_import_path(source: str) -> str {
        let start: i64 = 0;
        let pos: i64 = 0;
        let source_len = len(source);

        while pos < source_len {
            if char_code_at(source, pos) == 10 {
                let missing = missing_import_in_line(substring(source, start, pos));
                if len(missing) > 0 {
                    return missing;
                }
                pos = pos + 1;
                start = pos;
            } else {
                pos = pos + 1;
            }
        }

        if start < source_len {
            return missing_import_in_line(substring(source, start, source_len));
        }

        return "";
    }

    fn compile_to_c(source: str) -> str {
        let missing_import = first_missing_import_path(source);
        if len(missing_import) > 0 {
            return "/* Import error: missing module " + missing_import +
                ". AI repair hint: copy the imported Bunker module next to self_host_input.bkr or pre-expand imports before running bkrc. */" +
                from_char_code(10);
        }

        let expanded_source = expand_imports(source);
        let lex_result: Vec<i64> = tokenize(expanded_source);
        let p: Vec<i64> = parser_new(lex_result);
        let ast: Vec<i64> = parse_kernel(p);

        if parser_has_error(p) {
            let msg = "/* Parse error at token " + int_to_string(parser_error_position(p)) +
                ": expected " + token_name(parser_error_expected(p)) +
                ", got " + token_name(parser_error_actual(p)) +
                ". AI repair hint: inspect the construct before this token. Supported bootstrap syntax includes kernel, struct, fn, const, let, fixed arrays, field access, if, else, match expressions, Option<T> via Some/None, Result<T,E> via result_* builtins, Vec<T> and HashMap<i32,V> runtime handles, for-in ranges, while, loop, break, continue, return, primitive types, calls, casts, ternary expressions, bitwise operators, and basic expressions. */";
            return msg + from_char_code(10);
        }

        return gen_c_program(ast);
    }

    fn main() -> i32 {
        // File-based entrypoint for agents and the Rust wrapper:
        // write self_host_input.bkr, run this program, read self_host_output.c.
        let input_path = "self_host_input.bkr";
        let output_path = "self_host_output.c";

        let default_source = "kernel Test { fn main() -> i32 { let x: i32 = 40; let y: i32 = 2; return x + y; } }";
        if !file_exists(input_path) {
            write_file(input_path, default_source);
        }

        let source = read_file(input_path);
        let c_code = compile_to_c(source);
        let wrote = write_file(output_path, c_code);
        if !wrote {
            return 1;
        }

        if !file_exists(output_path) {
            return 2;
        }

        return 42;
    }
}
