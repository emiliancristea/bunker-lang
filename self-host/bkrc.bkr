// Bunker Compiler Driver (bkrc)
// Compiles Bunker source to C code
// Usage: bunker-cli run bkrc.bkr  (compiles test.bkr to test.c)

kernel BunkerCompiler {
    // ===== Token Constants =====
    const TOK_EOF: i64 = 0;
    const TOK_IDENT: i64 = 10;
    const TOK_INT: i64 = 11;
    const TOK_STR: i64 = 12;
    const TOK_TRUE: i64 = 14;
    const TOK_FALSE: i64 = 15;
    const TOK_KERNEL: i64 = 20;
    const TOK_FN: i64 = 23;
    const TOK_LET: i64 = 24;
    const TOK_IF: i64 = 25;
    const TOK_ELSE: i64 = 26;
    const TOK_WHILE: i64 = 29;
    const TOK_RETURN: i64 = 33;
    const TOK_CONST: i64 = 35;
    const TOK_I32: i64 = 60;
    const TOK_I64: i64 = 61;
    const TOK_BOOL: i64 = 63;
    const TOK_STR_TYPE: i64 = 64;
    const TOK_PLUS: i64 = 80;
    const TOK_MINUS: i64 = 81;
    const TOK_STAR: i64 = 82;
    const TOK_SLASH: i64 = 83;
    const TOK_PERCENT: i64 = 84;
    const TOK_EQ: i64 = 85;
    const TOK_NE: i64 = 86;
    const TOK_LT: i64 = 87;
    const TOK_GT: i64 = 88;
    const TOK_LE: i64 = 89;
    const TOK_GE: i64 = 90;
    const TOK_AND: i64 = 91;
    const TOK_OR: i64 = 92;
    const TOK_NOT: i64 = 93;
    const TOK_ASSIGN: i64 = 99;
    const TOK_ARROW: i64 = 101;
    const TOK_LPAREN: i64 = 110;
    const TOK_RPAREN: i64 = 111;
    const TOK_LBRACE: i64 = 112;
    const TOK_RBRACE: i64 = 113;
    const TOK_COMMA: i64 = 116;
    const TOK_SEMICOLON: i64 = 117;
    const TOK_COLON: i64 = 118;

    // ===== AST Node Constants =====
    const NODE_KERNEL: i64 = 1;
    const NODE_FN: i64 = 2;
    const NODE_PARAM: i64 = 3;
    const NODE_TYPE: i64 = 4;
    const NODE_BLOCK: i64 = 5;
    const NODE_LET: i64 = 6;
    const NODE_RETURN: i64 = 7;
    const NODE_IF: i64 = 8;
    const NODE_WHILE: i64 = 9;
    const NODE_EXPR_STMT: i64 = 10;
    const NODE_ASSIGN: i64 = 11;
    const NODE_BINARY: i64 = 20;
    const NODE_UNARY: i64 = 21;
    const NODE_CALL: i64 = 22;
    const NODE_IDENT: i64 = 23;
    const NODE_INT_LIT: i64 = 24;
    const NODE_BOOL_LIT: i64 = 25;
    const NODE_STR_LIT: i64 = 26;

    // ===== Type Constants =====
    const TYPE_I32: i64 = 0;
    const TYPE_I64: i64 = 1;
    const TYPE_F64: i64 = 2;
    const TYPE_BOOL: i64 = 3;
    const TYPE_STR: i64 = 4;
    const TYPE_VOID: i64 = 5;

    // ========================================
    // LEXER
    // ========================================

    // Token: [type, value_or_start, end, ...]
    // For strings: [type, start, end] where source[start:end] is the value

    fn is_alpha(c: i64) -> bool {
        return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
    }

    fn is_digit(c: i64) -> bool {
        return c >= 48 && c <= 57;
    }

    fn is_alnum(c: i64) -> bool {
        return is_alpha(c) || is_digit(c);
    }

    fn skip_whitespace(source: str, pos: i64) -> i64 {
        let src_len = len(source);
        while pos < src_len {
            let c = char_code(char_at(source, pos));
            if c == 32 || c == 9 || c == 10 || c == 13 {
                pos = pos + 1;
            } else if c == 47 && pos + 1 < src_len {
                // Check for // comment
                let next = char_code(char_at(source, pos + 1));
                if next == 47 {
                    pos = pos + 2;
                    while pos < src_len && char_code(char_at(source, pos)) != 10 {
                        pos = pos + 1;
                    }
                } else {
                    return pos;
                }
            } else {
                return pos;
            }
        }
        return pos;
    }

    fn tokenize(source: str) -> i64 {
        let tokens = vec_new();  // [type, start, end, type, start, end, ...]
        let names = vec_new();   // identifier/keyword strings
        let values = vec_new();  // integer values
        let strings = vec_new(); // string literal values

        let pos: i64 = 0;
        let src_len = len(source);

        while pos < src_len {
            pos = skip_whitespace(source, pos);
            if pos >= src_len {
                vec_push(tokens, TOK_EOF);
                vec_push(tokens, pos);
                vec_push(tokens, pos);
                let result = vec_new();
                vec_push(result, tokens);
                vec_push(result, names);
                vec_push(result, values);
                vec_push(result, strings);
                return result;
            }

            let start = pos;
            let c = char_code(char_at(source, pos));
            let tok_type: i64 = 0;
            let handled = false;

            // Identifier or keyword
            if is_alpha(c) {
                while pos < src_len && is_alnum(char_code(char_at(source, pos))) {
                    pos = pos + 1;
                }
                let word = substring(source, start, pos);
                tok_type = TOK_IDENT;

                if word == "kernel" { tok_type = TOK_KERNEL; }
                if word == "fn" { tok_type = TOK_FN; }
                if word == "let" { tok_type = TOK_LET; }
                if word == "if" { tok_type = TOK_IF; }
                if word == "else" { tok_type = TOK_ELSE; }
                if word == "while" { tok_type = TOK_WHILE; }
                if word == "return" { tok_type = TOK_RETURN; }
                if word == "const" { tok_type = TOK_CONST; }
                if word == "true" { tok_type = TOK_TRUE; }
                if word == "false" { tok_type = TOK_FALSE; }
                if word == "i32" { tok_type = TOK_I32; }
                if word == "i64" { tok_type = TOK_I64; }
                if word == "bool" { tok_type = TOK_BOOL; }
                if word == "str" { tok_type = TOK_STR_TYPE; }

                vec_push(tokens, tok_type);
                vec_push(tokens, vec_len(names));  // name index
                vec_push(tokens, pos);
                vec_push(names, word);
                handled = true;
            }

            // Number
            if !handled && is_digit(c) {
                while pos < src_len && is_digit(char_code(char_at(source, pos))) {
                    pos = pos + 1;
                }
                let num_str = substring(source, start, pos);
                let num_val = parse_int(num_str);
                vec_push(tokens, TOK_INT);
                vec_push(tokens, vec_len(values));  // value index
                vec_push(tokens, pos);
                vec_push(values, num_val);
                handled = true;
            }

            // String literal
            if !handled && c == 34 {  // "
                pos = pos + 1;  // skip opening quote
                let str_start = pos;
                while pos < src_len && char_code(char_at(source, pos)) != 34 {
                    pos = pos + 1;
                }
                let str_val = substring(source, str_start, pos);
                pos = pos + 1;  // skip closing quote
                vec_push(tokens, TOK_STR);
                vec_push(tokens, vec_len(strings));  // string index
                vec_push(tokens, pos);
                vec_push(strings, str_val);
                handled = true;
            }

            // Two-char operators
            if !handled && pos + 1 < src_len {
                let c2 = char_code(char_at(source, pos + 1));
                if c == 45 && c2 == 62 { tok_type = TOK_ARROW; pos = pos + 2; handled = true; }
                if !handled && c == 61 && c2 == 61 { tok_type = TOK_EQ; pos = pos + 2; handled = true; }
                if !handled && c == 33 && c2 == 61 { tok_type = TOK_NE; pos = pos + 2; handled = true; }
                if !handled && c == 60 && c2 == 61 { tok_type = TOK_LE; pos = pos + 2; handled = true; }
                if !handled && c == 62 && c2 == 61 { tok_type = TOK_GE; pos = pos + 2; handled = true; }
                if !handled && c == 38 && c2 == 38 { tok_type = TOK_AND; pos = pos + 2; handled = true; }
                if !handled && c == 124 && c2 == 124 { tok_type = TOK_OR; pos = pos + 2; handled = true; }
                if handled {
                    vec_push(tokens, tok_type);
                    vec_push(tokens, start);
                    vec_push(tokens, pos);
                }
            }

            // Single-char operators
            if !handled {
                if c == 43 { tok_type = TOK_PLUS; }
                if c == 45 { tok_type = TOK_MINUS; }
                if c == 42 { tok_type = TOK_STAR; }
                if c == 47 { tok_type = TOK_SLASH; }
                if c == 37 { tok_type = TOK_PERCENT; }
                if c == 60 { tok_type = TOK_LT; }
                if c == 62 { tok_type = TOK_GT; }
                if c == 33 { tok_type = TOK_NOT; }
                if c == 61 { tok_type = TOK_ASSIGN; }
                if c == 40 { tok_type = TOK_LPAREN; }
                if c == 41 { tok_type = TOK_RPAREN; }
                if c == 123 { tok_type = TOK_LBRACE; }
                if c == 125 { tok_type = TOK_RBRACE; }
                if c == 44 { tok_type = TOK_COMMA; }
                if c == 59 { tok_type = TOK_SEMICOLON; }
                if c == 58 { tok_type = TOK_COLON; }
                pos = pos + 1;
                vec_push(tokens, tok_type);
                vec_push(tokens, start);
                vec_push(tokens, pos);
            }
        }

        vec_push(tokens, TOK_EOF);
        vec_push(tokens, pos);
        vec_push(tokens, pos);

        let result = vec_new();
        vec_push(result, tokens);
        vec_push(result, names);
        vec_push(result, values);
        vec_push(result, strings);
        return result;
    }

    // ========================================
    // PARSER
    // ========================================

    fn parser_new(lex_result: i64) -> i64 {
        let state = vec_new();
        vec_push(state, vec_get(lex_result, 0));  // tokens
        vec_push(state, vec_get(lex_result, 1));  // names
        vec_push(state, vec_get(lex_result, 2));  // values
        vec_push(state, vec_get(lex_result, 3));  // strings
        vec_push(state, 0);                       // position (token index / 3)
        vec_push(state, 0);                       // error flag
        return state;
    }

    fn parser_peek(p: i64) -> i64 {
        let tokens = vec_get(p, 0);
        let pos = vec_get(p, 4);
        let idx = pos * 3;
        if idx >= vec_len(tokens) { return TOK_EOF; }
        return vec_get(tokens, idx);
    }

    fn parser_peek_value(p: i64) -> i64 {
        let tokens = vec_get(p, 0);
        let pos = vec_get(p, 4);
        return vec_get(tokens, pos * 3 + 1);
    }

    fn parser_advance(p: i64) -> i64 {
        let pos = vec_get(p, 4);
        vec_set(p, 4, pos + 1);
        return parser_peek(p);
    }

    fn parser_expect(p: i64, expected: i64) -> bool {
        if parser_peek(p) == expected {
            parser_advance(p);
            return true;
        }
        vec_set(p, 5, 1);  // set error
        return false;
    }

    fn parser_get_name(p: i64, idx: i64) -> i64 {
        let names = vec_get(p, 1);
        return vec_get(names, idx);
    }

    fn parser_get_value(p: i64, idx: i64) -> i64 {
        let values = vec_get(p, 2);
        return vec_get(values, idx);
    }

    fn parser_get_string(p: i64, idx: i64) -> i64 {
        let strings = vec_get(p, 3);
        return vec_get(strings, idx);
    }

    fn parser_has_error(p: i64) -> bool {
        return vec_get(p, 5) != 0;
    }

    // Parse type
    fn parse_type(p: i64) -> i64 {
        let node = vec_new();
        vec_push(node, NODE_TYPE);
        let tok = parser_peek(p);
        let kind: i64 = TYPE_I64;
        if tok == TOK_I32 { kind = TYPE_I32; parser_advance(p); }
        if tok == TOK_I64 { kind = TYPE_I64; parser_advance(p); }
        if tok == TOK_BOOL { kind = TYPE_BOOL; parser_advance(p); }
        if tok == TOK_STR_TYPE { kind = TYPE_STR; parser_advance(p); }
        vec_push(node, kind);
        return node;
    }

    // Note: To avoid forward references, we use a simplified parser
    // that doesn't support nested parens in function call args or complex if/while

    fn parse_atom(p: i64) -> i64 {
        let node = vec_new();
        let tok = parser_peek(p);

        if tok == TOK_INT {
            let val_idx = parser_peek_value(p);
            let val = parser_get_value(p, val_idx);
            parser_advance(p);
            vec_push(node, NODE_INT_LIT);
            vec_push(node, val);
            return node;
        }

        if tok == TOK_TRUE {
            parser_advance(p);
            vec_push(node, NODE_BOOL_LIT);
            vec_push(node, 1);
            return node;
        }

        if tok == TOK_FALSE {
            parser_advance(p);
            vec_push(node, NODE_BOOL_LIT);
            vec_push(node, 0);
            return node;
        }

        if tok == TOK_STR {
            let str_idx = parser_peek_value(p);
            let str_val = parser_get_string(p, str_idx);
            parser_advance(p);
            vec_push(node, NODE_STR_LIT);
            vec_push(node, str_val);
            return node;
        }

        if tok == TOK_IDENT {
            let name_idx = parser_peek_value(p);
            let name = parser_get_name(p, name_idx);
            parser_advance(p);

            // Check for function call with simple args
            if parser_peek(p) == TOK_LPAREN {
                parser_advance(p);
                let args = vec_new();

                // Parse simple arguments (atoms only, no nested expressions)
                while parser_peek(p) != TOK_RPAREN && parser_peek(p) != TOK_EOF {
                    let arg = parse_atom(p);
                    vec_push(args, arg);
                    if parser_peek(p) == TOK_COMMA {
                        parser_advance(p);
                    }
                }
                parser_expect(p, TOK_RPAREN);

                vec_push(node, NODE_CALL);
                vec_push(node, name);
                vec_push(node, args);
                return node;
            }

            vec_push(node, NODE_IDENT);
            vec_push(node, name);
            return node;
        }

        if tok == TOK_NOT {
            parser_advance(p);
            let operand = parse_atom(p);
            vec_push(node, NODE_UNARY);
            vec_push(node, TOK_NOT);
            vec_push(node, operand);
            return node;
        }

        if tok == TOK_MINUS {
            parser_advance(p);
            let operand = parse_atom(p);
            vec_push(node, NODE_UNARY);
            vec_push(node, TOK_MINUS);
            vec_push(node, operand);
            return node;
        }

        // Default: return 0
        vec_push(node, NODE_INT_LIT);
        vec_push(node, 0);
        return node;
    }

    fn parse_mul(p: i64) -> i64 {
        let left = parse_atom(p);
        while parser_peek(p) == TOK_STAR || parser_peek(p) == TOK_SLASH || parser_peek(p) == TOK_PERCENT {
            let op = parser_peek(p);
            parser_advance(p);
            let right = parse_atom(p);
            let node = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, op);
            vec_push(node, left);
            vec_push(node, right);
            left = node;
        }
        return left;
    }

    fn parse_add(p: i64) -> i64 {
        let left = parse_mul(p);
        while parser_peek(p) == TOK_PLUS || parser_peek(p) == TOK_MINUS {
            let op = parser_peek(p);
            parser_advance(p);
            let right = parse_mul(p);
            let node = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, op);
            vec_push(node, left);
            vec_push(node, right);
            left = node;
        }
        return left;
    }

    fn parse_comparison(p: i64) -> i64 {
        let left = parse_add(p);
        let tok = parser_peek(p);
        if tok == TOK_EQ || tok == TOK_NE || tok == TOK_LT || tok == TOK_GT || tok == TOK_LE || tok == TOK_GE {
            parser_advance(p);
            let right = parse_add(p);
            let node = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, tok);
            vec_push(node, left);
            vec_push(node, right);
            return node;
        }
        return left;
    }

    fn parse_and(p: i64) -> i64 {
        let left = parse_comparison(p);
        while parser_peek(p) == TOK_AND {
            parser_advance(p);
            let right = parse_comparison(p);
            let node = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, TOK_AND);
            vec_push(node, left);
            vec_push(node, right);
            left = node;
        }
        return left;
    }

    fn parse_or(p: i64) -> i64 {
        let left = parse_and(p);
        while parser_peek(p) == TOK_OR {
            parser_advance(p);
            let right = parse_and(p);
            let node = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, TOK_OR);
            vec_push(node, left);
            vec_push(node, right);
            left = node;
        }
        return left;
    }

    fn parse_expr(p: i64) -> i64 {
        return parse_or(p);
    }

    fn parse_let_stmt(p: i64) -> i64 {
        parser_advance(p);
        let name_idx = parser_peek_value(p);
        let name = parser_get_name(p, name_idx);
        parser_expect(p, TOK_IDENT);

        let type_node: i64 = 0;
        if parser_peek(p) == TOK_COLON {
            parser_advance(p);
            type_node = parse_type(p);
        }

        let init: i64 = 0;
        if parser_peek(p) == TOK_ASSIGN {
            parser_advance(p);
            init = parse_expr(p);
        }
        parser_expect(p, TOK_SEMICOLON);

        let node = vec_new();
        vec_push(node, NODE_LET);
        vec_push(node, name);
        vec_push(node, type_node);
        vec_push(node, init);
        return node;
    }

    fn parse_return_stmt(p: i64) -> i64 {
        parser_advance(p);
        let expr: i64 = 0;
        if parser_peek(p) != TOK_SEMICOLON {
            expr = parse_expr(p);
        }
        parser_expect(p, TOK_SEMICOLON);
        let node = vec_new();
        vec_push(node, NODE_RETURN);
        vec_push(node, expr);
        return node;
    }

    // Simplified statement that doesn't recurse into blocks
    fn parse_simple_stmt(p: i64) -> i64 {
        let tok = parser_peek(p);

        if tok == TOK_LET {
            return parse_let_stmt(p);
        }

        if tok == TOK_RETURN {
            return parse_return_stmt(p);
        }

        // Expression statement or assignment
        let expr = parse_expr(p);
        if parser_peek(p) == TOK_ASSIGN {
            parser_advance(p);
            let value = parse_expr(p);
            parser_expect(p, TOK_SEMICOLON);
            let node = vec_new();
            vec_push(node, NODE_ASSIGN);
            vec_push(node, expr);
            vec_push(node, value);
            return node;
        }
        parser_expect(p, TOK_SEMICOLON);
        let node = vec_new();
        vec_push(node, NODE_EXPR_STMT);
        vec_push(node, expr);
        return node;
    }

    // Parse a block (handles if/while inside)
    fn parse_block(p: i64) -> i64 {
        let node = vec_new();
        vec_push(node, NODE_BLOCK);
        parser_expect(p, TOK_LBRACE);

        while parser_peek(p) != TOK_RBRACE && parser_peek(p) != TOK_EOF {
            let tok = parser_peek(p);

            if tok == TOK_IF {
                parser_advance(p);
                let cond = parse_expr(p);
                let then_block = parse_block(p);
                let else_block: i64 = 0;
                if parser_peek(p) == TOK_ELSE {
                    parser_advance(p);
                    else_block = parse_block(p);
                }
                let if_node = vec_new();
                vec_push(if_node, NODE_IF);
                vec_push(if_node, cond);
                vec_push(if_node, then_block);
                vec_push(if_node, else_block);
                vec_push(node, if_node);
            } else if tok == TOK_WHILE {
                parser_advance(p);
                let cond = parse_expr(p);
                let body = parse_block(p);
                let while_node = vec_new();
                vec_push(while_node, NODE_WHILE);
                vec_push(while_node, cond);
                vec_push(while_node, body);
                vec_push(node, while_node);
            } else {
                let stmt = parse_simple_stmt(p);
                vec_push(node, stmt);
            }
        }
        parser_expect(p, TOK_RBRACE);
        return node;
    }

    fn parse_params(p: i64) -> i64 {
        let params = vec_new();
        parser_expect(p, TOK_LPAREN);
        if parser_peek(p) != TOK_RPAREN {
            // First param
            let name_idx = parser_peek_value(p);
            let name = parser_get_name(p, name_idx);
            parser_expect(p, TOK_IDENT);
            parser_expect(p, TOK_COLON);
            let ptype = parse_type(p);

            let param = vec_new();
            vec_push(param, NODE_PARAM);
            vec_push(param, name);
            vec_push(param, ptype);
            vec_push(params, param);

            while parser_peek(p) == TOK_COMMA {
                parser_advance(p);
                let name_idx2 = parser_peek_value(p);
                let name2 = parser_get_name(p, name_idx2);
                parser_expect(p, TOK_IDENT);
                parser_expect(p, TOK_COLON);
                let ptype2 = parse_type(p);

                let param2 = vec_new();
                vec_push(param2, NODE_PARAM);
                vec_push(param2, name2);
                vec_push(param2, ptype2);
                vec_push(params, param2);
            }
        }
        parser_expect(p, TOK_RPAREN);
        return params;
    }

    fn parse_fn(p: i64) -> i64 {
        parser_expect(p, TOK_FN);
        let name_idx = parser_peek_value(p);
        let name = parser_get_name(p, name_idx);
        parser_expect(p, TOK_IDENT);
        let params = parse_params(p);

        let ret_type: i64 = 0;
        if parser_peek(p) == TOK_ARROW {
            parser_advance(p);
            ret_type = parse_type(p);
        }

        let body = parse_block(p);

        let node = vec_new();
        vec_push(node, NODE_FN);
        vec_push(node, name);
        vec_push(node, params);
        vec_push(node, ret_type);
        vec_push(node, body);
        return node;
    }

    fn parse_kernel(p: i64) -> i64 {
        parser_expect(p, TOK_KERNEL);
        let name_idx = parser_peek_value(p);
        let name = parser_get_name(p, name_idx);
        parser_expect(p, TOK_IDENT);
        parser_expect(p, TOK_LBRACE);

        let items = vec_new();
        while parser_peek(p) != TOK_RBRACE && parser_peek(p) != TOK_EOF {
            let tok = parser_peek(p);
            if tok == TOK_FN {
                let fn_node = parse_fn(p);
                vec_push(items, fn_node);
            } else if tok == TOK_CONST {
                // Skip const declarations for now
                while parser_peek(p) != TOK_SEMICOLON && parser_peek(p) != TOK_EOF {
                    parser_advance(p);
                }
                parser_advance(p);  // skip semicolon
            } else {
                parser_advance(p);  // skip unknown
            }
        }
        parser_expect(p, TOK_RBRACE);

        let node = vec_new();
        vec_push(node, NODE_KERNEL);
        vec_push(node, name);
        vec_push(node, items);
        return node;
    }

    // ========================================
    // C CODE GENERATOR
    // ========================================

    fn type_to_c(kind: i64) -> str {
        if kind == TYPE_I32 { return "bkr_i32"; }
        if kind == TYPE_I64 { return "bkr_i64"; }
        if kind == TYPE_F64 { return "bkr_f64"; }
        if kind == TYPE_BOOL { return "bkr_bool"; }
        if kind == TYPE_STR { return "bkr_str"; }
        return "bkr_i64";
    }

    fn op_to_c(op: i64) -> str {
        if op == TOK_PLUS { return " + "; }
        if op == TOK_MINUS { return " - "; }
        if op == TOK_STAR { return " * "; }
        if op == TOK_SLASH { return " / "; }
        if op == TOK_PERCENT { return " % "; }
        if op == TOK_EQ { return " == "; }
        if op == TOK_NE { return " != "; }
        if op == TOK_LT { return " < "; }
        if op == TOK_GT { return " > "; }
        if op == TOK_LE { return " <= "; }
        if op == TOK_GE { return " >= "; }
        if op == TOK_AND { return " && "; }
        if op == TOK_OR { return " || "; }
        return " ? ";
    }

    // C codegen state: [output_lines, indent, kernel_name]
    fn cgen_new(kernel_name: str) -> i64 {
        let state = vec_new();
        vec_push(state, vec_new());  // lines
        vec_push(state, 0);          // indent
        vec_push(state, kernel_name);
        return state;
    }

    fn cgen_emit(state: i64, line: str) -> i64 {
        let lines = vec_get(state, 0);
        let indent = vec_get(state, 1);
        let prefix: str = "";
        let i: i64 = 0;
        while i < indent {
            prefix = prefix + "    ";
            i = i + 1;
        }
        vec_push(lines, prefix + line);
        return state;
    }

    fn cgen_indent(state: i64) -> i64 {
        vec_set(state, 1, vec_get(state, 1) + 1);
        return state;
    }

    fn cgen_dedent(state: i64) -> i64 {
        vec_set(state, 1, vec_get(state, 1) - 1);
        return state;
    }

    fn gen_c_expr(expr: i64) -> str {
        let node_type = vec_get(expr, 0);

        if node_type == NODE_INT_LIT {
            return int_to_string(vec_get(expr, 1));
        }

        if node_type == NODE_BOOL_LIT {
            if vec_get(expr, 1) == 1 { return "BKR_TRUE"; }
            return "BKR_FALSE";
        }

        if node_type == NODE_STR_LIT {
            let s = vec_get(expr, 1);
            // Quote char code is 34
            let quote = from_char_code(34);
            return quote + s + quote;
        }

        if node_type == NODE_IDENT {
            let name = vec_get(expr, 1);
            return name;
        }

        if node_type == NODE_BINARY {
            let op = vec_get(expr, 1);
            let left = vec_get(expr, 2);
            let right = vec_get(expr, 3);

            // String concatenation
            if op == TOK_PLUS {
                let left_type = vec_get(left, 0);
                let right_type = vec_get(right, 0);
                if left_type == NODE_STR_LIT || right_type == NODE_STR_LIT {
                    return "bkr_str_concat(" + gen_c_expr(left) + ", " + gen_c_expr(right) + ")";
                }
            }

            return "(" + gen_c_expr(left) + op_to_c(op) + gen_c_expr(right) + ")";
        }

        if node_type == NODE_UNARY {
            let op = vec_get(expr, 1);
            let operand = vec_get(expr, 2);
            if op == TOK_NOT { return "(!" + gen_c_expr(operand) + ")"; }
            if op == TOK_MINUS { return "(-" + gen_c_expr(operand) + ")"; }
            return gen_c_expr(operand);
        }

        if node_type == NODE_CALL {
            let name = vec_get(expr, 1);
            let args = vec_get(expr, 2);
            let result = name + "(";
            let i: i64 = 0;
            while i < vec_len(args) {
                if i > 0 { result = result + ", "; }
                result = result + gen_c_expr(vec_get(args, i));
                i = i + 1;
            }
            return result + ")";
        }

        return "0";
    }

    fn gen_c_stmt(state: i64, stmt: i64) -> i64 {
        let node_type = vec_get(stmt, 0);

        if node_type == NODE_LET {
            let name = vec_get(stmt, 1);
            let type_node = vec_get(stmt, 2);
            let init = vec_get(stmt, 3);

            let c_type: str = "bkr_i64";
            if type_node != 0 {
                let kind = vec_get(type_node, 1);
                c_type = type_to_c(kind);
            }

            let line = c_type + " " + name;
            if init != 0 {
                line = line + " = " + gen_c_expr(init);
            }
            cgen_emit(state, line + ";");
            return state;
        }

        if node_type == NODE_RETURN {
            let expr = vec_get(stmt, 1);
            if expr != 0 {
                cgen_emit(state, "return " + gen_c_expr(expr) + ";");
            } else {
                cgen_emit(state, "return;");
            }
            return state;
        }

        if node_type == NODE_IF {
            let cond = vec_get(stmt, 1);
            let then_block = vec_get(stmt, 2);
            let else_block = vec_get(stmt, 3);

            cgen_emit(state, "if (" + gen_c_expr(cond) + ") {");
            cgen_indent(state);
            gen_c_block(state, then_block);
            cgen_dedent(state);

            if else_block != 0 {
                cgen_emit(state, "} else {");
                cgen_indent(state);
                gen_c_block(state, else_block);
                cgen_dedent(state);
            }
            cgen_emit(state, "}");
            return state;
        }

        if node_type == NODE_WHILE {
            let cond = vec_get(stmt, 1);
            let body = vec_get(stmt, 2);
            cgen_emit(state, "while (" + gen_c_expr(cond) + ") {");
            cgen_indent(state);
            gen_c_block(state, body);
            cgen_dedent(state);
            cgen_emit(state, "}");
            return state;
        }

        if node_type == NODE_ASSIGN {
            let target = vec_get(stmt, 1);
            let value = vec_get(stmt, 2);
            cgen_emit(state, gen_c_expr(target) + " = " + gen_c_expr(value) + ";");
            return state;
        }

        if node_type == NODE_EXPR_STMT {
            let expr = vec_get(stmt, 1);
            cgen_emit(state, gen_c_expr(expr) + ";");
            return state;
        }

        return state;
    }

    fn gen_c_block(state: i64, block: i64) -> i64 {
        let i: i64 = 1;
        while i < vec_len(block) {
            gen_c_stmt(state, vec_get(block, i));
            i = i + 1;
        }
        return state;
    }

    fn gen_c_fn(state: i64, fn_node: i64) -> i64 {
        let name = vec_get(fn_node, 1);
        let params = vec_get(fn_node, 2);
        let ret_type_node = vec_get(fn_node, 3);
        let body = vec_get(fn_node, 4);

        let ret_type: str = "void";
        if ret_type_node != 0 {
            ret_type = type_to_c(vec_get(ret_type_node, 1));
        }

        // Generate parameter list
        let param_str: str = "";
        let i: i64 = 0;
        while i < vec_len(params) {
            let param = vec_get(params, i);
            let pname = vec_get(param, 1);
            let ptype = vec_get(param, 2);
            let ptype_c = type_to_c(vec_get(ptype, 1));
            if i > 0 { param_str = param_str + ", "; }
            param_str = param_str + ptype_c + " " + pname;
            i = i + 1;
        }
        if param_str == "" { param_str = "void"; }

        cgen_emit(state, ret_type + " " + name + "(" + param_str + ") {");
        cgen_indent(state);
        gen_c_block(state, body);
        cgen_dedent(state);
        cgen_emit(state, "}");
        cgen_emit(state, "");
        return state;
    }

    fn gen_c_kernel(state: i64, kernel: i64) -> i64 {
        let items = vec_get(kernel, 2);
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i);
            if vec_get(item, 0) == NODE_FN {
                gen_c_fn(state, item);
            }
            i = i + 1;
        }
        return state;
    }

    fn gen_c_program(kernel: i64) -> str {
        let kernel_name = vec_get(kernel, 1);
        let state = cgen_new(kernel_name);

        cgen_emit(state, "/* Generated by Bunker Compiler */");
        let quote = from_char_code(34);
        cgen_emit(state, "#include " + quote + "runtime.h" + quote);
        cgen_emit(state, "");

        gen_c_kernel(state, kernel);

        // Main wrapper that calls main()
        cgen_emit(state, "int main(void) {");
        cgen_emit(state, "    return (int)main();");
        cgen_emit(state, "}");

        // Join lines
        let lines = vec_get(state, 0);
        let output: str = "";
        let i: i64 = 0;
        while i < vec_len(lines) {
            let line = vec_get(lines, i);
            output = output + line + "\n";
            i = i + 1;
        }
        return output;
    }

    // ========================================
    // COMPILER DRIVER
    // ========================================

    fn compile_to_c(source: str) -> str {
        let lex_result = tokenize(source);
        let p = parser_new(lex_result);
        let ast = parse_kernel(p);

        if parser_has_error(p) {
            return "/* Parse error */\n";
        }

        return gen_c_program(ast);
    }

    fn main() -> i32 {
        // Compile a test program
        let source = "kernel Test { fn main() -> i32 { let x: i32 = 40; let y: i32 = 2; return x + y; } }";
        let c_code = compile_to_c(source);

        // Write to test.c
        write_file("test.c", c_code);

        // Also print it
        // (Can't print in bootstrap, but for testing)

        return 42;
    }
}
