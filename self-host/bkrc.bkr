// Bunker Compiler Driver (bkrc)
// Compiles Bunker source to C code
// Usage: bunker-cli run bkrc.bkr  (compiles test.bkr to test.c)

kernel BunkerCompiler {
    // ===== Token Constants =====
    const TOK_EOF: i64 = 0;
    const TOK_IDENT: i64 = 10;
    const TOK_INT: i64 = 11;
    const TOK_STR: i64 = 12;
    const TOK_FLOAT: i64 = 13;
    const TOK_TRUE: i64 = 14;
    const TOK_FALSE: i64 = 15;
    const TOK_KERNEL: i64 = 20;
    const TOK_FN: i64 = 23;
    const TOK_LET: i64 = 24;
    const TOK_IF: i64 = 25;
    const TOK_ELSE: i64 = 26;
    const TOK_FOR: i64 = 27;
    const TOK_IN: i64 = 28;
    const TOK_WHILE: i64 = 29;
    const TOK_BREAK: i64 = 30;
    const TOK_CONTINUE: i64 = 31;
    const TOK_LOOP: i64 = 32;
    const TOK_RETURN: i64 = 33;
    const TOK_CONST: i64 = 35;
    const TOK_I32: i64 = 60;
    const TOK_I64: i64 = 61;
    const TOK_F64: i64 = 62;
    const TOK_BOOL: i64 = 63;
    const TOK_STR_TYPE: i64 = 64;
    const TOK_PLUS: i64 = 80;
    const TOK_MINUS: i64 = 81;
    const TOK_STAR: i64 = 82;
    const TOK_SLASH: i64 = 83;
    const TOK_PERCENT: i64 = 84;
    const TOK_EQ: i64 = 85;
    const TOK_NE: i64 = 86;
    const TOK_LT: i64 = 87;
    const TOK_GT: i64 = 88;
    const TOK_LE: i64 = 89;
    const TOK_GE: i64 = 90;
    const TOK_AND: i64 = 91;
    const TOK_OR: i64 = 92;
    const TOK_NOT: i64 = 93;
    const TOK_BIT_AND: i64 = 94;
    const TOK_BIT_OR: i64 = 95;
    const TOK_BIT_XOR: i64 = 96;
    const TOK_SHL: i64 = 97;
    const TOK_SHR: i64 = 98;
    const TOK_ASSIGN: i64 = 99;
    const TOK_ARROW: i64 = 101;
    const TOK_DOT_DOT: i64 = 102;
    const TOK_DOT_DOT_EQ: i64 = 103;
    const TOK_LPAREN: i64 = 110;
    const TOK_RPAREN: i64 = 111;
    const TOK_LBRACE: i64 = 112;
    const TOK_RBRACE: i64 = 113;
    const TOK_LBRACKET: i64 = 114;
    const TOK_RBRACKET: i64 = 115;
    const TOK_COMMA: i64 = 116;
    const TOK_SEMICOLON: i64 = 117;
    const TOK_COLON: i64 = 118;
    const TOK_QUESTION: i64 = 119;

    // ===== AST Node Constants =====
    const NODE_KERNEL: i64 = 1;
    const NODE_FN: i64 = 2;
    const NODE_PARAM: i64 = 3;
    const NODE_TYPE: i64 = 4;
    const NODE_BLOCK: i64 = 5;
    const NODE_LET: i64 = 6;
    const NODE_RETURN: i64 = 7;
    const NODE_IF: i64 = 8;
    const NODE_WHILE: i64 = 9;
    const NODE_EXPR_STMT: i64 = 10;
    const NODE_ASSIGN: i64 = 11;
    const NODE_BREAK: i64 = 12;
    const NODE_CONTINUE: i64 = 13;
    const NODE_FOR: i64 = 14;
    const NODE_LOOP: i64 = 15;
    const NODE_BINARY: i64 = 20;
    const NODE_UNARY: i64 = 21;
    const NODE_CALL: i64 = 22;
    const NODE_IDENT: i64 = 23;
    const NODE_INT_LIT: i64 = 24;
    const NODE_BOOL_LIT: i64 = 25;
    const NODE_STR_LIT: i64 = 26;
    const NODE_CONST: i64 = 27;
    const NODE_TERNARY: i64 = 28;
    const NODE_FLOAT_LIT: i64 = 29;
    const NODE_ARRAY_LIT: i64 = 30;
    const NODE_INDEX: i64 = 31;

    // ===== Type Constants =====
    const TYPE_I32: i64 = 0;
    const TYPE_I64: i64 = 1;
    const TYPE_F64: i64 = 2;
    const TYPE_BOOL: i64 = 3;
    const TYPE_STR: i64 = 4;
    const TYPE_VOID: i64 = 5;
    const TYPE_ARRAY: i64 = 6;
    const TYPE_UNKNOWN: i64 = 99;

    // ========================================
    // LEXER
    // ========================================

    // Token: [type, value_or_start, end, ...]
    // For strings: [type, start, end] where source[start:end] is the value

    fn is_alpha(c: i64) -> bool {
        return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
    }

    fn is_digit(c: i64) -> bool {
        return c >= 48 && c <= 57;
    }

    fn is_alnum(c: i64) -> bool {
        return is_alpha(c) || is_digit(c);
    }

    fn skip_whitespace(source: str, pos: i64) -> i64 {
        let src_len = len(source);
        while pos < src_len {
            let c = char_code_at(source, pos);
            if c == 32 || c == 9 || c == 10 || c == 13 {
                pos = pos + 1;
            } else if c == 47 && pos + 1 < src_len {
                // Check for // comment
                let next = char_code_at(source, pos + 1);
                if next == 47 {
                    pos = pos + 2;
                    while pos < src_len && char_code_at(source, pos) != 10 {
                        pos = pos + 1;
                    }
                } else {
                    return pos;
                }
            } else {
                return pos;
            }
        }
        return pos;
    }

    fn intern_name(names: Vec<str>, word: str) -> i64 {
        let i: i64 = 0;
        while i < vec_len(names) {
            if vec_get(names, i) == word {
                return i;
            }
            i = i + 1;
        }
        let idx = vec_len(names);
        vec_push(names, word);
        return idx;
    }

    fn tokenize(source: str) -> Vec<i64> {
        let tokens: Vec<i64> = vec_new();  // [type, start, end, type, start, end, ...]
        let names: Vec<str> = vec_new();   // identifier/keyword strings
        let values: Vec<i64> = vec_new();  // integer values
        let strings: Vec<str> = vec_new(); // string literal values

        let pos: i64 = 0;
        let src_len = len(source);

        while pos < src_len {
            pos = skip_whitespace(source, pos);
            if pos >= src_len {
                vec_push(tokens, TOK_EOF);
                vec_push(tokens, pos);
                vec_push(tokens, pos);
                let result: Vec<i64> = vec_new();
                vec_push(result, tokens as i64);
                vec_push(result, names as i64);
                vec_push(result, values as i64);
                vec_push(result, strings as i64);
                return result;
            }

            let start = pos;
            let c = char_code_at(source, pos);
            let tok_type: i64 = 0;
            let handled = false;

            // Identifier or keyword
            if is_alpha(c) {
                while pos < src_len && is_alnum(char_code_at(source, pos)) {
                    pos = pos + 1;
                }
                let word = substring(source, start, pos);
                tok_type = TOK_IDENT;

                if word == "kernel" { tok_type = TOK_KERNEL; }
                if word == "fn" { tok_type = TOK_FN; }
                if word == "let" { tok_type = TOK_LET; }
                if word == "if" { tok_type = TOK_IF; }
                if word == "else" { tok_type = TOK_ELSE; }
                if word == "for" { tok_type = TOK_FOR; }
                if word == "in" { tok_type = TOK_IN; }
                if word == "while" { tok_type = TOK_WHILE; }
                if word == "break" { tok_type = TOK_BREAK; }
                if word == "continue" { tok_type = TOK_CONTINUE; }
                if word == "loop" { tok_type = TOK_LOOP; }
                if word == "return" { tok_type = TOK_RETURN; }
                if word == "const" { tok_type = TOK_CONST; }
                if word == "true" { tok_type = TOK_TRUE; }
                if word == "false" { tok_type = TOK_FALSE; }
                if word == "i32" { tok_type = TOK_I32; }
                if word == "i64" { tok_type = TOK_I64; }
                if word == "f64" { tok_type = TOK_F64; }
                if word == "bool" { tok_type = TOK_BOOL; }
                if word == "str" { tok_type = TOK_STR_TYPE; }

                let token_value = intern_name(names, word);
                vec_push(tokens, tok_type);
                vec_push(tokens, token_value);
                vec_push(tokens, pos);
                handled = true;
            }

            // Number
            if !handled && is_digit(c) {
                while pos < src_len && is_digit(char_code_at(source, pos)) {
                    pos = pos + 1;
                }
                if pos + 1 < src_len && char_code_at(source, pos) == 46 && is_digit(char_code_at(source, pos + 1)) {
                    pos = pos + 1;
                    while pos < src_len && is_digit(char_code_at(source, pos)) {
                        pos = pos + 1;
                    }
                    let float_str = substring(source, start, pos);
                    vec_push(tokens, TOK_FLOAT);
                    vec_push(tokens, vec_len(strings));
                    vec_push(tokens, pos);
                    vec_push(strings, float_str);
                } else {
                    let num_str = substring(source, start, pos);
                    let num_val = parse_int(num_str);
                    vec_push(tokens, TOK_INT);
                    vec_push(tokens, vec_len(values));  // value index
                    vec_push(tokens, pos);
                    vec_push(values, num_val);
                }
                handled = true;
            }

            // String literal
            if !handled && c == 34 {  // "
                pos = pos + 1;  // skip opening quote
                let str_start = pos;
                while pos < src_len && char_code_at(source, pos) != 34 {
                    pos = pos + 1;
                }
                let str_val = substring(source, str_start, pos);
                pos = pos + 1;  // skip closing quote
                vec_push(tokens, TOK_STR);
                vec_push(tokens, vec_len(strings));  // string index
                vec_push(tokens, pos);
                vec_push(strings, str_val);
                handled = true;
            }

            // Three-char operators
            if !handled && pos + 2 < src_len {
                let c2 = char_code_at(source, pos + 1);
                let c3 = char_code_at(source, pos + 2);
                if c == 46 && c2 == 46 && c3 == 61 { tok_type = TOK_DOT_DOT_EQ; pos = pos + 3; handled = true; }
                if handled {
                    vec_push(tokens, tok_type);
                    vec_push(tokens, start);
                    vec_push(tokens, pos);
                }
            }

            // Two-char operators
            if !handled && pos + 1 < src_len {
                let c2 = char_code_at(source, pos + 1);
                if c == 45 && c2 == 62 { tok_type = TOK_ARROW; pos = pos + 2; handled = true; }
                if !handled && c == 46 && c2 == 46 { tok_type = TOK_DOT_DOT; pos = pos + 2; handled = true; }
                if !handled && c == 61 && c2 == 61 { tok_type = TOK_EQ; pos = pos + 2; handled = true; }
                if !handled && c == 33 && c2 == 61 { tok_type = TOK_NE; pos = pos + 2; handled = true; }
                if !handled && c == 60 && c2 == 61 { tok_type = TOK_LE; pos = pos + 2; handled = true; }
                if !handled && c == 62 && c2 == 61 { tok_type = TOK_GE; pos = pos + 2; handled = true; }
                if !handled && c == 60 && c2 == 60 { tok_type = TOK_SHL; pos = pos + 2; handled = true; }
                if !handled && c == 62 && c2 == 62 { tok_type = TOK_SHR; pos = pos + 2; handled = true; }
                if !handled && c == 38 && c2 == 38 { tok_type = TOK_AND; pos = pos + 2; handled = true; }
                if !handled && c == 124 && c2 == 124 { tok_type = TOK_OR; pos = pos + 2; handled = true; }
                if handled {
                    vec_push(tokens, tok_type);
                    vec_push(tokens, start);
                    vec_push(tokens, pos);
                }
            }

            // Single-char operators
            if !handled {
                if c == 43 { tok_type = TOK_PLUS; }
                if c == 45 { tok_type = TOK_MINUS; }
                if c == 42 { tok_type = TOK_STAR; }
                if c == 47 { tok_type = TOK_SLASH; }
                if c == 37 { tok_type = TOK_PERCENT; }
                if c == 60 { tok_type = TOK_LT; }
                if c == 62 { tok_type = TOK_GT; }
                if c == 33 { tok_type = TOK_NOT; }
                if c == 38 { tok_type = TOK_BIT_AND; }
                if c == 124 { tok_type = TOK_BIT_OR; }
                if c == 94 { tok_type = TOK_BIT_XOR; }
                if c == 61 { tok_type = TOK_ASSIGN; }
                if c == 40 { tok_type = TOK_LPAREN; }
                if c == 41 { tok_type = TOK_RPAREN; }
                if c == 123 { tok_type = TOK_LBRACE; }
                if c == 125 { tok_type = TOK_RBRACE; }
                if c == 91 { tok_type = TOK_LBRACKET; }
                if c == 93 { tok_type = TOK_RBRACKET; }
                if c == 44 { tok_type = TOK_COMMA; }
                if c == 59 { tok_type = TOK_SEMICOLON; }
                if c == 58 { tok_type = TOK_COLON; }
                if c == 63 { tok_type = TOK_QUESTION; }
                pos = pos + 1;
                vec_push(tokens, tok_type);
                vec_push(tokens, start);
                vec_push(tokens, pos);
            }
        }

        vec_push(tokens, TOK_EOF);
        vec_push(tokens, pos);
        vec_push(tokens, pos);

        let result: Vec<i64> = vec_new();
        vec_push(result, tokens as i64);
        vec_push(result, names as i64);
        vec_push(result, values as i64);
        vec_push(result, strings as i64);
        return result;
    }

    // ========================================
    // PARSER
    // ========================================

    fn parser_new(lex_result: Vec<i64>) -> Vec<i64> {
        let state: Vec<i64> = vec_new();
        vec_push(state, vec_get(lex_result, 0));  // tokens
        vec_push(state, vec_get(lex_result, 1));  // names
        vec_push(state, vec_get(lex_result, 2));  // values
        vec_push(state, vec_get(lex_result, 3));  // strings
        vec_push(state, 0);                       // position (token index / 3)
        vec_push(state, 0);                       // error flag
        vec_push(state, -1);                      // first error position
        vec_push(state, TOK_EOF);                 // first expected token
        vec_push(state, TOK_EOF);                 // first actual token
        return state;
    }

    fn parser_peek(p: Vec<i64>) -> i64 {
        let tokens = vec_get(p, 0) as Vec<i64>;
        let pos = vec_get(p, 4);
        let idx = pos * 3;
        if idx >= vec_len(tokens) { return TOK_EOF; }
        return vec_get(tokens, idx);
    }

    fn parser_peek_value(p: Vec<i64>) -> i64 {
        let tokens = vec_get(p, 0) as Vec<i64>;
        let pos = vec_get(p, 4);
        return vec_get(tokens, pos * 3 + 1);
    }

    fn parser_advance(p: Vec<i64>) -> i64 {
        let pos = vec_get(p, 4);
        vec_set(p, 4, pos + 1);
        return parser_peek(p);
    }

    fn parser_expect(p: Vec<i64>, expected: i64) -> bool {
        if parser_peek(p) == expected {
            parser_advance(p);
            return true;
        }
        parser_mark_error(p, expected);
        return false;
    }

    fn parser_mark_error(p: Vec<i64>, expected: i64) -> Vec<i64> {
        vec_set(p, 5, 1);
        if vec_get(p, 6) < 0 {
            vec_set(p, 6, vec_get(p, 4));
            vec_set(p, 7, expected);
            vec_set(p, 8, parser_peek(p));
        }
        return p;
    }

    fn parser_get_name(p: Vec<i64>, idx: i64) -> str {
        let names = vec_get(p, 1) as Vec<str>;
        return vec_get(names, idx);
    }

    fn parser_get_value(p: Vec<i64>, idx: i64) -> i64 {
        let values = vec_get(p, 2) as Vec<i64>;
        return vec_get(values, idx);
    }

    fn parser_get_string(p: Vec<i64>, idx: i64) -> str {
        let strings = vec_get(p, 3) as Vec<str>;
        return vec_get(strings, idx);
    }

    fn parser_has_error(p: Vec<i64>) -> bool {
        return vec_get(p, 5) != 0;
    }

    fn parser_error_position(p: Vec<i64>) -> i64 {
        return vec_get(p, 6);
    }

    fn parser_error_expected(p: Vec<i64>) -> i64 {
        return vec_get(p, 7);
    }

    fn parser_error_actual(p: Vec<i64>) -> i64 {
        return vec_get(p, 8);
    }

    fn token_name(tok: i64) -> str {
        if tok == TOK_EOF { return "EOF"; }
        if tok == TOK_IDENT { return "identifier"; }
        if tok == TOK_INT { return "integer"; }
        if tok == TOK_STR { return "string"; }
        if tok == TOK_FLOAT { return "float"; }
        if tok == TOK_TRUE { return "true"; }
        if tok == TOK_FALSE { return "false"; }
        if tok == TOK_KERNEL { return "kernel"; }
        if tok == TOK_FN { return "fn"; }
        if tok == TOK_LET { return "let"; }
        if tok == TOK_IF { return "if"; }
        if tok == TOK_ELSE { return "else"; }
        if tok == TOK_FOR { return "for"; }
        if tok == TOK_IN { return "in"; }
        if tok == TOK_WHILE { return "while"; }
        if tok == TOK_BREAK { return "break"; }
        if tok == TOK_CONTINUE { return "continue"; }
        if tok == TOK_LOOP { return "loop"; }
        if tok == TOK_RETURN { return "return"; }
        if tok == TOK_CONST { return "const"; }
        if tok == TOK_I32 { return "i32"; }
        if tok == TOK_I64 { return "i64"; }
        if tok == TOK_F64 { return "f64"; }
        if tok == TOK_BOOL { return "bool"; }
        if tok == TOK_STR_TYPE { return "str"; }
        if tok == TOK_PLUS { return "+"; }
        if tok == TOK_MINUS { return "-"; }
        if tok == TOK_STAR { return "*"; }
        if tok == TOK_SLASH { return "/"; }
        if tok == TOK_PERCENT { return "%"; }
        if tok == TOK_EQ { return "=="; }
        if tok == TOK_NE { return "!="; }
        if tok == TOK_LT { return "<"; }
        if tok == TOK_GT { return ">"; }
        if tok == TOK_LE { return "<="; }
        if tok == TOK_GE { return ">="; }
        if tok == TOK_AND { return "&&"; }
        if tok == TOK_OR { return "||"; }
        if tok == TOK_NOT { return "!"; }
        if tok == TOK_BIT_AND { return "&"; }
        if tok == TOK_BIT_OR { return "|"; }
        if tok == TOK_BIT_XOR { return "^"; }
        if tok == TOK_SHL { return "<<"; }
        if tok == TOK_SHR { return ">>"; }
        if tok == TOK_ASSIGN { return "="; }
        if tok == TOK_ARROW { return "->"; }
        if tok == TOK_DOT_DOT { return ".."; }
        if tok == TOK_DOT_DOT_EQ { return "..="; }
        if tok == TOK_LPAREN { return "("; }
        if tok == TOK_RPAREN { return ")"; }
        if tok == TOK_LBRACE { return "{"; }
        if tok == TOK_RBRACE { return "}"; }
        if tok == TOK_LBRACKET { return "["; }
        if tok == TOK_RBRACKET { return "]"; }
        if tok == TOK_COMMA { return ","; }
        if tok == TOK_SEMICOLON { return ";"; }
        if tok == TOK_COLON { return ":"; }
        if tok == TOK_QUESTION { return "?"; }
        return "token " + int_to_string(tok);
    }

    fn is_name_token(tok: i64) -> bool {
        return tok == TOK_IDENT || tok == TOK_KERNEL || tok == TOK_FN || tok == TOK_LET ||
               tok == TOK_IF || tok == TOK_ELSE || tok == TOK_FOR || tok == TOK_IN ||
               tok == TOK_WHILE || tok == TOK_BREAK || tok == TOK_CONTINUE ||
               tok == TOK_LOOP || tok == TOK_RETURN || tok == TOK_CONST ||
               tok == TOK_I32 || tok == TOK_I64 || tok == TOK_F64 || tok == TOK_BOOL ||
               tok == TOK_STR_TYPE;
    }

    fn parser_expect_name(p: Vec<i64>) -> i64 {
        let value = parser_peek_value(p);
        if is_name_token(parser_peek(p)) {
            parser_advance(p);
            return value;
        }
        parser_mark_error(p, TOK_IDENT);
        return value;
    }

    fn parser_peek_ident_is(p: Vec<i64>, name: str) -> bool {
        if parser_peek(p) != TOK_IDENT {
            return false;
        }
        return parser_get_name(p, parser_peek_value(p)) == name;
    }

    fn skip_type_tail(p: Vec<i64>) -> Vec<i64> {
        if parser_peek(p) == TOK_LT {
            let depth: i64 = 0;
            while parser_peek(p) != TOK_EOF {
                let tok = parser_peek(p);
                if tok == TOK_LT {
                    depth = depth + 1;
                }
                if tok == TOK_GT {
                    depth = depth - 1;
                }
                parser_advance(p);
                if depth <= 0 {
                    return p;
                }
            }
        }
        return p;
    }

    // Parse type
    fn parse_type(p: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_TYPE);
        let tok = parser_peek(p);
        let kind: i64 = TYPE_I64;
        let consumed = false;
        if tok == TOK_LBRACKET {
            parser_advance(p);
            let elem_type: Vec<i64> = parse_type(p);
            parser_expect(p, TOK_SEMICOLON);
            let len_value: i64 = 0;
            if parser_peek(p) == TOK_INT {
                len_value = parser_get_value(p, parser_peek_value(p));
                parser_advance(p);
            } else {
                parser_mark_error(p, TOK_INT);
            }
            parser_expect(p, TOK_RBRACKET);
            vec_push(node, TYPE_ARRAY);
            vec_push(node, vec_get(elem_type, 1));
            vec_push(node, len_value);
            return node;
        }
        if tok == TOK_I32 { kind = TYPE_I32; parser_advance(p); consumed = true; }
        if tok == TOK_I64 { kind = TYPE_I64; parser_advance(p); consumed = true; }
        if tok == TOK_F64 { kind = TYPE_F64; parser_advance(p); consumed = true; }
        if tok == TOK_BOOL { kind = TYPE_BOOL; parser_advance(p); consumed = true; }
        if tok == TOK_STR_TYPE { kind = TYPE_STR; parser_advance(p); consumed = true; }
        if tok == TOK_IDENT {
            // Bootstrap generics such as Vec<i64> are represented as handles.
            parser_advance(p);
            skip_type_tail(p);
            consumed = true;
        }
        if !consumed && tok != TOK_EOF {
            parser_advance(p);
        }
        vec_push(node, kind);
        return node;
    }

    fn parse_atom(p: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        let tok = parser_peek(p);

        if tok == TOK_INT {
            let val_idx = parser_peek_value(p);
            let val = parser_get_value(p, val_idx);
            parser_advance(p);
            vec_push(node, NODE_INT_LIT);
            vec_push(node, val);
            return node;
        }

        if tok == TOK_FLOAT {
            let str_idx = parser_peek_value(p);
            parser_advance(p);
            vec_push(node, NODE_FLOAT_LIT);
            vec_push(node, parser_get_string(p, str_idx) as i64);
            return node;
        }

        if tok == TOK_TRUE {
            parser_advance(p);
            vec_push(node, NODE_BOOL_LIT);
            vec_push(node, 1);
            return node;
        }

        if tok == TOK_FALSE {
            parser_advance(p);
            vec_push(node, NODE_BOOL_LIT);
            vec_push(node, 0);
            return node;
        }

        if tok == TOK_STR {
            let str_idx = parser_peek_value(p);
            parser_advance(p);
            vec_push(node, NODE_STR_LIT);
            vec_push(node, parser_get_string(p, str_idx) as i64);
            return node;
        }

        if tok == TOK_LPAREN {
            parser_advance(p);
            let expr = parse_expr(p);
            parser_expect(p, TOK_RPAREN);
            return expr;
        }

        if tok == TOK_LBRACKET {
            parser_advance(p);
            let elements: Vec<i64> = vec_new();
            while parser_peek(p) != TOK_RBRACKET && parser_peek(p) != TOK_EOF {
                let elem: Vec<i64> = parse_expr(p);
                vec_push(elements, elem as i64);
                if parser_peek(p) == TOK_COMMA {
                    parser_advance(p);
                }
            }
            parser_expect(p, TOK_RBRACKET);
            vec_push(node, NODE_ARRAY_LIT);
            vec_push(node, elements as i64);
            return node;
        }

        if is_name_token(tok) {
            let name_idx = parser_peek_value(p);
            parser_advance(p);

            // Check for function call with simple args
            if parser_peek(p) == TOK_LPAREN {
                parser_advance(p);
                let args: Vec<i64> = vec_new();

                // Parse function call arguments as full expressions
                while parser_peek(p) != TOK_RPAREN && parser_peek(p) != TOK_EOF {
                    let arg: Vec<i64> = parse_expr(p);
                    vec_push(args, arg as i64);
                    if parser_peek(p) == TOK_COMMA {
                        parser_advance(p);
                    }
                }
                parser_expect(p, TOK_RPAREN);

                vec_push(node, NODE_CALL);
                vec_push(node, name_idx);
                vec_push(node, args as i64);
                return node;
            }

            vec_push(node, NODE_IDENT);
            vec_push(node, name_idx);
            return node;
        }

        if tok == TOK_NOT {
            parser_advance(p);
            let operand: Vec<i64> = parse_atom(p);
            vec_push(node, NODE_UNARY);
            vec_push(node, TOK_NOT);
            vec_push(node, operand as i64);
            return node;
        }

        if tok == TOK_MINUS {
            parser_advance(p);
            let operand: Vec<i64> = parse_atom(p);
            vec_push(node, NODE_UNARY);
            vec_push(node, TOK_MINUS);
            vec_push(node, operand as i64);
            return node;
        }

        // Default: consume the unexpected token so callers always make progress.
        if tok != TOK_EOF {
            parser_advance(p);
        }
        vec_push(node, NODE_INT_LIT);
        vec_push(node, 0);
        return node;
    }

    fn parse_postfix(p: Vec<i64>) -> Vec<i64> {
        let base: Vec<i64> = parse_atom(p);
        while parser_peek(p) == TOK_LBRACKET {
            parser_advance(p);
            let idx: Vec<i64> = parse_expr(p);
            parser_expect(p, TOK_RBRACKET);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_INDEX);
            vec_push(node, base as i64);
            vec_push(node, idx as i64);
            base = node;
        }
        return base;
    }

    fn parse_mul(p: Vec<i64>) -> Vec<i64> {
        let left: Vec<i64> = parse_postfix(p);
        while parser_peek(p) == TOK_STAR || parser_peek(p) == TOK_SLASH || parser_peek(p) == TOK_PERCENT {
            let op = parser_peek(p);
            parser_advance(p);
            let right: Vec<i64> = parse_postfix(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, op);
            vec_push(node, left as i64);
            vec_push(node, right as i64);
            left = node;
        }
        return left;
    }

    fn parse_add(p: Vec<i64>) -> Vec<i64> {
        let left: Vec<i64> = parse_mul(p);
        while parser_peek(p) == TOK_PLUS || parser_peek(p) == TOK_MINUS {
            let op = parser_peek(p);
            parser_advance(p);
            let right: Vec<i64> = parse_mul(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, op);
            vec_push(node, left as i64);
            vec_push(node, right as i64);
            left = node;
        }
        return left;
    }

    fn parse_shift(p: Vec<i64>) -> Vec<i64> {
        let left: Vec<i64> = parse_add(p);
        while parser_peek(p) == TOK_SHL || parser_peek(p) == TOK_SHR {
            let op = parser_peek(p);
            parser_advance(p);
            let right: Vec<i64> = parse_add(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, op);
            vec_push(node, left as i64);
            vec_push(node, right as i64);
            left = node;
        }
        return left;
    }

    fn parse_bit_and(p: Vec<i64>) -> Vec<i64> {
        let left: Vec<i64> = parse_shift(p);
        while parser_peek(p) == TOK_BIT_AND {
            parser_advance(p);
            let right: Vec<i64> = parse_shift(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, TOK_BIT_AND);
            vec_push(node, left as i64);
            vec_push(node, right as i64);
            left = node;
        }
        return left;
    }

    fn parse_bit_xor(p: Vec<i64>) -> Vec<i64> {
        let left: Vec<i64> = parse_bit_and(p);
        while parser_peek(p) == TOK_BIT_XOR {
            parser_advance(p);
            let right: Vec<i64> = parse_bit_and(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, TOK_BIT_XOR);
            vec_push(node, left as i64);
            vec_push(node, right as i64);
            left = node;
        }
        return left;
    }

    fn parse_bit_or(p: Vec<i64>) -> Vec<i64> {
        let left: Vec<i64> = parse_bit_xor(p);
        while parser_peek(p) == TOK_BIT_OR {
            parser_advance(p);
            let right: Vec<i64> = parse_bit_xor(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, TOK_BIT_OR);
            vec_push(node, left as i64);
            vec_push(node, right as i64);
            left = node;
        }
        return left;
    }

    fn parse_comparison(p: Vec<i64>) -> Vec<i64> {
        let left: Vec<i64> = parse_bit_or(p);
        let tok = parser_peek(p);
        if tok == TOK_EQ || tok == TOK_NE || tok == TOK_LT || tok == TOK_GT || tok == TOK_LE || tok == TOK_GE {
            parser_advance(p);
            let right: Vec<i64> = parse_bit_or(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, tok);
            vec_push(node, left as i64);
            vec_push(node, right as i64);
            return node;
        }
        return left;
    }

    fn parse_and(p: Vec<i64>) -> Vec<i64> {
        let left: Vec<i64> = parse_comparison(p);
        while parser_peek(p) == TOK_AND {
            parser_advance(p);
            let right: Vec<i64> = parse_comparison(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, TOK_AND);
            vec_push(node, left as i64);
            vec_push(node, right as i64);
            left = node;
        }
        return left;
    }

    fn parse_or(p: Vec<i64>) -> Vec<i64> {
        let left: Vec<i64> = parse_and(p);
        while parser_peek(p) == TOK_OR {
            parser_advance(p);
            let right: Vec<i64> = parse_and(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BINARY);
            vec_push(node, TOK_OR);
            vec_push(node, left as i64);
            vec_push(node, right as i64);
            left = node;
        }
        return left;
    }

    fn parse_ternary(p: Vec<i64>) -> Vec<i64> {
        let cond: Vec<i64> = parse_or(p);
        if parser_peek(p) == TOK_QUESTION {
            parser_advance(p);
            let then_expr: Vec<i64> = parse_expr(p);
            parser_expect(p, TOK_COLON);
            let else_expr: Vec<i64> = parse_expr(p);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_TERNARY);
            vec_push(node, cond as i64);
            vec_push(node, then_expr as i64);
            vec_push(node, else_expr as i64);
            return node;
        }
        return cond;
    }

    fn parse_expr(p: Vec<i64>) -> Vec<i64> {
        let expr: Vec<i64> = parse_ternary(p);
        while parser_peek_ident_is(p, "as") {
            parser_advance(p);
            parse_type(p);
        }
        return expr;
    }

    fn parse_let_stmt(p: Vec<i64>) -> Vec<i64> {
        parser_advance(p);
        let name_idx = parser_expect_name(p);

        let type_node: i64 = 0;
        if parser_peek(p) == TOK_COLON {
            parser_advance(p);
            type_node = parse_type(p) as i64;
        }

        let init: i64 = 0;
        if parser_peek(p) == TOK_ASSIGN {
            parser_advance(p);
            init = parse_expr(p) as i64;
        }
        parser_expect(p, TOK_SEMICOLON);

        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_LET);
        vec_push(node, name_idx);
        vec_push(node, type_node);
        vec_push(node, init);
        return node;
    }

    fn parse_return_stmt(p: Vec<i64>) -> Vec<i64> {
        parser_advance(p);
        let expr: i64 = 0;
        if parser_peek(p) != TOK_SEMICOLON {
            expr = parse_expr(p) as i64;
        }
        parser_expect(p, TOK_SEMICOLON);
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_RETURN);
        vec_push(node, expr);
        return node;
    }

    // Simplified statement that doesn't recurse into blocks
    fn parse_simple_stmt(p: Vec<i64>) -> Vec<i64> {
        let tok = parser_peek(p);

        if tok == TOK_LET {
            return parse_let_stmt(p);
        }

        if tok == TOK_RETURN {
            return parse_return_stmt(p);
        }

        if tok == TOK_BREAK {
            parser_advance(p);
            parser_expect(p, TOK_SEMICOLON);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_BREAK);
            return node;
        }

        if tok == TOK_CONTINUE {
            parser_advance(p);
            parser_expect(p, TOK_SEMICOLON);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_CONTINUE);
            return node;
        }

        // Expression statement or assignment
        let expr: Vec<i64> = parse_expr(p);
        if parser_peek(p) == TOK_ASSIGN {
            parser_advance(p);
            let value: Vec<i64> = parse_expr(p);
            parser_expect(p, TOK_SEMICOLON);
            let node: Vec<i64> = vec_new();
            vec_push(node, NODE_ASSIGN);
            vec_push(node, expr as i64);
            vec_push(node, value as i64);
            return node;
        }

        if !parser_expect(p, TOK_SEMICOLON) {
            // Recovery: consume tokens until the next statement boundary
            while parser_peek(p) != TOK_SEMICOLON && parser_peek(p) != TOK_RBRACE && parser_peek(p) != TOK_EOF {
                parser_advance(p);
            }
            if parser_peek(p) == TOK_SEMICOLON {
                parser_advance(p);
            }
        }

        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_EXPR_STMT);
        vec_push(node, expr as i64);
        return node;
    }

    fn parse_if_stmt(p: Vec<i64>) -> Vec<i64> {
        parser_expect(p, TOK_IF);
        let cond: Vec<i64> = parse_expr(p);
        let then_block: Vec<i64> = parse_block(p);
        let else_block: i64 = 0;
        if parser_peek(p) == TOK_ELSE {
            parser_advance(p);
            if parser_peek(p) == TOK_IF {
                let nested_if: Vec<i64> = parse_if_stmt(p);
                let wrapper: Vec<i64> = vec_new();
                vec_push(wrapper, NODE_BLOCK);
                vec_push(wrapper, nested_if as i64);
                else_block = wrapper as i64;
            } else {
                else_block = parse_block(p) as i64;
            }
        }
        let if_node: Vec<i64> = vec_new();
        vec_push(if_node, NODE_IF);
        vec_push(if_node, cond as i64);
        vec_push(if_node, then_block as i64);
        vec_push(if_node, else_block);
        return if_node;
    }

    fn parse_for_stmt(p: Vec<i64>) -> Vec<i64> {
        parser_expect(p, TOK_FOR);
        let name_idx = parser_expect_name(p);
        parser_expect(p, TOK_IN);
        let start_expr: Vec<i64> = parse_expr(p);

        let inclusive: i64 = 0;
        if parser_peek(p) == TOK_DOT_DOT_EQ {
            inclusive = 1;
            parser_advance(p);
        } else {
            parser_expect(p, TOK_DOT_DOT);
        }

        let end_expr: Vec<i64> = parse_expr(p);
        let body: Vec<i64> = parse_block(p);

        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_FOR);
        vec_push(node, name_idx);
        vec_push(node, start_expr as i64);
        vec_push(node, end_expr as i64);
        vec_push(node, inclusive);
        vec_push(node, body as i64);
        return node;
    }

    // Parse a block (handles if/while inside)
    fn parse_block(p: Vec<i64>) -> Vec<i64> {
        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_BLOCK);
        parser_expect(p, TOK_LBRACE);

        while parser_peek(p) != TOK_RBRACE && parser_peek(p) != TOK_EOF {
            let tok = parser_peek(p);

            if tok == TOK_IF {
                let if_node: Vec<i64> = parse_if_stmt(p);
                vec_push(node, if_node as i64);
            } else if tok == TOK_FOR {
                let for_node: Vec<i64> = parse_for_stmt(p);
                vec_push(node, for_node as i64);
            } else if tok == TOK_WHILE {
                parser_advance(p);
                let cond: Vec<i64> = parse_expr(p);
                let body: Vec<i64> = parse_block(p);
                let while_node: Vec<i64> = vec_new();
                vec_push(while_node, NODE_WHILE);
                vec_push(while_node, cond as i64);
                vec_push(while_node, body as i64);
                vec_push(node, while_node as i64);
            } else if tok == TOK_LOOP {
                parser_advance(p);
                let body: Vec<i64> = parse_block(p);
                let loop_node: Vec<i64> = vec_new();
                vec_push(loop_node, NODE_LOOP);
                vec_push(loop_node, body as i64);
                vec_push(node, loop_node as i64);
            } else {
                let stmt: Vec<i64> = parse_simple_stmt(p);
                vec_push(node, stmt as i64);
            }
        }
        parser_expect(p, TOK_RBRACE);
        return node;
    }

    fn parse_params(p: Vec<i64>) -> Vec<i64> {
        let params: Vec<i64> = vec_new();
        parser_expect(p, TOK_LPAREN);
        if parser_peek(p) != TOK_RPAREN {
            // First param
            let name_idx = parser_expect_name(p);
            parser_expect(p, TOK_COLON);
            let ptype: Vec<i64> = parse_type(p);

            let param: Vec<i64> = vec_new();
            vec_push(param, NODE_PARAM);
            vec_push(param, name_idx);
            vec_push(param, ptype as i64);
            vec_push(params, param as i64);

            while parser_peek(p) == TOK_COMMA {
                parser_advance(p);
                let name_idx2 = parser_expect_name(p);
                parser_expect(p, TOK_COLON);
                let ptype2: Vec<i64> = parse_type(p);

                let param2: Vec<i64> = vec_new();
                vec_push(param2, NODE_PARAM);
                vec_push(param2, name_idx2);
                vec_push(param2, ptype2 as i64);
                vec_push(params, param2 as i64);
            }
        }
        parser_expect(p, TOK_RPAREN);
        return params;
    }

    fn parse_fn(p: Vec<i64>) -> Vec<i64> {
        parser_expect(p, TOK_FN);
        let name_idx = parser_expect_name(p);
        let params: Vec<i64> = parse_params(p);

        let ret_type: i64 = 0;
        if parser_peek(p) == TOK_ARROW {
            parser_advance(p);
            ret_type = parse_type(p) as i64;
        }

        let body: Vec<i64> = parse_block(p);

        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_FN);
        vec_push(node, name_idx);
        vec_push(node, params as i64);
        vec_push(node, ret_type);
        vec_push(node, body as i64);
        return node;
    }

    fn parse_const(p: Vec<i64>) -> Vec<i64> {
        parser_expect(p, TOK_CONST);
        let name_idx = parser_expect_name(p);

        let type_node: i64 = 0;
        if parser_peek(p) == TOK_COLON {
            parser_advance(p);
            type_node = parse_type(p) as i64;
        }

        let value: i64 = 0;
        if parser_peek(p) == TOK_ASSIGN {
            parser_advance(p);
            value = parse_expr(p) as i64;
        }

        parser_expect(p, TOK_SEMICOLON);

        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_CONST);
        vec_push(node, name_idx);
        vec_push(node, type_node);
        vec_push(node, value);
        return node;
    }

    fn parse_kernel(p: Vec<i64>) -> Vec<i64> {
        parser_expect(p, TOK_KERNEL);
        let name_idx = parser_expect_name(p);
        parser_expect(p, TOK_LBRACE);

        let items: Vec<i64> = vec_new();
        let main_name_idx: i64 = -1;
        while parser_peek(p) != TOK_RBRACE && parser_peek(p) != TOK_EOF {
            let tok = parser_peek(p);
            if tok == TOK_FN {
                let fn_node: Vec<i64> = parse_fn(p);
                let fn_name_idx = vec_get(fn_node, 1);
                if parser_get_name(p, fn_name_idx) == "main" {
                    main_name_idx = fn_name_idx;
                }
                vec_push(items, fn_node as i64);
            } else if tok == TOK_CONST {
                let const_node: Vec<i64> = parse_const(p);
                vec_push(items, const_node as i64);
            } else {
                parser_advance(p);  // skip unknown
            }
        }
        parser_expect(p, TOK_RBRACE);

        let node: Vec<i64> = vec_new();
        vec_push(node, NODE_KERNEL);
        vec_push(node, name_idx);
        vec_push(node, items as i64);
        vec_push(node, main_name_idx);
        vec_push(node, vec_get(p, 1));  // names table for C codegen
        return node;
    }

    // ========================================
    // C CODE GENERATOR
    // ========================================

    fn type_to_c(kind: i64) -> str {
        if kind == TYPE_I32 { return "bkr_i32"; }
        if kind == TYPE_I64 { return "bkr_i64"; }
        if kind == TYPE_F64 { return "bkr_f64"; }
        if kind == TYPE_BOOL { return "bkr_bool"; }
        if kind == TYPE_STR { return "bkr_str"; }
        return "bkr_i64";
    }

    fn op_to_c(op: i64) -> str {
        if op == TOK_PLUS { return " + "; }
        if op == TOK_MINUS { return " - "; }
        if op == TOK_STAR { return " * "; }
        if op == TOK_SLASH { return " / "; }
        if op == TOK_PERCENT { return " % "; }
        if op == TOK_EQ { return " == "; }
        if op == TOK_NE { return " != "; }
        if op == TOK_LT { return " < "; }
        if op == TOK_GT { return " > "; }
        if op == TOK_LE { return " <= "; }
        if op == TOK_GE { return " >= "; }
        if op == TOK_AND { return " && "; }
        if op == TOK_OR { return " || "; }
        if op == TOK_BIT_AND { return " & "; }
        if op == TOK_BIT_OR { return " | "; }
        if op == TOK_BIT_XOR { return " ^ "; }
        if op == TOK_SHL { return " << "; }
        if op == TOK_SHR { return " >> "; }
        return " ? ";
    }

    fn name_from_table(names: Vec<str>, idx: i64) -> str {
        if idx >= 0 && idx < vec_len(names) {
            return vec_get(names, idx);
        }
        return "";
    }

    fn builtin_to_c(raw: str) -> str {
        if raw == "len" { return "bkr_len"; }
        if raw == "strlen" { return "bkr_len"; }
        if raw == "print" { return "bkr_print"; }
        if raw == "println" { return "bkr_println"; }
        if raw == "read_file" { return "read_file"; }
        if raw == "write_file" { return "write_file"; }
        if raw == "file_exists" { return "file_exists"; }
        if raw == "vec_new" { return "vec_new"; }
        if raw == "vec_push" { return "vec_push"; }
        if raw == "vec_get" { return "vec_get"; }
        if raw == "vec_set" { return "vec_set"; }
        if raw == "vec_len" { return "vec_len"; }
        if raw == "char_at" { return "char_at"; }
        if raw == "char_code" { return "char_code"; }
        if raw == "char_code_at" { return "char_code_at"; }
        if raw == "substring" { return "substring"; }
        if raw == "parse_int" { return "parse_int"; }
        if raw == "int_to_string" { return "int_to_string"; }
        if raw == "from_char_code" { return "from_char_code"; }
        return "";
    }

    fn name_to_c_from_names(names: Vec<str>, idx: i64) -> str {
        let raw = name_from_table(names, idx);
        let builtin = builtin_to_c(raw);
        if builtin != "" {
            return builtin;
        }
        return "_v" + int_to_string(idx);
    }

    fn name_to_c(state: Vec<i64>, idx: i64) -> str {
        let names = vec_get(state, 3) as Vec<str>;
        return name_to_c_from_names(names, idx);
    }

    // C codegen state: [output_lines, indent, kernel_name, names, local_names, local_types, fn_names, fn_types, global_names, global_types, array_names, array_lengths, array_elem_types]
    fn cgen_new(kernel_name: str, names: Vec<str>) -> Vec<i64> {
        let state: Vec<i64> = vec_new();
        let lines: Vec<str> = vec_new();
        let local_names: Vec<i64> = vec_new();
        let local_types: Vec<i64> = vec_new();
        let fn_names: Vec<i64> = vec_new();
        let fn_types: Vec<i64> = vec_new();
        let global_names: Vec<i64> = vec_new();
        let global_types: Vec<i64> = vec_new();
        let array_names: Vec<i64> = vec_new();
        let array_lengths: Vec<i64> = vec_new();
        let array_elem_types: Vec<i64> = vec_new();
        vec_push(state, lines as i64);
        vec_push(state, 0);          // indent
        vec_push(state, kernel_name as i64);
        vec_push(state, names as i64);
        vec_push(state, local_names as i64);
        vec_push(state, local_types as i64);
        vec_push(state, fn_names as i64);
        vec_push(state, fn_types as i64);
        vec_push(state, global_names as i64);
        vec_push(state, global_types as i64);
        vec_push(state, array_names as i64);
        vec_push(state, array_lengths as i64);
        vec_push(state, array_elem_types as i64);
        return state;
    }

    fn cgen_emit(state: Vec<i64>, line: str) -> Vec<i64> {
        let lines = vec_get(state, 0) as Vec<str>;
        let indent = vec_get(state, 1);
        let prefix: str = "";
        let i: i64 = 0;
        while i < indent {
            prefix = prefix + "    ";
            i = i + 1;
        }
        vec_push(lines, prefix + line);
        return state;
    }

    fn cgen_indent(state: Vec<i64>) -> Vec<i64> {
        vec_set(state, 1, vec_get(state, 1) + 1);
        return state;
    }

    fn cgen_dedent(state: Vec<i64>) -> Vec<i64> {
        vec_set(state, 1, vec_get(state, 1) - 1);
        return state;
    }

    fn type_node_kind(type_node: i64) -> i64 {
        if type_node == 0 {
            return TYPE_UNKNOWN;
        }
        let type_node_vec = type_node as Vec<i64>;
        return vec_get(type_node_vec, 1);
    }

    fn type_node_array_elem_kind(type_node: i64) -> i64 {
        if type_node == 0 {
            return TYPE_UNKNOWN;
        }
        let type_node_vec = type_node as Vec<i64>;
        if vec_len(type_node_vec) > 2 && vec_get(type_node_vec, 1) == TYPE_ARRAY {
            return vec_get(type_node_vec, 2);
        }
        return TYPE_UNKNOWN;
    }

    fn type_node_array_len(type_node: i64) -> i64 {
        if type_node == 0 {
            return -1;
        }
        let type_node_vec = type_node as Vec<i64>;
        if vec_len(type_node_vec) > 3 && vec_get(type_node_vec, 1) == TYPE_ARRAY {
            return vec_get(type_node_vec, 3);
        }
        return -1;
    }

    fn cgen_clear_locals(state: Vec<i64>) -> Vec<i64> {
        let local_names: Vec<i64> = vec_new();
        let local_types: Vec<i64> = vec_new();
        let array_names: Vec<i64> = vec_new();
        let array_lengths: Vec<i64> = vec_new();
        let array_elem_types: Vec<i64> = vec_new();
        vec_set(state, 4, local_names as i64);
        vec_set(state, 5, local_types as i64);
        vec_set(state, 10, array_names as i64);
        vec_set(state, 11, array_lengths as i64);
        vec_set(state, 12, array_elem_types as i64);
        return state;
    }

    fn cgen_add_local_type(state: Vec<i64>, name_idx: i64, kind: i64) -> Vec<i64> {
        let local_names = vec_get(state, 4) as Vec<i64>;
        let local_types = vec_get(state, 5) as Vec<i64>;
        vec_push(local_names, name_idx);
        vec_push(local_types, kind);
        return state;
    }

    fn cgen_add_fn_type(state: Vec<i64>, name_idx: i64, kind: i64) -> Vec<i64> {
        let fn_names = vec_get(state, 6) as Vec<i64>;
        let fn_types = vec_get(state, 7) as Vec<i64>;
        vec_push(fn_names, name_idx);
        vec_push(fn_types, kind);
        return state;
    }

    fn cgen_add_global_type(state: Vec<i64>, name_idx: i64, kind: i64) -> Vec<i64> {
        let global_names = vec_get(state, 8) as Vec<i64>;
        let global_types = vec_get(state, 9) as Vec<i64>;
        vec_push(global_names, name_idx);
        vec_push(global_types, kind);
        return state;
    }

    fn cgen_add_array_type(state: Vec<i64>, name_idx: i64, elem_kind: i64, len_value: i64) -> Vec<i64> {
        let array_names = vec_get(state, 10) as Vec<i64>;
        let array_lengths = vec_get(state, 11) as Vec<i64>;
        let array_elem_types = vec_get(state, 12) as Vec<i64>;
        vec_push(array_names, name_idx);
        vec_push(array_lengths, len_value);
        vec_push(array_elem_types, elem_kind);
        return state;
    }

    fn cgen_lookup_array_length(state: Vec<i64>, name_idx: i64) -> i64 {
        let array_names = vec_get(state, 10) as Vec<i64>;
        let array_lengths = vec_get(state, 11) as Vec<i64>;
        let result: i64 = -1;
        let i: i64 = 0;
        while i < vec_len(array_names) {
            if vec_get(array_names, i) == name_idx {
                result = vec_get(array_lengths, i);
            }
            i = i + 1;
        }
        return result;
    }

    fn cgen_lookup_array_elem_type(state: Vec<i64>, name_idx: i64) -> i64 {
        let array_names = vec_get(state, 10) as Vec<i64>;
        let array_elem_types = vec_get(state, 12) as Vec<i64>;
        let result: i64 = TYPE_UNKNOWN;
        let i: i64 = 0;
        while i < vec_len(array_names) {
            if vec_get(array_names, i) == name_idx {
                result = vec_get(array_elem_types, i);
            }
            i = i + 1;
        }
        return result;
    }

    fn cgen_lookup_pair(names: Vec<i64>, types: Vec<i64>, name_idx: i64) -> i64 {
        let result = TYPE_UNKNOWN;
        let i: i64 = 0;
        while i < vec_len(names) {
            if vec_get(names, i) == name_idx {
                result = vec_get(types, i);
            }
            i = i + 1;
        }
        return result;
    }

    fn cgen_lookup_name_type(state: Vec<i64>, name_idx: i64) -> i64 {
        let local_names = vec_get(state, 4) as Vec<i64>;
        let local_types = vec_get(state, 5) as Vec<i64>;
        let local_kind = cgen_lookup_pair(local_names, local_types, name_idx);
        if local_kind != TYPE_UNKNOWN {
            return local_kind;
        }

        let global_names = vec_get(state, 8) as Vec<i64>;
        let global_types = vec_get(state, 9) as Vec<i64>;
        return cgen_lookup_pair(global_names, global_types, name_idx);
    }

    fn cgen_lookup_fn_type(state: Vec<i64>, name_idx: i64) -> i64 {
        let fn_names = vec_get(state, 6) as Vec<i64>;
        let fn_types = vec_get(state, 7) as Vec<i64>;
        return cgen_lookup_pair(fn_names, fn_types, name_idx);
    }

    fn builtin_return_type(raw: str) -> i64 {
        if raw == "len" { return TYPE_I64; }
        if raw == "strlen" { return TYPE_I64; }
        if raw == "vec_new" { return TYPE_I64; }
        if raw == "vec_get" { return TYPE_I64; }
        if raw == "vec_len" { return TYPE_I64; }
        if raw == "char_code" { return TYPE_I64; }
        if raw == "char_code_at" { return TYPE_I64; }
        if raw == "parse_int" { return TYPE_I64; }
        if raw == "char_at" { return TYPE_STR; }
        if raw == "substring" { return TYPE_STR; }
        if raw == "int_to_string" { return TYPE_STR; }
        if raw == "from_char_code" { return TYPE_STR; }
        if raw == "read_file" { return TYPE_STR; }
        if raw == "write_file" { return TYPE_BOOL; }
        if raw == "file_exists" { return TYPE_BOOL; }
        return TYPE_UNKNOWN;
    }

    fn infer_c_expr_type(state: Vec<i64>, expr: Vec<i64>) -> i64 {
        let node_type = vec_get(expr, 0);

        if node_type == NODE_INT_LIT {
            return TYPE_I64;
        }

        if node_type == NODE_FLOAT_LIT {
            return TYPE_F64;
        }

        if node_type == NODE_BOOL_LIT {
            return TYPE_BOOL;
        }

        if node_type == NODE_STR_LIT {
            return TYPE_STR;
        }

        if node_type == NODE_ARRAY_LIT {
            let elems = vec_get(expr, 1) as Vec<i64>;
            if vec_len(elems) > 0 {
                return infer_c_expr_type(state, vec_get(elems, 0) as Vec<i64>);
            }
            return TYPE_UNKNOWN;
        }

        if node_type == NODE_IDENT {
            return cgen_lookup_name_type(state, vec_get(expr, 1));
        }

        if node_type == NODE_INDEX {
            let base = vec_get(expr, 1) as Vec<i64>;
            if vec_get(base, 0) == NODE_IDENT {
                return cgen_lookup_array_elem_type(state, vec_get(base, 1));
            }
            return TYPE_UNKNOWN;
        }

        if node_type == NODE_BINARY {
            let op = vec_get(expr, 1);
            let left = vec_get(expr, 2) as Vec<i64>;
            let right = vec_get(expr, 3) as Vec<i64>;
            let left_kind = infer_c_expr_type(state, left);
            let right_kind = infer_c_expr_type(state, right);
            if op == TOK_PLUS && (left_kind == TYPE_STR || right_kind == TYPE_STR) {
                return TYPE_STR;
            }
            if op == TOK_EQ || op == TOK_NE || op == TOK_LT || op == TOK_GT || op == TOK_LE || op == TOK_GE ||
               op == TOK_AND || op == TOK_OR {
                return TYPE_BOOL;
            }
            return left_kind;
        }

        if node_type == NODE_TERNARY {
            return infer_c_expr_type(state, vec_get(expr, 2) as Vec<i64>);
        }

        if node_type == NODE_UNARY {
            let op = vec_get(expr, 1);
            if op == TOK_NOT {
                return TYPE_BOOL;
            }
            return infer_c_expr_type(state, vec_get(expr, 2) as Vec<i64>);
        }

        if node_type == NODE_CALL {
            let name_idx = vec_get(expr, 1);
            let names = vec_get(state, 3) as Vec<str>;
            let raw = name_from_table(names, name_idx);
            let builtin_kind = builtin_return_type(raw);
            if builtin_kind != TYPE_UNKNOWN {
                return builtin_kind;
            }
            return cgen_lookup_fn_type(state, name_idx);
        }

        return TYPE_UNKNOWN;
    }

    fn gen_c_expr(state: Vec<i64>, expr: Vec<i64>) -> str {
        let node_type = vec_get(expr, 0);

        if node_type == NODE_INT_LIT {
            return int_to_string(vec_get(expr, 1));
        }

        if node_type == NODE_FLOAT_LIT {
            return vec_get(expr, 1) as str;
        }

        if node_type == NODE_BOOL_LIT {
            if vec_get(expr, 1) == 1 { return "BKR_TRUE"; }
            return "BKR_FALSE";
        }

        if node_type == NODE_STR_LIT {
            let raw = vec_get(expr, 1) as str;
            return c_escape_string(raw);
        }

        if node_type == NODE_ARRAY_LIT {
            let elems = vec_get(expr, 1) as Vec<i64>;
            let result = "{";
            let i: i64 = 0;
            while i < vec_len(elems) {
                if i > 0 { result = result + ", "; }
                result = result + gen_c_expr(state, vec_get(elems, i) as Vec<i64>);
                i = i + 1;
            }
            return result + "}";
        }

        if node_type == NODE_IDENT {
            let name_idx = vec_get(expr, 1);
            return name_to_c(state, name_idx);
        }

        if node_type == NODE_INDEX {
            let base = vec_get(expr, 1) as Vec<i64>;
            let idx = vec_get(expr, 2) as Vec<i64>;
            return gen_c_expr(state, base) + "[" + gen_c_expr(state, idx) + "]";
        }

        if node_type == NODE_BINARY {
            let op = vec_get(expr, 1);
            let left = vec_get(expr, 2) as Vec<i64>;
            let right = vec_get(expr, 3) as Vec<i64>;

            if op == TOK_EQ || op == TOK_NE {
                let left_kind = infer_c_expr_type(state, left);
                let right_kind = infer_c_expr_type(state, right);
                if left_kind == TYPE_STR || right_kind == TYPE_STR {
                    let cmp = "bkr_str_eq(" + gen_c_expr(state, left) + ", " + gen_c_expr(state, right) + ")";
                    if op == TOK_NE {
                        return "(!" + cmp + ")";
                    }
                    return cmp;
                }
            }

            if op == TOK_PLUS {
                let left_kind = infer_c_expr_type(state, left);
                let right_kind = infer_c_expr_type(state, right);
                if left_kind == TYPE_STR || right_kind == TYPE_STR {
                    return "bkr_str_concat(" + gen_c_expr(state, left) + ", " + gen_c_expr(state, right) + ")";
                }
            }

            return "(" + gen_c_expr(state, left) + op_to_c(op) + gen_c_expr(state, right) + ")";
        }

        if node_type == NODE_TERNARY {
            let cond = vec_get(expr, 1) as Vec<i64>;
            let then_expr = vec_get(expr, 2) as Vec<i64>;
            let else_expr = vec_get(expr, 3) as Vec<i64>;
            return "(" + gen_c_expr(state, cond) + " ? " + gen_c_expr(state, then_expr) + " : " + gen_c_expr(state, else_expr) + ")";
        }

        if node_type == NODE_UNARY {
            let op = vec_get(expr, 1);
            let operand = vec_get(expr, 2) as Vec<i64>;
            if op == TOK_NOT { return "(!" + gen_c_expr(state, operand) + ")"; }
            if op == TOK_MINUS { return "(-" + gen_c_expr(state, operand) + ")"; }
            return gen_c_expr(state, operand);
        }

        if node_type == NODE_CALL {
            let name_idx = vec_get(expr, 1);
            let args = vec_get(expr, 2) as Vec<i64>;
            let names = vec_get(state, 3) as Vec<str>;
            let raw = name_from_table(names, name_idx);
            if raw == "len" && vec_len(args) == 1 {
                let arg = vec_get(args, 0) as Vec<i64>;
                if vec_get(arg, 0) == NODE_IDENT {
                    let array_len = cgen_lookup_array_length(state, vec_get(arg, 1));
                    if array_len >= 0 {
                        return int_to_string(array_len);
                    }
                }
            }
            let name = name_to_c(state, name_idx);
            let result = name + "(";
            let i: i64 = 0;
            while i < vec_len(args) {
                if i > 0 { result = result + ", "; }
                result = result + gen_c_expr(state, vec_get(args, i) as Vec<i64>);
                i = i + 1;
            }
            return result + ")";
        }

        return "0";
    }

    fn gen_c_stmt(state: Vec<i64>, stmt: Vec<i64>) -> Vec<i64> {
        let node_type = vec_get(stmt, 0);

        if node_type == NODE_LET {
            let name = name_to_c(state, vec_get(stmt, 1));
            let type_node = vec_get(stmt, 2);
            let init = vec_get(stmt, 3);

            if type_node != 0 && type_node_kind(type_node) == TYPE_ARRAY {
                let elem_kind = type_node_array_elem_kind(type_node);
                let array_len = type_node_array_len(type_node);
                let line = type_to_c(elem_kind) + " " + name + "[" + int_to_string(array_len) + "]";
                if init != 0 {
                    line = line + " = " + gen_c_expr(state, init as Vec<i64>);
                }
                cgen_emit(state, line + ";");
                cgen_add_local_type(state, vec_get(stmt, 1), elem_kind);
                cgen_add_array_type(state, vec_get(stmt, 1), elem_kind, array_len);
                return state;
            }

            let kind = TYPE_I64;
            if type_node != 0 {
                kind = type_node_kind(type_node);
            } else if init != 0 {
                let init_kind = infer_c_expr_type(state, init as Vec<i64>);
                if init_kind != TYPE_UNKNOWN && init_kind != TYPE_VOID {
                    kind = init_kind;
                }
            }

            let c_type = type_to_c(kind);
            let line = c_type + " " + name;
            if init != 0 {
                line = line + " = " + gen_c_expr(state, init as Vec<i64>);
            }
            cgen_emit(state, line + ";");
            cgen_add_local_type(state, vec_get(stmt, 1), kind);
            return state;
        }

        if node_type == NODE_RETURN {
            let expr = vec_get(stmt, 1);
            if expr != 0 {
                cgen_emit(state, "return " + gen_c_expr(state, expr as Vec<i64>) + ";");
            } else {
                cgen_emit(state, "return;");
            }
            return state;
        }

        if node_type == NODE_IF {
            let cond = vec_get(stmt, 1) as Vec<i64>;
            let then_block = vec_get(stmt, 2) as Vec<i64>;
            let else_block = vec_get(stmt, 3);

            cgen_emit(state, "if (" + gen_c_expr(state, cond) + ") {");
            cgen_indent(state);
            gen_c_block(state, then_block);
            cgen_dedent(state);

            if else_block != 0 {
                cgen_emit(state, "} else {");
                cgen_indent(state);
                gen_c_block(state, else_block as Vec<i64>);
                cgen_dedent(state);
            }
            cgen_emit(state, "}");
            return state;
        }

        if node_type == NODE_WHILE {
            let cond = vec_get(stmt, 1) as Vec<i64>;
            let body = vec_get(stmt, 2) as Vec<i64>;
            cgen_emit(state, "while (" + gen_c_expr(state, cond) + ") {");
            cgen_indent(state);
            gen_c_block(state, body);
            cgen_dedent(state);
            cgen_emit(state, "}");
            return state;
        }

        if node_type == NODE_FOR {
            let name_idx = vec_get(stmt, 1);
            let name = name_to_c(state, name_idx);
            let start_expr = vec_get(stmt, 2) as Vec<i64>;
            let end_expr = vec_get(stmt, 3) as Vec<i64>;
            let inclusive = vec_get(stmt, 4);
            let body = vec_get(stmt, 5) as Vec<i64>;

            let cmp = "<";
            if inclusive != 0 {
                cmp = "<=";
            }

            cgen_emit(state, "for (bkr_i64 " + name + " = " + gen_c_expr(state, start_expr) + "; " + name + " " + cmp + " " + gen_c_expr(state, end_expr) + "; " + name + " = " + name + " + 1) {");
            cgen_indent(state);
            cgen_add_local_type(state, name_idx, TYPE_I64);
            gen_c_block(state, body);
            cgen_dedent(state);
            cgen_emit(state, "}");
            return state;
        }

        if node_type == NODE_LOOP {
            let body = vec_get(stmt, 1) as Vec<i64>;
            cgen_emit(state, "while (BKR_TRUE) {");
            cgen_indent(state);
            gen_c_block(state, body);
            cgen_dedent(state);
            cgen_emit(state, "}");
            return state;
        }

        if node_type == NODE_ASSIGN {
            let target = vec_get(stmt, 1) as Vec<i64>;
            let value = vec_get(stmt, 2) as Vec<i64>;
            cgen_emit(state, gen_c_expr(state, target) + " = " + gen_c_expr(state, value) + ";");
            return state;
        }

        if node_type == NODE_EXPR_STMT {
            let expr = vec_get(stmt, 1) as Vec<i64>;
            cgen_emit(state, gen_c_expr(state, expr) + ";");
            return state;
        }

        if node_type == NODE_BREAK {
            cgen_emit(state, "break;");
            return state;
        }

        if node_type == NODE_CONTINUE {
            cgen_emit(state, "continue;");
            return state;
        }

        return state;
    }

    fn c_escape_string(raw: str) -> str {
        let quote = from_char_code(34);
        let backslash = from_char_code(92);
        let out = "";
        let i = 0;
        while i < len(raw) {
            let ch = char_at(raw, i);
            let ch_code = char_code(ch);

            if ch_code == 10 {
                out = out + backslash + "n";
            } else if ch_code == 13 {
                out = out + backslash + "r";
            } else if ch_code == 9 {
                out = out + backslash + "t";
            } else if ch_code == 34 {
                out = out + backslash + quote;
            } else if ch_code == 92 {
                out = out + backslash + backslash;
            } else {
                out = out + ch;
            }

            i = i + 1;
        }

        return quote + out + quote;
    }

    fn gen_c_block(state: Vec<i64>, block: Vec<i64>) -> Vec<i64> {
        let i: i64 = 1;
        while i < vec_len(block) {
            gen_c_stmt(state, vec_get(block, i) as Vec<i64>);
            i = i + 1;
        }
        return state;
    }

    fn gen_c_signature(state: Vec<i64>, fn_node: Vec<i64>) -> str {
        let name = name_to_c(state, vec_get(fn_node, 1));
        let params = vec_get(fn_node, 2) as Vec<i64>;
        let ret_type_node = vec_get(fn_node, 3);

        let ret_type: str = "void";
        if ret_type_node != 0 {
            let ret_type_vec = ret_type_node as Vec<i64>;
            ret_type = type_to_c(vec_get(ret_type_vec, 1));
        }

        // Generate parameter list
        let param_str: str = "";
        let i: i64 = 0;
        while i < vec_len(params) {
            let param = vec_get(params, i) as Vec<i64>;
            let pname = name_to_c(state, vec_get(param, 1));
            let ptype = vec_get(param, 2) as Vec<i64>;
            let ptype_c = type_to_c(vec_get(ptype, 1));
            if i > 0 { param_str = param_str + ", "; }
            param_str = param_str + ptype_c + " " + pname;
            i = i + 1;
        }
        if param_str == "" { param_str = "void"; }

        return ret_type + " " + name + "(" + param_str + ")";
    }

    fn gen_c_prototype(state: Vec<i64>, fn_node: Vec<i64>) -> Vec<i64> {
        cgen_emit(state, gen_c_signature(state, fn_node) + ";");
        return state;
    }

    fn gen_c_fn(state: Vec<i64>, fn_node: Vec<i64>) -> Vec<i64> {
        cgen_clear_locals(state);
        let params = vec_get(fn_node, 2) as Vec<i64>;
        let i: i64 = 0;
        while i < vec_len(params) {
            let param = vec_get(params, i) as Vec<i64>;
            let ptype = vec_get(param, 2) as Vec<i64>;
            cgen_add_local_type(state, vec_get(param, 1), vec_get(ptype, 1));
            i = i + 1;
        }

        let body = vec_get(fn_node, 4) as Vec<i64>;

        cgen_emit(state, gen_c_signature(state, fn_node) + " {");
        cgen_indent(state);
        gen_c_block(state, body);
        cgen_dedent(state);
        cgen_emit(state, "}");
        cgen_emit(state, "");
        return state;
    }

    fn gen_c_const(state: Vec<i64>, const_node: Vec<i64>) -> Vec<i64> {
        let name = name_to_c(state, vec_get(const_node, 1));
        let type_node = vec_get(const_node, 2);
        let value = vec_get(const_node, 3);

        let kind = TYPE_I64;
        if type_node != 0 {
            kind = type_node_kind(type_node);
        } else if value != 0 {
            let value_kind = infer_c_expr_type(state, value as Vec<i64>);
            if value_kind != TYPE_UNKNOWN && value_kind != TYPE_VOID {
                kind = value_kind;
            }
        }

        let c_type = type_to_c(kind);
        let c_value: str = "0";
        if value != 0 {
            c_value = gen_c_expr(state, value as Vec<i64>);
        }

        cgen_emit(state, "static const " + c_type + " " + name + " = " + c_value + ";");
        cgen_add_global_type(state, vec_get(const_node, 1), kind);
        return state;
    }

    fn gen_c_kernel_function_types(state: Vec<i64>, kernel: Vec<i64>) -> Vec<i64> {
        let items = vec_get(kernel, 2) as Vec<i64>;
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if vec_get(item, 0) == NODE_FN {
                let ret_type_node = vec_get(item, 3);
                let kind = TYPE_VOID;
                if ret_type_node != 0 {
                    kind = type_node_kind(ret_type_node);
                }
                cgen_add_fn_type(state, vec_get(item, 1), kind);
            }
            i = i + 1;
        }
        return state;
    }

    fn gen_c_kernel_consts(state: Vec<i64>, kernel: Vec<i64>) -> Vec<i64> {
        let items = vec_get(kernel, 2) as Vec<i64>;
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if vec_get(item, 0) == NODE_CONST {
                gen_c_const(state, item);
            }
            i = i + 1;
        }
        return state;
    }

    fn gen_c_kernel_prototypes(state: Vec<i64>, kernel: Vec<i64>) -> Vec<i64> {
        let items = vec_get(kernel, 2) as Vec<i64>;
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if vec_get(item, 0) == NODE_FN {
                gen_c_prototype(state, item);
            }
            i = i + 1;
        }
        return state;
    }

    fn gen_c_kernel(state: Vec<i64>, kernel: Vec<i64>) -> Vec<i64> {
        let items = vec_get(kernel, 2) as Vec<i64>;
        let i: i64 = 0;
        while i < vec_len(items) {
            let item = vec_get(items, i) as Vec<i64>;
            if vec_get(item, 0) == NODE_FN {
                gen_c_fn(state, item);
            }
            i = i + 1;
        }
        return state;
    }

    fn gen_c_program(kernel: Vec<i64>) -> str {
        let names = vec_get(kernel, 4) as Vec<str>;
        let kernel_name = name_to_c_from_names(names, vec_get(kernel, 1));
        let state: Vec<i64> = cgen_new(kernel_name, names);

        cgen_emit(state, "/* Generated by Bunker Compiler */");
        let quote = from_char_code(34);
        cgen_emit(state, "#include " + quote + "runtime.h" + quote);
        cgen_emit(state, "");

        gen_c_kernel_function_types(state, kernel);
        gen_c_kernel_consts(state, kernel);
        cgen_emit(state, "");
        gen_c_kernel_prototypes(state, kernel);
        cgen_emit(state, "");
        gen_c_kernel(state, kernel);

        let entry_idx = vec_get(kernel, 3);
        let entry_name = name_to_c(state, entry_idx);

        // Main wrapper that calls the parsed Bunker main()
        cgen_emit(state, "int main(void) {");
        cgen_emit(state, "    return (int)" + entry_name + "();");
        cgen_emit(state, "}");

        // Join lines
        let lines = vec_get(state, 0) as Vec<str>;
        let output: str = "";
        let newline = from_char_code(10);
        let i: i64 = 0;
        while i < vec_len(lines) {
            let line = vec_get(lines, i);
            output = output + line + newline;
            i = i + 1;
        }
        return output;
    }

    // ========================================
    // COMPILER DRIVER
    // ========================================

    fn compile_to_c(source: str) -> str {
        let lex_result: Vec<i64> = tokenize(source);
        let p: Vec<i64> = parser_new(lex_result);
        let ast: Vec<i64> = parse_kernel(p);

        if parser_has_error(p) {
            let msg = "/* Parse error at token " + int_to_string(parser_error_position(p)) +
                ": expected " + token_name(parser_error_expected(p)) +
                ", got " + token_name(parser_error_actual(p)) +
                ". AI repair hint: inspect the construct before this token. Supported bootstrap syntax includes kernel, fn, const, let, fixed arrays, if, else, for-in ranges, while, loop, break, continue, return, primitive types, Vec<T> handles, calls, casts, ternary expressions, bitwise operators, and basic expressions. */";
            return msg + from_char_code(10);
        }

        return gen_c_program(ast);
    }

    fn main() -> i32 {
        // File-based entrypoint for agents and the Rust wrapper:
        // write self_host_input.bkr, run this program, read self_host_output.c.
        let input_path = "self_host_input.bkr";
        let output_path = "self_host_output.c";

        let default_source = "kernel Test { fn main() -> i32 { let x: i32 = 40; let y: i32 = 2; return x + y; } }";
        if !file_exists(input_path) {
            write_file(input_path, default_source);
        }

        let source = read_file(input_path);
        let c_code = compile_to_c(source);
        let wrote = write_file(output_path, c_code);
        if !wrote {
            return 1;
        }

        if !file_exists(output_path) {
            return 2;
        }

        return 42;
    }
}
