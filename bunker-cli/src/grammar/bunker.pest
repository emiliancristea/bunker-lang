// Bunker Language Grammar (PEG)
// File extension: .bkr

// ====================
// TOP-LEVEL STRUCTURE
// ====================

file = { SOI ~ (kernel_block | shell_block | view_block)* ~ EOI }

kernel_block = { "kernel" ~ identifier ~ "{" ~ kernel_item* ~ "}" }
shell_block  = { "shell" ~ identifier ~ "{" ~ shell_item* ~ "}" }
view_block   = { "view" ~ identifier ~ "{" ~ view_item* ~ "}" }

// ====================
// KERNEL LAYER
// ====================

kernel_item = { function | struct_def | enum_def | const_def | comptime_fn | type_alias_def }

function = { 
    attribute* ~ 
    "fn" ~ fn_name ~ "(" ~ param_list? ~ ")" ~ 
    ("->" ~ type_expr)? ~ 
    block 
}
fn_name = { identifier ~ (("::" | ".") ~ identifier)? }

comptime_fn = {
    "comptime" ~ "fn" ~ fn_name ~ "(" ~ param_list? ~ ")" ~
    ("->" ~ type_expr)? ~
    block
}

struct_def = { "struct" ~ identifier ~ (struct_body_fields | struct_body_tuple) }
struct_body_fields = { "{" ~ struct_field* ~ "}" }
struct_body_tuple = { "(" ~ (type_expr ~ ("," ~ type_expr)* ~ ","?)? ~ ")" ~ ";"? }
struct_field = { identifier ~ ":" ~ type_expr ~ ","? }

enum_def = { "enum" ~ identifier ~ "{" ~ enum_variant_list? ~ "}" }
enum_variant_list = { enum_variant ~ ("," ~ enum_variant)* ~ ","? }
enum_variant = { identifier ~ ("(" ~ type_expr ~ ("," ~ type_expr)* ~ ")")? }

const_def = { "const" ~ identifier ~ ":" ~ type_expr ~ "=" ~ expr ~ ";" }

type_alias_def = { "type" ~ identifier ~ "=" ~ type_expr ~ ";" }

param_list = { param ~ ("," ~ param)* ~ ","? }
param = { self_param | typed_param }
self_param = { "self" ~ (":" ~ type_expr)? }
typed_param = { identifier ~ ":" ~ type_expr }

// ====================
// SHELL LAYER
// ====================

shell_item = { import_stmt | agent_def }

import_stmt = { "import" ~ identifier ~ ";" }

agent_def = { "agent" ~ identifier ~ "{" ~ agent_item* ~ "}" }
agent_item = { state_decl | message_handler }

state_decl = { identifier ~ "=" ~ expr ~ ";" }

message_handler = { 
    "on" ~ "receive" ~ string_literal ~ 
    ("with" ~ param_list)? ~ 
    block 
}

// ====================
// VIEW LAYER
// ====================

view_item = { component }

component = { target_attr? ~ identifier ~ "{" ~ component_body* ~ "}" }
component_body = { property | component }

target_attr = { "#[target(" ~ ("graphics" | "embedded") ~ ")]" }

property = { identifier ~ ":" ~ expr ~ ";" }

// ====================
// ATTRIBUTES
// ====================

attribute = { "#[" ~ attribute_inner ~ "]" }
attribute_inner = { 
    "verified" | 
    "unsafe_trust" | 
    requires_attr | 
    ensures_attr 
}
requires_attr = { "requires(" ~ expr ~ ")" }
ensures_attr = { "ensures(" ~ expr ~ ")" }

// ====================
// STATEMENTS
// ====================

block = { "{" ~ statement* ~ "}" }

statement = {
    let_stmt |
    return_stmt |
    if_stmt |
    for_stmt |
    while_stmt |
    loop_stmt |
    break_stmt |
    continue_stmt |
    match_stmt |
    defer_stmt |
    send_stmt |
    assign_stmt |
    expr_stmt
}

assign_stmt = { assign_target ~ "=" ~ expr ~ ";" }
assign_target = { identifier ~ ("." ~ identifier | "[" ~ expr ~ "]")* }

let_stmt = { "let" ~ identifier ~ (":" ~ type_expr)? ~ "=" ~ expr ~ ";" }
return_stmt = { "return" ~ expr? ~ ";" }
if_stmt = { "if" ~ expr ~ block ~ ("else" ~ (if_stmt | block))? }
loop_label = @{ "'" ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
for_stmt = { (loop_label ~ ":")? ~ "for" ~ identifier ~ "in" ~ expr ~ block }
while_stmt = { (loop_label ~ ":")? ~ "while" ~ expr ~ block }
loop_stmt = { (loop_label ~ ":")? ~ "loop" ~ block }
break_stmt = { "break" ~ loop_label? ~ ";" }
continue_stmt = { "continue" ~ loop_label? ~ ";" }
match_stmt = { "match" ~ expr ~ "{" ~ match_arm* ~ "}" }
match_arm = { pattern ~ match_guard? ~ "=>" ~ (expr ~ ";" | block) }
match_guard = { "if" ~ expr }
defer_stmt = { "defer" ~ (expr ~ ";" | block) }
send_stmt = { "send" ~ expr ~ "to" ~ identifier ~ ("with" ~ named_args)? ~ ";" }
expr_stmt = { expr ~ ";" }

// ====================
// EXPRESSIONS
// ====================

expr = { ternary_expr }
ternary_expr = { range_expr ~ ("?" ~ expr ~ ":" ~ expr)? }
range_expr = { or_expr ~ (range_op ~ or_expr)? }
range_op = { "..=" | ".." }
or_expr = { prefix_expr ~ (binary_op ~ prefix_expr)* }

prefix_expr = { prefix_op? ~ postfix_expr }
prefix_op = { "!" | "-" | "copy" }

postfix_expr = { primary_expr ~ postfix_op* }
postfix_op = { try_op | call_op | index_op | field_op | cast_op }
try_op = { "?" ~ !ternary_lookahead }
ternary_lookahead = _{ (!(":" | ";" | "}" | ")") ~ ANY)* ~ ":" }

call_op = { "(" ~ arg_list? ~ ")" }
index_op = { "[" ~ expr ~ "]" }
field_op = { "." ~ (ASCII_DIGIT+ | identifier) }
cast_op = { "as" ~ type_expr }

arg_list = { expr ~ ("," ~ expr)* }
named_args = { named_arg ~ ("," ~ named_arg)* }
named_arg = { identifier ~ "=" ~ expr }

primary_expr = {
    unit_literal |
    tuple_literal |
    "(" ~ expr ~ ")" |
    use_expr |
    send_expr |
    lambda_expr |
    if_expr |
    match_expr |
    option_expr |
    array_literal |
    struct_literal |
    literal |
    path_expr |
    block |
    identifier
}
path_expr = { identifier ~ "::" ~ identifier }

unit_literal = { "(" ~ ")" }
tuple_literal = { "(" ~ expr ~ ("," ~ expr)+ ~ ","? ~ ")" }

send_expr = { "send" ~ expr ~ "to" ~ qualified_name ~ ("with" ~ named_args)? }

use_expr = { "use" ~ qualified_name ~ "with" ~ named_args }
qualified_name = { identifier ~ ("." ~ identifier)* }

lambda_expr = { "|" ~ param_list? ~ "|" ~ (expr | block) }

if_expr = { "if" ~ expr ~ block ~ "else" ~ block }
match_expr = { "match" ~ expr ~ "{" ~ match_arm* ~ "}" }

option_expr = { "Some(" ~ expr ~ ")" | "None" }

array_literal = { "[" ~ (array_repeat | (expr ~ ("," ~ expr)*)?) ~ "]" }
array_repeat = { expr ~ ";" ~ integer }
struct_update = { ".." ~ expr }
struct_literal = { identifier ~ "{" ~ ((struct_init ~ ("," ~ struct_init)* ~ ("," ~ struct_update)?) | struct_update)? ~ ","? ~ "}" }
struct_init = { identifier ~ ":" ~ expr }

// ====================
// OPERATORS
// ====================

binary_op = {
    "==" | "!=" | "<=" | ">=" | "<<" | ">>" | "<" | ">" |
    "&&" | "||" |
    "+" | "-" | "*" | "/" | "%" |
    "&" | "|" | "^" |
    "as"
}

// ====================
// PATTERNS
// ====================

tuple_pattern = { "(" ~ pattern ~ ("," ~ pattern)+ ~ ","? ~ ")" }
struct_pattern = { identifier ~ "{" ~ (struct_field_pattern ~ ("," ~ struct_field_pattern)* ~ ","?)? ~ "}" }
struct_field_pattern = { identifier ~ (":" ~ pattern)? }

option_some_pattern = { ("Option.")? ~ "Some" ~ "(" ~ pattern ~ ")" }
result_ok_pattern = { ("Result.")? ~ "Ok" ~ "(" ~ pattern ~ ")" }
result_err_pattern = { ("Result.")? ~ "Err" ~ "(" ~ pattern ~ ")" }

pattern = {
    "()" |
    tuple_pattern |
    struct_pattern |
    option_some_pattern |
    "Option.None" |
    "None" |
    result_ok_pattern |
    result_err_pattern |
    "true" |
    "false" |
    enum_variant_pattern |
    tuple_struct_pattern |
    literal |
    identifier
}
enum_variant_pattern = { identifier ~ "." ~ identifier ~ ("(" ~ identifier ~ ("," ~ identifier)* ~ ")")? }
tuple_struct_pattern = { identifier ~ "(" ~ (pattern ~ ("," ~ pattern)* ~ ","?)? ~ ")" }

// ====================
// TYPES
// ====================

type_expr = {
    never_type |
    unit_type |
    tuple_type |
    option_type |
    result_type |
    vec_type |
    hashmap_type |
    array_type |
    ref_type |
    fn_type |
    base_type
}

never_type = { "!" | "never" }
unit_type = { "(" ~ ")" }
tuple_type = { "(" ~ type_expr ~ ("," ~ type_expr)+ ~ ","? ~ ")" }
option_type = { "Option<" ~ type_expr ~ ">" }
result_type = { "Result<" ~ type_expr ~ "," ~ type_expr ~ ">" }
vec_type = { "Vec<" ~ type_expr ~ ">" }
hashmap_type = { "HashMap<" ~ type_expr ~ "," ~ type_expr ~ ">" }
array_type = { "[" ~ type_expr ~ ";" ~ integer ~ "]" }
ref_type = { "&" ~ "mut"? ~ type_expr }
fn_type = { "fn" ~ "(" ~ fn_params? ~ ")" ~ fn_ret? }
fn_params = { type_expr ~ ("," ~ type_expr)* ~ ","? }
fn_ret = { "->" ~ type_expr }
base_type = {
    "i32" | "i64" | "f32" | "f64" |
    "bool" | "str" | "vec3" | "vec2" |
    identifier
}

// ====================
// LITERALS
// ====================

literal = {
    float |
    integer |
    string_literal |
    char_literal |
    bool_literal |
    hex_color
}

integer = @{ "-"? ~ ASCII_DIGIT+ }
float = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
string_literal = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
char_literal = @{ "'" ~ ANY ~ "'" }
bool_literal = { "true" | "false" }
hex_color = @{ "#" ~ ASCII_HEX_DIGIT{6} }

// ====================
// IDENTIFIERS & WHITESPACE
// ====================

identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
